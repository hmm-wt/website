---
import Base from './Base.astro';
import { buildContactMailto } from '../utils/mailto.ts';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const doctrineMailto = buildContactMailto('Doctrine · talk through it');
---
<Base title={title} description={description} ogImage={ogImage} bare>
  <div class="doctrine">
    <div class="doctrine__progress" aria-hidden="true"><span class="doctrine__progress-bar"></span></div>

    <header class="doctrine__masthead">
      <slot name="header" />
    </header>

    <nav class="doctrine__toc-mobile" aria-label="Chapters">
      <slot name="toc" />
    </nav>

    <div class="doctrine__shell container">
      <aside class="doctrine__toc" aria-label="Chapters">
        <slot name="toc" />
      </aside>

      <main class="doctrine__body">
        <slot />
        <aside class="doctrine__cta surface-warm" aria-label="Next steps">
          <p class="kicker doctrine__cta-label">End of doctrine</p>
          <p class="doctrine__cta-line">Five Structural Certainties carry five dated bets on the scoreboard. The IM expands every chapter with the dataset and the deal pipeline.</p>
          <p class="doctrine__cta-row">
            <a href="/data/scoreboard/" class="doctrine__cta-link">The scoreboard →</a>
            <a href={doctrineMailto} class="doctrine__cta-link doctrine__cta-link--accent">Talk through it →</a>
          </p>
        </aside>
      </main>

      <aside class="doctrine__rail" aria-label="State of play">
        <slot name="rail" />
      </aside>
    </div>

    <footer class="doctrine__foot container">
      <slot name="footer" />
    </footer>
  </div>

  <script>
    function initDoctrineProgress() {
      const bar = document.querySelector('.doctrine__progress-bar');
      if (!(bar instanceof HTMLElement)) return;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) bar.style.transition = 'none';
      const update = () => {
        const h = document.documentElement;
        const max = (h.scrollHeight - h.clientHeight) || 1;
        const pct = Math.max(0, Math.min(100, (h.scrollTop / max) * 100));
        bar.style.width = pct + '%';
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);

      // Pulse on chapter boundary crossing.
      const chapters = document.querySelectorAll<HTMLElement>('.chapter');
      if (!chapters.length || reduced) return;
      const pulse = () => {
        bar.classList.add('is-pulse');
        window.setTimeout(() => bar.classList.remove('is-pulse'), 320);
      };
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting && e.intersectionRatio > 0.4) pulse();
        });
      }, { threshold: [0, 0.4, 0.8] });
      chapters.forEach((c) => obs.observe(c));
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDoctrineProgress);
    } else {
      initDoctrineProgress();
    }
  </script>
</Base>

<style>
  .doctrine { padding-block-end: var(--s-9); }

  .doctrine__progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: transparent;
    z-index: 60;
    pointer-events: none;
  }
  .doctrine__progress-bar {
    display: block;
    height: 100%;
    width: 0;
    background: var(--c-tomato);
    transition: width 80ms linear, box-shadow var(--mo-tick) var(--ease-golden);
  }
  .doctrine__progress-bar.is-pulse {
    box-shadow: 0 0 6px var(--c-tomato), 0 0 14px rgba(196, 69, 57, 0.45);
  }

  .doctrine__toc-mobile { display: none; }
  .doctrine__toc-mobile > nav,
  .doctrine__toc-mobile > * { padding: var(--s-5); border-bottom: 1px solid var(--rule); }

  .doctrine__cta {
    margin-block-start: var(--s-8);
    padding: var(--s-6);
    border-top: 2px solid var(--c-tomato);
    background: var(--bg-warm);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .doctrine__cta-label { color: var(--c-tomato); margin: 0; }
  .doctrine__cta-line {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    margin: 0;
    max-width: 52ch;
    color: var(--fg);
  }
  .doctrine__cta-row {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .doctrine__cta-link {
    color: var(--c-mahogany);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  .doctrine__cta-link:hover { color: var(--c-tomato); }
  .doctrine__cta-link--accent { color: var(--c-tomato); }


  .doctrine__masthead {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding-block: var(--s-8) var(--s-7);
  }

  .doctrine__shell {
    display: grid;
    grid-template-columns: 220px minmax(0, 60ch) 260px;
    grid-template-areas: "toc body rail";
    column-gap: var(--s-6);
    align-items: start;
    padding-block: var(--s-8);
  }

  .doctrine__toc {
    grid-area: toc;
    position: sticky;
    top: calc(var(--s-7) + 1rem);
    align-self: start;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    padding-inline-end: var(--s-3);
  }

  .doctrine__body {
    grid-area: body;
    max-width: 60ch;
  }

  /* Footnotes live on the site-wide /references/ page. Hide the auto-rendered
     footnote sections inside each chapter so the doctrine reads as a clean
     artefact. Inline [^N] markers still render and link to the references page. */
  .doctrine__body :global(section[data-footnotes]),
  .doctrine__body :global(aside.footnotes),
  .doctrine__body :global(.footnotes) {
    display: none;
  }
  /* Inline footnote markers also hidden — the link target is the now-
   * hidden in-page footnote section, so the marker would be a dead
   * click. Reader finds citations on the consolidated /references/
   * page (linked from the nav, footer, and DoctrineHeader). */
  .doctrine__body :global(sup.footnote-ref),
  .doctrine__body :global(a[data-footnote-ref]) {
    display: none;
  }

  .doctrine__rail {
    grid-area: rail;
    position: sticky;
    top: calc(var(--s-7) + 1rem);
    align-self: start;
  }

  .doctrine__foot {
    margin-block-start: var(--s-8);
    padding-block-start: var(--s-6);
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 1100px) {
    .doctrine__shell {
      grid-template-columns: 200px minmax(0, 1fr);
      grid-template-areas:
        "toc body"
        "toc rail";
    }
    .doctrine__rail { position: static; margin-block-start: var(--s-5); }
  }

  @media (max-width: 820px) {
    .doctrine__shell {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "body"
        "rail";
    }
    .doctrine__toc { display: none; }
    .doctrine__rail { position: static; }
    .doctrine__toc-mobile { display: block; }
  }
</style>
