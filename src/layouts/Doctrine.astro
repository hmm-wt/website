---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
---
<Base title={title} description={description} ogImage={ogImage} bare>
  <div class="doctrine">
    <header class="doctrine__masthead">
      <slot name="header" />
    </header>

    <div class="doctrine__shell container">
      <aside class="doctrine__toc" aria-label="Chapters">
        <slot name="toc" />
      </aside>

      <main class="doctrine__body">
        <slot />
      </main>

      <aside class="doctrine__rail" aria-label="State of play">
        <slot name="rail" />
      </aside>
    </div>

    <footer class="doctrine__foot container">
      <slot name="footer" />
    </footer>
  </div>
</Base>

<style>
  .doctrine { padding-block-end: var(--s-9); }

  .doctrine__masthead {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding-block: var(--s-8) var(--s-7);
  }

  .doctrine__shell {
    display: grid;
    grid-template-columns: 220px minmax(0, 60ch) 260px;
    grid-template-areas: "toc body rail";
    column-gap: var(--s-6);
    align-items: start;
    padding-block: var(--s-8);
  }

  .doctrine__toc {
    grid-area: toc;
    position: sticky;
    top: calc(var(--s-7) + 1rem);
    align-self: start;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    padding-inline-end: var(--s-3);
  }

  .doctrine__body {
    grid-area: body;
    max-width: 60ch;
  }

  /* Footnotes live on /doctrine/references/. Hide the auto-rendered
     footnote sections inside each chapter so the doctrine reads as a clean
     artefact. Inline [^N] markers still render and link to the references page. */
  .doctrine__body :global(section[data-footnotes]),
  .doctrine__body :global(aside.footnotes),
  .doctrine__body :global(.footnotes) {
    display: none;
  }
  .doctrine__body :global(a[data-footnote-ref]),
  .doctrine__body :global(sup.footnote-ref a),
  .doctrine__body :global(a.data-footnote-ref) {
    color: var(--c-tomato);
    font-family: var(--f-mono);
    font-size: 0.78em;
    text-decoration: none;
    border-bottom: none;
    padding: 0 0.1em;
  }

  .doctrine__rail {
    grid-area: rail;
    position: sticky;
    top: calc(var(--s-7) + 1rem);
    align-self: start;
  }

  .doctrine__foot {
    margin-block-start: var(--s-8);
    padding-block-start: var(--s-6);
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 1100px) {
    .doctrine__shell {
      grid-template-columns: 200px minmax(0, 1fr);
      grid-template-areas:
        "toc body"
        "toc rail";
    }
    .doctrine__rail { position: static; margin-block-start: var(--s-5); }
  }

  @media (max-width: 820px) {
    .doctrine__shell {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "toc"
        "body"
        "rail";
    }
    .doctrine__toc { position: static; max-height: none; }
    .doctrine__rail { position: static; }
  }
</style>
