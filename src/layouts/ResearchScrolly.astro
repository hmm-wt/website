---
import Base from './Base.astro';

interface HeadlineMetric { label: string; value: string }
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Optional headline metrics shown above the first scroll stage. */
  headlineMetrics?: HeadlineMetric[];
}

const { title, description, ogImage, headlineMetrics } = Astro.props;
---
<Base title={title} description={description} ogImage={ogImage}>
  <article class="rscroll surface-light">
    <div class="rscroll__progress scroll-progress" aria-hidden="true" data-scrolly-progress></div>

    <header class="rscroll__head container">
      <p class="kicker rscroll__kicker">
        <span class="rscroll__reg" aria-hidden="true"></span>
        Research · hmm Ventures
      </p>
      <h1 class="rscroll__title gavel-drop">{title}.</h1>
    </header>

    {headlineMetrics && headlineMetrics.length > 0 && (
      <section class="rscroll__metrics container" aria-label="Headline metrics">
        <ul class="rscroll__metrics-list" role="list">
          {headlineMetrics.map((m) => (
            <li class="rscroll__metric">
              <span class="rscroll__metric-value">{m.value}</span>
              <span class="rscroll__metric-label">{m.label}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="rscroll__prose prose container">
      <slot />
    </div>
  </article>

  <script>
    import '../scripts/scrolly';
  </script>
</Base>

<style>
  .rscroll {
    position: relative;
    padding-block: var(--s-7) var(--s-9);
  }
  .rscroll__progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 0;
  }

  .rscroll__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding-block-end: var(--s-5);
    border-bottom: 1px solid var(--rule);
    margin-block-end: var(--s-6);
    max-width: 64rem;
  }
  .rscroll__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin: 0;
  }
  .rscroll__reg {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--c-tomato);
  }
  .rscroll__version { color: var(--c-tomato); margin-inline-start: var(--s-2); }
  .rscroll__date { margin: 0; }
  .rscroll__title {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    margin: var(--s-3) 0 0;
    max-width: 22ch;
  }

  .rscroll__metrics {
    max-width: 72rem;
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--rule);
    margin-block-end: var(--s-6);
  }
  .rscroll__metrics-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--s-4) var(--s-6);
  }
  .rscroll__metric { display: flex; flex-direction: column; gap: 0.2rem; }
  .rscroll__metric-value {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: 1;
    color: var(--c-tomato);
    letter-spacing: -0.01em;
  }
  .rscroll__metric-label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
  }

  .rscroll__prose {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: var(--lh-loose);
    max-width: 64rem;
  }

  /* Scrolly sections inside the prose. Each <section data-scrolly> sets up
   * the sticky viz / scroll rail two-column layout. The right column scrolls
   * normally; the left pin stays in view until the section's last stage. */
  :global(.rscroll__prose [data-scrolly]) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 32rem);
    gap: var(--s-6);
    align-items: start;
    margin-block: var(--s-7);
  }
  :global(.rscroll__prose .scrolly__viz) {
    position: sticky;
    top: 12vh;
    align-self: start;
    height: 76vh;
    max-height: 540px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  :global(.rscroll__prose .scrolly__rail) {
    display: flex;
    flex-direction: column;
    gap: 28vh;
    padding-block: 12vh;
  }
  :global(.rscroll__prose .scrolly__stage) {
    min-height: 40vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--s-5);
    border-left: 2px solid var(--rule);
    background: color-mix(in srgb, var(--c-pearl) 30%, transparent);
    opacity: 0.58;
    transition: border-left-color var(--mo-tick) var(--ease-golden),
                background var(--mo-tick) var(--ease-golden),
                opacity var(--mo-tick) var(--ease-golden);
  }
  /* Active stage. Engine adds .scrolly__stage--active to the matching child
   * stage on scrolly:enter; we lift it into focus while siblings stay dim. */
  :global(.rscroll__prose .scrolly__stage--active) {
    opacity: 1;
    border-left-color: var(--c-tomato);
    background: color-mix(in srgb, var(--c-pearl) 60%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.rscroll__prose .scrolly__stage) {
      transition: none;
      opacity: 1;
    }
  }

  @media (max-width: 900px) {
    :global(.rscroll__prose [data-scrolly]) {
      grid-template-columns: minmax(0, 1fr);
    }
    :global(.rscroll__prose .scrolly__viz) {
      position: static;
      height: auto;
      max-height: none;
      min-height: 40vh;
    }
    :global(.rscroll__prose .scrolly__rail) {
      gap: var(--s-5);
      padding-block: var(--s-5);
    }
    :global(.rscroll__prose .scrolly__stage) {
      min-height: 0;
    }
  }
</style>
