---
import Base from './Base.astro';

interface HeadlineMetric { label: string; value: string }
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  headlineMetrics?: HeadlineMetric[];
}

const { title, description, ogImage, headlineMetrics } = Astro.props;

const markets = [
  { code: 'AUS', name: 'Australia', fauna: '/fauna/hmm-fauna-au-wattle.svg' },
  { code: 'JPN', name: 'Japan',     fauna: '/fauna/hmm-fauna-jp-chrysanthemum.svg' },
  { code: 'NZL', name: 'New Zealand', fauna: '/fauna/hmm-fauna-nz-koru.svg' },
  { code: 'SIN', name: 'Singapore', fauna: '/fauna/hmm-fauna-sg-vanda.svg' }
];
---
<Base title={title} description={description} ogImage={ogImage}>
  <article class="rcorr surface-light">
    <header class="rcorr__head container">
      <p class="kicker rcorr__kicker">
        <span class="rcorr__reg" aria-hidden="true"></span>
        Research · hmm Ventures
      </p>
      <h1 class="rcorr__title gavel-drop">{title}.</h1>
      <ul class="rcorr__fauna-row" role="list" aria-label="Four corridor markets">
        {markets.map((m) => (
          <li class="rcorr__fauna-cell">
            <img src={m.fauna} alt="" loading="lazy" />
            <span class="rcorr__fauna-code">{m.code}</span>
            <span class="rcorr__fauna-name">{m.name}</span>
          </li>
        ))}
      </ul>
    </header>

    {headlineMetrics && headlineMetrics.length > 0 && (
      <section class="rcorr__metrics container" aria-label="Headline metrics">
        <ul class="rcorr__metrics-list" role="list">
          {headlineMetrics.map((m) => (
            <li class="rcorr__metric">
              <span class="rcorr__metric-value">{m.value}</span>
              <span class="rcorr__metric-label">{m.label}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="rcorr__hero container">
      <slot name="hero" />
    </div>

    <div class="rcorr__prose prose container">
      <slot />
    </div>
  </article>
</Base>

<style>
  .rcorr { padding-block: var(--s-7) var(--s-9); }
  .rcorr__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding-block-end: var(--s-5);
    border-bottom: 1px solid var(--rule);
    margin-block-end: var(--s-6);
    max-width: 72rem;
  }
  .rcorr__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin: 0;
  }
  .rcorr__reg {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--c-tomato);
  }
  .rcorr__version { color: var(--c-tomato); margin-inline-start: var(--s-2); }
  .rcorr__date { margin: 0; }
  .rcorr__title {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    margin: var(--s-3) 0 0;
    max-width: 22ch;
  }

  .rcorr__fauna-row {
    list-style: none;
    margin: var(--s-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s-4);
    border-top: 1px solid var(--rule);
    padding-block-start: var(--s-4);
  }
  .rcorr__fauna-cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }
  .rcorr__fauna-cell img {
    width: 2rem;
    height: 2rem;
    filter: brightness(0) saturate(100%);
    opacity: 0.9;
  }
  .rcorr__fauna-code {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-tomato);
    margin-block-start: var(--s-2);
  }
  .rcorr__fauna-name {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: var(--fg-soft);
    letter-spacing: 0.08em;
  }

  .rcorr__metrics {
    max-width: 72rem;
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--rule);
    margin-block-end: var(--s-6);
  }
  .rcorr__metrics-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--s-4) var(--s-6);
  }
  .rcorr__metric { display: flex; flex-direction: column; gap: 0.2rem; }
  .rcorr__metric-value {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: 1;
    color: var(--c-tomato);
    letter-spacing: -0.01em;
  }
  .rcorr__metric-label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
  }

  .rcorr__hero {
    max-width: 72rem;
    margin-block-end: var(--s-7);
  }
  .rcorr__hero:empty { display: none; }

  .rcorr__prose {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: var(--lh-loose);
    max-width: 72rem;
  }

  /* Per-market sub-section pattern: <section class="corridor-market">
   * with a fauna glyph aligned left and the market content right. Each
   * uses one of the four anchors AUS / JPN / NZL / SIN. */
  :global(.rcorr__prose .corridor-market) {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: var(--s-5);
    align-items: start;
    padding-block: var(--s-6);
    border-top: 1px solid var(--rule);
  }
  :global(.rcorr__prose .corridor-market__glyph) {
    width: 3rem;
    height: 3rem;
    filter: brightness(0) saturate(100%);
    opacity: 0.85;
  }
  :global(.rcorr__prose .corridor-market__body h2) {
    margin: 0 0 var(--s-3);
  }

  @media (max-width: 720px) {
    .rcorr__fauna-row { grid-template-columns: repeat(2, 1fr); gap: var(--s-3); }
    :global(.rcorr__prose .corridor-market) {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-3);
    }
    :global(.rcorr__prose .corridor-market__glyph) {
      width: 2rem;
      height: 2rem;
    }
  }
</style>
