---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** When true, hides the right-margin widget rail (single-column mode). */
  hideWidget?: boolean;
}

const { title, description, ogImage, hideWidget = false } = Astro.props;
---
<Base title={title} description={description} ogImage={ogImage}>
  <article class={`essay container ${hideWidget ? 'essay--single' : ''}`}>
    <div class="essay__body">
      <slot name="meta" />
      <div class="essay__prose prose">
        <slot />
      </div>
    </div>
    {!hideWidget && (
      <div class="essay__rail">
        <slot name="widget" />
      </div>
    )}
    <footer class="essay__footer">
      <slot name="footer" />
    </footer>
  </article>
</Base>

<style>
  /* Footnotes live on the site-wide /references/ page. Hide the auto-rendered
   * footnote sections inside each market chapter so the prose reads clean.
   * Inline [^N] markers still render. */
  .essay__prose :global(section[data-footnotes]),
  .essay__prose :global(aside.footnotes),
  .essay__prose :global(.footnotes) {
    display: none;
  }
  .essay__prose :global(a[data-footnote-ref]),
  .essay__prose :global(sup.footnote-ref a),
  .essay__prose :global(a.data-footnote-ref) {
    color: var(--c-tomato);
    font-family: var(--f-mono);
    font-size: 0.78em;
    text-decoration: none;
    border-bottom: none;
    padding: 0 0.1em;
  }

  .essay {
    padding-block: var(--s-8) var(--s-9);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    grid-template-areas:
      "body rail"
      "footer footer";
    column-gap: var(--s-7);
    row-gap: var(--s-7);
    align-items: start;
  }

  .essay--single {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "body"
      "footer";
  }

  .essay__body { grid-area: body; max-width: 64ch; }
  .essay__rail {
    grid-area: rail;
    position: sticky;
    top: calc(var(--s-7) + 1rem);
    align-self: start;
  }
  .essay__footer {
    grid-area: footer;
    border-top: 1px solid var(--rule);
    padding-block-start: var(--s-6);
  }

  .essay__prose {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: var(--lh-body);
  }

  @media (max-width: 900px) {
    .essay {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "body"
        "rail"
        "footer";
    }
    .essay__rail { position: static; }
  }
</style>
