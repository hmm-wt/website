---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
---
<Base title={title} description={description} ogImage={ogImage}>
  <div class="ix">
    <slot />
  </div>
</Base>

<style is:global>
  .ix {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    min-height: calc(100vh - 200px);
    padding-block: var(--s-8) var(--s-9);
  }
  .ix a { color: var(--c-pearl); }
  .ix a:hover { color: var(--c-tomato); }
</style>
