---
import Base from './Base.astro';

interface HeadlineMetric {
  label: string;
  value: string;
}

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Optional headline metrics rendered in the right rail. */
  headlineMetrics?: HeadlineMetric[];
  /** Auto-collapse h2 sections under details elements. Useful for dense pages. */
  collapseSections?: boolean;
}

const { title, description, ogImage, headlineMetrics, collapseSections } = Astro.props;
---
<Base title={title} description={description} ogImage={ogImage}>
  <article class="research container surface-light">
    <div class="research__body">
      <header class="research__head">
        <p class="kicker research__kicker">
          <span class="research__reg" aria-hidden="true"></span>
          Research · hmm Ventures
        </p>
      </header>
      <h1 class="research__title">{title}.</h1>
      {collapseSections && (
        <p class="research__collapse-toggle">
          <button type="button" data-expand-all>Expand all</button>
          <span aria-hidden="true">·</span>
          <button type="button" data-collapse-all>Collapse all</button>
        </p>
      )}
      <div class={`research__prose prose ${collapseSections ? 'is-collapsible' : ''}`} data-collapsible={collapseSections ? 'true' : 'false'}>
        <slot />
      </div>
    </div>

    <script>
      // Wrap each h2-led section in a <details> so dense pages collapse.
      // Honours #anchor links: opens the matching section then scrolls.
      function initCollapsibleSections() {
        const root = document.querySelector('.research__prose.is-collapsible');
        if (!root) return;
        const children = Array.from(root.children);
        let groups: HTMLElement[][] = [];
        let current: HTMLElement[] = [];
        children.forEach((el) => {
          if (el.tagName === 'H2') {
            if (current.length) groups.push(current);
            current = [el as HTMLElement];
          } else {
            current.push(el as HTMLElement);
          }
        });
        if (current.length) groups.push(current);
        groups.forEach((group, i) => {
          const h2 = group[0];
          const details = document.createElement('details');
          details.className = 'research__section';
          if (i === 0) details.open = true;
          const summary = document.createElement('summary');
          summary.className = 'research__section-summary';
          summary.innerHTML = h2.outerHTML + '<span class="research__section-chev" aria-hidden="true">▾</span>';
          details.appendChild(summary);
          const body = document.createElement('div');
          body.className = 'research__section-body';
          group.slice(1).forEach((el) => body.appendChild(el));
          details.appendChild(body);
          // Anchor: copy the h2's id (if any) to the details for #links
          const id = h2.id;
          if (id) details.id = id;
          h2.remove();
          root.appendChild(details);
        });
        // Move the original h2s out — already in the summary clone
        // Auto-open on hash change
        const openFromHash = () => {
          const hash = location.hash.slice(1);
          if (!hash) return;
          const el = document.getElementById(hash);
          if (el && el.tagName === 'DETAILS') {
            (el as HTMLDetailsElement).open = true;
            requestAnimationFrame(() => el.scrollIntoView({ behavior: 'smooth', block: 'start' }));
          }
        };
        window.addEventListener('hashchange', openFromHash);
        openFromHash();
        // Toggle all
        document.querySelector('[data-expand-all]')?.addEventListener('click', () => {
          root.querySelectorAll<HTMLDetailsElement>('details.research__section').forEach((d) => d.open = true);
        });
        document.querySelector('[data-collapse-all]')?.addEventListener('click', () => {
          root.querySelectorAll<HTMLDetailsElement>('details.research__section').forEach((d, i) => d.open = i === 0);
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCollapsibleSections);
      } else {
        initCollapsibleSections();
      }
    </script>

    {headlineMetrics && headlineMetrics.length > 0 && (
      <aside class="research__rail" aria-label="Headline metrics">
        <p class="research__rail-label kicker">Headline metrics</p>
        <dl class="research__metrics">
          {headlineMetrics.map((m) => (
            <div class="research__metric">
              <dt>{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))}
        </dl>
      </aside>
    )}
  </article>
</Base>

<style>
  .research {
    padding-block: var(--s-8) var(--s-9);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: var(--s-7);
    align-items: start;
  }
  .research__body { max-width: 72ch; }
  .research__head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: baseline;
    padding-block-end: var(--s-5);
    border-bottom: 1px solid var(--rule);
    margin-block-end: var(--s-6);
  }
  .research__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin: 0;
  }
  .research__reg {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--c-tomato);
  }
  .research__version {
    margin-inline-start: var(--s-2);
    color: var(--c-tomato);
  }
  .research__date {
    margin-inline-start: auto;
  }
  .research__title {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    margin: 0 0 var(--s-6);
  }

  .research__prose {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: var(--lh-loose);
    max-width: 72ch;
  }

  /* Footnotes live on the site-wide /references/ page. Hide the auto-rendered
   * footnote sections inside each research entry so the prose reads clean.
   * Inline [^N] markers still render. */
  .research__prose :global(section[data-footnotes]),
  .research__prose :global(aside.footnotes),
  .research__prose :global(.footnotes) {
    display: none;
  }
  /* Inline footnote markers also hidden — see /references/. */
  .research__prose :global(sup.footnote-ref),
  .research__prose :global(a[data-footnote-ref]) {
    display: none;
  }

  .research__collapse-toggle {
    display: flex;
    gap: var(--s-3);
    align-items: center;
    margin-block: var(--s-4);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-tomato);
  }
  .research__collapse-toggle button {
    background: none;
    border: 0;
    color: var(--c-tomato);
    font: inherit;
    cursor: pointer;
    padding: var(--s-2) 0;
  }
  .research__collapse-toggle button:hover { color: var(--c-mahogany); }

  :global(.research__prose details.research__section) {
    border-top: 1px solid var(--rule-light);
    margin-block: 0;
    padding-block: var(--s-3);
  }
  :global(.research__prose details.research__section:last-of-type) {
    border-bottom: 1px solid var(--rule-light);
  }
  :global(.research__prose .research__section-summary) {
    cursor: pointer;
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    list-style: none;
    transition: color var(--mo-tick) var(--ease-golden);
  }
  :global(.research__prose .research__section-summary::-webkit-details-marker) { display: none; }
  :global(.research__prose .research__section-summary:hover) { color: var(--c-tomato); }
  :global(.research__prose .research__section-summary h2) {
    margin: 0;
    flex: 1;
  }
  :global(.research__prose .research__section-chev) {
    color: var(--c-tomato);
    font-family: var(--f-mono);
    font-size: var(--fs-md);
    transition: transform var(--mo-tick) var(--ease-golden);
  }
  :global(.research__prose details.research__section[open] .research__section-chev) {
    transform: rotate(180deg);
  }
  :global(.research__prose .research__section-body) {
    padding-block-start: var(--s-4);
  }

  .research__rail {
    position: sticky;
    top: calc(var(--s-7) + 1rem);
    align-self: start;
    padding: var(--s-5);
    background: var(--c-evergreen);
    color: var(--c-pearl);
    border-left: 2px solid var(--c-tomato);
    font-family: var(--f-mono);
  }
  .research__rail-label {
    color: color-mix(in srgb, var(--c-pearl) 70%, transparent);
    margin: 0 0 var(--s-3);
  }
  .research__metrics {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin: 0;
  }
  .research__metric {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-block-end: var(--s-2);
    border-bottom: 1px solid color-mix(in srgb, var(--c-pearl) 15%, transparent);
  }
  .research__metric:last-child { border-bottom: 0; }
  .research__metric dt {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
  }
  .research__metric dd {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    margin: 0;
    color: var(--c-pearl);
    line-height: 1.1;
  }

  @media (max-width: 900px) {
    .research {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "rail" "body";
      gap: var(--s-5);
      padding-block: var(--s-7) var(--s-8);
    }
    .research__body { grid-area: body; }
    .research__rail {
      grid-area: rail;
      position: static;
      padding: var(--s-4);
    }
    .research__rail-label { font-size: var(--fs-xs); }
  }

  /* Print: expand every collapsible section, single-column body, rail
   * below body, no sticky positioning, white-on-black avoided. The dense
   * research entries must be readable on paper. */
  @media print {
    .research {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "body" "rail";
      gap: var(--s-4);
      padding-block: 0;
      background: white;
      color: black;
    }
    .research__rail {
      position: static;
      background: white;
      color: black;
      border-left: 2px solid black;
      page-break-before: always;
    }
    .research__rail dt, .research__rail dd { color: black; }
    .research__collapse-toggle { display: none; }
    /* Force every collapsible section open. */
    :global(.research__prose details.research__section) {
      page-break-inside: avoid;
    }
    :global(.research__prose details.research__section[open]),
    :global(.research__prose details.research__section) {
      display: block;
    }
    :global(.research__prose details.research__section > .research__section-body) {
      display: block !important;
    }
    :global(.research__prose .research__section-chev) {
      display: none;
    }
  }
</style>
<script>
  // Print-mode helper: force every collapsible details open before print.
  if (typeof window !== 'undefined') {
    window.addEventListener('beforeprint', () => {
      document.querySelectorAll<HTMLDetailsElement>('details.research__section').forEach((d) => {
        d.dataset.printRestoreOpen = String(d.open);
        d.open = true;
      });
    });
    window.addEventListener('afterprint', () => {
      document.querySelectorAll<HTMLDetailsElement>('details.research__section').forEach((d, i) => {
        d.open = d.dataset.printRestoreOpen === 'true' || i === 0;
        delete d.dataset.printRestoreOpen;
      });
    });
  }
</script>
