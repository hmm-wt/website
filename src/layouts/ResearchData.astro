---
import Base from './Base.astro';
import StatusIndicator from '../components/StatusIndicator.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Display version, e.g. "v1.0". */
  version?: string;
  /** ISO date string. Rendered as "As of {long date}". */
  asOf?: string;
  /** Refresh cadence label, e.g. "Quarterly", "Monthly", "Annual rescore". */
  refresh?: string;
  /** Status badge. Mirrors the StatusIndicator component's enum. */
  status?: 'live' | 'open' | 'closed' | 'pending' | 'embargoed' | 'confirmed' | 'refuted';
  /** Surface register: 'dark' (default — matches Index pattern) or 'light'. */
  surface?: 'dark' | 'light';
  /** Optional kicker label, default "Live data product". */
  kicker?: string;
}

const {
  title, description, ogImage,
  version = 'v1.0',
  asOf,
  refresh,
  status = 'live',
  surface = 'dark',
  kicker = 'Live data product'
} = Astro.props;

const asOfLabel = asOf
  ? new Date(asOf).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---
<Base title={title} description={description} ogImage={ogImage}>
  <article class={`rdata rdata--${surface}`}>
    <header class="rdata__head container">
      <div class="rdata__meta">
        <span class="rdata__reg" aria-hidden="true"></span>
        <span class="rdata__kicker">{kicker} · {version}</span>
        <StatusIndicator status={status} />
      </div>
      <h1 class="rdata__title gavel-drop"><slot name="title">{title}.</slot></h1>
      <slot name="lede" />
      <div class="rdata__chips">
        {refresh && <span class="rdata__chip">Refresh: {refresh}</span>}
        {asOfLabel && <span class="rdata__chip">As of {asOfLabel}</span>}
      </div>
    </header>

    <div class="rdata__body container">
      <slot />
    </div>

    <footer class="rdata__foot container">
      <slot name="footer" />
    </footer>
  </article>
</Base>

<style>
  .rdata {
    padding-block: var(--s-7) var(--s-9);
    min-height: 100vh;
  }
  .rdata--dark {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    --fg: var(--c-pearl);
    --fg-soft: color-mix(in srgb, var(--c-pearl) 78%, transparent);
    --fg-faint: color-mix(in srgb, var(--c-pearl) 55%, transparent);
    --rule: color-mix(in srgb, var(--c-pearl) 18%, transparent);
  }
  .rdata--light {
    background: var(--c-light-tint, var(--c-pearl));
    color: var(--c-mahogany);
  }

  .rdata__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding-block-end: var(--s-5);
    border-bottom: 1px solid var(--rule);
    margin-block-end: var(--s-7);
    max-width: 72rem;
  }
  .rdata__meta {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .rdata__reg {
    display: inline-block;
    width: 10px;
    height: 10px;
    background: var(--c-tomato);
    align-self: center;
  }
  .rdata__kicker { color: var(--fg-soft); }
  .rdata__meta :global(.status) { margin-inline-start: auto; }

  .rdata__title {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    margin: var(--s-3) 0 0;
    color: var(--fg);
    max-width: 22ch;
  }

  .rdata__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-block-start: var(--s-3);
  }
  .rdata__chip {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
    border: 1px solid var(--rule);
    padding: 0.25em 0.65em;
  }

  .rdata__body { max-width: 72rem; }
  .rdata__foot {
    margin-block-start: var(--s-7);
    padding-block-start: var(--s-5);
    border-top: 1px solid var(--rule);
    max-width: 72rem;
  }
  .rdata__foot:empty { display: none; }
</style>
