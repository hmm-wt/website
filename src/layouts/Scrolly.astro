---
/**
 * Scrolly. Sticky-viz + scroll-step page layout.
 *
 * Consumes the existing scrolly.ts engine. The viz slot pins to the top of
 * the viewport; the rail slot scrolls past, advancing data-active-stage on
 * each stage entering the viewport's centre band.
 *
 * Usage in a page:
 *   <Scrolly title="..." kicker="...">
 *     <Fragment slot="viz">
 *       <UnitDotFunnel />
 *     </Fragment>
 *     <Fragment slot="rail">
 *       <div class="scrolly__stage" data-stage="s1">...</div>
 *       <div class="scrolly__stage" data-stage="s2">...</div>
 *       <div class="scrolly__stage" data-stage="s3">...</div>
 *     </Fragment>
 *   </Scrolly>
 */
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  kicker?: string;
  heroTitle?: string;
  heroSub?: string;
}

const { title, description, kicker, heroTitle, heroSub } = Astro.props;
---
<Base title={title} description={description}>
  {(kicker || heroTitle || heroSub) && (
    <header class="scrolly-hero container">
      {kicker && <p class="kicker scrolly-hero__kicker">{kicker}</p>}
      {heroTitle && <h1 class="scrolly-hero__title">{heroTitle}</h1>}
      {heroSub && <p class="scrolly-hero__sub">{heroSub}</p>}
    </header>
  )}

  <section class="scrolly" data-scrolly aria-label="Scroll-driven explainer">
    <div class="scrolly__viz" data-scrolly-viz>
      <div class="scrolly__viz-inner">
        <slot name="viz" />
      </div>
    </div>
    <div class="scrolly__rail">
      <slot name="rail" />
    </div>
  </section>

  <slot />
</Base>

<script>
  import '../scripts/scrolly.ts';
</script>

<style>
  .scrolly-hero {
    padding-block: var(--s-8) var(--s-6);
    max-width: 56rem;
  }
  .scrolly-hero__kicker { color: var(--c-tomato); margin: 0 0 var(--s-3); }
  .scrolly-hero__title {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 22ch;
  }
  .scrolly-hero__sub {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: var(--fg-soft);
    max-width: 56ch;
    margin: var(--s-4) 0 0;
  }

  .scrolly {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-7);
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--s-5);
    padding-block: var(--s-7);
  }

  .scrolly__viz {
    position: sticky;
    top: 0;
    height: 100vh;
    display: grid;
    place-items: center;
  }
  .scrolly__viz-inner {
    width: 100%;
  }

  .scrolly__rail :global(.scrolly__stage) {
    min-height: 90vh;
    padding-block: var(--s-8);
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: var(--lh-body);
    color: var(--fg-soft);
    transition: color var(--mo-hold) var(--ease-golden), opacity var(--mo-hold) var(--ease-golden);
    opacity: 0.45;
  }
  .scrolly__rail :global(.scrolly__stage--active) {
    color: var(--fg);
    opacity: 1;
  }
  .scrolly__rail :global(.scrolly__stage h2) {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: 0 0 var(--s-4);
    color: var(--fg);
  }
  .scrolly__rail :global(.scrolly__stage .stage__num) {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: 1;
    color: var(--hero);
    display: block;
    margin-bottom: var(--s-3);
  }
  .scrolly__rail :global(.scrolly__stage .stage__kicker) {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-faint);
    margin: 0 0 var(--s-3);
  }

  @media (max-width: 880px) {
    .scrolly { grid-template-columns: 1fr; gap: var(--s-5); }
    .scrolly__viz {
      position: sticky;
      top: 0;
      height: 60vh;
      background: var(--bg);
      z-index: 2;
      padding-block: var(--s-4);
      border-bottom: 1px solid var(--rule);
    }
    .scrolly__rail :global(.scrolly__stage) {
      min-height: 70vh;
      padding-block: var(--s-6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scrolly__rail :global(.scrolly__stage) {
      opacity: 1;
      color: var(--fg);
    }
  }
</style>
