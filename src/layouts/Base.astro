---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** When true, omits container padding so the page can run edge-to-edge. */
  bare?: boolean;
}

const {
  title,
  description = 'hmm Ventures. Necessity is the thesis. An APAC-focused seed fund investing where regulation creates demand.',
  ogImage = '/og-default.png'
} = Astro.props;

const fullTitle = title === 'hmm Ventures' ? title : `${title} · hmm Ventures`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://hmm.ventures').toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? 'https://hmm.ventures').toString()} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/InstrumentSerif-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/DMSans-VariableFont.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/IBMPlexMono-Regular.woff2" as="font" type="font/woff2" crossorigin />

    {import.meta.env.PROD && (
      <script is:inline defer data-domain="hmm.ventures" src="https://plausible.io/js/script.js"></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Reveal-on-scroll. Any element with .reveal or .reveal-group fades up
      // when entering the viewport. Canonical ease: cubic-bezier(0.16, 1, 0.3, 1).
      (function () {
        if (!('IntersectionObserver' in window)) {
          document.querySelectorAll('.reveal, .reveal-group').forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                observer.unobserve(e.target);
              }
            });
          },
          { rootMargin: '-5% 0px -10% 0px', threshold: 0.05 }
        );
        document.querySelectorAll('.reveal, .reveal-group').forEach((el) => observer.observe(el));
      })();
    </script>
  </body>
</html>
