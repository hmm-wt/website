---
/**
 * Five Necessities x four markets matrix.
 * Cell intensity scales with in-thesis company count from the necessity-index.
 * Public-safe: no fund returns; sources from the canonical 19,416-company dataset.
 */
import data from '../data/necessity-index.json';
import NecessityMark from './NecessityMark.astro';

type NecKind = 'food' | 'biomedical' | 'power' | 'autonomous' | 'materials';

const NECESSITIES: { name: string; short: string; icon: string; kind: NecKind }[] = [
  { name: 'Food Security Systems', short: 'Food Security', icon: '01', kind: 'food' },
  { name: 'Biomedical Systems', short: 'Biomedical', icon: '02', kind: 'biomedical' },
  { name: 'Power Systems', short: 'Power', icon: '03', kind: 'power' },
  { name: 'Autonomous Systems', short: 'Autonomous', icon: '04', kind: 'autonomous' },
  { name: 'Critical Materials and Supply Integrity', short: 'Critical Materials', icon: '05', kind: 'materials' }
];

const MARKETS = data.per_market.map((m) => ({
  code: m.market,
  name: m.code,
  regulations: m.regulations,
  t1: m.t1,
}));

// Look up per-Necessity data by NAME (not by index). The JSON `per_necessity`
// order does not match the display order in NECESSITIES, so an index-based
// join (the previous bug) crossed labels and values.
const necByName = new Map(data.per_necessity.map((n) => [n.name, n]));
const maxCount = Math.max(...data.per_necessity.map((n) => n.in_thesis_companies));
---
<section class="ng">
  <header class="ng__head">
    <p class="kicker ng__kicker">The screen</p>
    <h2 class="ng__title">Five Necessities. Four markets. One filter.</h2>
    <p class="ng__lede">
      Six thousand five hundred companies in the four target markets pass the T1 / T2 screen. The shape of the in-thesis universe.
    </p>
  </header>

  <div class="ng__grid">
    {NECESSITIES.map((n) => {
      const necData = necByName.get(n.name);
      const intensity = necData ? necData.in_thesis_companies / maxCount : 0;
      return (
        <article
          class="ng__cell reveal"
          style={`--cell-intensity: ${intensity}`}
        >
          <header class="ng__cell-head">
            <span class="ng__cell-mark"><NecessityMark kind={n.kind} size={28} /></span>
            <span class="ng__cell-idx">[{n.icon}]</span>
            <span class="ng__cell-name">{n.short}</span>
          </header>
          <p class="ng__cell-count">
            <span class="ng__cell-num">{necData?.in_thesis_companies.toLocaleString('en-US') ?? 'n/a'}</span>
            <span class="ng__cell-label">in-thesis companies</span>
          </p>
          <footer class="ng__cell-foot">
            <span>T1: {necData?.regulations_t1 ?? 'n/a'}</span>
            <span class="ng__cell-sep">·</span>
            <span>T2: {necData?.regulations_t2 ?? 'n/a'}</span>
            <span class="ng__cell-sep">·</span>
            <span>regs</span>
          </footer>
        </article>
      );
    })}
  </div>

  <footer class="ng__foot">
    <p class="kicker">
      Source: hmm classified universe, 19,416 four-market companies. Per-Necessity counts and the 34 in-flight regulations dated 2024 to 2030 underpin the fund's deployment.
    </p>
    <p class="ng__cta">
      <a href="/research/data/necessity-index/">View the full index →</a>
      <span class="ng__cta-sep"> · </span>
      <a href="/research/data/calendar/">See the calendar →</a>
    </p>
  </footer>
</section>

<style>
  .ng {
    padding-block: var(--s-9);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .ng__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-end: var(--s-7);
    max-width: 56ch;
  }
  .ng__kicker { color: var(--c-tomato); margin: 0; }
  .ng__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: 0;
  }
  .ng__lede {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    color: var(--fg-soft);
    line-height: var(--lh-snug);
    margin: 0;
  }

  .ng__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--s-3);
  }
  @media (max-width: 980px) { .ng__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 640px) { .ng__grid { grid-template-columns: 1fr 1fr; } }

  .ng__cell {
    padding: var(--s-5);
    background: color-mix(
      in srgb,
      var(--c-tomato) calc(var(--cell-intensity, 0) * 18%),
      var(--surface)
    );
    border-left: 2px solid color-mix(
      in srgb,
      var(--c-tomato) calc(var(--cell-intensity, 0) * 100% + 12%),
      transparent
    );
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    transition: background var(--transition), border-left-color var(--transition);
  }
  .ng__cell:hover {
    background: color-mix(in srgb, var(--c-tomato) 14%, var(--surface));
    border-left-color: var(--c-tomato);
  }

  .ng__cell-head {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .ng__cell-mark { color: var(--c-tomato); display: inline-flex; margin-block-end: var(--s-1); }
  .ng__cell-idx { color: var(--c-tomato); font-weight: 600; }
  .ng__cell-name { color: var(--c-pearl); }

  .ng__cell-count {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
  }
  .ng__cell-num {
    font-family: var(--f-display);
    font-size: clamp(2rem, 1.4rem + 2vw, 2.75rem);
    line-height: 1;
    color: var(--c-tomato);
  }
  .ng__cell-label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
  }

  .ng__cell-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    align-items: baseline;
    margin-block-start: auto;
    padding-block-start: var(--s-3);
    border-top: 1px solid var(--rule);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: var(--fg-soft);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .ng__cell-sep { color: var(--fg-faint); }

  .ng__foot {
    margin-block-start: var(--s-7);
    padding-block-start: var(--s-5);
    border-top: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .ng__foot .kicker { margin: 0; max-width: 72ch; line-height: 1.5; }
  .ng__cta {
    margin: 0;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .ng__cta a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .ng__cta a:hover { color: var(--c-pearl); }
  .ng__cta-sep { color: var(--fg-faint); }
</style>
