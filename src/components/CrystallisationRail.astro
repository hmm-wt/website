---
import calendar from '../data/crystallisation-window.json';

interface Props {
  /** Filter to a single market. If omitted, shows next 5 across all markets. */
  market?: 'AU' | 'JP' | 'NZ' | 'SG';
  /** Number of upcoming regulations to show. Default 5. */
  limit?: number;
  /** Optional title override. */
  title?: string;
}

const { market, limit = 5, title } = Astro.props;

const filtered = calendar.regulations
  .filter((r) => !market || r.market === market)
  .sort((a, b) => a.effective_year - b.effective_year)
  .slice(0, limit);

const marketLabel: Record<string, string> = { AU: 'Australia', JP: 'Japan', NZ: 'New Zealand', SG: 'Singapore' };
const headerLabel = title ?? (market ? `Crystallisation Window · ${marketLabel[market]}` : 'Crystallisation Window');
---
<aside class="cw" aria-label={headerLabel}>
  <header class="cw__head">
    <span class="cw__reg" aria-hidden="true"></span>
    <span class="cw__label">{headerLabel}</span>
  </header>

  <ol class="cw__list" role="list">
    {filtered.map((r) => (
      <li class="cw__item">
        <div class="cw__top">
          <span class="cw__year">{r.effective_year}</span>
          {!market && <span class="cw__market">{r.market}</span>}
          <span class={`cw__tier cw__tier--${r.tier.toLowerCase()}`}>{r.tier}</span>
        </div>
        <p class="cw__title">{r.title}</p>
        <p class="cw__necessity">{r.necessity}</p>
      </li>
    ))}
  </ol>

  <footer class="cw__foot">
    <a class="cw__link" href={market ? `/calendar/?market=${market}` : '/calendar/'}>
      View full calendar →
    </a>
  </footer>
</aside>

<style>
  .cw {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding: var(--s-5) var(--s-4);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    border-top: 2px solid var(--c-tomato);
  }
  .cw__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2);
    padding-block-end: var(--s-3);
    border-bottom: 1px solid color-mix(in srgb, var(--c-pearl) 15%, transparent);
    margin-block-end: var(--s-3);
  }
  .cw__reg {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--c-tomato);
  }
  .cw__label {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-pearl);
    font-weight: 600;
    font-size: calc(var(--fs-xs) * 0.95);
  }
  .cw__date {
    margin-inline-start: auto;
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
  }
  .cw__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .cw__item {
    padding: var(--s-2);
    margin: 0 calc(var(--s-2) * -1);
    border-bottom: 1px solid color-mix(in srgb, var(--c-pearl) 10%, transparent);
    transition: background var(--mo-tick) var(--ease-golden);
  }
  .cw__item:hover {
    background: color-mix(in srgb, var(--c-tomato) 8%, transparent);
  }
  .cw__item:last-child { border-bottom: 0; }

  .cw__top {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    margin-block-end: 4px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .cw__year { color: var(--c-tomato); font-weight: 600; }
  .cw__market { color: color-mix(in srgb, var(--c-pearl) 70%, transparent); }
  .cw__tier {
    margin-inline-start: auto;
    padding: 0.05em 0.4em;
    font-size: calc(var(--fs-xs) * 0.85);
    font-weight: 600;
  }
  .cw__tier--t1 {
    background: color-mix(in srgb, var(--c-tomato) 18%, transparent);
    color: var(--c-tomato);
  }
  .cw__tier--t2 {
    background: color-mix(in srgb, var(--c-pearl) 10%, transparent);
    color: color-mix(in srgb, var(--c-pearl) 70%, transparent);
  }
  .cw__title {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    line-height: 1.45;
    color: var(--c-pearl);
    margin: 0;
    font-weight: 500;
  }
  .cw__necessity {
    color: color-mix(in srgb, var(--c-pearl) 50%, transparent);
    font-size: calc(var(--fs-xs) * 0.9);
    margin: 2px 0 0;
  }

  .cw__foot {
    margin-block-start: var(--s-3);
    padding-block-start: var(--s-3);
    border-top: 1px solid color-mix(in srgb, var(--c-pearl) 15%, transparent);
  }
  .cw__link {
    color: var(--c-tomato);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .cw__link:hover { color: var(--c-pearl); }
</style>
