---
/**
 * Three-tier returns framing per IM canon. Target / Median / Bear / Tail.
 * Single source of truth: src/data/im-canonical.json.
 */
import canonical from '../data/im-canonical.json';

const tiers = canonical.returns.tiers as ReadonlyArray<'Target' | 'Median' | 'Bear' | 'Tail'>;
const tierKey = (t: string) => t.toLowerCase() as keyof typeof canonical.returns.dpi;

const rows = [
  {
    label: 'DPI',
    note: 'Distributions-to-paid-in',
    values: tiers.map((t) => ({
      tier: t,
      value: canonical.returns.dpi[tierKey(t)].toFixed(2) + 'x'
    }))
  },
  {
    label: 'IRR',
    note: 'Internal rate of return',
    values: tiers.map((t) => ({
      tier: t,
      value: canonical.returns.irr_pct[tierKey(t)].toFixed(2) + '%'
    }))
  },
  {
    label: 'MOIC',
    note: 'Multiple on invested capital',
    values: tiers.map((t) => ({
      tier: t,
      value: canonical.returns.moic[tierKey(t)].toFixed(2) + 'x'
    }))
  }
];
---
<div class="rt">
  <div class="rt__scroll">
    <table class="rt__tbl">
      <thead>
        <tr>
          <th class="rt__metric">Metric</th>
          {tiers.map((t) => (
            <th class={`rt__tier rt__tier--${t.toLowerCase()}`}>{t}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td class="rt__metric">
              <span class="rt__metric-label">{row.label}</span>
              <span class="rt__metric-note">{row.note}</span>
            </td>
            {row.values.map((v) => (
              <td class={`rt__val rt__val--${v.tier.toLowerCase()}`}>{v.value}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="rt__source">
    <span class="rt__source-k">Basis</span> {canonical.returns.basis}
  </p>
  <p class="rt__source">
    <span class="rt__source-k">Source</span> {canonical.returns.source}
  </p>
</div>

<style>
  .rt { font-family: var(--f-mono); }
  .rt__scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .rt__tbl {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
    min-width: 32rem;
  }
  .rt__tbl th,
  .rt__tbl td {
    padding: var(--s-3) var(--s-4);
    text-align: right;
    border-bottom: 1px solid var(--rule);
    font-variant-numeric: tabular-nums;
  }
  .rt__tbl th {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--fs-xs);
    color: var(--fg-soft);
    border-bottom-color: var(--c-tomato);
  }
  .rt__tbl .rt__metric { text-align: left; }
  .rt__metric-label {
    display: block;
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    color: var(--fg);
  }
  .rt__metric-note {
    display: block;
    font-size: calc(var(--fs-xs) * 0.92);
    color: var(--fg-faint);
    margin-block-start: 2px;
    text-transform: none;
    letter-spacing: 0;
  }
  .rt__tier--target { color: var(--c-tomato); }
  .rt__tier--median { color: var(--fg); }
  .rt__tier--bear   { color: var(--fg-soft); }
  .rt__tier--tail   { color: var(--fg-faint); }
  .rt__val {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: 1;
  }
  .rt__val--target { color: var(--c-tomato); font-style: italic; }
  .rt__val--median { color: var(--fg); }
  .rt__val--bear   { color: var(--fg-soft); }
  .rt__val--tail   { color: var(--fg-faint); }

  .rt__source {
    font-size: calc(var(--fs-xs) * 0.92);
    color: var(--fg-soft);
    margin: var(--s-3) 0 0;
    line-height: 1.55;
  }
  .rt__source-k {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--fg-faint);
    font-weight: 700;
    margin-inline-end: var(--s-2);
  }
</style>
