---
/**
 * Primary nav. Thesis-led positioning (post 2026-05-11 pivot):
 * The Doctrine is the named artefact and the primary CTA.
 * GP page is footer-only.
 */
const items = [
  { href: '/doctrine/', label: 'Doctrine' },
  { href: '/thesis/', label: 'Thesis' },
  { href: '/research/', label: 'Research' },
  { href: '/scoreboard/', label: 'Scoreboard' },
  { href: '/gp/', label: 'Author' },
  { href: '/contact/', label: 'Contact' }
];

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  path === href || (href !== '/' && path.startsWith(href));
---
<header class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__brand" aria-label="hmm Ventures home">
      <span class="nav__reg" aria-hidden="true"></span>
      <span class="nav__mark">hmm</span>
      <span class="nav__dot" aria-hidden="true">.</span>
      <span class="nav__tld">ventures</span>
    </a>
    <nav aria-label="Primary">
      <ul role="list" class="nav__list">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              class={`nav__link ${isCurrent(item.href) ? 'is-current' : ''}`}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
        <li>
          <a href="/#subscribe" class="nav__cta">Subscribe →</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    padding-block: var(--s-4);
  }

  .nav__brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    text-decoration: none;
    color: var(--fg);
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .nav__brand:hover { color: var(--accent); }
  .nav__reg {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--c-tomato);
    align-self: center;
    margin-inline-end: 0.1em;
  }
  .nav__dot { color: var(--accent); }
  .nav__tld {
    font-family: var(--f-mono);
    font-size: 0.65em;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .nav__list {
    display: flex;
    gap: var(--s-5);
    align-items: center;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: var(--fg-soft);
    padding-block: 0.25rem;
  }
  .nav__link:hover,
  .nav__link.is-current {
    color: var(--accent);
    border-bottom: 1px solid currentColor;
  }

  .nav__cta {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--c-evergreen);
    color: var(--c-evergreen);
    background: transparent;
    transition: background var(--dur-1) var(--ease), color var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease);
  }
  .nav__cta:hover {
    background: var(--c-tomato);
    border-color: var(--c-tomato);
    color: var(--c-light-tint);
  }

  @media (max-width: 820px) {
    .nav__inner { flex-direction: column; align-items: flex-start; gap: var(--s-3); }
    .nav__list { gap: var(--s-3); }
  }
</style>
