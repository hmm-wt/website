---
interface NavItem { href: string; label: string; }

// /markets/ stays live and indexable (in sitemap, robots allow), but is
// kept out of the primary nav so it is not a clearly visible menu item.
// External backlinks to /markets/ still resolve (200) and index. Deep
// contextual links (references/exits, thesis/[market], 404) remain.
const items: NavItem[] = [
  { href: '/necessities/', label: 'Necessities' },
  { href: '/research/', label: 'Research' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' }
];

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  path === href || (href !== '/' && path.startsWith(href));
---
<header class="nav" data-nav>
  <div class="container nav__inner">
    <a href="/" class="nav__brand" aria-label="hmm Ventures home">
      <svg class="nav__logo hmm-cadence" viewBox="0 0 208 119" role="img" aria-label="hmm...">
        <title>hmm…</title>
        <g fill="currentColor">
          <path class="hmm-letter" data-beat="1" d="M0 0H12.8V49.28H13.44C15.4667 44.5867 18.2933 40.8533 21.92 38.08C25.6533 35.3067 30.6133 33.92 36.8 33.92C45.3333 33.92 52.0533 36.6933 56.96 42.24C61.9733 47.68 64.48 55.4133 64.48 65.44V118.4H51.68V67.68C51.68 52.8533 45.44 45.44 32.96 45.44C30.4 45.44 27.8933 45.76 25.44 46.4C23.0933 47.04 20.96 48 19.04 49.28C17.12 50.56 15.5733 52.2133 14.4 54.24C13.3333 56.16 12.8 58.4533 12.8 61.12V118.4H0V0Z"/>
          <path class="hmm-letter" data-beat="2" d="M12.5 57L10.5 53.5L14.4399 49.36C15.3999 47.2267 16.4666 45.2533 17.6399 43.44C18.9199 41.52 20.4133 39.8667 22.1199 38.48C23.9333 37.0933 26.0133 36.0267 28.3599 35.28C30.7066 34.4267 33.4799 34 36.6799 34C42.1199 34 47.1333 35.3333 51.7199 38C56.3066 40.56 59.7199 44.8267 61.9599 50.8H62.2799C63.7733 46.32 66.5466 42.4267 70.5999 39.12C74.7599 35.7067 80.3599 34 87.3999 34C95.8266 34 102.387 36.7733 107.08 42.32C111.88 47.76 114.28 55.4933 114.28 65.52V118.48H101.48V67.76C101.48 60.4 100.04 54.8533 97.16 51.12C94.2799 47.3867 89.6933 45.52 83.3999 45.52C80.8399 45.52 78.3866 45.84 76.0399 46.48C73.7999 47.12 71.7733 48.08 69.9599 49.36C68.1466 50.64 66.7066 52.2933 65.6399 54.32C64.5733 56.24 64.0399 58.5333 64.0399 61.2V118.48H51.2399V67.76C51.2399 60.4 49.7999 54.8533 46.9199 51.12C44.0399 47.3867 39.5599 45.52 33.4799 45.52C30.9199 45.52 28.3467 43.86 26 44.5C23.6533 45.14 21.3133 45.72 19.5 47C17.6867 48.28 14.6733 49.9733 13.5 52C12.4333 53.92 12.7811 51.8 12.5 57Z"/>
          <path class="hmm-letter" data-beat="3" d="M64 57L62 53.5L65.9399 49.36C66.8999 47.2267 67.9666 45.2533 69.1399 43.44C70.4199 41.52 71.9133 39.8667 73.6199 38.48C75.4333 37.0933 77.5133 36.0267 79.8599 35.28C82.2066 34.4267 84.9799 34 88.1799 34C93.6199 34 98.6333 35.3333 103.22 38C107.807 40.56 111.22 44.8267 113.46 50.8H113.78C115.273 46.32 118.047 42.4267 122.1 39.12C126.26 35.7067 131.86 34 138.9 34C147.327 34 153.887 36.7733 158.58 42.32C163.38 47.76 165.78 55.4933 165.78 65.52V118.48H152.98V67.76C152.98 60.4 151.54 54.8533 148.66 51.12C145.78 47.3867 141.193 45.52 134.9 45.52C132.34 45.52 129.887 45.84 127.54 46.48C125.3 47.12 123.273 48.08 121.46 49.36C119.647 50.64 118.207 52.2933 117.14 54.32C116.073 56.24 115.54 58.5333 115.54 61.2V118.48H102.74V67.76C102.74 60.4 101.3 54.8533 98.4199 51.12C95.5399 47.3867 91.0599 45.52 84.9799 45.52C82.4199 45.52 79.8467 43.86 77.5 44.5C75.1533 45.14 72.8133 45.72 71 47C69.1867 48.28 66.1733 49.9733 65 52C63.9333 53.92 64.2811 51.8 64 57Z"/>
          <circle class="hmm-dot" data-beat="4" cx="173.5" cy="112.5" r="6"/>
          <circle class="hmm-dot" data-beat="5" cx="187.5" cy="112.5" r="6"/>
        </g>
        <circle class="hmm-dot hmm-dot--open" data-beat="6" cx="201.5" cy="112.5" r="6" fill="none" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </a>

    <button type="button" class="nav__hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="nav-sheet" data-sheet-toggle>
      <span class="nav__hamburger-bar"></span>
      <span class="nav__hamburger-bar"></span>
      <span class="nav__hamburger-bar"></span>
    </button>

    <nav class="nav__primary" aria-label="Primary">
      <ul role="list" class="nav__list">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              class={`nav__link ${isCurrent(item.href) ? 'is-current' : ''}`}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<aside id="nav-sheet" class="nav-sheet" aria-hidden="true" data-sheet>
  <div class="nav-sheet__head container">
    <a href="/" class="nav-sheet__brand" aria-label="hmm Ventures home">hmm.</a>
    <button type="button" class="nav-sheet__close" aria-label="Close menu" data-sheet-close>x</button>
  </div>
  <nav class="nav-sheet__nav container" aria-label="Primary mobile">
    <ul role="list" class="nav-sheet__list">
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            class={`nav-sheet__link ${isCurrent(item.href) ? 'is-current' : ''}`}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<script>
  function initSheet() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-sheet-toggle]');
    const sheet = document.querySelector<HTMLElement>('[data-sheet]');
    const close = document.querySelector<HTMLButtonElement>('[data-sheet-close]');
    if (!toggle || !sheet || !close) return;
    if (toggle.dataset.bound === 'true') return;
    toggle.dataset.bound = 'true';
    let lastFocused: HTMLElement | null = null;

    const open = () => {
      lastFocused = document.activeElement as HTMLElement;
      sheet.classList.add('is-open');
      sheet.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => close.focus());
    };
    const closeFn = () => {
      sheet.classList.remove('is-open');
      sheet.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      lastFocused?.focus();
    };

    toggle.addEventListener('click', () => {
      if (sheet.classList.contains('is-open')) closeFn(); else open();
    });
    close.addEventListener('click', closeFn);
    document.addEventListener('keydown', (e) => {
      if (!sheet.classList.contains('is-open')) return;
      if (e.key === 'Escape') { closeFn(); return; }
      // Focus trap: cycle Tab inside the sheet.
      if (e.key === 'Tab') {
        const focusables = Array.from(
          sheet.querySelectorAll<HTMLElement>('a, button, [tabindex]:not([tabindex="-1"])'),
        ).filter((el) => !el.hasAttribute('disabled') && el.offsetParent !== null);
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const active = document.activeElement as HTMLElement | null;
        if (e.shiftKey && active === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && active === last) { e.preventDefault(); first.focus(); }
      }
    });
    sheet.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', closeFn);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSheet);
  } else {
    initSheet();
  }
  document.addEventListener('astro:page-load', initSheet);
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    padding-block: var(--s-4);
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--fg);
    line-height: 1;
    min-height: var(--tap-min);
    padding-block: 0.5rem;
    margin-block: -0.5rem;
    transition: color var(--mo-tick) var(--ease-golden);
  }
  .nav__brand:hover { color: var(--c-tomato); }
  .nav__logo { height: 28px; width: auto; display: block; color: currentColor; }

  .nav__hamburger {
    display: none;
    width: 44px;
    height: 44px;
    background: none;
    border: 1px solid var(--rule);
    cursor: pointer;
    padding: 0;
    position: relative;
  }
  .nav__hamburger:hover { border-color: var(--c-tomato); }
  .nav__hamburger-bar {
    position: absolute;
    left: 10px;
    right: 10px;
    height: 2px;
    background: var(--c-pearl);
    transition: background var(--mo-tick) var(--ease-golden);
  }
  .nav__hamburger-bar:nth-child(1) { top: 14px; }
  .nav__hamburger-bar:nth-child(2) { top: 21px; }
  .nav__hamburger-bar:nth-child(3) { top: 28px; }
  .nav__hamburger:hover .nav__hamburger-bar { background: var(--c-tomato); }

  .nav__list {
    display: flex;
    gap: var(--s-5);
    align-items: center;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
  }
  .nav__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap-min);
    min-width: var(--tap-min);
    padding: 0.5rem 0.5rem;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: var(--fg);
    border-bottom: 1px solid transparent;
    transition: color var(--mo-tick) var(--ease-golden), border-color var(--mo-tick) var(--ease-golden);
  }
  .nav__link:hover, .nav__link.is-current {
    color: var(--accent);
    border-bottom-color: currentColor;
  }

  @media (max-width: 1024px) {
    .nav__primary { display: none; }
    .nav__hamburger { display: block; }
    .nav__inner { padding-block: var(--s-3); }
  }

  .nav-sheet {
    position: fixed;
    inset: 0;
    background: var(--c-evergreen);
    color: var(--c-pearl);
    z-index: 100;
    display: flex;
    flex-direction: column;
    padding-top: env(safe-area-inset-top);
    padding-bottom: env(safe-area-inset-bottom);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity var(--mo-hold) var(--ease-golden),
                visibility var(--mo-hold) var(--ease-golden),
                transform var(--mo-hold) var(--ease-golden);
  }
  .nav-sheet.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav-sheet__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: var(--s-4);
    border-bottom: 1px solid color-mix(in srgb, var(--c-pearl) 15%, transparent);
  }
  .nav-sheet__brand {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    color: var(--c-pearl);
    text-decoration: none;
  }
  .nav-sheet__close {
    width: 44px;
    height: 44px;
    background: none;
    border: 1px solid color-mix(in srgb, var(--c-pearl) 30%, transparent);
    color: var(--c-pearl);
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }
  .nav-sheet__close:hover { color: var(--c-tomato); border-color: var(--c-tomato); }

  .nav-sheet__nav {
    flex: 1;
    padding-block: var(--s-7);
    overflow-y: auto;
  }
  .nav-sheet__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .nav-sheet__link {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    color: var(--c-pearl);
    text-decoration: none;
    display: block;
    padding-block: var(--s-2);
  }
  .nav-sheet__link:hover,
  .nav-sheet__link.is-current { color: var(--c-tomato); }

  @media (min-width: 1025px) {
    .nav-sheet { display: none; }
  }
</style>
