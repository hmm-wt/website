---
/**
 * IM-style figure card. Mirrors the chrome in CIM/html/charts.py chart_card().
 * Sci corners, eyebrow with fignum + label, serif title with em-tomato accents,
 * sub line, metric strip (4 cells), plot slot, source/basis grid.
 *
 * Props mirror the IM chart_card() signature so chart components can be ported
 * verbatim from CIM/html/charts.py.
 */
interface Metric {
  label: string;
  value: string;
  ci?: string;
  accent?: boolean;
}

interface Props {
  fignum: string;        // e.g. "EX-2"
  label: string;         // e.g. "Cumulative Premium Wedge · T1 vs Unregulated"
  title: string;         // serif headline. May include <em>...</em> for tomato accent.
  sub?: string;
  metrics?: Metric[];
  source?: string;
  basis?: string;
}

const { fignum, label, title, sub, metrics = [], source, basis } = Astro.props;
---
<figure class="imfig" role="figure" aria-label={label}>
  <span class="imfig__corner imfig__corner--tl" aria-hidden="true"></span>
  <span class="imfig__corner imfig__corner--tr" aria-hidden="true"></span>
  <span class="imfig__corner imfig__corner--bl" aria-hidden="true"></span>
  <span class="imfig__corner imfig__corner--br" aria-hidden="true"></span>

  <div class="imfig__inner">
    <div class="imfig__eyebrow">
      <span class="imfig__num">{fignum}</span>
      <span class="imfig__label">{label}</span>
    </div>

    <h3 class="imfig__title" set:html={title}></h3>
    {sub && <p class="imfig__sub">{sub}</p>}

    {metrics.length > 0 && (
      <div class="imfig__strip">
        {metrics.map((m) => (
          <div class="imfig__cell">
            <div class="imfig__cell-label">{m.label}</div>
            <div class={`imfig__cell-val ${m.accent ? 'imfig__cell-val--accent' : ''}`}>{m.value}</div>
            {m.ci && <div class="imfig__cell-ci">{m.ci}</div>}
          </div>
        ))}
      </div>
    )}

    <div class="imfig__plot" data-imfig-plot>
      <button type="button" class="imfig__zoom" data-imfig-zoom aria-label="Expand chart to full screen">
        <span class="imfig__zoom-icon" aria-hidden="true">⤢</span>
        <span class="imfig__zoom-label">Tap to expand</span>
      </button>
      <div class="imfig__plot-inner">
        <slot />
      </div>
    </div>

    {(source || basis) && (
      <div class="imfig__source">
        {source && <><span class="imfig__source-k">Source</span><span>{source}</span></>}
        {basis && <><span class="imfig__source-k">Basis</span><span>{basis}</span></>}
      </div>
    )}
  </div>
</figure>

<style>
  .imfig {
    position: relative;
    border: 1px solid var(--c-mahogany);
    background: var(--c-pearl);
    color: var(--c-mahogany);
    padding: var(--s-6);
    margin: 0;
    --imfig-rule: rgba(4, 47, 42, 0.18);
    --imfig-muted: rgba(37, 0, 1, 0.66);
    --imfig-faint: rgba(37, 0, 1, 0.42);
    transition: box-shadow var(--mo-tick) var(--ease-golden);
  }
  .imfig:hover {
    box-shadow: 0 6px 18px rgba(4, 47, 42, 0.10), 0 1px 3px rgba(4, 47, 42, 0.08);
  }
  .imfig::before {
    content: "";
    position: absolute;
    inset: 4px;
    border: 1px solid var(--imfig-rule);
    pointer-events: none;
  }
  .imfig__inner { position: relative; z-index: 1; }

  .imfig__corner {
    position: absolute;
    width: 12px;
    height: 12px;
    pointer-events: none;
    z-index: 2;
    opacity: 0.4;
  }
  .imfig__corner--tl { top: 8px; left: 8px; border-top: 1px solid var(--c-mahogany); border-left: 1px solid var(--c-mahogany); }
  .imfig__corner--tr { top: 8px; right: 8px; border-top: 1px solid var(--c-mahogany); border-right: 1px solid var(--c-mahogany); }
  .imfig__corner--bl { bottom: 8px; left: 8px; border-bottom: 1px solid var(--c-mahogany); border-left: 1px solid var(--c-mahogany); }
  .imfig__corner--br { bottom: 8px; right: 8px; border-bottom: 1px solid var(--c-mahogany); border-right: 1px solid var(--c-mahogany); }

  .imfig__eyebrow {
    display: flex;
    gap: var(--s-3);
    align-items: baseline;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--imfig-muted);
    padding-block-end: var(--s-3);
    border-bottom: 1px solid var(--imfig-rule);
    margin-block-end: var(--s-4);
  }
  .imfig__num { color: var(--c-tomato); font-weight: 700; }

  .imfig__title {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: var(--fs-2xl);
    line-height: 1.14;
    letter-spacing: -0.005em;
    color: var(--c-mahogany);
    margin: 0 0 var(--s-3);
    text-wrap: balance;
  }
  .imfig__title :global(em) { font-style: italic; color: var(--c-tomato); }

  .imfig__sub {
    font-family: var(--f-body);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--imfig-muted);
    margin: 0 0 var(--s-5);
    max-width: 60ch;
  }

  .imfig__strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--imfig-rule);
    border-bottom: 1px solid var(--imfig-rule);
    padding-block: var(--s-4);
    margin-block-end: var(--s-5);
  }
  .imfig__cell {
    padding-inline: var(--s-4);
    border-left: 1px solid var(--imfig-rule);
    font-family: var(--f-mono);
  }
  .imfig__cell:first-child { border-left: 0; padding-left: 0; }
  .imfig__cell-label {
    font-size: calc(var(--fs-xs) * 0.92);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--imfig-muted);
    margin-block-end: var(--s-2);
  }
  .imfig__cell-val {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: 1;
    color: var(--c-mahogany);
  }
  .imfig__cell-val--accent { font-style: italic; color: var(--c-tomato); }
  .imfig__cell-ci {
    font-size: calc(var(--fs-xs) * 0.95);
    color: var(--imfig-muted);
    margin-block-start: var(--s-2);
  }

  .imfig__plot {
    margin-block: var(--s-4);
    position: relative;
  }
  .imfig__plot-inner { display: block; }

  /* Mobile: allow horizontal scroll on charts so they render at native
   * readable size, plus a tap-to-expand button that opens a fullscreen
   * modal. Desktop: zoom button hidden, no scrolling needed. */
  .imfig__zoom {
    display: none;
    position: absolute;
    top: var(--s-2);
    right: var(--s-2);
    z-index: 3;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.6rem;
    background: var(--c-mahogany);
    color: var(--c-pearl);
    border: 1px solid var(--c-mahogany);
    font-family: var(--f-mono);
    font-size: calc(var(--fs-xs) * 0.92);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
  }
  .imfig__zoom:hover, .imfig__zoom:focus { background: var(--c-tomato); border-color: var(--c-tomato); outline: none; }
  .imfig__zoom-icon { font-size: 1.05em; line-height: 1; }
  @media (max-width: 720px) {
    .imfig__zoom { display: inline-flex; }
    .imfig__plot-inner {
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
    }
    .imfig__plot-inner > :global(svg) {
      min-width: 32rem;
      display: block;
    }
  }

  .imfig__source {
    border-top: 1px solid var(--imfig-rule);
    padding-block-start: var(--s-3);
    font-family: var(--f-mono);
    font-size: calc(var(--fs-xs) * 0.92);
    line-height: 1.55;
    color: var(--imfig-muted);
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--s-2) var(--s-4);
    letter-spacing: 0.04em;
  }
  .imfig__source-k {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--imfig-faint);
    font-weight: 700;
  }

  @media (max-width: 720px) {
    .imfig { padding: var(--s-5); }
    .imfig__strip { grid-template-columns: repeat(2, 1fr); }
    .imfig__cell { padding-block: var(--s-2); }
    .imfig__cell:nth-child(3) { border-left: 0; padding-left: 0; }
    .imfig__source { grid-template-columns: 3rem 1fr; gap: var(--s-1) var(--s-3); }
  }
</style>

<!-- Global chart-zoom modal. Injected once by the script below on first use. -->
<style is:global>
  .chart-zoom-modal {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--c-mahogany, #250001);
    color: var(--c-pearl, #F2ECC9);
    z-index: 200;
  }
  .chart-zoom-modal::backdrop { background: rgba(4, 47, 42, 0.88); }
  .chart-zoom-modal[open] {
    display: flex;
    flex-direction: column;
  }
  .chart-zoom-modal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--c-pearl, #F2ECC9) 18%, transparent);
    flex-shrink: 0;
  }
  .chart-zoom-modal__title {
    margin: 0;
    font-family: var(--f-mono, monospace);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--c-pearl, #F2ECC9) 80%, transparent);
  }
  .chart-zoom-modal__close {
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--c-pearl, #F2ECC9) 30%, transparent);
    color: var(--c-pearl, #F2ECC9);
    font-size: 1.4rem;
    line-height: 1;
    width: 2.25rem;
    height: 2.25rem;
    cursor: pointer;
  }
  .chart-zoom-modal__close:hover { color: var(--c-tomato, #C44539); border-color: var(--c-tomato, #C44539); }
  .chart-zoom-modal__body {
    flex: 1;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    padding: 1rem;
    background: var(--c-pearl, #F2ECC9);
    color: var(--c-mahogany, #250001);
  }
  .chart-zoom-modal__body > svg,
  .chart-zoom-modal__body > * > svg {
    display: block;
    width: 100%;
    height: auto;
    min-width: 60rem;
    max-width: none;
  }
  .chart-zoom-modal__hint {
    margin: 0;
    padding: 0.5rem 1rem 0.75rem;
    font-family: var(--f-mono, monospace);
    font-size: 0.72rem;
    color: color-mix(in srgb, var(--c-pearl, #F2ECC9) 60%, transparent);
    text-align: center;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    flex-shrink: 0;
  }
</style>

<script>
  function ensureChartZoomModal(): HTMLDialogElement {
    let modal = document.getElementById('chart-zoom-modal') as HTMLDialogElement | null;
    if (modal) return modal;
    modal = document.createElement('dialog');
    modal.id = 'chart-zoom-modal';
    modal.className = 'chart-zoom-modal';
    modal.innerHTML = `
      <header class="chart-zoom-modal__head">
        <p class="chart-zoom-modal__title" data-zoom-title></p>
        <button type="button" class="chart-zoom-modal__close" data-zoom-close aria-label="Close">×</button>
      </header>
      <div class="chart-zoom-modal__body" data-zoom-body></div>
      <p class="chart-zoom-modal__hint">Pinch or scroll to inspect · tap outside to close</p>
    `;
    document.body.appendChild(modal);
    modal.querySelector('[data-zoom-close]')?.addEventListener('click', () => modal!.close());
    modal.addEventListener('click', (e) => {
      // Click outside the body (i.e. on the backdrop)
      const body = modal!.querySelector('[data-zoom-body]');
      if (!body || !(e.target instanceof Node)) return;
      if (e.target === modal) modal!.close();
    });
    return modal;
  }

  function initImfigZoom() {
    document.querySelectorAll<HTMLButtonElement>('[data-imfig-zoom]').forEach((btn) => {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const figure = btn.closest('figure.imfig');
        if (!figure) return;
        const inner = figure.querySelector('.imfig__plot-inner');
        if (!inner) return;
        const modal = ensureChartZoomModal();
        const body = modal.querySelector<HTMLElement>('[data-zoom-body]');
        const title = modal.querySelector<HTMLElement>('[data-zoom-title]');
        if (!body) return;
        // Clone the chart content into the modal body.
        body.innerHTML = '';
        const clone = inner.cloneNode(true) as HTMLElement;
        // Remove min-width hack on clone so it adopts modal sizing.
        clone.querySelectorAll('svg').forEach((svg) => {
          (svg as SVGSVGElement).style.minWidth = '';
        });
        body.appendChild(clone);
        // Title from the figure's eyebrow label.
        const label = figure.querySelector('.imfig__label');
        if (title && label) title.textContent = label.textContent;
        if (typeof modal.showModal === 'function') {
          modal.showModal();
        } else {
          // Very old browsers: fallback to visible open attr.
          modal.setAttribute('open', '');
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initImfigZoom);
  } else {
    initImfigZoom();
  }
  document.addEventListener('astro:page-load', initImfigZoom);
</script>
