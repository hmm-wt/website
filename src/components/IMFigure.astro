---
/**
 * IM-style figure card. Mirrors the chrome in CIM/html/charts.py chart_card().
 * Sci corners, eyebrow with fignum + label, serif title with em-tomato accents,
 * sub line, metric strip (4 cells), plot slot, source/basis grid.
 *
 * Props mirror the IM chart_card() signature so chart components can be ported
 * verbatim from CIM/html/charts.py.
 */
interface Metric {
  label: string;
  value: string;
  ci?: string;
  accent?: boolean;
}

interface Props {
  fignum: string;        // e.g. "EX-2"
  label: string;         // e.g. "Cumulative Premium Wedge · T1 vs Unregulated"
  title?: string;        // serif headline. May include <em>...</em> for tomato accent.
                         // Optional: pure-illustration exhibits sit under a prose argument.
  sub?: string;
  metrics?: Metric[];
  source?: string;
  basis?: string;
  bleed?: 'narrow' | 'wide' | 'full';  // narrow=column (default), wide=72rem, full=viewport
}

const { fignum, label, title, sub, metrics = [], source, basis, bleed = 'narrow' } = Astro.props;
const bleedClass = bleed === 'wide' ? 'imfig--bleed-wide' : bleed === 'full' ? 'imfig--bleed-full' : '';
---
<figure class:list={['imfig', bleedClass]} role="figure" aria-label={label}>
  <span class="imfig__corner imfig__corner--tl" aria-hidden="true"></span>
  <span class="imfig__corner imfig__corner--tr" aria-hidden="true"></span>
  <span class="imfig__corner imfig__corner--bl" aria-hidden="true"></span>
  <span class="imfig__corner imfig__corner--br" aria-hidden="true"></span>

  <div class="imfig__inner">
    <div class="imfig__eyebrow">
      <span class="imfig__num">{fignum}</span>
      <span class="imfig__label">{label}</span>
    </div>

    {title && <h3 class="imfig__title" set:html={title}></h3>}
    {sub && <p class="imfig__sub">{sub}</p>}

    {metrics.length > 0 && (
      <div class="imfig__strip">
        {metrics.map((m) => (
          <div class="imfig__cell">
            <div class="imfig__cell-label">{m.label}</div>
            <div class={`imfig__cell-val ${m.accent ? 'imfig__cell-val--accent' : ''}`}>{m.value}</div>
            {m.ci && <div class="imfig__cell-ci">{m.ci}</div>}
          </div>
        ))}
      </div>
    )}

    <div class="imfig__plot" data-imfig-plot>
      <div class="imfig__plot-inner">
        <slot />
      </div>
    </div>

    {(source || basis) && (
      <div class="imfig__source">
        {source && <><span class="imfig__source-k">Source</span><span>{source}</span></>}
        {basis && <><span class="imfig__source-k">Basis</span><span>{basis}</span></>}
      </div>
    )}
  </div>
</figure>

<style>
  .imfig {
    position: relative;
    border: 1px solid var(--c-mahogany);
    background: var(--c-pearl);
    color: var(--c-mahogany);
    padding: var(--s-6);
    margin: 0;
    --imfig-rule: rgba(4, 47, 42, 0.18);
    --imfig-muted: rgba(37, 0, 1, 0.66);
    --imfig-faint: rgba(37, 0, 1, 0.42);
    /* IM-system aliases so charts ported verbatim from CIM/html/charts.py
       render with the same var() names without rewriting. */
    --tomato: var(--c-tomato);
    --mahogany: var(--c-mahogany);
    --paper: var(--c-pearl);
    --pearl: var(--c-pearl);
    --ink: var(--c-mahogany);
    --ink-80: rgba(37, 0, 1, 0.80);
    --muted: var(--imfig-muted);
    --faint: var(--imfig-faint);
    --rule: var(--imfig-rule);
    --rule-strong: rgba(4, 47, 42, 0.32);
    --dark-teal: var(--c-dark-teal);
    --serif: var(--f-display);
    --mono: var(--f-mono);
    /* Surface remap: site-native charts authored against the dark page
       (--cohort-*, --fg-*, --hair-color) inherit pearl-surface equivalents
       when placed inside the card, so any chart renders legibly on paper
       without per-component edits. --hero stays Tomato (reads on both). */
    --fg: var(--c-mahogany);
    --fg-soft: var(--imfig-muted);
    --fg-faint: var(--imfig-faint);
    --hair-color: var(--imfig-rule);
    --hair-strong: var(--rule-strong);
    --cohort-1: var(--cohort-1-on-light);
    --cohort-2: var(--cohort-2-on-light);
    --cohort-3: var(--cohort-3-on-light);
    --cohort-4: var(--cohort-4-on-light);
    --cohort-ink: var(--cohort-ink-on-light);
    transition: box-shadow var(--mo-tick) var(--ease-golden);
  }
  .imfig:hover {
    box-shadow: 0 6px 18px rgba(4, 47, 42, 0.10), 0 1px 3px rgba(4, 47, 42, 0.08);
  }
  /* Bleed: escape the prose column without depending on parent grid.
   * Viewport-centered breakout that lands cleanly inside any flow parent. */
  .imfig--bleed-wide {
    width: min(72rem, 100vw - 2rem);
    margin-inline: calc(50% - min(36rem, 50vw - 1rem));
  }
  .imfig--bleed-full {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    max-width: none;
  }
  @media (max-width: 820px) {
    .imfig--bleed-wide, .imfig--bleed-full {
      width: 100%;
      margin-inline: 0;
    }
  }
  .imfig::before {
    content: "";
    position: absolute;
    inset: 4px;
    border: 1px solid var(--imfig-rule);
    pointer-events: none;
  }
  .imfig__inner { position: relative; z-index: 1; }

  .imfig__corner {
    position: absolute;
    width: 12px;
    height: 12px;
    pointer-events: none;
    z-index: 2;
    opacity: 0.4;
  }
  .imfig__corner--tl { top: 8px; left: 8px; border-top: 1px solid var(--c-mahogany); border-left: 1px solid var(--c-mahogany); }
  .imfig__corner--tr { top: 8px; right: 8px; border-top: 1px solid var(--c-mahogany); border-right: 1px solid var(--c-mahogany); }
  .imfig__corner--bl { bottom: 8px; left: 8px; border-bottom: 1px solid var(--c-mahogany); border-left: 1px solid var(--c-mahogany); }
  .imfig__corner--br { bottom: 8px; right: 8px; border-bottom: 1px solid var(--c-mahogany); border-right: 1px solid var(--c-mahogany); }

  .imfig__eyebrow {
    display: flex;
    gap: var(--s-3);
    align-items: baseline;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--imfig-muted);
    padding-block-end: var(--s-3);
    border-bottom: 1px solid var(--imfig-rule);
    margin-block-end: var(--s-4);
  }
  .imfig__num { color: var(--c-tomato); font-weight: 700; }

  .imfig__title {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: var(--fs-2xl);
    line-height: 1.14;
    letter-spacing: -0.005em;
    color: var(--c-mahogany);
    margin: 0 0 var(--s-3);
    text-wrap: balance;
  }
  .imfig__title :global(em) { font-style: italic; color: var(--c-tomato); }

  .imfig__sub {
    font-family: var(--f-body);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--imfig-muted);
    margin: 0 0 var(--s-5);
    max-width: 60ch;
  }

  .imfig__strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--imfig-rule);
    border-bottom: 1px solid var(--imfig-rule);
    padding-block: var(--s-4);
    margin-block-end: var(--s-5);
  }
  .imfig__cell {
    padding-inline: var(--s-4);
    border-left: 1px solid var(--imfig-rule);
    font-family: var(--f-mono);
  }
  .imfig__cell:first-child { border-left: 0; padding-left: 0; }
  .imfig__cell-label {
    font-size: calc(var(--fs-xs) * 0.92);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--imfig-muted);
    margin-block-end: var(--s-2);
  }
  .imfig__cell-val {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: 1;
    color: var(--c-mahogany);
  }
  .imfig__cell-val--accent { font-style: italic; color: var(--c-tomato); }
  .imfig__cell-ci {
    font-size: calc(var(--fs-xs) * 0.95);
    color: var(--imfig-muted);
    margin-block-start: var(--s-2);
  }

  .imfig__plot {
    margin-block: var(--s-4);
    position: relative;
  }
  .imfig__plot-inner { display: block; }

  /* Staggered reveal on viewport entry. Chrome paints from load; the plot
   * fades + lifts once the IntersectionObserver flags the figure visible.
   * prefers-reduced-motion: imfig-reveal.ts marks every figure revealed at
   * boot so the same selector applies the no-op state. */
  .imfig__plot-inner {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 480ms var(--ease-golden, ease-out), transform 480ms var(--ease-golden, ease-out);
  }
  .imfig[data-imfig-revealed="true"] .imfig__plot-inner {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .imfig__plot-inner {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Mobile lets the plot scroll horizontally so charts render at native
   * readable size. */
  @media (max-width: 720px) {
    .imfig__plot-inner {
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
    }
    .imfig__plot-inner > :global(svg) {
      min-width: 32rem;
      display: block;
    }
  }

  .imfig__source {
    border-top: 1px solid var(--imfig-rule);
    padding-block-start: var(--s-3);
    font-family: var(--f-mono);
    font-size: calc(var(--fs-xs) * 0.92);
    line-height: 1.55;
    color: var(--imfig-muted);
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--s-2) var(--s-4);
    letter-spacing: 0.04em;
  }
  .imfig__source-k {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--imfig-faint);
    font-weight: 700;
  }

  @media (max-width: 720px) {
    .imfig { padding: var(--s-5); }
    .imfig__strip { grid-template-columns: repeat(2, 1fr); }
    .imfig__cell { padding-block: var(--s-2); }
    .imfig__cell:nth-child(3) { border-left: 0; padding-left: 0; }
    .imfig__source { grid-template-columns: 3rem 1fr; gap: var(--s-1) var(--s-3); }
  }
</style>

<script>
  import '../scripts/imfig-reveal';
</script>
