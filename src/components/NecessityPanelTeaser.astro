---
/**
 * NecessityPanelTeaser. One beat in the home-page Five Necessities scroll.
 *
 * Layout: stamped number on the left, claim + regulation sparkline on the right.
 * Links into /necessities/[slug]/.
 */
import NecessityMark from './NecessityMark.astro';
import crystallisation from '../data/crystallisation-window.json';

interface Props {
  slug: string;
  name: string;
  shortName: string;
  inThesis: number;
  claim: string;
  necessityKey: string;
  markKind: 'food' | 'biomedical' | 'power' | 'autonomous' | 'materials';
  index?: number;
}

const { slug, name, shortName, inThesis, claim, necessityKey, markKind, index = 0 } = Astro.props;

const years = [2024, 2025, 2026, 2027, 2028, 2029, 2030];

const regsByYear: Record<number, number> = {};
years.forEach((y) => { regsByYear[y] = 0; });

(crystallisation.regulations as any[]).forEach((r) => {
  if (r.necessity === necessityKey && years.includes(r.effective_year)) {
    regsByYear[r.effective_year] += 1;
  }
});

const values = years.map((y) => regsByYear[y]);

let peakYear: number | null = null;
let peakCount = 0;
values.forEach((v, i) => {
  if (v > peakCount) { peakCount = v; peakYear = years[i]; }
});

const totalRegs = values.reduce((a, b) => a + b, 0);
---
<article class="npt" data-i={index} style={`--npt-delay: ${index * 60}ms;`}>
  <a class="npt__link" href={`/necessities/${slug}/`}>
    <div class="npt__numside">
      <span class="npt__num ticker-roll">{inThesis.toLocaleString()}</span>
      <span class="npt__numlabel">In-thesis companies</span>
    </div>
    <div class="npt__contentside">
      <header class="npt__head">
        <span class="npt__mark" aria-hidden="true"><NecessityMark kind={markKind} size={28} /></span>
        <p class="kicker npt__kicker">{shortName}</p>
        <h3 class="npt__name">{name}</h3>
      </header>
      <p class="npt__claim">{claim}</p>
      {totalRegs > 0 && (
        <p class="npt__regnote">
          {totalRegs} regulation{totalRegs === 1 ? '' : 's'} in flight{peakYear ? <>, peak <span class="npt__peak">{peakYear}</span></> : null}
        </p>
      )}
      <span class="npt__more">Open the panel &rarr;</span>
    </div>
  </a>
</article>

<style>
  .npt {
    border-top: var(--hair) solid var(--hair-color);
  }
  .npt:last-child { border-bottom: var(--hair) solid var(--hair-color); }
  .npt__link {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--s-6);
    padding: var(--s-6) var(--s-4);
    text-decoration: none;
    color: var(--fg);
    transition: background var(--mo-hold) var(--ease-golden);
  }
  .npt__link:hover { background: color-mix(in srgb, var(--c-tomato) 6%, transparent); }

  .npt__numside {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    border-right: var(--hair) solid var(--hair-color);
    padding-right: var(--s-5);
  }
  .npt__num {
    font-family: var(--f-display);
    font-size: clamp(2.5rem, 1.5rem + 3.5vw, 4rem);
    line-height: 1;
    color: var(--hero);
    letter-spacing: -0.02em;
  }
  .npt__numlabel {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-faint);
    max-width: 22ch;
  }

  .npt__contentside {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .npt__head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    flex-wrap: wrap;
  }
  .npt__mark {
    color: var(--c-tomato);
    flex-shrink: 0;
    align-self: center;
    transition: color var(--mo-tick) var(--ease-golden);
  }
  .npt__link:hover .npt__mark { color: var(--c-pearl); }
  .npt__kicker { color: var(--fg-faint); margin: 0; }
  .npt__name {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-tight);
    margin: 0;
    color: var(--fg);
  }
  .npt__claim {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--fg-soft);
    margin: var(--s-2) 0;
    max-width: 50ch;
  }
  .npt__regnote {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-faint);
    margin: var(--s-3) 0 0;
  }
  .npt__peak { color: var(--c-tomato); }
  .npt__more {
    margin-block-start: var(--s-4);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--hero);
  }
  .npt__link:hover .npt__more { color: var(--c-pearl); }

  @media (max-width: 800px) {
    .npt__link {
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }
    .npt__numside {
      border-right: 0;
      border-bottom: var(--hair) solid var(--hair-color);
      padding-right: 0;
      padding-bottom: var(--s-4);
    }
  }
</style>
