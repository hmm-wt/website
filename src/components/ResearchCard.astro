---
interface Props {
  href: string;
  title: string;
  summary: string;
  date: string;
  version?: string;
  markets?: string[];
  pdfUrl?: string;
  pages?: number;
  index?: string;
  status?: 'live' | 'draft' | 'archived';
}

const { href, title, summary, date, version, markets, pdfUrl, pages, index, status = 'live' } = Astro.props;
const dateLabel = new Date(date).toLocaleDateString('en-GB', {
  year: 'numeric', month: 'short', day: '2-digit'
});
const ageDays = Math.floor((Date.now() - new Date(date).getTime()) / 86400000);
const freshness = ageDays < 30 ? 'New' : ageDays < 120 ? 'Recent' : null;
---
<article class="rc">
  <a class="rc__link" href={href}>
    <header class="rc__head">
      {index && <span class="rc__idx">[{index}]</span>}
      <span class="rc__type">Research</span>
      <span class={`rc__status rc__status--${status}`}>{status}</span>
      {freshness && <span class="rc__fresh">{freshness}</span>}
      {version && <span class="rc__version">{version}</span>}
    </header>
    <h3 class="rc__title">{title}</h3>
    <p class="rc__summary">{summary}</p>
    <footer class="rc__foot">
      <time datetime={date}>{dateLabel}</time>
      {pages && <span>{pages} pp</span>}
      {markets && markets.length > 0 && (
        <span class="rc__markets">{markets.join(' · ')}</span>
      )}
      {pdfUrl && (
        <a class="rc__pdf" href={pdfUrl} download data-stop>PDF ↓</a>
      )}
    </footer>
  </a>
</article>

<style>
  .rc {
    border-top: 1px solid var(--rule);
    transition: background var(--dur-1) var(--ease);
  }
  .rc:hover { background: var(--bg-warm); }
  .rc__link {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-6) var(--s-5);
    text-decoration: none;
    color: var(--fg);
  }
  .rc__head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .rc__idx { color: var(--c-tomato); font-weight: 600; }
  .rc__type { color: var(--fg-soft); }
  .rc__version { margin-inline-start: auto; color: var(--c-tomato); }
  .rc__status {
    padding: 0.1em 0.5em;
    border: 1px solid currentColor;
    font-size: calc(var(--fs-xs) * 0.85);
    font-weight: 600;
  }
  .rc__status--live { color: var(--c-tomato); }
  .rc__status--draft { color: var(--fg-soft); }
  .rc__status--archived { color: var(--fg-faint); }
  .rc__fresh {
    padding: 0.1em 0.5em;
    background: var(--c-tomato);
    color: var(--c-pearl);
    font-size: calc(var(--fs-xs) * 0.85);
    font-weight: 600;
  }

  .rc__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: 0;
    transition: color var(--dur-1) var(--ease);
  }
  .rc__link:hover .rc__title { color: var(--c-tomato); }

  .rc__summary {
    font-size: var(--fs-md);
    color: var(--fg-soft);
    max-width: 64ch;
    margin: 0;
    line-height: 1.55;
  }

  .rc__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    align-items: baseline;
    margin-block-start: var(--s-3);
    padding-block-start: var(--s-3);
    border-top: 1px dashed var(--rule);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: var(--fg-soft);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .rc__markets { color: var(--fg); }
  .rc__pdf {
    margin-inline-start: auto;
    color: var(--c-tomato);
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .rc__pdf:hover { color: var(--fg); }
</style>
