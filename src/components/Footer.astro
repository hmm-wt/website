---
const year = new Date().getFullYear();

/**
 * Multilingual tagline block. Exact wording per CLAUDE_wahid_voice_memory.md §0.
 * Order: EN (master), AR (GCC), ZH (SG/APAC), JA (JP), Māori (NZ).
 * No Bahasa per voice memory.
 */
const taglines = [
  { lang: 'en', text: 'Necessity is the thesis.' },
  { lang: 'ar', text: 'الضرورة هي الأساس', dir: 'rtl' },
  { lang: 'zh', text: '刚需即论点' },
  { lang: 'ja', text: '必要性こそ論拠' },
  { lang: 'mi', text: 'Ko te hiahia, ko te kaupapa' }
];
---
<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <span class="footer__reg" aria-hidden="true"></span>
      <p class="kicker">hmm Ventures</p>
      <ul role="list" class="footer__taglines">
        {taglines.map((t) => (
          <li lang={t.lang} dir={t.dir ?? 'ltr'} class={`footer__tagline footer__tagline--${t.lang}`}>
            {t.text}
          </li>
        ))}
      </ul>
    </div>

    <nav aria-label="Footer">
      <p class="kicker">Read</p>
      <ul role="list" class="footer__links">
        <li><a href="/doctrine/">The Necessity Doctrine</a></li>
        <li><a href="/thesis/">Thesis</a></li>
        <li><a href="/scoreboard/">Scoreboard</a></li>
        <li><a href="/gp/">Author</a></li>
      </ul>
    </nav>

    <div class="footer__contact">
      <p class="kicker">Direct</p>
      <ul role="list" class="footer__contact-list">
        <li><a href="mailto:wt@hmm.ventures">wt@hmm.ventures</a></li>
        <li class="footer__contact-meta">DIFC, Dubai · SIN · TYO · SYD · AKL</li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer__base">
    <p class="kicker footer__legal">
      © {year} hmm Ventures Fund I, L.P. This material does not constitute an offer to sell or a solicitation to buy securities. The Fund is offered under Reg D 506(b) to accredited investors with a pre-existing substantive relationship.
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-deep);
    color: var(--fg-on-deep);
    padding-block: var(--s-8) var(--s-5);
    margin-block-start: var(--s-9);
  }
  .footer a { color: var(--c-pearl); text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--c-pearl) 25%, transparent); padding-bottom: 1px; }
  .footer a:hover { color: var(--c-tomato); border-bottom-color: var(--c-tomato); }

  .footer__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr;
    gap: var(--s-7);
    align-items: start;
  }

  .footer__brand { position: relative; }
  .footer__reg {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--c-tomato);
    margin-block-end: var(--s-3);
  }

  .footer__taglines {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    margin-block-start: var(--s-2);
  }
  .footer__tagline {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: 1.3;
  }
  .footer__tagline--ar,
  .footer__tagline--zh,
  .footer__tagline--ja {
    font-family: var(--f-display), 'Noto Naskh Arabic', 'Noto Sans CJK', sans-serif;
  }
  .footer__tagline:not(.footer__tagline--en) {
    font-size: var(--fs-md);
    color: color-mix(in srgb, var(--c-pearl) 78%, transparent);
  }

  .footer__links,
  .footer__contact-list {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    margin-block-start: var(--s-2);
  }

  .footer__contact-meta {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
  }

  .footer__base {
    margin-block-start: var(--s-7);
    padding-block-start: var(--s-4);
    border-top: 1px solid color-mix(in srgb, var(--c-pearl) 15%, transparent);
  }
  .footer__legal {
    max-width: 80ch;
    color: color-mix(in srgb, var(--c-pearl) 55%, transparent);
    line-height: 1.5;
  }

  .footer .kicker { color: color-mix(in srgb, var(--c-pearl) 65%, transparent); }

  @media (max-width: 820px) {
    .footer__inner { grid-template-columns: 1fr; gap: var(--s-6); }
  }
</style>
