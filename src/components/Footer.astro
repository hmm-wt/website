---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__brand">hmm Ventures</p>
    <p class="footer__address">DIFC, Dubai · Track A self-managed VCFM · DFSA Category 3C</p>
    <p class="footer__contact"><a href="mailto:wt@hmm.ventures">wt@hmm.ventures</a></p>
    <p class="footer__copy">© {year} hmm Ventures</p>
    <p class="footer__disclaimer">
      Public research, not an offer. Nothing on this site is an offer to sell, or a solicitation of an offer to buy, any securities or partnership interests in any jurisdiction.
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-deep);
    color: var(--fg-on-deep);
    padding-block: var(--s-7) var(--s-5);
    margin-block-start: var(--s-9);
  }
  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .footer__brand {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-tomato);
    margin: 0 0 var(--s-3);
  }
  .footer__address,
  .footer__contact,
  .footer__copy,
  .footer__disclaimer {
    font-family: var(--f-mono);
    font-size: calc(var(--fs-xs) * 0.95);
    line-height: 1.55;
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
    margin: 0;
  }
  .footer__contact a {
    color: var(--c-pearl);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--c-pearl) 25%, transparent);
    padding-bottom: 1px;
  }
  .footer__contact a:hover {
    color: var(--c-tomato);
    border-bottom-color: var(--c-tomato);
  }
  .footer__disclaimer {
    margin-block-start: var(--s-4);
    color: color-mix(in srgb, var(--c-pearl) 40%, transparent);
    max-width: 80ch;
  }
</style>
