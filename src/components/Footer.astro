---
import JurisdictionMark from './JurisdictionMark.astro';
const year = new Date().getFullYear();

/**
 * Multilingual tagline block. Per Design System v1.0 §C.06.
 * Order: EN (master), ZH (SG), JA (JP), Māori (NZ).
 */
interface Tagline { lang: string; text: string; dir?: 'ltr' | 'rtl'; }
const taglines: Tagline[] = [
  { lang: 'en', text: 'Necessity is the thesis.' },
  { lang: 'zh', text: '刚需即论点' },
  { lang: 'ja', text: '必要性こそ論拠' },
  { lang: 'mi', text: 'Ko te hiahia, ko te kaupapa' }
];

const locations: { market: 'SG' | 'JP' | 'AU' | 'NZ'; name: string; slug: string }[] = [
  { market: 'SG', name: 'Singapore', slug: 'singapore' },
  { market: 'JP', name: 'Japan', slug: 'japan' },
  { market: 'AU', name: 'Australia', slug: 'australia' },
  { market: 'NZ', name: 'New Zealand', slug: 'new-zealand' }
];
---
<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <span class="footer__reg" aria-hidden="true"></span>
      <p class="kicker">hmm Ventures</p>
      <ul role="list" class="footer__taglines">
        {taglines.map((t) => (
          <li lang={t.lang} dir={t.dir ?? 'ltr'} class={`footer__tagline footer__tagline--${t.lang}`}>
            {t.lang === 'en' ? (
              <>Necessity is <span class="footer__tagline-accent">the&nbsp;thesis.</span></>
            ) : (
              t.text
            )}
          </li>
        ))}
      </ul>
    </div>

    <nav aria-label="Footer">
      <p class="kicker">Read</p>
      <ul role="list" class="footer__links">
        <li><a href="/doctrine/">The Necessity Doctrine</a></li>
        <li><a href="/research/data/scoreboard/">Scoreboard</a></li>
        <li><a href="/research/">Research</a></li>
      </ul>
    </nav>

    <div class="footer__markets">
      <p class="kicker">Markets</p>
      <ul role="list" class="footer__locations">
        {locations.map((loc) => (
          <li class="footer__location">
            <a href={`/thesis/${loc.slug}/`} class="footer__location-link">
              <span class="footer__location-mark"><JurisdictionMark market={loc.market} size={20} /></span>
              <span class="footer__location-name">{loc.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="container footer__base">
    <p class="kicker footer__legal">© {year} hmm Ventures · <a href="mailto:wt@hmm.ventures">wt@hmm.ventures</a></p>
    <p class="footer__disclaimer">
      Public research, not an offer. Nothing on this site is an offer to sell, or a solicitation of an offer to buy, any securities or partnership interests in any jurisdiction. The fund's Investment Memorandum is provided on a confidential basis only to qualified investors with a pre-existing substantive relationship with the General Partner, and only in compliance with US Regulation D Rule 506(b) (accredited investors, no general solicitation), DFSA Professional Client rules, AU wholesale investor exemptions under Corporations Act 2001 s.708, JP FIEA Professional Investor rules, NZ FMCA 2013 Schedule 1 wholesale exclusions, and SG SFA accredited / institutional investor carve-outs (ss.274 / 275). Past performance is not indicative of future results. Forward-looking statements and any references to simulated outcomes are based on assumptions that are subject to change; actual results may differ materially. The fund manager's DFSA Category 3C licence is pending; no LP commitments will be formalised until DFSA authorisation is confirmed. Pending counsel sign-off.
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-deep);
    color: var(--fg-on-deep);
    padding-block: var(--s-8) var(--s-5);
    margin-block-start: var(--s-9);
  }
  .footer a { color: var(--c-pearl); text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--c-pearl) 25%, transparent); padding-bottom: 1px; }
  .footer a:hover { color: var(--c-tomato); border-bottom-color: var(--c-tomato); }

  .footer__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr;
    gap: var(--s-7);
    align-items: start;
  }

  .footer__brand { position: relative; }
  .footer__reg {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--c-tomato);
    margin-block-end: var(--s-3);
  }

  .footer__taglines {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    margin-block-start: var(--s-2);
  }
  .footer__tagline {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: 1.3;
  }
  .footer__tagline--ar,
  .footer__tagline--zh,
  .footer__tagline--ja {
    font-family: var(--f-display), 'Noto Naskh Arabic', 'Noto Sans CJK', sans-serif;
  }
  .footer__tagline:not(.footer__tagline--en) {
    font-size: var(--fs-md);
    color: color-mix(in srgb, var(--c-pearl) 78%, transparent);
  }
  .footer__tagline-accent {
    color: var(--c-tomato);
    font-style: italic;
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    margin-block-start: var(--s-2);
  }

  .footer__markets { margin: 0; }
  .footer__locations {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-3);
    margin: var(--s-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .footer__location {
    color: color-mix(in srgb, var(--c-pearl) 70%, transparent);
  }
  .footer__location-link {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    color: inherit;
    text-decoration: none;
    border-bottom: 0;
    padding: 0;
    transition: color var(--mo-tick) var(--ease-golden);
  }
  .footer__location-link:hover { color: var(--c-tomato); border-bottom: 0; }
  .footer__location-mark { color: var(--c-tomato); display: inline-flex; flex-shrink: 0; }
  .footer__location-name { font-size: calc(var(--fs-xs) * 0.96); }

  .footer__base {
    margin-block-start: var(--s-7);
    padding-block-start: var(--s-4);
    border-top: 1px solid color-mix(in srgb, var(--c-pearl) 15%, transparent);
  }
  .footer__legal {
    max-width: 80ch;
    color: color-mix(in srgb, var(--c-pearl) 55%, transparent);
    line-height: 1.5;
  }
  .footer__disclaimer {
    margin: var(--s-3) 0 0;
    max-width: 80ch;
    font-family: var(--f-mono);
    font-size: calc(var(--fs-xs) * 0.92);
    line-height: 1.55;
    color: color-mix(in srgb, var(--c-pearl) 45%, transparent);
    letter-spacing: 0.02em;
  }

  .footer .kicker { color: color-mix(in srgb, var(--c-pearl) 65%, transparent); }

  @media (max-width: 820px) {
    .footer__inner { grid-template-columns: 1fr; gap: var(--s-6); }
  }
</style>
