---
/**
 * CorridorGrid. Four-market grid. Replaces CountryCorridorGrid + MarketBlock
 * with Pudding-style hairline rules and cohort+hero treatment.
 */
import data from '../data/necessity-index.json';

interface MarketCell {
  market: string;
  code: string;
  companies: number;
  regulations: number;
  t1: number;
  t2: number;
  allocation: number;
  slug: string;
}

const allocationMap: Record<string, number> = {
  AU: 35,
  JP: 30,
  NZ: 20,
  SG: 15,
};

const slugMap: Record<string, string> = {
  AU: 'australia',
  JP: 'japan',
  NZ: 'new-zealand',
  SG: 'singapore',
};

const markets: MarketCell[] = (data.per_market as any[]).map((m) => ({
  market: m.market,
  code: m.code,
  companies: m.companies,
  regulations: m.regulations,
  t1: m.t1,
  t2: m.t2,
  allocation: allocationMap[m.market] ?? 0,
  slug: slugMap[m.market] ?? m.market.toLowerCase(),
}));

const maxAlloc = Math.max(...markets.map((m) => m.allocation));
---
<section class="corridor container" aria-label="Four-market corridor">
  <ol class="corridor__list">
    {markets.map((m) => (
      <li class="corridor__cell">
        <a class="corridor__link" href={`/thesis/${m.slug}/`}>
          <header class="corridor__head">
            <span class="corridor__code">{m.code}</span>
            <span class="corridor__alloc">{m.allocation}%</span>
          </header>
          <div class="corridor__bar" aria-hidden="true">
            <span
              class="corridor__fill"
              style={`width: ${(m.allocation / maxAlloc) * 100}%`}
            ></span>
          </div>
          <dl class="corridor__stats">
            <div class="corridor__stat">
              <dt>Companies</dt>
              <dd>{m.companies.toLocaleString()}</dd>
            </div>
            <div class="corridor__stat">
              <dt>Regulations</dt>
              <dd>{m.regulations}</dd>
            </div>
            <div class="corridor__stat">
              <dt>T1 / T2</dt>
              <dd>{m.t1} / {m.t2}</dd>
            </div>
          </dl>
          <span class="corridor__more">Open the market &rarr;</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .corridor {
    padding-block: var(--s-7);
  }
  .corridor__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: var(--hair) solid var(--hair-color);
    border-bottom: var(--hair) solid var(--hair-color);
  }
  .corridor__cell {
    border-left: var(--hair) solid var(--hair-color);
  }
  .corridor__cell:first-child { border-left: 0; }
  .corridor__link {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-5);
    height: 100%;
    text-decoration: none;
    color: var(--fg);
    transition: background var(--mo-hold) var(--ease-golden);
  }
  .corridor__link:hover { background: color-mix(in srgb, var(--c-tomato) 8%, transparent); }
  .corridor__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }
  .corridor__code {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: 1;
  }
  .corridor__alloc {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: 1;
    color: var(--hero);
  }
  .corridor__bar {
    height: 4px;
    background: var(--cohort-1);
    overflow: hidden;
  }
  .corridor__fill {
    display: block;
    height: 100%;
    background: var(--hero);
  }
  .corridor__stats {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .corridor__stat {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .corridor__stat dt {
    color: var(--fg-faint);
    margin: 0;
  }
  .corridor__stat dd {
    margin: 0;
    color: var(--fg);
    font-family: var(--f-display);
    text-transform: none;
    letter-spacing: 0;
    font-size: var(--fs-base);
  }
  .corridor__more {
    margin-block-start: auto;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--hero);
  }

  @media (max-width: 980px) {
    .corridor__list { grid-template-columns: repeat(2, 1fr); }
    .corridor__cell:nth-child(2n+1) { border-left: 0; }
    .corridor__cell { border-top: var(--hair) solid var(--hair-color); }
    .corridor__cell:nth-child(-n+2) { border-top: 0; }
  }
  @media (max-width: 540px) {
    .corridor__list { grid-template-columns: 1fr; }
    .corridor__cell { border-left: 0; border-top: var(--hair) solid var(--hair-color); }
    .corridor__cell:first-child { border-top: 0; }
  }
</style>
