---
interface FilterGroup {
  key: string;            // e.g. "market" or "necessity"
  label: string;
  options: string[];      // ["AU", "JP", "NZ", "SG"]
}

interface Props {
  groups: FilterGroup[];
  /** Selector for the items to filter. Each item must carry data-{key} attributes matching option values. */
  target: string;         // e.g. ".memo-list .card"
}

const { groups, target } = Astro.props;
---
<div class="tf" data-tag-filter data-target={target}>
  <div class="tf__head">
    <p class="kicker tf__label">Filter</p>
    <button class="tf__clear" type="button" data-tf-clear hidden>Clear all</button>
  </div>

  {groups.map((g) => (
    <fieldset class="tf__group" data-tf-group={g.key}>
      <legend class="tf__group-label">{g.label}</legend>
      <div class="tf__chips">
        {g.options.map((opt) => (
          <button
            type="button"
            class="tf__chip"
            data-tf-chip
            data-tf-key={g.key}
            data-tf-value={opt}
            aria-pressed="false"
          >{opt}</button>
        ))}
      </div>
    </fieldset>
  ))}

  <p class="tf__count" data-tf-count></p>
</div>

<script>
  function initTagFilter() {
    document.querySelectorAll<HTMLElement>('[data-tag-filter]').forEach((root) => {
      const targetSel = root.dataset.target;
      if (!targetSel) return;

      const chips = root.querySelectorAll<HTMLButtonElement>('[data-tf-chip]');
      const clearBtn = root.querySelector<HTMLButtonElement>('[data-tf-clear]');
      const countEl = root.querySelector<HTMLElement>('[data-tf-count]');

      // Active filters keyed by filter key (e.g. "market" → Set of values)
      const active = new Map<string, Set<string>>();

      function applyFilters() {
        const items = document.querySelectorAll<HTMLElement>(targetSel ?? '');
        let visible = 0;

        items.forEach((item) => {
          let show = true;
          for (const [key, values] of active.entries()) {
            if (values.size === 0) continue;
            const itemVal = item.dataset[key];
            if (!itemVal || !values.has(itemVal)) {
              show = false;
              break;
            }
          }
          item.hidden = !show;
          if (show) visible++;
        });

        if (countEl) {
          const total = items.length;
          countEl.textContent = visible === total
            ? `${total} ${total === 1 ? 'item' : 'items'}`
            : `${visible} of ${total} ${total === 1 ? 'item' : 'items'}`;
        }

        const anyActive = Array.from(active.values()).some((s) => s.size > 0);
        if (clearBtn) clearBtn.hidden = !anyActive;

        // Sync URL hash for shareability
        const params = new URLSearchParams();
        for (const [key, values] of active.entries()) {
          if (values.size > 0) params.set(key, Array.from(values).join(','));
        }
        const qs = params.toString();
        history.replaceState(null, '', qs ? `?${qs}${location.hash}` : location.pathname + location.hash);
      }

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const key = chip.dataset.tfKey;
          const value = chip.dataset.tfValue;
          if (!key || !value) return;
          if (!active.has(key)) active.set(key, new Set());
          const set = active.get(key)!;
          if (set.has(value)) {
            set.delete(value);
            chip.setAttribute('aria-pressed', 'false');
          } else {
            set.add(value);
            chip.setAttribute('aria-pressed', 'true');
          }
          applyFilters();
        });
      });

      clearBtn?.addEventListener('click', () => {
        active.clear();
        chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
        applyFilters();
      });

      // Restore from URL on load
      const params = new URLSearchParams(location.search);
      params.forEach((val, key) => {
        const values = val.split(',');
        values.forEach((v) => {
          const chip = root.querySelector<HTMLButtonElement>(
            `[data-tf-chip][data-tf-key="${key}"][data-tf-value="${v}"]`
          );
          chip?.click();
        });
      });

      applyFilters();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTagFilter);
  } else {
    initTagFilter();
  }
</script>

<style>
  .tf {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-5);
    background: var(--bg-warm);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .tf__head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
  }
  .tf__label { margin: 0; }
  .tf__clear {
    margin-inline-start: auto;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: transparent;
    border: 0;
    color: var(--c-tomato);
    cursor: pointer;
    padding: 0;
    border-bottom: 1px solid currentColor;
  }
  .tf__clear:hover { color: var(--fg); }

  .tf__group {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: center;
  }
  .tf__group-label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-soft);
    margin-inline-end: var(--s-2);
  }
  .tf__chips { display: flex; flex-wrap: wrap; gap: var(--s-2); }

  .tf__chip {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--fg-soft);
    padding: 0.35rem 0.7rem;
    cursor: pointer;
    transition: color var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }
  .tf__chip:hover { color: var(--c-tomato); border-color: var(--c-tomato); }
  .tf__chip[aria-pressed='true'] {
    background: var(--c-tomato);
    color: var(--c-light-tint);
    border-color: var(--c-tomato);
  }

  .tf__count {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
    margin: 0;
  }
</style>
