---
/**
 * DataSection. IM design language without IM card chrome.
 *
 * Wraps any inline data-vis on dark pages with the IM voice: mono eyebrow
 * with tomato fignum, serif title with em-tomato accent, sub line, source +
 * basis footer. Skips the mahogany rim, sci-corners, and metric strip — those
 * are floating-card affordances that double the chrome when the section
 * already fills its width.
 *
 * Use on dark surfaces (Evergreen). Pearl text inherits from the page.
 */
interface Props {
  fignum: string;       // e.g. "WEB-E"
  label: string;        // e.g. "Stage funnel · T1 / T2 universe"
  title: string;        // serif headline. May include <em>...</em> for tomato accent.
  sub?: string;
  source?: string;
  basis?: string;
  expandable?: boolean; // shows expand-to-modal button + wraps body in zoom-content
}

const { fignum, label, title, sub, source, basis, expandable = false } = Astro.props;
---
<section class="ds">
  <header class="ds__head">
    <p class="ds__eyebrow">
      <span class="ds__num">{fignum}</span>
      <span class="ds__label">{label}</span>
    </p>
    <h2 class="ds__title gavel-drop" set:html={title}></h2>
    {sub && <p class="ds__sub">{sub}</p>}
  </header>

  <div class="ds__body" data-chart-zoom-root data-zoom-title={label}>
    {expandable && (
      <button type="button" class="ds__zoom" data-chart-zoom aria-label="Expand chart to full screen">
        <span class="ds__zoom-icon" aria-hidden="true">⤢</span>
        <span class="ds__zoom-label">Expand</span>
      </button>
    )}
    <div class="ds__body-inner" data-chart-zoom-content>
      <slot />
    </div>
  </div>

  {(source || basis) && (
    <footer class="ds__source">
      {source && <><span class="ds__source-k">Source</span><span>{source}</span></>}
      {basis && <><span class="ds__source-k">Basis</span><span>{basis}</span></>}
    </footer>
  )}
</section>

<style>
  .ds {
    padding-block: var(--s-7);
    border-bottom: 1px solid color-mix(in srgb, var(--c-pearl) 12%, transparent);
  }
  .ds:last-of-type { border-bottom: 0; }

  .ds__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-end: var(--s-5);
  }
  .ds__eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: baseline;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
    margin: 0;
    padding-block-end: var(--s-3);
    border-bottom: 1px solid color-mix(in srgb, var(--c-pearl) 12%, transparent);
  }
  .ds__num { color: var(--c-tomato); font-weight: 700; }
  .ds__label { color: color-mix(in srgb, var(--c-pearl) 70%, transparent); }

  .ds__title {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    letter-spacing: -0.01em;
    color: var(--c-pearl);
    margin: 0;
    text-wrap: balance;
    max-width: 32ch;
  }
  .ds__title :global(em) {
    font-style: italic;
    color: var(--c-tomato);
  }

  .ds__sub {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: color-mix(in srgb, var(--c-pearl) 78%, transparent);
    max-width: 60ch;
    margin: 0;
  }

  .ds__body { margin-block-start: var(--s-5); position: relative; }
  .ds__body-inner { display: block; }

  /* Expand button — dark-surface twin of .imfig__zoom. */
  .ds__zoom {
    display: inline-flex;
    position: absolute;
    top: 0;
    right: 0;
    z-index: 3;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.6rem;
    background: color-mix(in srgb, var(--c-pearl) 12%, transparent);
    color: var(--c-pearl);
    border: 1px solid color-mix(in srgb, var(--c-pearl) 28%, transparent);
    font-family: var(--f-mono);
    font-size: calc(var(--fs-xs) * 0.92);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity var(--mo-tick) var(--ease-golden), background var(--mo-tick) var(--ease-golden), border-color var(--mo-tick) var(--ease-golden);
  }
  .ds:hover .ds__zoom { opacity: 1; }
  .ds__zoom:hover, .ds__zoom:focus {
    background: var(--c-tomato);
    color: var(--c-pearl);
    border-color: var(--c-tomato);
    outline: none;
    opacity: 1;
  }
  .ds__zoom-icon { font-size: 1.05em; line-height: 1; }

  /* Staggered reveal — mirrors IMFigure pattern; observer adds the flag. */
  .ds__body-inner {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 480ms var(--ease-golden, ease-out), transform 480ms var(--ease-golden, ease-out);
  }
  .ds[data-imfig-revealed="true"] .ds__body-inner {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .ds__body-inner {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .ds__source {
    margin-block-start: var(--s-5);
    padding-block-start: var(--s-3);
    border-top: 1px solid color-mix(in srgb, var(--c-pearl) 12%, transparent);
    font-family: var(--f-mono);
    font-size: calc(var(--fs-xs) * 0.92);
    line-height: 1.55;
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--s-2) var(--s-4);
    letter-spacing: 0.04em;
  }
  .ds__source-k {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--c-pearl) 45%, transparent);
    font-weight: 700;
  }

  @media (max-width: 720px) {
    .ds { padding-block: var(--s-6); }
    .ds__head { gap: var(--s-2); }
    .ds__source { grid-template-columns: 3rem 1fr; gap: var(--s-1) var(--s-3); }
  }
</style>

<script>
  import '../scripts/chart-zoom';
  import '../scripts/imfig-reveal';
</script>
