---
/**
 * ExitsUnitStrip. Unit chart of named acquirer deals. Each deal is one dot,
 * placed along a year axis. T1 deals are hero; T2 stay cohort.
 *
 * Pulls verbatim from exits-named.json.
 */
import exitsData from '../data/exits-named.json';

const exits = (exitsData.exits as any[]).slice().sort((a, b) => a.year - b.year);

const years = Array.from({ length: 2026 - 2020 + 1 }, (_, i) => 2020 + i);

interface BinnedExit {
  year: number;
  exit: any;
  positionInYear: number;
}

const byYear: Record<number, any[]> = {};
years.forEach((y) => { byYear[y] = []; });
exits.forEach((e) => {
  if (byYear[e.year]) byYear[e.year].push(e);
});

const binned: BinnedExit[] = [];
years.forEach((y) => {
  byYear[y].forEach((e, i) => {
    binned.push({ year: y, exit: e, positionInYear: i });
  });
});

const width = 720;
const height = 280;
const margin = { top: 30, right: 30, bottom: 60, left: 50 };
const usableW = width - margin.left - margin.right;
const usableH = height - margin.top - margin.bottom;
const xStep = usableW / (years.length - 1);
const dotSize = 12;
const dotGap = 4;

const dots = binned.map((b) => {
  const yearIndex = years.indexOf(b.year);
  const x = margin.left + yearIndex * xStep;
  const y = height - margin.bottom - 10 - b.positionInYear * (dotSize + dotGap);
  return { ...b, x, y };
});
---
<svg
  class="exitsstrip"
  viewBox={`0 0 ${width} ${height}`}
  width="100%"
  height={height}
  preserveAspectRatio="xMidYMid meet"
  role="img"
  aria-label="Named developed-APAC regulated-company acquisitions 2020 to 2026"
>
  {/* Hairline year axis */}
  <line
    x1={margin.left}
    y1={height - margin.bottom}
    x2={width - margin.right}
    y2={height - margin.bottom}
    stroke="var(--hair-color)"
    stroke-width="0.75"
  />

  {/* Year labels */}
  {years.map((y, i) => (
    <text
      x={margin.left + i * xStep}
      y={height - margin.bottom + 20}
      text-anchor="middle"
      class="exitsstrip__year"
    >{y}</text>
  ))}

  {/* Cohort dots first */}
  {dots.map((d) => {
    if (d.exit.tier === 'T1') return null;
    return (
      <g>
        <rect
          x={d.x - dotSize / 2}
          y={d.y - dotSize / 2}
          width={dotSize}
          height={dotSize}
          fill="var(--cohort-3)"
        >
          <title>{d.exit.company} ({d.exit.market}, {d.exit.tier}). {d.exit.acquirer}. {d.exit.value_display}</title>
        </rect>
      </g>
    );
  })}

  {/* Hero dots on top */}
  {dots.map((d) => {
    if (d.exit.tier !== 'T1') return null;
    return (
      <g>
        <rect
          x={d.x - dotSize / 2}
          y={d.y - dotSize / 2}
          width={dotSize}
          height={dotSize}
          fill="var(--hero)"
        >
          <title>{d.exit.company} ({d.exit.market}, {d.exit.tier}). {d.exit.acquirer}. {d.exit.value_display}</title>
        </rect>
      </g>
    );
  })}

  {/* Annotation: 2024 (Costa) and 2026 (Eucalyptus) callouts */}
  {(() => {
    const costa = dots.find((d) => d.exit.id === 'costa-paineschwartz');
    const eucalyptus = dots.find((d) => d.exit.id === 'eucalyptus-hims');
    return (
      <g>
        {costa && (
          <g>
            <line
              x1={costa.x + dotSize / 2 + 4}
              y1={costa.y}
              x2={costa.x + 80}
              y2={costa.y - 30}
              stroke="var(--hero)"
              stroke-width="0.75"
            />
            <text x={costa.x + 84} y={costa.y - 34} class="exitsstrip__annot">Costa A$2.459B</text>
            <text x={costa.x + 84} y={costa.y - 20} class="exitsstrip__annot exitsstrip__annot--sub">AU Food T2</text>
          </g>
        )}
        {eucalyptus && (
          <g>
            <line
              x1={eucalyptus.x - dotSize / 2 - 4}
              y1={eucalyptus.y}
              x2={eucalyptus.x - 80}
              y2={eucalyptus.y - 60}
              stroke="var(--hero)"
              stroke-width="0.75"
            />
            <text x={eucalyptus.x - 84} y={eucalyptus.y - 64} text-anchor="end" class="exitsstrip__annot">Eucalyptus up to $1.15B</text>
            <text x={eucalyptus.x - 84} y={eucalyptus.y - 50} text-anchor="end" class="exitsstrip__annot exitsstrip__annot--sub">AU Biomedical T1</text>
          </g>
        )}
      </g>
    );
  })()}
</svg>

<style>
  .exitsstrip { display: block; max-width: 100%; }
  .exitsstrip :global(.exitsstrip__year) {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    fill: var(--fg-soft);
  }
  .exitsstrip :global(.exitsstrip__annot) {
    font-family: var(--f-annot);
    font-size: var(--fs-annot);
    font-weight: 500;
    fill: var(--hero);
  }
  .exitsstrip :global(.exitsstrip__annot--sub) {
    fill: var(--fg-faint);
    font-weight: 400;
  }
</style>
