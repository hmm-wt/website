---
/**
 * Pause mark. Per Design System v1.0 section X.
 * Ellipsis with the third dot hollow. Mirrors the brand mark at sentence scale.
 * Inline use only, in long-form studio prose.
 * Renders three baseline-aligned dots in currentColor: two filled, one ring.
 */
interface Props {
  ariaLabel?: string;
}
const { ariaLabel = 'pause' } = Astro.props;
---
<span class="pause" role="img" aria-label={ariaLabel}>
  <span class="pause__dot"></span>
  <span class="pause__dot"></span>
  <span class="pause__dot pause__dot--hollow"></span>
</span>

<style>
  .pause {
    display: inline-flex;
    align-items: flex-end;
    gap: 3px;
    margin-inline: 0.15em;
    line-height: 1;
    vertical-align: baseline;
    padding-bottom: 0.12em;
  }
  .pause__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    display: inline-block;
  }
  .pause__dot--hollow {
    background: transparent;
    border: 1px solid currentColor;
    width: 5px;
    height: 5px;
    box-sizing: border-box;
  }
</style>
