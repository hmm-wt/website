---
/**
 * Five Necessities mark. Per Design System Section phi.
 * Each mark is a composition of the chart-glyph alphabet
 * (square, ring, triangle, bar, cross) rendered in currentColor.
 *
 * - food:       quincunx (five squares)
 * - biomedical: paired rings, offset
 * - power:      stacked bars, ascending
 * - autonomous: vector + trailing dot
 * - materials:  sealed cross, four stamps
 */
interface Props {
  kind: 'food' | 'biomedical' | 'power' | 'autonomous' | 'materials';
  size?: number;
  ariaLabel?: string;
}

const { kind, size = 32, ariaLabel } = Astro.props;

const labels: Record<Props['kind'], string> = {
  food: 'Food Security Systems',
  biomedical: 'Biomedical Systems',
  power: 'Power Systems',
  autonomous: 'Autonomous Systems',
  materials: 'Critical Materials and Supply Integrity',
};
const label = ariaLabel ?? labels[kind];
---
<svg
  class={`necmark necmark--${kind}`}
  data-mark={kind}
  viewBox="0 0 100 100"
  width={size}
  height={size}
  role="img"
  aria-label={label}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {kind === 'food' && (
    <g>
      {/* Quincunx of 5 squares: 4 corners + 1 centre */}
      <rect x="14" y="14" width="18" height="18" fill="currentColor" stroke="none" />
      <rect x="68" y="14" width="18" height="18" fill="currentColor" stroke="none" />
      <rect x="41" y="41" width="18" height="18" fill="currentColor" stroke="none" />
      <rect x="14" y="68" width="18" height="18" fill="currentColor" stroke="none" />
      <rect x="68" y="68" width="18" height="18" fill="currentColor" stroke="none" />
    </g>
  )}

  {kind === 'biomedical' && (
    <g>
      {/* Two offset rings. Bench and clinic. */}
      <circle cx="38" cy="50" r="26" />
      <circle cx="62" cy="50" r="26" />
    </g>
  )}

  {kind === 'power' && (
    <g>
      {/* Stacked bars ascending. Load capacity headroom. */}
      <rect x="14" y="64" width="22" height="10" fill="currentColor" stroke="none" />
      <rect x="14" y="48" width="40" height="10" fill="currentColor" stroke="none" />
      <rect x="14" y="32" width="58" height="10" fill="currentColor" stroke="none" />
      <rect x="14" y="16" width="76" height="10" fill="currentColor" stroke="none" />
    </g>
  )}

  {kind === 'autonomous' && (
    <g>
      {/* Vector triangle pointing right plus trailing dot. Direction and agency. */}
      <polygon points="40,18 86,50 40,82" fill="currentColor" stroke="none" />
      <circle cx="22" cy="50" r="6" fill="none" stroke="currentColor" stroke-width="2" />
    </g>
  )}

  {kind === 'materials' && (
    <g>
      {/* Sealed cross: square frame with diagonals. Assay, seal, checkpoint. */}
      <rect x="14" y="14" width="72" height="72" stroke-width="2" />
      <line x1="14" y1="14" x2="86" y2="86" stroke-width="2" />
      <line x1="86" y1="14" x2="14" y2="86" stroke-width="2" />
      {/* Four corner stamps */}
      <rect x="10" y="10" width="8" height="8" fill="currentColor" stroke="none" />
      <rect x="82" y="10" width="8" height="8" fill="currentColor" stroke="none" />
      <rect x="10" y="82" width="8" height="8" fill="currentColor" stroke="none" />
      <rect x="82" y="82" width="8" height="8" fill="currentColor" stroke="none" />
    </g>
  )}
</svg>

<style>
  .necmark {
    display: inline-block;
    vertical-align: middle;
    color: currentColor;
  }
</style>
