---
import necessityIndex from '../data/necessity-index.json';
import crystallisation from '../data/crystallisation-window.json';

const peakYear = Object.entries(crystallisation.year_counts as Record<string, number>)
  .sort((a, b) => b[1] - a[1])[0]?.[0] ?? '2027';

const cells = [
  { label: 'Companies classified', value: necessityIndex.universe.total_companies.toLocaleString('en-GB') },
  { label: 'Four-market regs', value: String(necessityIndex.universe.regulations_four_market) },
  { label: 'In flight', value: String(crystallisation.total_count) },
  { label: 'Window peak', value: peakYear }
];
---
<aside class="lss" aria-label="Research live status">
  <ul class="lss__list" role="list">
    {cells.map((c) => (
      <li class="lss__cell">
        <span class="lss__label">{c.label}</span>
        <span class="lss__value">{c.value}</span>
      </li>
    ))}
  </ul>
</aside>

<style>
  .lss {
    border-block: 1px solid var(--rule);
    padding-block: var(--s-3);
    margin-block: var(--s-6);
  }
  .lss__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s-4);
    margin: 0;
    padding: 0;
  }
  .lss__cell {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-inline: var(--s-3);
    border-inline-start: 1px solid var(--rule);
    min-width: 0;
  }
  .lss__cell:first-child { border-inline-start: 0; padding-inline-start: 0; }
  .lss__label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
  }
  .lss__value {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: 1;
    color: var(--c-tomato);
    letter-spacing: -0.01em;
  }

  @media (max-width: 900px) {
    .lss__list { grid-template-columns: repeat(2, 1fr); gap: var(--s-3); }
    .lss__cell:nth-child(3) { border-inline-start: 0; padding-inline-start: 0; }
  }
  @media (max-width: 480px) {
    .lss__list { grid-template-columns: 1fr; }
    .lss__cell { border-inline-start: 0; padding-inline-start: 0; }
  }
</style>
