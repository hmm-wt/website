---
interface Props {
  id: string;
  market: 'AU' | 'JP' | 'NZ' | 'SG';
  necessity: string;
  tier: 'T1' | 'T2';
  effective_year: number;
  status: string;
  title: string;
}

const { id, market, necessity, tier, effective_year, status, title } = Astro.props;
const marketLabel: Record<string, string> = { AU: 'Australia', JP: 'Japan', NZ: 'New Zealand', SG: 'Singapore' };
---
<li
  class="ce"
  id={id}
  data-market={market}
  data-necessity={necessity}
  data-tier={tier}
  data-year={effective_year}
>
  <div class="ce__year">{effective_year}</div>
  <div class="ce__body">
    <header class="ce__head">
      <span class="ce__market">[{market}]</span>
      <span class="ce__market-full">{marketLabel[market]}</span>
      <span class={`ce__tier ce__tier--${tier.toLowerCase()}`}>{tier}</span>
      <span class={`ce__status ce__status--${status}`}>{status.replace('_', ' ')}</span>
    </header>
    <h3 class="ce__title">{title}</h3>
    <p class="ce__necessity kicker">{necessity}</p>
  </div>
</li>

<style>
  .ce {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--s-4);
    padding: var(--s-5) 0;
    border-bottom: 1px solid var(--rule);
    list-style: none;
  }
  .ce:last-of-type { border-bottom: 0; }
  /* Ensure TagFilter's [hidden] attribute actually hides the entry.
     Without this, .ce's display: grid wins over the UA hidden default. */
  .ce[hidden] { display: none; }

  .ce__year {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: 1;
    color: var(--c-tomato);
  }

  .ce__body { display: flex; flex-direction: column; gap: var(--s-2); }

  .ce__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .ce__market { color: var(--c-tomato); font-weight: 600; }
  .ce__market-full { color: var(--fg-soft); }

  .ce__tier {
    padding: 0.1em 0.45em;
    font-weight: 600;
  }
  .ce__tier--t1 {
    background: color-mix(in srgb, var(--c-tomato) 14%, transparent);
    color: var(--c-tomato);
  }
  .ce__tier--t2 {
    background: color-mix(in srgb, var(--fg) 8%, transparent);
    color: var(--fg-soft);
  }

  .ce__status {
    padding: 0.1em 0.45em;
    font-weight: 500;
  }
  .ce__status--expected {
    background: color-mix(in srgb, var(--c-evergreen) 10%, transparent);
    color: var(--c-evergreen);
  }
  .ce__status--in_parliament,
  .ce__status--in.parliament {
    background: color-mix(in srgb, var(--c-tomato) 12%, transparent);
    color: var(--c-tomato);
  }
  .ce__status--enacted {
    background: color-mix(in srgb, var(--fg) 8%, transparent);
    color: var(--fg-soft);
  }

  .ce__title {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    margin: 0;
  }

  .ce__necessity { margin: 0; }

  @media (max-width: 640px) {
    .ce { grid-template-columns: 1fr; }
    .ce__year { font-size: var(--fs-xl); }
  }
</style>
