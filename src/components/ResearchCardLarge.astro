---
interface Metric { label: string; value: string }
interface Props {
  href: string;
  title: string;
  summary: string;
  date: string;
  version?: string;
  markets?: string[];
  necessities?: string[];
  pdfUrl?: string;
  pages?: number;
  index?: string;
  status?: 'live' | 'draft' | 'archived';
  headlineMetric?: Metric;
  sourceDataset?: string;
}

const {
  href, title, summary, date, version, markets, necessities,
  pdfUrl, pages, index, status = 'live', headlineMetric, sourceDataset
} = Astro.props;

const dateLabel = new Date(date).toLocaleDateString('en-GB', {
  year: 'numeric', month: 'short', day: '2-digit'
});
const ageDays = Math.floor((Date.now() - new Date(date).getTime()) / 86400000);
const freshness = ageDays < 30 ? 'New' : ageDays < 120 ? 'Recent' : null;

const faunaByMarket: Record<string, string> = {
  AU: '/fauna/hmm-fauna-au-wattle.svg',
  JP: '/fauna/hmm-fauna-jp-chrysanthemum.svg',
  NZ: '/fauna/hmm-fauna-nz-koru.svg',
  SG: '/fauna/hmm-fauna-sg-vanda.svg'
};
const fauna = (markets ?? [])
  .map((m) => faunaByMarket[m])
  .filter(Boolean) as string[];
---
<article class="rcl">
  <a class="rcl__link" href={href}>
    <div class="rcl__body">
      <header class="rcl__head">
        {index && <span class="rcl__idx">[{index}]</span>}
        <span class="rcl__type">Research</span>
        <span class={`rcl__status rcl__status--${status}`}>{status}</span>
        {freshness && <span class="rcl__fresh">{freshness}</span>}
        {version && <span class="rcl__version">{version}</span>}
      </header>
      <h3 class="rcl__title">{title} <span class="rcl__chev" aria-hidden="true">→</span></h3>
      <p class="rcl__summary">{summary}</p>
      <footer class="rcl__foot">
        <time datetime={date}>{dateLabel}</time>
        {pages && <span>{pages} pp</span>}
        {markets && markets.length > 0 && (
          <span class="rcl__markets">{markets.join(' · ')}</span>
        )}
        {sourceDataset && (
          <span class="rcl__source">Source: {sourceDataset}</span>
        )}
        {pdfUrl && (
          <a class="rcl__pdf" href={pdfUrl} download>PDF ↓</a>
        )}
      </footer>
    </div>
    {(headlineMetric || fauna.length > 0) && (
      <aside class="rcl__rail">
        {headlineMetric && (
          <div class="rcl__metric">
            <span class="rcl__metric-value">{headlineMetric.value}</span>
            <span class="rcl__metric-label">{headlineMetric.label}</span>
          </div>
        )}
        {fauna.length > 0 && (
          <div class="rcl__fauna" aria-hidden="true">
            {fauna.map((src) => (
              <img src={src} alt="" loading="lazy" />
            ))}
          </div>
        )}
        {necessities && necessities.length > 0 && (
          <ul class="rcl__necessities" role="list">
            {necessities.map((n) => (<li>{n}</li>))}
          </ul>
        )}
      </aside>
    )}
  </a>
</article>

<style>
  .rcl {
    border-top: 1px solid var(--rule);
    transition: background var(--dur-1) var(--ease);
  }
  .rcl:hover, .rcl:focus-within, .rcl:active {
    background: var(--bg-warm);
    --fg: var(--c-mahogany);
    --fg-soft: rgba(37, 0, 1, 0.7);
    --fg-faint: rgba(37, 0, 1, 0.5);
    --rule: rgba(4, 47, 42, 0.18);
    color: var(--fg);
  }
  .rcl:active { transform: scale(0.998); transition-duration: 80ms; }

  .rcl__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 18rem);
    gap: var(--s-6);
    padding: var(--s-7) var(--s-5);
    text-decoration: none;
    color: var(--fg);
  }
  .rcl__body { display: flex; flex-direction: column; gap: var(--s-3); }

  .rcl__head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    flex-wrap: wrap;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .rcl__idx { color: var(--c-tomato); font-weight: 600; }
  .rcl__type { color: var(--fg-soft); }
  .rcl__version { margin-inline-start: auto; color: var(--c-tomato); }
  .rcl__status {
    padding: 0.1em 0.5em;
    border: 1px solid currentColor;
    font-size: calc(var(--fs-xs) * 0.85);
    font-weight: 600;
  }
  .rcl__status--live { color: var(--c-tomato); }
  .rcl__status--draft { color: var(--fg-soft); }
  .rcl__status--archived { color: var(--fg-faint); }
  .rcl__fresh {
    padding: 0.1em 0.5em;
    background: var(--c-tomato);
    color: var(--c-pearl);
    font-size: calc(var(--fs-xs) * 0.85);
    font-weight: 600;
  }

  .rcl__title {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    letter-spacing: -0.015em;
    margin: 0;
    transition: color var(--dur-1) var(--ease);
  }
  .rcl__link:hover .rcl__title { color: var(--c-tomato); }
  .rcl__chev {
    display: inline-block;
    color: var(--c-tomato);
    margin-inline-start: 0.3em;
    transition: transform var(--transition);
  }
  .rcl__link:hover .rcl__chev { transform: translateX(4px); }

  .rcl__summary {
    font-size: var(--fs-lg);
    color: var(--fg-soft);
    max-width: 56ch;
    margin: 0;
    line-height: 1.5;
  }

  .rcl__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    align-items: baseline;
    margin-block-start: var(--s-3);
    padding-block-start: var(--s-3);
    border-top: 1px dashed var(--rule);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: var(--fg-soft);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .rcl__markets { color: var(--fg); }
  .rcl__source { color: var(--fg-faint); }
  .rcl__pdf {
    margin-inline-start: auto;
    color: var(--c-tomato);
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .rcl__pdf:hover { color: var(--fg); }

  .rcl__rail {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding-inline-start: var(--s-5);
    border-inline-start: 1px solid var(--rule);
  }
  .rcl__metric { display: flex; flex-direction: column; gap: 0.25rem; }
  .rcl__metric-value {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: 1;
    color: var(--c-tomato);
    letter-spacing: -0.02em;
  }
  .rcl__metric-label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
  }

  .rcl__fauna {
    display: flex;
    gap: var(--s-2);
    align-items: center;
    height: 2.25rem;
  }
  .rcl__fauna img {
    width: 1.75rem;
    height: 1.75rem;
    opacity: 0.85;
    filter: brightness(0) saturate(100%);
    /* Renders the SVGs in current text colour. */
  }
  .rcl:hover .rcl__fauna img { opacity: 1; }

  .rcl__necessities {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .rcl__necessities li {
    font-family: var(--f-mono);
    font-size: calc(var(--fs-xs) * 0.95);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-soft);
    border: 1px solid var(--rule);
    padding: 0.2em 0.5em;
  }

  @media (max-width: 900px) {
    .rcl__link {
      grid-template-columns: 1fr;
      gap: var(--s-4);
      padding: var(--s-6) var(--s-4);
    }
    .rcl__rail {
      padding-inline-start: 0;
      border-inline-start: 0;
      border-top: 1px dashed var(--rule);
      padding-block-start: var(--s-4);
    }
    .rcl__title { font-size: var(--fs-2xl); }
    .rcl__metric-value { font-size: var(--fs-2xl); }
  }
</style>
