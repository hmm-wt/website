---
/**
 * The shape of the universe. Five IM-anchored stats rendered as a row of
 * mono-stamp blocks. Sits directly under the hero on the homepage so the
 * reader sees the dataset shape before any further argument.
 */
import data from '../data/necessity-index.json';

const stats = [
  {
    value: data.universe.four_market_companies.toLocaleString('en-US'),
    label: 'Four-market classified universe',
    caption: 'AU · JP · NZ · SG'
  },
  {
    value: `${data.tier_shares.conservative_classifier_pct}%`,
    label: 'Pass conservative T1 / T2 screen',
    caption: `${data.tier_shares.conservative_classifier_count.toLocaleString('en-US')} companies in scope`
  },
  {
    value: data.stage_funnel[2].count.toLocaleString('en-US'),
    label: 'Seed-stage in scope',
    caption: `${data.stage_funnel[2].share_pct}% of the universe`
  },
  {
    value: data.universe.regulations_four_market.toString(),
    label: 'Regulations in target markets',
    caption: '117 T1 in the Five Necessities'
  },
  {
    value: data.crystallisation_window.in_flight_2024_2030.toString(),
    label: 'In-flight 2024 to 2030',
    caption: 'AU 11 · JP 11 · SG 10 · NZ 2'
  }
];
---
<section class="ss" aria-label="The shape of the four-market universe">
  <header class="ss__head">
    <p class="kicker ss__kicker">The shape</p>
  </header>
  <ol class="ss__list" role="list">
    {stats.map((s, i) => (
      <li class="ss__cell">
        <span class="ss__idx">[{String(i + 1).padStart(2, '0')}]</span>
        <p class="ss__value" data-count-up={s.value}>{s.value}</p>
        <p class="ss__label">{s.label}</p>
        <p class="ss__caption">{s.caption}</p>
      </li>
    ))}
  </ol>

  <script is:inline>
    // Count-up animation on scroll-into-view. Respects prefers-reduced-motion.
    (function () {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced || !('IntersectionObserver' in window)) return;
      const els = document.querySelectorAll('[data-count-up]');
      const animate = (el) => {
        const target = el.getAttribute('data-count-up');
        // Parse: extract numeric portion + suffix (e.g. "%", "x", or full value with commas)
        const m = target.match(/^([\d,\.]+)(.*)$/);
        if (!m) return;
        const finalNum = parseFloat(m[1].replace(/,/g, ''));
        const suffix = m[2];
        const decimals = (m[1].split('.')[1] || '').length;
        const dur = 900;
        const start = performance.now();
        const tick = (now) => {
          const t = Math.min(1, (now - start) / dur);
          // ease-out cubic
          const eased = 1 - Math.pow(1 - t, 3);
          const cur = finalNum * eased;
          const formatted = decimals > 0
            ? cur.toFixed(decimals)
            : Math.floor(cur).toLocaleString('en-US');
          el.textContent = formatted + suffix;
          if (t < 1) requestAnimationFrame(tick);
        };
        el.textContent = '0' + suffix;
        requestAnimationFrame(tick);
      };
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            animate(e.target);
            obs.unobserve(e.target);
          }
        });
      }, { threshold: 0.4 });
      els.forEach((el) => obs.observe(el));
    })();
  </script>
  <footer class="ss__foot">
    <p class="kicker">
      As of {data.as_of}  ·  IM v3.8.3  ·  sources on <a href="/doctrine/references/">/doctrine/references/</a>
    </p>
  </footer>
</section>

<style>
  .ss {
    padding-block: var(--s-7) var(--s-8);
    border-top: 1px solid color-mix(in srgb, var(--c-pearl) 18%, transparent);
    background: var(--c-evergreen);
    color: var(--c-pearl);
  }
  .ss__head { margin-block-end: var(--s-5); }
  .ss__kicker { color: var(--c-tomato); margin: 0; }

  .ss__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--s-5);
  }
  @media (max-width: 980px) { .ss__list { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .ss__list { grid-template-columns: 1fr; } }

  .ss__cell {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding-block: var(--s-3) var(--s-5);
    border-left: 2px solid var(--c-tomato);
    padding-inline-start: var(--s-4);
    transition: padding var(--mo-tick) var(--ease-golden);
  }
  .ss__cell:hover {
    padding-inline-start: calc(var(--s-4) + 4px);
  }

  .ss__idx {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-tomato);
    font-weight: 600;
  }

  .ss__value {
    font-family: var(--f-display);
    font-size: clamp(2.25rem, 1.5rem + 2.4vw, 3.5rem);
    line-height: 1;
    color: var(--c-pearl);
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .ss__label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--c-pearl) 75%, transparent);
    margin: 0;
    line-height: 1.4;
  }

  .ss__caption {
    font-family: var(--f-mono);
    font-size: calc(var(--fs-xs) * 0.92);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--c-pearl) 55%, transparent);
    margin: 0;
  }

  .ss__foot {
    margin-block-start: var(--s-6);
    padding-block-start: var(--s-4);
    border-top: 1px solid color-mix(in srgb, var(--c-pearl) 14%, transparent);
  }
  .ss__foot .kicker {
    text-transform: none;
    letter-spacing: 0;
    font-family: var(--f-mono);
    color: color-mix(in srgb, var(--c-pearl) 55%, transparent);
  }
  .ss__foot a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .ss__foot a:hover { color: var(--c-pearl); border-bottom-color: var(--c-pearl); }
</style>
