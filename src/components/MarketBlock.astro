---
/**
 * Four-market block. Per-market card with flower mark, name, headline
 * counts, and a link to /thesis/[market]/. Used on the homepage.
 */
import JurisdictionMark from './JurisdictionMark.astro';
import data from '../data/necessity-index.json';

const slugByMarket: Record<'AU' | 'JP' | 'NZ' | 'SG', string> = {
  AU: 'australia',
  JP: 'japan',
  NZ: 'new-zealand',
  SG: 'singapore',
};

const markets = data.per_market.map((m) => ({
  code: m.market as 'AU' | 'JP' | 'NZ' | 'SG',
  name: m.code,
  companies: m.companies,
  regulations: m.regulations,
  t1: m.t1,
  t2: m.t2,
  slug: slugByMarket[m.market as 'AU' | 'JP' | 'NZ' | 'SG'],
}));
---
<section class="mb">
  <header class="mb__head">
    <p class="kicker mb__kicker">The four markets</p>
    <h2 class="mb__title">Australia. Japan. New Zealand. Singapore.</h2>
    <p class="mb__lede">
      Developed APAC at emerging-market entry prices. Each market has built deep regulatory architecture in the Five Necessities and is in active enforcement transition through 2024 to 2030.
    </p>
  </header>

  <ol class="mb__list" role="list">
    {markets.map((m) => (
      <li class="mb__cell">
        <a href={`/thesis/${m.slug}/`} class="mb__link">
          <header class="mb__cell-head">
            <span class="mb__cell-mark"><JurisdictionMark market={m.code} size={48} /></span>
            <span class="mb__cell-code">{m.code}</span>
          </header>
          <p class="mb__cell-name">{m.name}</p>
          <dl class="mb__cell-stats">
            {m.companies && (
              <div class="mb__cell-stat">
                <dt>Classified</dt>
                <dd>{m.companies.toLocaleString('en-US')}</dd>
              </div>
            )}
            <div class="mb__cell-stat">
              <dt>Regulations</dt>
              <dd>{m.regulations}</dd>
            </div>
            <div class="mb__cell-stat">
              <dt>T1 / T2</dt>
              <dd>{m.t1} / {m.t2}</dd>
            </div>
          </dl>
          <footer class="mb__cell-foot">Why {m.name} →</footer>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .mb {
    padding-block: var(--s-8);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .mb__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-end: var(--s-7);
    max-width: 56ch;
  }
  .mb__kicker { color: var(--c-tomato); margin: 0; }
  .mb__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: 0;
  }
  .mb__lede {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    color: var(--fg-soft);
    line-height: var(--lh-snug);
    margin: 0;
  }

  .mb__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }
  @media (max-width: 980px) { .mb__list { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .mb__list { grid-template-columns: 1fr; } }

  .mb__cell {
    border-left: 1px solid var(--rule);
  }
  .mb__cell:first-child { border-left: 0; }
  @media (max-width: 980px) {
    .mb__cell:nth-child(3) { border-left: 0; border-top: 1px solid var(--rule); }
    .mb__cell:nth-child(4) { border-top: 1px solid var(--rule); }
  }
  @media (max-width: 560px) {
    .mb__cell { border-left: 0; border-top: 1px solid var(--rule); }
    .mb__cell:first-child { border-top: 0; }
  }

  .mb__link {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-5) var(--s-5);
    text-decoration: none;
    color: var(--fg);
    height: 100%;
    transition: background var(--mo-hold) var(--ease-golden);
  }
  .mb__link:hover { background: color-mix(in srgb, var(--c-tomato) 8%, transparent); }

  .mb__cell-head {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }
  .mb__cell-mark { color: var(--c-tomato); display: inline-flex; }
  .mb__cell-code {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-tomato);
    font-weight: 600;
  }

  .mb__cell-name {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-tight);
    margin: 0;
    color: var(--fg);
  }

  .mb__cell-stats {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    margin: 0;
    padding-block-start: var(--s-3);
    border-top: 1px solid var(--rule);
  }
  .mb__cell-stat {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .mb__cell-stat dt { color: var(--fg-soft); margin: 0; }
  .mb__cell-stat dd { color: var(--c-pearl); margin: 0; font-weight: 600; }

  .mb__cell-foot {
    margin-block-start: auto;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-tomato);
  }
  .mb__link:hover .mb__cell-foot { color: var(--c-pearl); }
</style>
