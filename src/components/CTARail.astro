---
/**
 * CTARail. Single CTA strip at the foot of a page.
 *
 * Two columns: allocator action + founder action. Replaces the old paths
 * grid and the duplicated /#lps + /#founders sections.
 */
import { buildContactMailto, buildLpMeetingMailto } from '../utils/mailto.ts';

const lpMailto = buildLpMeetingMailto();
const founderMailto = buildContactMailto('Founder intro');
---
<section class="cta-rail container" aria-label="Get in touch">
  <div class="cta-rail__col" id="lps">
    <p class="kicker cta-rail__kicker">If you allocate capital</p>
    <h2 class="cta-rail__title">Discuss the market map.</h2>
    <p class="cta-rail__lede">
      A short note on the office, the mandate, and what you have read.
    </p>
    <a class="cta-rail__cta" href={lpMailto}>Request a meeting &rarr;</a>
  </div>

  <div class="cta-rail__divider" aria-hidden="true"></div>

  <div class="cta-rail__col" id="founders">
    <p class="kicker cta-rail__kicker">If you build what people need</p>
    <h2 class="cta-rail__title">Tell us what you are building.</h2>
    <p class="cta-rail__lede">
      Heal, power, move, supply, eat. Read the doctrine before sending a deck.
    </p>
    <a class="cta-rail__cta" href={founderMailto}>Tell us more &rarr;</a>
  </div>
</section>

<style>
  .cta-rail {
    padding-block: var(--s-8);
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    gap: var(--s-7);
    max-width: 72rem;
    border-top: var(--hair) solid var(--hair-color);
    border-bottom: var(--hair) solid var(--hair-color);
    margin-block: var(--s-8);
    scroll-margin-top: var(--s-7);
  }
  .cta-rail__col {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    max-width: 36ch;
    scroll-margin-top: var(--s-7);
  }
  .cta-rail__divider {
    background: var(--hair-color);
    width: 1px;
    align-self: stretch;
  }
  .cta-rail__kicker { color: var(--c-tomato); margin: 0; }
  .cta-rail__title {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-tight);
    margin: 0;
    color: var(--fg);
  }
  .cta-rail__lede {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    color: var(--fg-soft);
    margin: 0;
  }
  .cta-rail__cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding: 0.875rem var(--s-5);
    background: var(--c-tomato);
    color: var(--c-pearl);
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    transition: background var(--mo-tick) var(--ease-golden);
    margin-block-start: var(--s-3);
  }
  .cta-rail__cta:hover,
  .cta-rail__cta:active { background: var(--c-mahogany); }

  @media (max-width: 800px) {
    .cta-rail {
      grid-template-columns: 1fr;
    }
    .cta-rail__divider {
      width: 100%;
      height: 1px;
    }
  }
</style>
