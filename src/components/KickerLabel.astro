---
interface Props {
  /** Index number, e.g. "01" → renders as [01]. Omit for label-only. */
  index?: string;
  /** Label text. Rendered uppercase mono. */
  label?: string;
  /** Optional href turns the kicker into an anchor. */
  href?: string;
  /** Use tomato accent (default) or inherit current colour. */
  accent?: boolean;
}

const { index, label, href, accent = true } = Astro.props;
const Tag = href ? 'a' : 'span';
---
<Tag
  class={`kicker-label ${accent ? 'is-accent' : ''}`}
  href={href}
>
  {index && <span class="kicker-label__idx">[{index}]</span>}
  {label && <span class="kicker-label__text">{label}</span>}
  <slot />
</Tag>

<style>
  .kicker-label {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    color: var(--fg-soft);
    line-height: 1.4;
  }
  .kicker-label.is-accent .kicker-label__idx {
    color: var(--c-tomato);
    font-weight: 600;
  }
  a.kicker-label:hover {
    color: var(--c-tomato);
  }
</style>
