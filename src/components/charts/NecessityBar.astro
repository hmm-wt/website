---
/**
 * NecessityBar (WEB-F). 1:1 port of web_necessity_bar() in CIM/html/charts.py.
 * Per-Necessity Necessities-aligned company count. Tomato on the leader (Biomedical).
 */
import IMFigure from '../IMFigure.astro';

interface Row { label: string; count: number }
const rows: Row[] = [
  { label: 'Biomedical Systems',           count: 1269 },
  { label: 'Power Systems',                count: 581 },
  { label: 'Autonomous Systems',           count: 561 },
  { label: 'Critical Materials & Supply',  count: 505 },
  { label: 'Food Security Systems',        count: 395 }
];

const W = 800;
const H = 280;
const ml = 200, mr = 90, mt = 30, mb = 40;
const iw = W - ml - mr;
const ih = H - mt - mb;
const maxX = Math.max(...rows.map((r) => r.count)) * 1.10;
const rowH = ih / rows.length;
const ticks = [250, 500, 750, 1000, 1250];
const maxCount = Math.max(...rows.map((r) => r.count));
---
<IMFigure
  fignum="WEB-F"
  label="Companies by Necessity · Cohort view"
  title='<em>Biomedical Systems</em> leads at 1,269. Four others between 395 and 581.'
  sub="Company count by Necessity across the four-market base. T1 + T2 classifier applied. The Biomedical concentration anchors the heal Necessity."
  metrics={[
    { label: 'BIOMEDICAL',        value: '1,269', ci: 'Heal · largest cohort', accent: true },
    { label: 'POWER',             value: '581',   ci: 'Grid + storage + DER' },
    { label: 'AUTONOMOUS',        value: '561',   ci: 'Move + logistics' },
    { label: 'FOOD + MATERIALS',  value: '900',   ci: 'Eat + supply combined' }
  ]}
  source="hmm Ventures classified dataset"
  basis="Companies by Necessity · T1 + T2 classifier · Four-market base"
>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="xMidYMid meet"
    style="width:100%;height:auto;display:block;"
    role="img"
    aria-label="Companies by Necessity: Biomedical leads at 1,269; Power, Autonomous, Critical Materials, and Food Security each between 395 and 581."
  >
    <line x1={ml} y1={mt} x2={ml} y2={mt + ih} stroke="var(--mahogany)" stroke-width="0.6" />
    <line x1={ml} y1={mt + ih} x2={ml + iw} y2={mt + ih} stroke="var(--mahogany)" stroke-width="0.6" />

    {ticks.map((v) => {
      const x = ml + (v / maxX) * iw;
      return (
        <g>
          <line x1={x} y1={mt} x2={x} y2={mt + ih} stroke="var(--rule)" stroke-width="0.4" stroke-dasharray="1 2" />
          <text x={x} y={mt + ih + 14} text-anchor="middle" fill="var(--muted)" font-family="var(--mono)" font-size="7">{v.toLocaleString('en-GB')}</text>
        </g>
      );
    })}

    {rows.map((r, i) => {
      const y = mt + i * rowH + rowH / 2;
      const barH = rowH * 0.50;
      const bw = (r.count / maxX) * iw;
      const isTop = r.count === maxCount;
      const col = isTop ? 'var(--tomato)' : 'var(--dark-teal)';
      const op = isTop ? '0.80' : '0.30';
      const weight = isTop ? '700' : '500';
      return (
        <g>
          <text x={ml - 10} y={y + 3} text-anchor="end" fill={col} font-family="var(--mono)" font-size="8.5" font-weight={weight}>{r.label}</text>
          <rect x={ml} y={y - barH / 2} width={bw} height={barH} fill={col} opacity={op} />
          <text x={ml + bw + 8} y={y + 3} fill={col} font-family="var(--mono)" font-size="9" font-weight={weight}>{r.count.toLocaleString('en-GB')}</text>
        </g>
      );
    })}

    <text x={ml + iw / 2} y={mt + ih + 30} text-anchor="middle" fill="var(--ink)" font-family="var(--mono)" font-size="7" letter-spacing="0.16em" font-weight="700">IN-THESIS COMPANIES · FOUR-MARKET</text>
  </svg>
</IMFigure>
