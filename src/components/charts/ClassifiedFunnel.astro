---
/**
 * ClassifiedFunnel — inline port of web_classified_funnel() from CIM/html/charts.py.
 * Four-step trapezoidal funnel from 22,217 global → 2,625 seed-stage in-thesis.
 *
 * Data binds to src/data/necessity-index.json so refreshes flow through automatically.
 *
 * Motion hooks:
 *  - .funnel-row.stagger-row data-i="0..3" on each trapezoid row group
 *  - .ticker-roll on count values (consumed by primitives.ts later)
 */
import IMFigure from '../IMFigure.astro';
import data from '../../data/necessity-index.json';

const counts = {
  global: data.universe.total_companies,
  fourMarket: data.universe.four_market_companies,
  inThesis: data.tier_shares.conservative_classifier_count,
  seed: data.stage_funnel[2].count,
};

const steps = [
  { label: 'Global universe', count: counts.global, ci: 'Crunchbase + Dealroom four-market base' },
  { label: 'Four-market companies', count: counts.fourMarket, ci: 'Geographic filter applied' },
  { label: 'In thesis (T1 + T2)', count: counts.inThesis, ci: `Conservative classifier · ${data.tier_shares.conservative_classifier_pct}%` },
  { label: 'Seed-stage in thesis', count: counts.seed, ci: `Stage filter · ${data.stage_funnel[2].share_pct}% of four-market` },
];

const W = 800;
const H = 320;
const ml = 180, mr = 220, mt = 30, mb = 30;
const iw = W - ml - mr;
const ih = H - mt - mb;
const maxCount = steps[0].count;
const n = steps.length;
const rowH = ih / n;
const gap = 6;

// Pre-compute trapezoid points and label positions
const rows = steps.map((s, i) => {
  const isTerminal = i === n - 1;
  const isThesis = i === n - 2;
  const fill = isTerminal || isThesis ? 'var(--c-tomato)' : 'var(--c-dark-teal)';
  const op = isTerminal ? 0.85 : isThesis ? 0.55 : 0.30;
  const weight = isTerminal || isThesis ? 700 : 500;
  const textCol = isTerminal || isThesis ? 'var(--c-tomato)' : 'var(--c-mahogany)';

  const topW = (s.count / maxCount) * iw;
  const nextCount = i + 1 < n ? steps[i + 1].count : s.count * 0.7;
  const botW = i + 1 < n ? (nextCount / maxCount) * iw : topW * 0.92;
  const cx = ml + iw / 2;
  const y0 = mt + i * rowH + gap / 2;
  const y1 = mt + (i + 1) * rowH - gap / 2;
  const labelY = (y0 + y1) / 2 + 3;
  const xTl = cx - topW / 2;
  const xTr = cx + topW / 2;
  const xBl = cx - botW / 2;
  const xBr = cx + botW / 2;

  return {
    ...s,
    i, fill, op, weight, textCol,
    points: `${xTl.toFixed(1)},${y0.toFixed(1)} ${xTr.toFixed(1)},${y0.toFixed(1)} ${xBr.toFixed(1)},${y1.toFixed(1)} ${xBl.toFixed(1)},${y1.toFixed(1)}`,
    labelY,
    countX: ml + iw + 16,
    labelX: ml - 16,
  };
});
---
<IMFigure
  fignum="WEB-E"
  label="Classified universe · Four-step funnel"
  title={`From 22,217 global companies to <em>${counts.seed.toLocaleString('en-US')}</em> seed-stage in-thesis targets.`}
  sub="Geographic filter narrows to four-market base. Conservative classifier applies the T1/T2 test. Stage filter isolates seed-priced rounds."
  metrics={[
    { label: 'GLOBAL UNIVERSE', value: counts.global.toLocaleString('en-US'), ci: 'Pre-filter base' },
    { label: 'FOUR-MARKET', value: counts.fourMarket.toLocaleString('en-US'), ci: 'Geographic filter' },
    { label: 'IN THESIS', value: counts.inThesis.toLocaleString('en-US'), ci: `T1 + T2 · ${data.tier_shares.conservative_classifier_pct}%` },
    { label: 'SEED-STAGE', value: counts.seed.toLocaleString('en-US'), ci: 'Pipeline base', accent: true },
  ]}
  source={`hmm Ventures Comprehensive Classified Dataset · ${data.as_of} snapshot`}
  basis="Four-step funnel · Crunchbase + Dealroom four-market base"
>
  <svg
    class="cf"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label="Classification funnel: 22,217 global companies narrow to 2,625 seed-stage four-market in-thesis targets."
  >
    {rows.map((r) => (
      <g class="cf__row stagger-row" data-i={r.i}>
        <polygon
          points={r.points}
          fill={r.fill}
          opacity={r.op}
          stroke={r.fill}
          stroke-width="0.6"
          stroke-opacity="0.6"
        />
        <text
          x={r.labelX}
          y={r.labelY}
          text-anchor="end"
          fill="var(--c-mahogany)"
          font-family="var(--f-mono)"
          font-size="9"
          font-weight="600"
        >{r.label}</text>
        <text
          class="ticker-roll"
          x={r.countX}
          y={r.labelY - 3}
          fill={r.textCol}
          font-family="var(--f-mono)"
          font-size="12"
          font-weight={r.weight}
        >{r.count.toLocaleString('en-US')}</text>
        <text
          x={r.countX}
          y={r.labelY + 11}
          fill="var(--imfig-muted)"
          font-family="var(--f-mono)"
          font-size="7"
          letter-spacing="0.04em"
        >{r.ci}</text>
      </g>
    ))}
  </svg>
</IMFigure>

<style>
  .cf { width: 100%; height: auto; display: block; }
</style>
