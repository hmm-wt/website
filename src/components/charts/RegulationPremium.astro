---
/**
 * Regulation Premium horizontal bar chart. Inline SVG.
 * Ports CIM/html/charts.py web_regulation_premium.
 * Voice: "barrier", not "moat".
 */
import IMFigure from '../IMFigure.astro';

interface Row {
  label: string;
  lo: number;
  hi: number;
  isReg: boolean;
}

const rows: Row[] = [
  { label: 'Regulated-sector software', lo: 14.0, hi: 17.0, isReg: true },
  { label: 'Healthcare AI (FDA-aligned)', lo: 5.0, hi: 10.0, isReg: true },
  { label: 'All software M&A (EBITDA)', lo: 10.2, hi: 10.2, isReg: false },
  { label: 'BVP Cloud Index avg', lo: 5.8, hi: 5.8, isReg: false },
  { label: 'Standard SaaS median', lo: 3.4, hi: 3.4, isReg: false },
];

const W = 800, H = 280;
const ml = 220, mr = 70, mt = 30, mb = 50;
const iw = W - ml - mr;
const ih = H - mt - mb;
const maxX = 18.0;
const rowH = ih / rows.length;

const sx = (v: number) => ml + (v / maxX) * iw;
---
<IMFigure
  fignum="WEB-A"
  label="Regulation premium · EV / Revenue multiples"
  title='Regulated sectors trade at <em>5–17x</em>. Standard SaaS at 3.4x.'
  sub="Regulation creates a barrier. The barrier widens the multiple. Compliance frameworks lift exit valuations across regulated-sector software and FDA-aligned healthcare AI."
  metrics={[
    { label: 'Regulated software', value: '14–17x', ci: 'EV / Revenue', accent: true },
    { label: 'Healthcare AI', value: '5–10x', ci: 'FDA-aligned' },
    { label: 'All software M&A', value: '10.2x', ci: 'EBITDA basis' },
    { label: 'Standard SaaS', value: '3.4x', ci: 'Median multiple' },
  ]}
  source="Public M&A comparables · Bessemer Cloud Index · SaaS Capital"
  basis="EV / Revenue · EBITDA where labelled · 4-market dataset"
>
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label="Regulated sectors trade at 5–17x EV/Revenue versus 3.4–5.8x for unregulated software" class="rp__svg">
    <line x1={ml} y1={mt} x2={ml} y2={mt + ih} class="rp__spine" />
    <line x1={ml} y1={mt + ih} x2={ml + iw} y2={mt + ih} class="rp__spine" />

    {[5, 10, 15].map((v) => {
      const x = sx(v);
      return (
        <>
          <line x1={x} y1={mt} x2={x} y2={mt + ih} class="rp__grid" />
          <text x={x} y={mt + ih + 14} text-anchor="middle" class="rp__tick">{v}x</text>
        </>
      );
    })}

    {rows.map((r, i) => {
      const y = mt + i * rowH + rowH / 2;
      const barH = rowH * 0.42;
      const xLo = sx(r.lo);
      const xHi = sx(r.hi);
      const colorClass = r.isReg ? 'rp__bar--reg' : 'rp__bar--base';
      const labelClass = r.isReg ? 'rp__label--reg' : 'rp__label--base';
      return (
        <>
          <text x={ml - 10} y={y + 3} text-anchor="end" class={`rp__row-label ${labelClass}`}>{r.label}</text>
          {r.hi > r.lo ? (
            <>
              <rect x={xLo} y={y - barH / 2} width={xHi - xLo} height={barH} class={`rp__bar ${colorClass}`} />
              <text x={xHi + 8} y={y + 3} class={`rp__val rp__val--reg`}>{r.lo.toFixed(0)}–{r.hi.toFixed(0)}x</text>
            </>
          ) : (
            <>
              <rect x={ml} y={y - barH / 2} width={xHi - ml} height={barH} class={`rp__bar ${colorClass}`} />
              <text x={xHi + 8} y={y + 3} class={`rp__val ${labelClass}`}>{r.hi.toFixed(1)}x</text>
            </>
          )}
        </>
      );
    })}

    <text x={ml + iw / 2} y={mt + ih + 34} text-anchor="middle" class="rp__axis-title">EV / REVENUE MULTIPLE (EBITDA WHERE NOTED)</text>
  </svg>
</IMFigure>

<style>
  .rp__svg { width: 100%; height: auto; display: block; }
  .rp__spine { stroke: var(--c-mahogany); stroke-width: 0.6; }
  .rp__grid { stroke: rgba(4, 47, 42, 0.18); stroke-width: 0.4; stroke-dasharray: 1 2; }
  .rp__tick { fill: rgba(37, 0, 1, 0.66); font-family: var(--f-mono); font-size: 8px; }
  .rp__row-label { font-family: var(--f-mono); font-size: 9px; }
  .rp__label--reg { fill: var(--c-tomato); font-weight: 700; }
  .rp__label--base { fill: rgba(37, 0, 1, 0.66); font-weight: 400; }
  .rp__bar--reg { fill: var(--c-tomato); opacity: 0.75; }
  .rp__bar--base { fill: rgba(10, 74, 64, 0.45); }
  .rp__val { font-family: var(--f-mono); font-size: 10px; font-weight: 700; }
  .rp__val--reg { fill: var(--c-tomato); }
  .rp__axis-title { fill: var(--c-mahogany); font-family: var(--f-mono); font-size: 8px; letter-spacing: 0.16em; font-weight: 700; }
</style>
