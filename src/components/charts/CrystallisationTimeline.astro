---
/**
 * CrystallisationTimeline.
 *
 * Horizontal multi-lane timeline of in-flight regulations across the four
 * target markets (AU · JP · NZ · SG), 2024–2030. Each regulation renders as
 * a button-marker on its market lane at its effective-year column. Hover /
 * focus a marker → annotation panel below updates with title, necessity,
 * tier, and effective year.
 *
 * Data source: src/data/crystallisation-window.json.
 *
 * Keyboard: tab through markers in DOM order; left/right arrows move within
 * a lane. Marker click opens the source modal (existing chart-zoom).
 *
 * Sits inside an IMFigure with bleed="wide" so it spans 72rem on desktop.
 */
import calendar from '../../data/crystallisation-window.json';

interface Props {
  /** Optional filter to a single market lane. */
  market?: 'AU' | 'JP' | 'NZ' | 'SG';
}

const { market: filterMarket } = Astro.props;

const yearStart = 2024;
const yearEnd = 2030;
const years = Array.from({ length: yearEnd - yearStart + 1 }, (_, i) => yearStart + i);

const markets = (filterMarket ? [filterMarket] : ['AU', 'JP', 'NZ', 'SG']) as Array<'AU' | 'JP' | 'NZ' | 'SG'>;
const marketLabel: Record<string, string> = {
  AU: 'Australia',
  JP: 'Japan',
  NZ: 'New Zealand',
  SG: 'Singapore',
};

const regs = calendar.regulations
  .filter((r) => !filterMarket || r.market === filterMarket)
  .filter((r) => r.effective_year >= yearStart && r.effective_year <= yearEnd)
  .sort((a, b) => a.effective_year - b.effective_year);

// NOW position: today as a fraction across the year axis.
const now = new Date();
const startMs = new Date(yearStart, 0, 1).getTime();
const endMs = new Date(yearEnd + 1, 0, 1).getTime();
const nowMs = now.getTime();
const nowPct = Math.max(0, Math.min(100, ((nowMs - startMs) / (endMs - startMs)) * 100));

// Bucket regs by market+year so we can stack markers within a cell.
type Reg = (typeof calendar.regulations)[number];
const cells: Record<string, Reg[]> = {};
regs.forEach((r) => {
  const key = `${r.market}-${r.effective_year}`;
  (cells[key] ||= []).push(r as Reg);
});

// Per-year totals across all visible lanes for the axis density read.
const yearTotals: Record<number, number> = {};
regs.forEach((r) => {
  yearTotals[r.effective_year] = (yearTotals[r.effective_year] ?? 0) + 1;
});
const maxYearCount = Math.max(1, ...Object.values(yearTotals));

const totalCount = regs.length;
---
<div class="cwt" data-cwt-root>
  <header class="cwt__head">
    <p class="cwt__eyebrow">
      <span class="cwt__num">{totalCount}</span>
      <span class="cwt__label">in-flight regulations · {yearStart}–{yearEnd}</span>
    </p>
  </header>

  <div class="cwt__board" role="group" aria-label="Crystallisation window timeline">
    <div class="cwt__axis" aria-hidden="true">
      {years.map((y) => {
        const count = yearTotals[y] ?? 0;
        const intensity = count / maxYearCount;
        return (
          <span class="cwt__year" style={`--cwt-year-intensity: ${intensity.toFixed(3)}`} data-year={y}>
            <span class="cwt__year-num">{y}</span>
            {count > 0 && <span class="cwt__year-count">{count}</span>}
            <span class="cwt__year-bar" aria-hidden="true"></span>
          </span>
        );
      })}
    </div>

    <div class="cwt__lanes">
      <span class="cwt__now" style={`left: ${nowPct.toFixed(2)}%`} aria-hidden="true">
        <span class="cwt__now-label">NOW</span>
      </span>

      {markets.map((m) => (
        <div class="cwt__lane" data-lane={m}>
          <span class="cwt__lane-label">{m}</span>
          <div class="cwt__lane-track" role="list" aria-label={`${marketLabel[m]} regulations`}>
            {years.map((y) => {
              const items = cells[`${m}-${y}`] ?? [];
              if (!items.length) return null;
              const left = ((y - yearStart + 0.5) / (yearEnd - yearStart + 1)) * 100;
              return (
                <div class="cwt__cell" style={`left: ${left.toFixed(2)}%`}>
                  {items.map((r) => (
                    <button
                      type="button"
                      class:list={['cwt__mark', `cwt__mark--${r.tier.toLowerCase()}`]}
                      data-id={r.id}
                      data-title={r.title}
                      data-necessity={r.necessity}
                      data-tier={r.tier}
                      data-year={r.effective_year}
                      data-market={r.market}
                      data-status={r.status}
                      aria-label={`${r.title}, ${marketLabel[r.market]} ${r.tier}, ${r.effective_year}`}
                    >
                      <span class="cwt__mark-dot" aria-hidden="true"></span>
                    </button>
                  ))}
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </div>

  <output class="cwt__panel" data-cwt-panel aria-live="polite">
    <p class="cwt__panel-hint" data-cwt-hint>Hover or focus a marker for detail.</p>
    <div class="cwt__panel-body" data-cwt-body hidden>
      <p class="cwt__panel-top">
        <span class="cwt__panel-year" data-cwt-year></span>
        <span class="cwt__panel-market" data-cwt-market></span>
        <span class="cwt__panel-tier" data-cwt-tier></span>
      </p>
      <p class="cwt__panel-title" data-cwt-title></p>
      <p class="cwt__panel-necessity" data-cwt-necessity></p>
    </div>
  </output>

  <footer class="cwt__legend" aria-hidden="true">
    <span class="cwt__legend-item"><span class="cwt__mark-dot cwt__mark-dot--t1"></span> T1 · licence-as-barrier</span>
    <span class="cwt__legend-item"><span class="cwt__mark-dot cwt__mark-dot--t2"></span> T2 · regulated</span>
  </footer>
</div>

<script>
  import '../../scripts/imfig-reveal';

  function initTimeline(root: HTMLElement) {
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const panel = root.querySelector<HTMLElement>('[data-cwt-panel]');
    const body = root.querySelector<HTMLElement>('[data-cwt-body]');
    const hint = root.querySelector<HTMLElement>('[data-cwt-hint]');
    const yearEl = root.querySelector<HTMLElement>('[data-cwt-year]');
    const marketEl = root.querySelector<HTMLElement>('[data-cwt-market]');
    const tierEl = root.querySelector<HTMLElement>('[data-cwt-tier]');
    const titleEl = root.querySelector<HTMLElement>('[data-cwt-title]');
    const necEl = root.querySelector<HTMLElement>('[data-cwt-necessity]');
    if (!panel || !body || !hint || !yearEl || !marketEl || !tierEl || !titleEl || !necEl) return;

    const marks = Array.from(root.querySelectorAll<HTMLButtonElement>('.cwt__mark'));

    const show = (btn: HTMLButtonElement) => {
      yearEl.textContent = btn.dataset.year ?? '';
      marketEl.textContent = btn.dataset.market ?? '';
      tierEl.textContent = btn.dataset.tier ?? '';
      titleEl.textContent = btn.dataset.title ?? '';
      necEl.textContent = btn.dataset.necessity ?? '';
      hint.hidden = true;
      body.hidden = false;
      marks.forEach((m) => m.removeAttribute('data-active'));
      btn.setAttribute('data-active', 'true');
    };

    marks.forEach((btn) => {
      btn.addEventListener('mouseenter', () => show(btn));
      btn.addEventListener('focus', () => show(btn));
      btn.addEventListener('click', () => show(btn));
    });

    // Scrolly integration: when the nearest [data-scrolly] container changes
    // its data-active-stage attribute (a year string), highlight that column.
    const scrollyRoot = root.closest('[data-scrolly]') as HTMLElement | null;
    if (scrollyRoot) {
      const applyYear = () => {
        const year = scrollyRoot.getAttribute('data-active-stage');
        root.setAttribute('data-active-year', year ?? '');
      };
      applyYear();
      const obs = new MutationObserver(applyYear);
      obs.observe(scrollyRoot, { attributes: true, attributeFilter: ['data-active-stage'] });
      scrollyRoot.addEventListener('scrolly:enter', applyYear);
    }

    // TagFilter integration: when a sibling TagFilter on the same page
    // emits tagfilter:change, dim non-matching markers in step with the
    // filter applied to the year-list below.
    document.addEventListener('tagfilter:change', ((e: Event) => {
      const detail = (e as CustomEvent).detail as Record<string, string[]>;
      const filterMarket = (detail.market ?? []).join(',');
      const filterTier = (detail.tier ?? []).join(',');
      const filterNecessity = (detail.necessity ?? []).join(',');
      root.setAttribute('data-filter-market', filterMarket);
      root.setAttribute('data-filter-tier', filterTier);
      root.setAttribute('data-filter-necessity', filterNecessity);
      // Per-marker matching done in JS (CSS [attr~=] on comma-list is awkward
      // when multiple filters combine).
      marks.forEach((btn) => {
        const m = btn.dataset.market ?? '';
        const t = btn.dataset.tier ?? '';
        const n = btn.dataset.necessity ?? '';
        const marketOk = !filterMarket || filterMarket.split(',').includes(m);
        const tierOk = !filterTier || filterTier.split(',').includes(t);
        const necOk = !filterNecessity || filterNecessity.split(',').includes(n);
        btn.classList.toggle('cwt__mark--filtered-out', !(marketOk && tierOk && necOk));
      });
    }) as EventListener);

    // Arrow-key navigation within a lane (left/right siblings).
    root.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (!(t instanceof HTMLButtonElement) || !t.classList.contains('cwt__mark')) return;
      const lane = t.closest('[data-lane]');
      if (!lane) return;
      const laneMarks = Array.from(lane.querySelectorAll<HTMLButtonElement>('.cwt__mark'));
      const idx = laneMarks.indexOf(t);
      if (idx < 0) return;
      let next: HTMLButtonElement | null = null;
      if (e.key === 'ArrowRight' && idx < laneMarks.length - 1) next = laneMarks[idx + 1];
      else if (e.key === 'ArrowLeft' && idx > 0) next = laneMarks[idx - 1];
      if (next) {
        e.preventDefault();
        next.focus();
      }
    });
  }

  function bootTimelines() {
    document.querySelectorAll<HTMLElement>('[data-cwt-root]').forEach(initTimeline);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootTimelines);
  } else {
    bootTimelines();
  }
  document.addEventListener('astro:page-load', bootTimelines);
</script>

<style>
  .cwt {
    --cwt-pearl: var(--c-pearl);
    --cwt-evergreen: var(--c-evergreen);
    --cwt-tomato: var(--c-tomato);
    --cwt-rule: rgba(4, 47, 42, 0.18);
    font-family: var(--f-mono);
    color: var(--c-mahogany);
  }

  .cwt__head {
    margin-block-end: var(--s-4);
  }
  .cwt__eyebrow {
    display: flex;
    gap: var(--s-3);
    align-items: baseline;
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--cwt-evergreen);
    margin: 0;
  }
  .cwt__num { color: var(--cwt-tomato); font-weight: 700; font-size: var(--fs-base); }
  .cwt__label { color: color-mix(in srgb, var(--c-mahogany) 66%, transparent); }

  .cwt__board {
    position: relative;
    padding-block: var(--s-4) var(--s-3);
  }

  .cwt__axis {
    display: grid;
    grid-template-columns: 3rem repeat(7, 1fr);
    align-items: end;
    padding-block-end: var(--s-3);
    border-bottom: 1px solid var(--cwt-rule);
    font-size: calc(var(--fs-xs) * 0.92);
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--c-mahogany) 58%, transparent);
  }
  .cwt__year {
    grid-column: span 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    position: relative;
  }
  .cwt__axis .cwt__year:first-of-type { grid-column-start: 2; }
  .cwt__year-num {
    font-family: var(--f-mono);
    font-size: calc(var(--fs-xs) * 0.92);
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--c-mahogany) 58%, transparent);
  }
  .cwt__year-count {
    font-family: var(--f-display);
    font-size: calc(var(--fs-base) * (0.78 + 0.42 * var(--cwt-year-intensity, 0)));
    line-height: 1;
    font-weight: 600;
    color: color-mix(in srgb, var(--cwt-tomato) calc(60% + 35% * var(--cwt-year-intensity, 0)), var(--c-mahogany));
  }
  .cwt__year-bar {
    display: block;
    height: 3px;
    width: 0;
    background: linear-gradient(90deg,
      color-mix(in srgb, var(--cwt-tomato) calc(35% + 50% * var(--cwt-year-intensity, 0)), transparent),
      color-mix(in srgb, var(--cwt-tomato) calc(15% + 45% * var(--cwt-year-intensity, 0)), transparent));
    margin-block-start: 2px;
    transition: width 720ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cwt[data-imfig-revealed="true"] .cwt__year-bar {
    width: calc(45% + 50% * var(--cwt-year-intensity, 0));
  }
  .cwt__year-count {
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 480ms var(--ease-golden, ease-out), transform 480ms var(--ease-golden, ease-out);
  }
  .cwt[data-imfig-revealed="true"] .cwt__year-count {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .cwt__year-bar { transition: none; width: calc(45% + 50% * var(--cwt-year-intensity, 0)); }
    .cwt__year-count { transition: none; opacity: 1; transform: none; }
  }
  /* When a year is active via scrolly, lift its axis tile. */
  .cwt[data-active-year="2024"] .cwt__year[data-year="2024"] .cwt__year-num,
  .cwt[data-active-year="2025"] .cwt__year[data-year="2025"] .cwt__year-num,
  .cwt[data-active-year="2026"] .cwt__year[data-year="2026"] .cwt__year-num,
  .cwt[data-active-year="2027"] .cwt__year[data-year="2027"] .cwt__year-num,
  .cwt[data-active-year="2028"] .cwt__year[data-year="2028"] .cwt__year-num,
  .cwt[data-active-year="2030"] .cwt__year[data-year="2030"] .cwt__year-num {
    color: var(--cwt-tomato);
    font-weight: 700;
  }

  .cwt__lanes {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding-block-start: var(--s-3);
  }

  .cwt__lane {
    display: grid;
    grid-template-columns: 3rem 1fr;
    align-items: center;
    min-height: 2.25rem;
  }
  .cwt__lane-label {
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    color: var(--cwt-tomato);
    font-weight: 700;
  }
  .cwt__lane-track {
    position: relative;
    height: 100%;
    min-height: 2rem;
    border-top: 1px dashed color-mix(in srgb, var(--c-mahogany) 14%, transparent);
  }

  .cwt__now {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
    border-left: 1px solid var(--cwt-tomato);
    z-index: 4;
    pointer-events: none;
    /* Offset by axis label column. */
    margin-left: 3rem;
    transform: translateX(-1px);
    /* Constrain to track area, not full board. */
  }
  .cwt__now-label {
    position: absolute;
    top: -1.3rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--cwt-tomato);
    color: var(--c-pearl);
    font-size: calc(var(--fs-xs) * 0.85);
    letter-spacing: 0.18em;
    padding: 0.15rem 0.4rem;
    white-space: nowrap;
  }

  .cwt__cell {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .cwt__mark {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 4px;
    cursor: pointer;
    line-height: 0;
  }
  .cwt__mark:focus { outline: none; }
  .cwt__mark:focus-visible .cwt__mark-dot {
    box-shadow: 0 0 0 2px var(--c-pearl), 0 0 0 4px var(--cwt-tomato);
  }
  .cwt__mark[data-active="true"] .cwt__mark-dot {
    transform: scale(1.4);
  }

  .cwt__mark-dot {
    display: inline-block;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--cwt-tomato);
    border: 1px solid var(--c-mahogany);
    transition: transform var(--mo-tick, 160ms) var(--ease-golden, ease-out);
  }
  .cwt__mark--t2 .cwt__mark-dot {
    background: color-mix(in srgb, var(--c-mahogany) 18%, var(--c-pearl));
    border-color: color-mix(in srgb, var(--c-mahogany) 35%, transparent);
  }
  .cwt__mark-dot--t1 { background: var(--cwt-tomato); border: 1px solid var(--c-mahogany); }
  .cwt__mark-dot--t2 {
    background: color-mix(in srgb, var(--c-mahogany) 18%, var(--c-pearl));
    border: 1px solid color-mix(in srgb, var(--c-mahogany) 35%, transparent);
  }
  .cwt__mark:hover .cwt__mark-dot { transform: scale(1.3); }

  /* TagFilter integration: markers filtered out by sibling filters dim. */
  .cwt__mark--filtered-out {
    opacity: 0.18;
    transition: opacity 240ms var(--ease-golden, ease-out);
  }
  .cwt__mark--filtered-out .cwt__mark-dot {
    transform: scale(0.85);
  }
  @media (prefers-reduced-motion: reduce) {
    .cwt__mark--filtered-out { transition: none; }
  }

  /* Scrolly-driven year highlight: when [data-active-year="YYYY"] is set on
   * the timeline root, markers whose data-year matches stay full opacity and
   * non-matching markers fade. The axis year label highlights too. */
  .cwt[data-active-year]:not([data-active-year=""]) .cwt__mark {
    opacity: 0.28;
    transition: opacity 280ms var(--ease-golden, ease-out);
  }
  .cwt[data-active-year="2024"] .cwt__mark[data-year="2024"],
  .cwt[data-active-year="2025"] .cwt__mark[data-year="2025"],
  .cwt[data-active-year="2026"] .cwt__mark[data-year="2026"],
  .cwt[data-active-year="2027"] .cwt__mark[data-year="2027"],
  .cwt[data-active-year="2028"] .cwt__mark[data-year="2028"],
  .cwt[data-active-year="2030"] .cwt__mark[data-year="2030"] {
    opacity: 1;
  }
  .cwt[data-active-year="2024"] .cwt__mark[data-year="2024"] .cwt__mark-dot,
  .cwt[data-active-year="2025"] .cwt__mark[data-year="2025"] .cwt__mark-dot,
  .cwt[data-active-year="2026"] .cwt__mark[data-year="2026"] .cwt__mark-dot,
  .cwt[data-active-year="2027"] .cwt__mark[data-year="2027"] .cwt__mark-dot,
  .cwt[data-active-year="2028"] .cwt__mark[data-year="2028"] .cwt__mark-dot,
  .cwt[data-active-year="2030"] .cwt__mark[data-year="2030"] .cwt__mark-dot {
    transform: scale(1.25);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--cwt-tomato) 24%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .cwt[data-active-year]:not([data-active-year=""]) .cwt__mark {
      transition: none;
    }
  }

  .cwt__panel {
    display: block;
    margin-block-start: var(--s-5);
    padding: var(--s-4);
    background: color-mix(in srgb, var(--c-pearl) 96%, var(--c-mahogany));
    border-left: 2px solid var(--cwt-tomato);
    min-height: 5rem;
  }
  .cwt__panel-hint {
    margin: 0;
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--c-mahogany) 55%, transparent);
  }
  .cwt__panel-top {
    margin: 0 0 var(--s-2);
    display: flex;
    gap: var(--s-3);
    align-items: baseline;
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .cwt__panel-year { color: var(--cwt-tomato); font-weight: 700; }
  .cwt__panel-market { color: color-mix(in srgb, var(--c-mahogany) 70%, transparent); }
  .cwt__panel-tier {
    margin-inline-start: auto;
    padding: 0.1em 0.5em;
    background: color-mix(in srgb, var(--cwt-tomato) 18%, transparent);
    color: var(--cwt-tomato);
    font-weight: 700;
  }
  .cwt__panel-title {
    margin: 0;
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: 1.25;
    color: var(--c-mahogany);
  }
  .cwt__panel-necessity {
    margin: var(--s-2) 0 0;
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--c-mahogany) 60%, transparent);
  }

  .cwt__legend {
    margin-block-start: var(--s-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    font-size: calc(var(--fs-xs) * 0.92);
    color: color-mix(in srgb, var(--c-mahogany) 60%, transparent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cwt__legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (max-width: 720px) {
    .cwt__axis { grid-template-columns: 2.5rem repeat(7, 1fr); font-size: calc(var(--fs-xs) * 0.82); }
    .cwt__lane { grid-template-columns: 2.5rem 1fr; }
    .cwt__now { margin-left: 2.5rem; }
    .cwt__mark-dot { width: 0.75rem; height: 0.75rem; }
    .cwt__panel-title { font-size: var(--fs-md); }
  }
</style>
