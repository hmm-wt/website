---
/**
 * RegClockStrip (WEB-H). 1:1 port of web_reg_clock_strip() in
 * CIM/html/charts.py. Compact regulatory-clock strip for the home hero.
 */
import IMFigure from '../IMFigure.astro';

interface Marker { code: string; year: number; desc: string }
const markers: Marker[] = [
  { code: 'AUS', year: 2026.3, desc: 'TGA UDI · APRA CPS' },
  { code: 'NZL', year: 2026.9, desc: 'Therapeutic Products Act' },
  { code: 'JPN', year: 2027.0, desc: 'AI Promotion · PMDA SaMD' },
  { code: 'SIN', year: 2027.5, desc: 'LTA AV Framework' }
];

const W = 800;
const H = 110;
const ml = 30, mr = 30, mt = 38, mb = 28;
const iw = W - ml - mr;
const ih = H - mt - mb;
const axisY = mt + ih / 2;
const yearMin = 2024;
const yearMax = 2030;
const sx = (yr: number) => ml + ((yr - yearMin) / (yearMax - yearMin)) * iw;
const nowX = sx(2026.4);
const years = [2024, 2025, 2026, 2027, 2028, 2029, 2030];
---
<IMFigure
  fignum="WEB-H"
  label="Regulatory clock · Crystallisation window"
  title='Four markets crystallise between <em>2026 and 2027</em>.'
  sub="Peak-density regulatory events across the four markets, plotted on a single axis. The fund deploys against this clock."
  metrics={[
    { label: 'AUS', value: '2026', ci: 'TGA UDI · APRA CPS' },
    { label: 'NZL', value: '2026', ci: 'Therapeutic Products Act' },
    { label: 'JPN', value: '2027', ci: 'PMDA SaMD · AI Promotion', accent: true },
    { label: 'SIN', value: '2027', ci: 'LTA AV Framework' }
  ]}
  source="hmm Ventures regulatory dataset · effective-date midpoints"
  basis="Peak density per market · Four-market scope · 2024 to 2030"
>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="xMidYMid meet"
    style="width:100%;height:auto;display:block;"
    role="img"
    aria-label="Regulatory clock: AUS 2026, NZL 2026, JPN 2027, SIN 2027. NOW marker at 2026."
  >
    <line x1={ml} y1={axisY} x2={ml + iw} y2={axisY} stroke="var(--mahogany)" stroke-width="0.6" />
    {years.map((yr) => (
      <g>
        <line x1={sx(yr)} y1={axisY - 3} x2={sx(yr)} y2={axisY + 3} stroke="var(--mahogany)" stroke-width="0.6" />
        <text x={sx(yr)} y={axisY + 18} text-anchor="middle" fill="var(--muted)" font-family="var(--mono)" font-size="7">{yr}</text>
      </g>
    ))}

    <line x1={nowX} y1={mt - 4} x2={nowX} y2={axisY + 10} stroke="var(--tomato)" stroke-width="1.0" stroke-dasharray="3 3" />
    <text x={nowX} y={mt - 8} text-anchor="middle" fill="var(--tomato)" font-family="var(--mono)" font-size="7" font-weight="700" letter-spacing="0.16em">NOW</text>

    {markers.map((m) => {
      const x = sx(m.year);
      return (
        <g>
          <circle cx={x} cy={axisY} r="4" fill="var(--tomato)" opacity="0.85" />
          <text x={x} y={axisY - 12} text-anchor="middle" fill="var(--tomato)" font-family="var(--mono)" font-size="8.5" font-weight="700" letter-spacing="0.12em">{m.code}</text>
        </g>
      );
    })}
  </svg>
</IMFigure>
