---
/**
 * UnitDotGrid. Generic N-mark unit chart.
 *
 * Each mark is one entity (one company, one regulation, one exit).
 * Pudding pattern: encode individuals, then highlight one as hero.
 *
 * Three rendering modes:
 *   - 'dots' (default): circle marks
 *   - 'squares': rect marks (denser, used for >500 marks)
 *
 * Heroes are drawn last so they sit on top.
 */
interface Mark {
  /** Optional id (used as React key equivalent). */
  id?: string;
  /** When true, mark uses hero color. */
  hero?: boolean;
  /** Optional opacity override 0..1. Otherwise inherits cohort tier. */
  alpha?: number;
}

interface Props {
  marks: Mark[];
  cols?: number;
  /** Total svg width. Height auto-derived from rows x markSize. */
  width?: number;
  markSize?: number;
  gap?: number;
  shape?: 'dots' | 'squares';
  /** Cohort tier (1..4). Higher = brighter. Default 2. */
  cohortTier?: 1 | 2 | 3 | 4;
  /** Aria label for the whole grid. */
  ariaLabel?: string;
}

const {
  marks,
  cols = 80,
  width = 960,
  markSize,
  gap = 1,
  shape = 'dots',
  cohortTier = 2,
  ariaLabel,
} = Astro.props;

const ms = markSize ?? Math.max(2, Math.floor((width - (cols - 1) * gap) / cols));
const rows = Math.ceil(marks.length / cols);
const height = rows * (ms + gap);

const cohortVar = `var(--cohort-${cohortTier})`;
---
<svg
  class="unit-dot-grid"
  viewBox={`0 0 ${width} ${height}`}
  width="100%"
  height={height}
  preserveAspectRatio="xMinYMin meet"
  role="img"
  aria-label={ariaLabel}
>
  {/* Cohort marks first */}
  {marks.map((m, i) => {
    if (m.hero) return null;
    const col = i % cols;
    const row = Math.floor(i / cols);
    const x = col * (ms + gap);
    const y = row * (ms + gap);
    const fill = cohortVar;
    const opacity = m.alpha ?? 1;
    if (shape === 'squares') {
      return <rect x={x} y={y} width={ms} height={ms} fill={fill} opacity={opacity} />;
    }
    return <circle cx={x + ms / 2} cy={y + ms / 2} r={ms / 2} fill={fill} opacity={opacity} />;
  })}
  {/* Hero marks on top */}
  {marks.map((m, i) => {
    if (!m.hero) return null;
    const col = i % cols;
    const row = Math.floor(i / cols);
    const x = col * (ms + gap);
    const y = row * (ms + gap);
    if (shape === 'squares') {
      return <rect x={x} y={y} width={ms} height={ms} fill="var(--hero)" />;
    }
    return <circle cx={x + ms / 2} cy={y + ms / 2} r={ms / 2} fill="var(--hero)" />;
  })}
</svg>

<style>
  .unit-dot-grid { display: block; }
</style>
