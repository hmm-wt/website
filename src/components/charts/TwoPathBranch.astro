---
/**
 * TwoPathBranch (WEB-I). 1:1 port of web_two_path_branch() in
 * CIM/html/charts.py. Two-path branching: Crystallisation vs Fragmentation.
 */
import IMFigure from '../IMFigure.astro';

const W = 800;
const H = 360;
const rootX = W / 2;
const rootY = 70;
const branchY = 200;
const leftX = 200;
const rightX = 600;
const endY = 300;
---
<IMFigure
  fignum="WEB-I"
  label="Two paths · Crystallisation vs Fragmentation"
  title='The doctrine bets <em>Path A</em>. Path B falsifies it.'
  sub="The regulatory build is in flight across four markets. Either the regimes converge enough to form a tradeable T1/T2 universe, or they fragment. The doctrine plays Crystallisation; the Scoreboard makes Fragmentation falsifiable."
  metrics={[
    { label: 'PATH A', value: 'Crystallisation', ci: 'Deploys here', accent: true },
    { label: 'PATH B', value: 'Fragmentation',   ci: 'Doctrine fails' },
    { label: 'TEST',   value: 'By 2028',         ci: 'Scoreboard window' },
    { label: 'BASE',   value: '2,625 cos',       ci: 'Seed-stage Necessities-aligned' }
  ]}
  source="The Necessity Doctrine · Chapter 09 (Path A) · Chapter 10 (Path B)"
  basis="Binary outcome · Both paths publicly tracked on the Scoreboard"
>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="xMidYMid meet"
    style="width:100%;height:auto;display:block;"
    role="img"
    aria-label="Two-path branching: Crystallisation (the doctrine plays here) versus Fragmentation (falsified by 2028 if regimes diverge)."
  >
    <path d={`M ${rootX},${rootY + 30} Q ${rootX},${branchY - 20} ${leftX},${branchY - 10}`} fill="none" stroke="var(--tomato)" stroke-width="2" opacity="0.85" />
    <path d={`M ${rootX},${rootY + 30} Q ${rootX},${branchY - 20} ${rightX},${branchY - 10}`} fill="none" stroke="var(--mahogany)" stroke-width="1.2" opacity="0.30" stroke-dasharray="4 3" />

    <line x1={leftX}  y1={branchY + 44} x2={leftX}  y2={endY - 10} stroke="var(--tomato)"   stroke-width="2"   opacity="0.85" />
    <line x1={rightX} y1={branchY + 44} x2={rightX} y2={endY - 10} stroke="var(--mahogany)" stroke-width="1.2" opacity="0.30" stroke-dasharray="4 3" />

    <rect x={rootX - 130} y={rootY - 22} width="260" height="56" rx="3" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.2" />
    <text x={rootX} y={rootY - 4}  text-anchor="middle" fill="var(--muted)" font-family="var(--mono)"  font-size="7"  letter-spacing="0.14em" font-weight="700">TODAY</text>
    <text x={rootX} y={rootY + 15} text-anchor="middle" fill="var(--ink)"   font-family="var(--serif)" font-style="normal" font-size="12">The regulatory build is in flight</text>

    <rect x={leftX - 90} y={branchY - 10} width="180" height="54" rx="3" fill="var(--paper)" stroke="var(--tomato)" stroke-width="1.4" />
    <text x={leftX} y={branchY + 6}  text-anchor="middle" fill="var(--tomato)" font-family="var(--mono)"  font-size="8"  letter-spacing="0.14em" font-weight="700">PATH A</text>
    <text x={leftX} y={branchY + 24} text-anchor="middle" fill="var(--tomato)" font-family="var(--serif)" font-style="normal" font-size="13" font-weight="700">Crystallisation</text>
    <text x={leftX} y={branchY + 38} text-anchor="middle" fill="var(--ink)"    font-family="var(--mono)"  font-size="7.5">Four markets harden</text>

    <rect x={leftX - 90} y={endY - 10} width="180" height="54" rx="3" fill="var(--tomato)" opacity="0.92" />
    <text x={leftX} y={endY + 6}  text-anchor="middle" fill="var(--pearl)" font-family="var(--mono)"  font-size="7"  letter-spacing="0.14em" font-weight="700">DEPLOYS HERE</text>
    <text x={leftX} y={endY + 24} text-anchor="middle" fill="var(--pearl)" font-family="var(--serif)" font-style="normal" font-size="12">T1 / T2 Necessities-aligned</text>
    <text x={leftX} y={endY + 38} text-anchor="middle" fill="var(--pearl)" font-family="var(--mono)"  font-size="7.5" opacity="0.9">2,625 seed-stage targets</text>

    <rect x={rightX - 90} y={branchY - 10} width="180" height="54" rx="3" fill="var(--paper)" stroke="var(--mahogany)" stroke-width="1" stroke-dasharray="3 2" />
    <text x={rightX} y={branchY + 6}  text-anchor="middle" fill="var(--muted)" font-family="var(--mono)"  font-size="8"  letter-spacing="0.14em" font-weight="700">PATH B</text>
    <text x={rightX} y={branchY + 24} text-anchor="middle" fill="var(--muted)" font-family="var(--serif)" font-style="normal" font-size="13" font-weight="500">Fragmentation</text>
    <text x={rightX} y={branchY + 38} text-anchor="middle" fill="var(--muted)" font-family="var(--mono)"  font-size="7.5">Regimes diverge · mandate breaks</text>

    <rect x={rightX - 90} y={endY - 10} width="180" height="54" rx="3" fill="var(--paper)" stroke="var(--mahogany)" stroke-width="0.8" stroke-dasharray="3 2" opacity="0.50" />
    <text x={rightX} y={endY + 6}  text-anchor="middle" fill="var(--muted)" font-family="var(--mono)"  font-size="7"  letter-spacing="0.14em" font-weight="700">SCOREBOARD TEST</text>
    <text x={rightX} y={endY + 24} text-anchor="middle" fill="var(--muted)" font-family="var(--serif)" font-style="normal" font-size="12">Falsifiable by 2028</text>
    <text x={rightX} y={endY + 38} text-anchor="middle" fill="var(--muted)" font-family="var(--mono)"  font-size="7.5">Five public claims</text>
  </svg>
</IMFigure>
