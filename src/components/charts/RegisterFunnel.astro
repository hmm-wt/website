---
/**
 * RegisterFunnel. Canvas dot-matrix funnel.
 *
 * The signature device: each stage count is DRAWN from the company dots
 * themselves. Every lit pixel in "6,505" is a company that survived the
 * regulation filter. The number is made of the cohort it counts.
 *
 * Stages (driven by the shared scrolly.ts engine via data-active-stage on
 * the closest [data-scrolly] ancestor):
 *   s1 -> 19,416  universe, all dots, neutral pearl
 *   s2 ->  6,505  survive the T1/T2 filter, reform in tomato; rest recede
 *   s3 ->  2,625  seed-stage subset reforms
 *   s4 ->     25  portfolio cluster
 *
 * Each cut is a strict subset of the prior, matching the funnel semantics.
 * Survivors carry an illustrative tier / Necessity / market so hovering a
 * dot can state why it survived. Market chips re-filter the universe.
 *
 * Single canvas, rAF, DPR-capped. Reduced motion renders the final-state
 * formation once with no loop. Numbers are wired from necessity-index.json
 * so the canon figures are never re-keyed here.
 */
import indexData from '../../data/necessity-index.json';

interface Props {
  ariaLabel?: string;
}
const { ariaLabel = 'Funnel from 19,416 four-market companies to a 25-company portfolio. Each dot is one company; the surviving dots form each stage count.' } = Astro.props;

const universe = indexData.universe.four_market_companies;          // 19416
const passFilter = indexData.tier_shares.conservative_classifier_count; // 6505
const seedStage = 2625;                                              // stage_funnel[2] canon
const portfolio = 25;
const t1 = indexData.tier_shares.t1_count;                          // 5556
const t2 = indexData.tier_shares.t2_count;                          // 949
const markets = indexData.per_market;                              // AU/JP/NZ/SG with company counts

// Serialised to the client as a data attribute so the canon never gets
// re-typed in the script body.
const config = {
  universe, passFilter, seedStage, portfolio, t1, t2,
  markets: markets.map((m) => ({ code: m.market, name: m.code, companies: m.companies })),
  necessities: indexData.per_necessity.map((n) => ({ name: n.name, n: n.in_thesis_companies })),
};
---
<div class="rf" data-register-funnel data-config={JSON.stringify(config)}>
  <canvas class="rf__canvas" aria-hidden="true"></canvas>

  <div class="rf__tip" data-rf-tip hidden role="status" aria-live="polite"></div>

  <div class="rf__controls" data-rf-markets aria-label="Filter the universe by market">
    {markets.map((m) => (
      <button type="button" class="rf__chip" data-market={m.market} aria-pressed="true">
        {m.market}
      </button>
    ))}
  </div>

  <!-- Text equivalent of the funnel for assistive tech and no-JS. -->
  <p class="rf__sr">
    Classified universe {universe.toLocaleString('en-GB')} four-market companies.
    {passFilter.toLocaleString('en-GB')} sit behind a Tier 1 licence or Tier 2 compulsion barrier.
    {seedStage.toLocaleString('en-GB')} of those are seed-stage and in the five Necessities.
    {portfolio} enter the portfolio.
  </p>
</div>

<style>
  .rf {
    position: relative;
    width: 100%;
    container-type: inline-size;
  }
  .rf__canvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 4;
    /* Sits on the section ground; no border, no chrome. */
  }

  .rf__tip {
    position: absolute;
    top: 0;
    left: 0;
    transform: translate(-50%, calc(-100% - 10px));
    pointer-events: none;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    line-height: 1.3;
    letter-spacing: 0.02em;
    color: var(--c-pearl);
    background: var(--c-mahogany);
    border: var(--hair) solid var(--rule-strong);
    padding: 0.45rem 0.6rem;
    max-width: 24ch;
    white-space: normal;
    z-index: 3;
  }
  .rf__tip[hidden] { display: none; }

  .rf__controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-block-start: var(--s-4);
  }
  .rf__chip {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    min-height: var(--tap-min);
    padding: 0.35rem 0.8rem;
    color: var(--c-pearl);
    background: transparent;
    border: var(--hair) solid var(--rule);
    cursor: pointer;
    transition: color var(--mo-tick) var(--ease-golden),
                border-color var(--mo-tick) var(--ease-golden),
                background var(--mo-tick) var(--ease-golden);
  }
  .rf__chip[aria-pressed='true'] {
    color: var(--c-evergreen);
    background: var(--c-pearl);
    border-color: var(--c-pearl);
  }
  .rf__chip[aria-pressed='false'] {
    color: var(--fg-faint);
    border-color: var(--rule);
  }
  .rf__chip:hover { border-color: var(--c-tomato); }

  .rf__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .rf__canvas { aspect-ratio: 4 / 5; }
  }
</style>

<script>
  // ── 5x7 dot-matrix glyphs. 1 = lit. Comma carries a narrow advance width.
  const GLYPH: Record<string, string[]> = {
    '0': ['01110', '10001', '10011', '10101', '11001', '10001', '01110'],
    '1': ['00100', '01100', '00100', '00100', '00100', '00100', '01110'],
    '2': ['01110', '10001', '00001', '00010', '00100', '01000', '11111'],
    '3': ['11110', '00001', '00001', '01110', '00001', '00001', '11110'],
    '4': ['00010', '00110', '01010', '10010', '11111', '00010', '00010'],
    '5': ['11111', '10000', '11110', '00001', '00001', '10001', '01110'],
    '6': ['00110', '01000', '10000', '11110', '10001', '10001', '01110'],
    '7': ['11111', '00001', '00010', '00100', '01000', '01000', '01000'],
    '8': ['01110', '10001', '10001', '01110', '10001', '10001', '01110'],
    '9': ['01110', '10001', '10001', '01111', '00001', '00010', '01100'],
    ',': ['00000', '00000', '00000', '00000', '00000', '00100', '01100'],
  };
  const GLYPH_W: Record<string, number> = { ',': 2 };
  const ROWS = 7;

  type Cfg = {
    universe: number; passFilter: number; seedStage: number; portfolio: number;
    t1: number; t2: number;
    markets: { code: string; name: string; companies: number }[];
    necessities: { name: string; n: number }[];
  };

  type Dot = {
    v: number;            // 0..1 survivorship rank. Lower survives further.
    market: number;       // index into cfg.markets
    tier: 1 | 2;          // illustrative T1/T2 for survivors
    necessity: number;    // index into cfg.necessities
    x: number; y: number; // current px (canvas internal coords)
    tx: number; ty: number; // target px
    a: number; ta: number;  // current / target alpha
    hero: boolean;        // tomato vs pearl at current stage
  };

  const STAGE_NUM: Record<string, (c: Cfg) => number> = {
    s1: (c) => c.universe,
    s2: (c) => c.passFilter,
    s3: (c) => c.seedStage,
    s4: (c) => c.portfolio,
  };

  function litCells(text: string): { col: number; row: number }[] {
    const cells: { col: number; row: number }[] = [];
    let col = 0;
    for (const ch of text) {
      const g = GLYPH[ch];
      const w = GLYPH_W[ch] ?? 5;
      if (g) {
        for (let r = 0; r < ROWS; r++) {
          for (let cc = 0; cc < w; cc++) {
            if (g[r][cc] === '1') cells.push({ col: col + cc, row: r });
          }
        }
      }
      col += w + 1; // 1 col spacing
    }
    return cells;
  }
  function textWidthCols(text: string): number {
    let col = 0;
    for (const ch of text) col += (GLYPH_W[ch] ?? 5) + 1;
    return Math.max(1, col - 1);
  }

  class RegisterFunnel {
    el: HTMLElement;
    cfg: Cfg;
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    tip: HTMLElement | null;
    dots: Dot[] = [];
    stage = 's1';
    enabledMarkets: Set<number>;
    reduced: boolean;
    W = 0; H = 0; dpr = 1;
    dotR = 2;
    raf = 0;
    running = false;
    settleFrames = 0;
    colHero = '#C44539';
    colNeutral = 'rgba(242,236,201,0.82)';
    colDim = 'rgba(242,236,201,0.12)';
    hovered = -1;
    pointer: { x: number; y: number } | null = null;
    onResize: () => void;
    onMove: (e: PointerEvent) => void;
    onLeave: () => void;

    constructor(el: HTMLElement) {
      this.el = el;
      this.cfg = JSON.parse(el.dataset.config || '{}');
      this.canvas = el.querySelector('.rf__canvas') as HTMLCanvasElement;
      this.ctx = this.canvas.getContext('2d')!;
      this.tip = el.querySelector('[data-rf-tip]');
      this.enabledMarkets = new Set(this.cfg.markets.map((_, i) => i));
      this.reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const cs = getComputedStyle(document.documentElement);
      const read = (n: string, fb: string) => (cs.getPropertyValue(n).trim() || fb);
      this.colHero = read('--c-tomato', this.colHero);
      this.colNeutral = read('--cohort-ink', this.colNeutral);
      this.colDim = read('--cohort-1', this.colDim);

      this.buildDots();
      this.layout();

      // Discrete stage from the shared scrolly engine.
      const host = el.closest('[data-scrolly]');
      const initial = host?.getAttribute('data-active-stage');
      if (initial) this.stage = initial;
      host?.addEventListener('scrolly:enter', (e) => {
        const detail = (e as CustomEvent).detail;
        if (detail?.stage && STAGE_NUM[detail.stage]) this.setStage(detail.stage);
      });

      // Market chips.
      el.querySelectorAll<HTMLButtonElement>('.rf__chip').forEach((chip, i) => {
        chip.addEventListener('click', () => this.toggleMarket(i, chip));
      });

      this.onResize = () => { this.layout(); this.assignTargets(true); this.kick(); };
      window.addEventListener('resize', this.onResize, { passive: true });

      this.onMove = (e: PointerEvent) => this.handleHover(e);
      this.onLeave = () => { this.pointer = null; this.hovered = -1; this.hideTip(); };
      if (!this.reduced) {
        this.canvas.addEventListener('pointermove', this.onMove, { passive: true });
        this.canvas.addEventListener('pointerleave', this.onLeave);
      }

      this.assignTargets(true);
      if (this.reduced) {
        // Snap to target, draw once, no loop.
        this.dots.forEach((d) => { d.x = d.tx; d.y = d.ty; d.a = d.ta; });
        this.draw();
      } else {
        this.kick();
      }
    }

    destroy() {
      cancelAnimationFrame(this.raf);
      window.removeEventListener('resize', this.onResize);
      this.canvas.removeEventListener('pointermove', this.onMove);
      this.canvas.removeEventListener('pointerleave', this.onLeave);
    }

    // Dot population. Sample scaled to the true universe; counts on screen
    // are derived from this model so they stay honest to the visual.
    buildDots() {
      const isNarrow = window.innerWidth < 720;
      const N = isNarrow ? 1800 : 2600;
      const ms = this.cfg.markets;
      const totalCo = ms.reduce((s, m) => s + m.companies, 0);
      // Cumulative market thresholds for proportional assignment.
      const cum: number[] = [];
      let acc = 0;
      for (const m of ms) { acc += m.companies / totalCo; cum.push(acc); }
      const necc = this.cfg.necessities;
      const neccTotal = necc.reduce((s, n) => s + n.n, 0);
      const t1Share = this.cfg.t1 / (this.cfg.t1 + this.cfg.t2);

      this.dots = Array.from({ length: N }, (_, i) => {
        const v = (i + 0.5) / N; // even rank 0..1; deterministic, no Math.random
        // Market by proportional bands, jittered so it is not striped.
        const mr = ((i * 47) % N) / N;
        let market = 0;
        for (let k = 0; k < cum.length; k++) { if (mr <= cum[k]) { market = k; break; } market = cum.length - 1; }
        const tier: 1 | 2 = (((i * 31) % 1000) / 1000) < t1Share ? 1 : 2;
        // Necessity by share.
        const nr = ((i * 53) % neccTotal) / neccTotal;
        let necc_i = 0, na = 0;
        for (let k = 0; k < necc.length; k++) { na += necc[k].n / neccTotal; if (nr <= na) { necc_i = k; break; } necc_i = necc.length - 1; }
        return { v, market, tier, necessity: necc_i, x: 0, y: 0, tx: 0, ty: 0, a: 0, ta: 0, hero: false };
      });
    }

    layout() {
      const rect = this.canvas.getBoundingClientRect();
      this.dpr = Math.min(2, window.devicePixelRatio || 1);
      this.W = Math.max(1, Math.round(rect.width));
      this.H = Math.max(1, Math.round(rect.height));
      this.canvas.width = Math.round(this.W * this.dpr);
      this.canvas.height = Math.round(this.H * this.dpr);
      this.ctx.setTransform(this.dpr, 0, 0, this.dpr, 0, 0);
    }

    setStage(s: string) {
      if (s === this.stage) return;
      this.stage = s;
      this.assignTargets(false);
      this.kick();
    }

    toggleMarket(i: number, chip: HTMLButtonElement) {
      if (this.enabledMarkets.has(i)) {
        if (this.enabledMarkets.size === 1) return; // keep at least one
        this.enabledMarkets.delete(i);
        chip.setAttribute('aria-pressed', 'false');
      } else {
        this.enabledMarkets.add(i);
        chip.setAttribute('aria-pressed', 'true');
      }
      this.assignTargets(false);
      this.kick();
    }

    // Which dots are "active" (form the number) at the current stage and
    // market filter, and the count the number should read.
    activeAndCount(): { active: boolean[]; count: number } {
      const inScope = (d: Dot) => this.enabledMarkets.has(d.market);
      const scoped = this.dots.filter(inScope);
      const total = scoped.length;
      const scaleAll = this.cfg.universe / total; // dots -> companies for THIS scope

      let thresh = 1;
      if (this.stage === 's1') thresh = 1;
      else if (this.stage === 's2') thresh = this.cfg.passFilter / this.cfg.universe;
      else if (this.stage === 's3') thresh = this.cfg.seedStage / this.cfg.universe;
      else if (this.stage === 's4') thresh = -1; // handled below

      const active = this.dots.map((d) => false);
      let count = 0;

      if (this.stage === 's4') {
        // Lowest-v scoped dots become the portfolio.
        const order = scoped.slice().sort((a, b) => a.v - b.v);
        const k = this.allMarketsOn() ? this.cfg.portfolio
          : Math.max(1, Math.round(this.cfg.portfolio * (total / this.dots.length)));
        const chosen = new Set(order.slice(0, k));
        for (let i = 0; i < this.dots.length; i++) if (chosen.has(this.dots[i])) active[i] = true;
        count = k;
        return { active, count };
      }

      for (let i = 0; i < this.dots.length; i++) {
        const d = this.dots[i];
        if (!inScope(d)) continue;
        if (d.v <= thresh) { active[i] = true; }
      }
      const activeScoped = scoped.filter((d) => d.v <= thresh).length;
      // At full scope the canon figure is exact; when filtered, derive from the model.
      if (this.allMarketsOn()) {
        count = STAGE_NUM[this.stage](this.cfg);
      } else {
        count = Math.round(activeScoped * scaleAll * (this.stage === 's1' ? 1 : 1));
      }
      return { active, count };
    }

    allMarketsOn() { return this.enabledMarkets.size === this.cfg.markets.length; }

    assignTargets(immediate: boolean) {
      const { active, count } = this.activeAndCount();
      const text = count.toLocaleString('en-GB');
      const cells = litCells(text);
      const cols = textWidthCols(text);

      // Cell geometry: fit the glyph block to ~78% width, centred.
      const targetW = this.W * 0.78;
      let cell = targetW / cols;
      // Cap height so tall single-glyph stages ("25") do not blow up.
      const maxCellH = (this.H * 0.62) / ROWS;
      cell = Math.min(cell, maxCellH);
      const blockW = cols * cell;
      const blockH = ROWS * cell;
      const ox = (this.W - blockW) / 2;
      const oy = (this.H - blockH) / 2;

      const activeIdx: number[] = [];
      const idleIdx: number[] = [];
      for (let i = 0; i < this.dots.length; i++) (active[i] ? activeIdx : idleIdx).push(i);

      // Candidate sub-points inside each lit cell, dense enough for the dots.
      const m = activeIdx.length;
      const L = Math.max(1, cells.length);
      const k = Math.max(1, Math.ceil(Math.sqrt(m / L)));
      const candidates: { x: number; y: number }[] = [];
      for (const c of cells) {
        for (let ry = 0; ry < k; ry++) {
          for (let rx = 0; rx < k; rx++) {
            const jx = (rx + 0.5) / k;
            const jy = (ry + 0.5) / k;
            candidates.push({ x: ox + (c.col + jx) * cell, y: oy + (c.row + jy) * cell });
          }
        }
      }
      // Assign active dots evenly across candidates (sorted by v for stable core).
      activeIdx.sort((a, b) => this.dots[a].v - this.dots[b].v);
      const C = candidates.length;
      const dotR = Math.max(1.1, cell / k * 0.42);
      this.dotR = dotR;
      for (let j = 0; j < activeIdx.length; j++) {
        const d = this.dots[activeIdx[j]];
        const cand = candidates[Math.floor((j * C) / Math.max(1, m)) % C];
        d.tx = cand.x; d.ty = cand.y;
        d.ta = 1;
        d.hero = this.stage !== 's1';
      }

      // Idle dots recede to a faint background field across the canvas.
      const fieldCols = Math.ceil(Math.sqrt(idleIdx.length * (this.W / this.H)));
      const fieldRows = Math.ceil(idleIdx.length / Math.max(1, fieldCols));
      const fxStep = this.W / Math.max(1, fieldCols);
      const fyStep = this.H / Math.max(1, fieldRows);
      for (let j = 0; j < idleIdx.length; j++) {
        const d = this.dots[idleIdx[j]];
        const fc = j % fieldCols;
        const fr = Math.floor(j / fieldCols);
        d.tx = fxStep * (fc + 0.5);
        d.ty = fyStep * (fr + 0.5);
        d.ta = this.stage === 's1' ? 0 : 0.10; // s1 has no idle dots
        d.hero = false;
      }

      if (immediate) this.dots.forEach((d) => { d.x = d.tx; d.y = d.ty; d.a = d.ta; });
    }

    kick() {
      if (this.reduced) { this.assignTargets(true); this.draw(); return; }
      this.settleFrames = 0;
      if (!this.running) { this.running = true; this.raf = requestAnimationFrame(() => this.frame()); }
    }

    frame() {
      let maxDelta = 0;
      for (const d of this.dots) {
        d.x += (d.tx - d.x) * 0.16;
        d.y += (d.ty - d.y) * 0.16;
        d.a += (d.ta - d.a) * 0.16;
        const dd = Math.abs(d.tx - d.x) + Math.abs(d.ty - d.y);
        if (dd > maxDelta) maxDelta = dd;
      }
      this.draw();
      if (maxDelta < 0.4) {
        this.settleFrames++;
        if (this.settleFrames > 4) { this.running = false; return; }
      } else {
        this.settleFrames = 0;
      }
      this.raf = requestAnimationFrame(() => this.frame());
    }

    draw() {
      const ctx = this.ctx;
      ctx.clearRect(0, 0, this.W, this.H);
      const r = this.dotR;
      for (let i = 0; i < this.dots.length; i++) {
        const d = this.dots[i];
        if (d.a <= 0.012) continue;
        ctx.globalAlpha = d.a;
        ctx.fillStyle = d.hero ? this.colHero : (d.ta >= 0.95 ? this.colNeutral : this.colDim);
        // Square marks read as dot-matrix / printout, not bubbles.
        ctx.fillRect(d.x - r, d.y - r, r * 2, r * 2);
      }
      // Hovered dot ring.
      if (this.hovered >= 0) {
        const d = this.dots[this.hovered];
        ctx.globalAlpha = 1;
        ctx.strokeStyle = this.colHero;
        ctx.lineWidth = 1.5;
        ctx.strokeRect(d.x - r - 2.5, d.y - r - 2.5, (r + 2.5) * 2, (r + 2.5) * 2);
      }
      ctx.globalAlpha = 1;
    }

    handleHover(e: PointerEvent) {
      const rect = this.canvas.getBoundingClientRect();
      const px = e.clientX - rect.left;
      const py = e.clientY - rect.top;
      let best = -1, bestD = 14 * 14;
      for (let i = 0; i < this.dots.length; i++) {
        const d = this.dots[i];
        if (d.a < 0.5) continue; // only solid dots are hoverable
        const dx = d.x - px, dy = d.y - py;
        const dist = dx * dx + dy * dy;
        if (dist < bestD) { bestD = dist; best = i; }
      }
      if (best !== this.hovered) {
        this.hovered = best;
        if (best >= 0) this.showTip(best, e.clientX - rect.left, e.clientY - rect.top);
        else this.hideTip();
        if (!this.running) this.draw();
      }
    }

    showTip(i: number, x: number, y: number) {
      if (!this.tip) return;
      const d = this.dots[i];
      const market = this.cfg.markets[d.market]?.name ?? '';
      const necc = this.cfg.necessities[d.necessity]?.name ?? '';
      let line: string;
      if (this.stage === 's1') {
        line = `One company · ${market}`;
      } else {
        const why = d.tier === 1 ? 'Tier 1 · licence to operate' : 'Tier 2 · compulsion to comply';
        line = `Survives · ${why}\n${necc} · ${market}`;
      }
      this.tip.textContent = line;
      this.tip.style.left = x + 'px';
      this.tip.style.top = y + 'px';
      this.tip.hidden = false;
    }
    hideTip() { if (this.tip) this.tip.hidden = true; }
  }

  const REGISTRY = new WeakSet<HTMLElement>();
  const live: RegisterFunnel[] = [];

  function boot() {
    // Tear down prior instances across view transitions.
    while (live.length) live.pop()?.destroy();
    document.querySelectorAll<HTMLElement>('[data-register-funnel]').forEach((el) => {
      live.push(new RegisterFunnel(el));
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => { while (live.length) live.pop()?.destroy(); });
</script>
