---
/**
 * ComplianceCycle (WEB-C). 1:1 port of web_compliance_cycle() in
 * CIM/html/charts.py. Six-step compliance cycle.
 */
import IMFigure from '../IMFigure.astro';

const W = 800;
const H = 440;
const cx = W / 2;
const cy = H / 2;
const r = 160;
const boxW = 130;
const boxH = 56;

const steps = [
  ['01', 'Regulation passes'],
  ['02', 'Buyer must comply'],
  ['03', 'Compliant vendor required'],
  ['04', 'Vendor embeds in stack'],
  ['05', 'Switching cost = legal risk'],
  ['06', 'Regulation updates']
];

const centres = steps.map((_, i) => {
  const ang = -Math.PI / 2 + i * (2 * Math.PI / steps.length);
  return { x: cx + r * Math.cos(ang), y: cy + r * Math.sin(ang) };
});
---
<IMFigure
  fignum="WEB-C"
  label="Compliance cycle · How regulation creates the barrier"
  title='Each loop hardens the <em>barrier</em>.'
  sub="Regulation passes. The buyer is compelled to comply. Only a compliant vendor will do. The vendor embeds in the buyer stack. Switching becomes a legal risk, not a procurement decision. Then the regulation updates and the loop repeats."
  metrics={[
    { label: 'STEP 01', value: 'Regulation',       ci: 'Compulsion event' },
    { label: 'STEP 03', value: 'Vendor lock',      ci: 'Compliant only', accent: true },
    { label: 'STEP 05', value: 'Switching',        ci: '= legal risk' },
    { label: 'LOOP',    value: 'Self-reinforcing', ci: 'Per regulatory update' }
  ]}
  source="hmm Ventures regulatory dataset · 174 four-market regulations"
  basis="Cycle structure · Same loop holds across all five Necessities"
>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="xMidYMid meet"
    style="width:100%;height:auto;display:block;"
    role="img"
    aria-label="The compliance cycle: regulation passes, buyer must comply, compliant vendor required, vendor embeds in stack, switching cost equals legal risk, regulation updates, repeat."
  >
    <defs>
      <marker id="cc-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 Z" fill="var(--rule-strong)" />
      </marker>
    </defs>

    {centres.map((a, i) => {
      const b = centres[(i + 1) % centres.length];
      const mx = (a.x + b.x) / 2;
      const my = (a.y + b.y) / 2;
      const dx = mx - cx;
      const dy = my - cy;
      const d = Math.hypot(dx, dy) || 1;
      const bx = mx + (dx / d) * 22;
      const by = my + (dy / d) * 22;
      return (
        <path
          d={`M${a.x.toFixed(1)},${a.y.toFixed(1)} Q${bx.toFixed(1)},${by.toFixed(1)} ${b.x.toFixed(1)},${b.y.toFixed(1)}`}
          fill="none"
          stroke="var(--rule-strong)"
          stroke-width="0.8"
          marker-end="url(#cc-arrow)"
        />
      );
    })}

    {steps.map(([idx, label], i) => {
      const { x, y } = centres[i];
      const isAccent = i === 0 || i === 5;
      const stroke = isAccent ? 'var(--tomato)' : 'var(--mahogany)';
      const op = isAccent ? '1' : '0.55';
      return (
        <g>
          <rect
            x={x - boxW / 2}
            y={y - boxH / 2}
            width={boxW}
            height={boxH}
            rx="3"
            fill="var(--paper)"
            stroke={stroke}
            stroke-width="1.1"
            opacity={op}
          />
          <text
            x={x - boxW / 2 + 6}
            y={y - boxH / 2 + 14}
            fill="var(--tomato)"
            font-family="var(--mono)"
            font-size="7"
            letter-spacing="0.14em"
            font-weight="700"
          >{idx}</text>
          <text
            x={x}
            y={y + 6}
            text-anchor="middle"
            fill="var(--mahogany)"
            font-family="var(--mono)"
            font-size="9"
            font-weight="500"
          >{label}</text>
        </g>
      );
    })}

    <text
      x={cx}
      y={cy - 4}
      text-anchor="middle"
      fill="var(--muted)"
      font-family="var(--mono)"
      font-size="7"
      letter-spacing="0.16em"
    >SELF-REINFORCING</text>
    <text
      x={cx}
      y={cy + 10}
      text-anchor="middle"
      fill="var(--tomato)"
      font-family="var(--mono)"
      font-size="9"
      font-weight="700"
      letter-spacing="0.12em"
    >BARRIER</text>
  </svg>
</IMFigure>
