---
/**
 * CrystallisationStrip. Pudding-style year axis with hero peak.
 *
 * Reads year_counts from crystallisation-window.json. Each year is a
 * cohort bar; the peak year is the hero.
 *
 * Pass `market` to filter to a single jurisdiction; omit to show the
 * four-market sum.
 */
import data from '../../data/crystallisation-window.json';

interface Props {
  market?: 'AU' | 'JP' | 'NZ' | 'SG';
}

const { market } = Astro.props;

const yearRange = [2024, 2025, 2026, 2027, 2028, 2029, 2030];
const yearCounts: Record<string, number> = {};
yearRange.forEach((y) => { yearCounts[String(y)] = 0; });

if (market) {
  (data.regulations as any[]).forEach((r) => {
    if (r.market === market && yearCounts[String(r.effective_year)] !== undefined) {
      yearCounts[String(r.effective_year)] += 1;
    }
  });
} else {
  Object.entries(data.year_counts as Record<string, number>).forEach(([y, n]) => {
    if (yearCounts[y] !== undefined) yearCounts[y] = n;
  });
}

const years = Object.keys(yearCounts).sort();
const peakYear = years.reduce((a, b) => (yearCounts[a] >= yearCounts[b] ? a : b));

const max = Math.max(1, ...years.map((y) => yearCounts[y]));

const width = 720;
const height = 260;
const margin = { top: 40, right: 40, bottom: 60, left: 60 };
const usableW = width - margin.left - margin.right;
const usableH = height - margin.top - margin.bottom;
const barW = (usableW - (years.length - 1) * 12) / years.length;

const bars = years.map((y, i) => {
  const v = yearCounts[y];
  const h = (v / max) * usableH;
  const x = margin.left + i * (barW + 12);
  const yy = height - margin.bottom - h;
  return { year: y, v, x, y: yy, h, isHero: y === peakYear };
});

const peakBar = bars.find((b) => b.isHero)!;
---
<svg
  class="crysstrip"
  viewBox={`0 0 ${width} ${height}`}
  width="100%"
  height="100%"
  preserveAspectRatio="xMidYMid meet"
  role="img"
  aria-label="In-flight regulations by year, 2024 to 2030"
>
  {/* Hairline x-axis only */}
  <line
    x1={margin.left}
    y1={height - margin.bottom}
    x2={width - margin.right}
    y2={height - margin.bottom}
    stroke="var(--hair-color)"
    stroke-width="0.75"
  />

  {bars.map((b) => (
    <g>
      <rect
        x={b.x}
        y={b.y}
        width={barW}
        height={b.h}
        fill={b.isHero ? 'var(--hero)' : 'var(--cohort-2)'}
      />
      <text
        x={b.x + barW / 2}
        y={height - margin.bottom + 18}
        text-anchor="middle"
        class="crysstrip__year"
      >{b.year}</text>
      <text
        x={b.x + barW / 2}
        y={b.y - 6}
        text-anchor="middle"
        class={b.isHero ? 'crysstrip__count crysstrip__count--hero' : 'crysstrip__count'}
      >{b.v}</text>
    </g>
  ))}

  {/* Hero peak annotation */}
  <line
    x1={peakBar.x + barW / 2}
    y1={peakBar.y - 28}
    x2={peakBar.x + barW / 2 + 90}
    y2={peakBar.y - 56}
    stroke="var(--hero)"
    stroke-width="0.75"
    fill="none"
  />
  <text
    x={peakBar.x + barW / 2 + 96}
    y={peakBar.y - 60}
    class="crysstrip__annot"
    text-anchor="start"
  >Peak crystallisation</text>
  <text
    x={peakBar.x + barW / 2 + 96}
    y={peakBar.y - 44}
    class="crysstrip__annot crysstrip__annot--sub"
    text-anchor="start"
  >{peakYear}. {peakBar.v} regulations</text>
</svg>

<style>
  .crysstrip { display: block; }
  .crysstrip :global(.crysstrip__year) {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    fill: var(--fg-soft);
  }
  .crysstrip :global(.crysstrip__count) {
    font-family: var(--f-display);
    font-size: 0.875rem;
    fill: var(--fg-faint);
  }
  .crysstrip :global(.crysstrip__count--hero) {
    fill: var(--hero);
    font-size: 1rem;
  }
  .crysstrip :global(.crysstrip__annot) {
    font-family: var(--f-annot);
    font-size: var(--fs-annot);
    font-weight: 500;
    fill: var(--hero);
  }
  .crysstrip :global(.crysstrip__annot--sub) {
    fill: var(--fg-faint);
    font-weight: 400;
  }
</style>
