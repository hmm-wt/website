---
/**
 * RegulatoryAcceleration (WEB-D). 1:1 port of web_regulatory_timeline() in
 * CIM/html/charts.py.
 */
import IMFigure from '../IMFigure.astro';

type Status = 'in-effect' | 'upcoming' | 'multi-year';
interface Row { name: string; start: number; end: number; status: Status }
interface Market { market: string; code: string; colour: string; rows: Row[] }

const markets: Market[] = [
  { market: 'Australia', code: 'AU', colour: 'var(--tomato)', rows: [
    { name: 'APRA CPS 230',         start: 2024.4, end: 2025.6, status: 'in-effect' },
    { name: 'AEMO NEM Reform',      start: 2025.0, end: 2027.5, status: 'multi-year' },
    { name: 'TGA ASDR',             start: 2025.0, end: 2026.3, status: 'in-effect' },
    { name: 'TGA UDI (Class I)',    start: 2025.2, end: 2026.6, status: 'in-effect' },
    { name: 'TGA UDI (Class III)',  start: 2026.5, end: 2027.4, status: 'upcoming' }
  ]},
  { market: 'Japan', code: 'JP', colour: '#B8863A', rows: [
    { name: 'AI Promotion Act',          start: 2025.1, end: 2026.0, status: 'upcoming' },
    { name: 'Building Standards Reform', start: 2025.4, end: 2026.6, status: 'upcoming' },
    { name: 'GX-ETS Phase 2',            start: 2025.3, end: 2027.4, status: 'multi-year' },
    { name: 'PMDA SaMD Framework',       start: 2025.4, end: 2027.4, status: 'multi-year' }
  ]},
  { market: 'New Zealand', code: 'NZ', colour: '#2E5F5A', rows: [
    { name: 'Climate Disclosure Regime', start: 2024.0, end: 2025.6, status: 'in-effect' },
    { name: 'AIP Visa Programme',        start: 2024.6, end: 2026.4, status: 'in-effect' }
  ]},
  { market: 'Singapore', code: 'SG', colour: '#5A7A6E', rows: [
    { name: 'IMDA AI Governance', start: 2025.0, end: 2026.0, status: 'in-effect' },
    { name: 'HSA SaMD Guidance',  start: 2025.0, end: 2026.2, status: 'in-effect' },
    { name: 'LTA AV Framework',   start: 2025.4, end: 2027.5, status: 'multi-year' },
    { name: 'MAS AI Risk Mgmt',   start: 2025.4, end: 2026.3, status: 'in-effect' }
  ]}
];

const W = 800;
const H = 380;
const ml = 140, mr = 30, mt = 30, mb = 38;
const iw = W - ml - mr;
const ih = H - mt - mb;
const yearMin = 2024.0;
const yearMax = 2028.0;
const sx = (yr: number) => ml + ((yr - yearMin) / (yearMax - yearMin)) * iw;

const totalRows = markets.reduce((s, m) => s + m.rows.length, 0);
const rowH = ih / Math.max(totalRows, 1);
const barH = rowH * 0.55;

const opOf = (s: Status) => s === 'in-effect' ? '0.78' : s === 'upcoming' ? '0.45' : '0.62';

let cursor = mt;
const blocks = markets.map((m) => {
  const blockH = m.rows.length * rowH;
  const midY = cursor + blockH / 2;
  const start = cursor;
  cursor += blockH;
  const divider = cursor < mt + ih ? cursor : null;
  return { ...m, blockH, midY, start, divider };
});

const nowX = sx(2026.4);
const legend = [
  { label: 'In effect',            op: '0.78' },
  { label: 'Upcoming',             op: '0.45' },
  { label: 'Multi-year programme', op: '0.62' }
];
---
<IMFigure
  fignum="WEB-D"
  label="Regulatory acceleration · 2024 to 2028"
  title='Thirty-four in-flight regulations across the four markets. <em>Peak density 2026 to 2027.</em>'
  sub="Major regulatory events across Australia, Japan, New Zealand, and Singapore. The build is structural, not cyclical. Each market hardens the regulated-sector barrier on a different clock."
  metrics={[
    { label: 'MARKETS',  value: 'AU · JP · NZ · SG', ci: 'Four-market mandate' },
    { label: 'IN-FLIGHT', value: '34',               ci: '2024 to 2030 window', accent: true },
    { label: 'PEAK YEAR', value: '2026',             ci: 'Density peak' },
    { label: 'DATASET',   value: '174',              ci: 'Four-market regulations' }
  ]}
  source="APRA · TGA · METI · MLIT · MAS · MOH · LTA · Medsafe · NZ official publications (2025-2028)"
  basis="Major regulatory events · 4-market dataset · Generated from hmm regulatory dataset"
>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="xMidYMid meet"
    style="width:100%;height:auto;display:block;"
    role="img"
    aria-label="Regulatory timeline 2024 to 2028 across Australia, Japan, New Zealand, and Singapore. 34 in-flight regulations, peak density 2026 to 2027."
  >
    {[2024, 2025, 2026, 2027, 2028].map((yr) => (
      <g>
        <line x1={sx(yr)} y1={mt} x2={sx(yr)} y2={mt + ih} stroke="var(--rule)" stroke-width="0.4" stroke-dasharray="1 2" />
        <text x={sx(yr)} y={mt + ih + 18} text-anchor="middle" fill="var(--muted)" font-family="var(--mono)" font-size="8">{yr}</text>
      </g>
    ))}

    <line x1={nowX} y1={mt - 4} x2={nowX} y2={mt + ih + 4} stroke="var(--tomato)" stroke-width="0.9" stroke-dasharray="3 3" />
    <text x={nowX} y={mt - 8} text-anchor="middle" fill="var(--tomato)" font-family="var(--mono)" font-size="7" font-weight="700" letter-spacing="0.16em">NOW</text>

    {blocks.map((m) => (
      <g>
        <text x={ml - 12} y={m.midY + 3} text-anchor="end" fill={m.colour} font-family="var(--mono)" font-size="9" font-weight="700">{m.market}</text>
        {m.rows.map((row, i) => {
          const y = m.start + i * rowH + rowH / 2;
          const x1 = sx(row.start);
          const x2 = sx(row.end);
          return (
            <g>
              <rect x={x1} y={y - barH / 2} width={x2 - x1} height={barH} fill={m.colour} opacity={opOf(row.status)} rx="1.5" />
              <text x={x1 + 6} y={y + 2.5} fill="var(--paper)" font-family="var(--mono)" font-size="7" font-weight="600">{row.name}</text>
            </g>
          );
        })}
        {m.divider !== null && (
          <line x1={ml - 30} y1={m.divider} x2={ml + iw} y2={m.divider} stroke="var(--rule)" stroke-width="0.3" />
        )}
      </g>
    ))}

    {legend.map((l, i) => {
      const cursorX = ml + i * (14 + l.label.length * 4.6 + 16);
      return (
        <g>
          <rect x={cursorX} y={H - 15} width="10" height="6" fill="var(--mahogany)" opacity={l.op} />
          <text x={cursorX + 14} y={H - 9} fill="var(--muted)" font-family="var(--mono)" font-size="7">{l.label}</text>
        </g>
      );
    })}
  </svg>
</IMFigure>
