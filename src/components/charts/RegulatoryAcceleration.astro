---
import IMFigure from '../IMFigure.astro';

interface Row {
  title: string;
  start: number;
  end: number;
  status: 'in_effect' | 'upcoming' | 'programme';
}

interface MarketBlock {
  market: string;
  code: 'AU' | 'JP' | 'NZ' | 'SG';
  rows: Row[];
}

const blocks: MarketBlock[] = [
  {
    market: 'Australia',
    code: 'AU',
    rows: [
      { title: 'APRA CPS 230',         start: 2024.4, end: 2025.6, status: 'in_effect' },
      { title: 'AEMO NEM Reform',       start: 2024.8, end: 2027.4, status: 'programme' },
      { title: 'TGA ASDR',              start: 2024.8, end: 2026.4, status: 'in_effect' },
      { title: 'TGA UDI (Class I)',     start: 2025.0, end: 2026.6, status: 'in_effect' },
      { title: 'TGA UDI (Class III)',   start: 2026.8, end: 2027.6, status: 'upcoming' }
    ]
  },
  {
    market: 'Japan',
    code: 'JP',
    rows: [
      { title: 'AI Promotion Act',          start: 2025.0, end: 2026.2, status: 'in_effect' },
      { title: 'Building Standards Reform', start: 2025.4, end: 2026.6, status: 'in_effect' },
      { title: 'GX-ETS Phase 2',            start: 2025.4, end: 2027.4, status: 'programme' },
      { title: 'PMDA SaMD Framework',       start: 2025.4, end: 2027.4, status: 'programme' }
    ]
  },
  {
    market: 'New Zealand',
    code: 'NZ',
    rows: [
      { title: 'Climate Disclosure Regime', start: 2024.0, end: 2025.6, status: 'in_effect' },
      { title: 'AIP Visa Programme',        start: 2024.6, end: 2026.4, status: 'in_effect' },
      { title: 'Therapeutic Products Act',  start: 2026.4, end: 2027.6, status: 'upcoming' }
    ]
  },
  {
    market: 'Singapore',
    code: 'SG',
    rows: [
      { title: 'IMDA AI Governance',  start: 2025.0, end: 2026.2, status: 'in_effect' },
      { title: 'HSA SaMD Guidance',   start: 2025.2, end: 2026.4, status: 'in_effect' },
      { title: 'LTA AV Framework',    start: 2025.4, end: 2027.4, status: 'programme' },
      { title: 'MAS AI Risk Mgmt',    start: 2025.4, end: 2026.6, status: 'in_effect' }
    ]
  }
];

const W = 800;
const H = 470;
const ml = 110, mr = 50, mt = 30, mb = 60;
const iw = W - ml - mr;
const ih = H - mt - mb;

const yearStart = 2024;
const yearEnd = 2028;
const xOf = (yr: number) => ml + ((yr - yearStart) / (yearEnd - yearStart)) * iw;

const totalRows = blocks.reduce((acc, b) => acc + b.rows.length, 0);
const rowH = ih / totalRows;

const marketColours: Record<string, { fill: string; fillEffect: string; ink: string }> = {
  AU: { fill: 'var(--c-tomato)',          fillEffect: 'var(--c-tomato)',     ink: 'var(--c-tomato)' },
  JP: { fill: '#C9A35F',                  fillEffect: '#C9A35F',             ink: '#C9A35F' },
  NZ: { fill: '#5F8B7A',                  fillEffect: '#5F8B7A',             ink: '#5F8B7A' },
  SG: { fill: '#7C9F8E',                  fillEffect: '#7C9F8E',             ink: '#7C9F8E' }
};

const nowYear = 2026.42;

let rowIdx = 0;
const renderRows = blocks.flatMap((b) => {
  const start = rowIdx;
  const rows = b.rows.map((r, i) => {
    const y = mt + (rowIdx + 0.5) * rowH;
    rowIdx++;
    return { ...r, y, market: b.code };
  });
  const midY = mt + ((start + b.rows.length / 2) * rowH);
  return [{ kind: 'label' as const, market: b.code, label: b.market, midY }, ...rows.map((r) => ({ kind: 'bar' as const, ...r }))];
});
---
<IMFigure
  fignum="WEB-D"
  label="Regulatory acceleration · 2024 to 2028"
  title='Thirty-four in-flight regulations across the four markets. <em>Peak density 2026 to 2027.</em>'
  sub="Major regulatory events across Australia, Japan, New Zealand, and Singapore. The build is structural, not cyclical. Each market hardens the regulated-sector barrier on a different clock."
  metrics={[
    { label: 'MARKETS', value: 'AU · JP · NZ · SG', ci: 'Four-market mandate' },
    { label: 'IN-FLIGHT', value: '34', ci: '2024 to 2030 window', accent: true },
    { label: 'PEAK YEAR', value: '2026', ci: 'Density peak' },
    { label: 'DATASET', value: '174', ci: 'Four-market regulations' }
  ]}
  source="APRA · TGA · METI · MLIT · MAS · MOH · LTA · Medsafe · NZ official publications (2025-2028)"
  basis="Major regulatory events · 4-market dataset · Generated from hmm Comprehensive Regulatory Dataset"
>
  <svg
    class="ra"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label="Gantt of major regulatory events across Australia, Japan, New Zealand, and Singapore from 2024 to 2028, peak density 2026 to 2027."
  >
    {/* Year gridlines */}
    {[2024, 2025, 2026, 2027, 2028].map((y) => (
      <g class="ra__grid">
        <line
          x1={xOf(y)} y1={mt}
          x2={xOf(y)} y2={mt + ih}
          stroke="var(--imfig-rule)"
          stroke-width="0.6"
          stroke-dasharray="1 3"
        />
        <text
          x={xOf(y)}
          y={mt + ih + 18}
          text-anchor="middle"
          fill="var(--imfig-muted)"
          font-family="var(--f-mono)"
          font-size="9"
          letter-spacing="0.04em"
        >{y}</text>
      </g>
    ))}

    {/* NOW vertical */}
    <g class="ra__now">
      <line
        x1={xOf(nowYear)} y1={mt - 4}
        x2={xOf(nowYear)} y2={mt + ih + 4}
        stroke="var(--c-tomato)"
        stroke-width="1"
        stroke-dasharray="3 3"
      />
      <text
        x={xOf(nowYear)}
        y={mt - 8}
        text-anchor="middle"
        fill="var(--c-tomato)"
        font-family="var(--f-mono)"
        font-size="8"
        font-weight="700"
        letter-spacing="0.16em"
      >NOW</text>
    </g>

    {/* Market labels + bars */}
    {renderRows.map((r) => {
      if (r.kind === 'label') {
        const col = marketColours[r.market].ink;
        return (
          <text
            x={ml - 14}
            y={r.midY + 3}
            text-anchor="end"
            fill={col}
            font-family="var(--f-display)"
            font-style="italic"
            font-size="11"
            font-weight="600"
          >{r.label}</text>
        );
      }
      const palette = marketColours[r.market];
      const x = xOf(r.start);
      const w = Math.max(xOf(r.end) - xOf(r.start), 6);
      const barH = rowH * 0.62;
      const yBar = r.y - barH / 2;
      const opacity = r.status === 'upcoming' ? 0.45 : r.status === 'programme' ? 0.78 : 0.88;
      return (
        <g class="ra__bar">
          <rect
            x={x} y={yBar}
            width={w} height={barH}
            fill={palette.fill}
            opacity={opacity}
            rx="1"
          />
          <text
            x={x + 6}
            y={r.y + 3}
            fill="var(--c-pearl)"
            font-family="var(--f-mono)"
            font-size="7.5"
            font-weight="600"
            letter-spacing="0.02em"
          >{r.title}</text>
        </g>
      );
    })}

    {/* Axis baseline */}
    <line x1={ml} y1={mt + ih} x2={ml + iw} y2={mt + ih} stroke="var(--c-mahogany)" stroke-width="0.6" />

    {/* Legend */}
    <g transform={`translate(${ml}, ${H - 14})`}>
      <rect x="0" y="-6" width="10" height="8" fill="var(--c-mahogany)" opacity="0.88" />
      <text x="14" y="2" fill="var(--imfig-muted)" font-family="var(--f-mono)" font-size="7.5" letter-spacing="0.06em">In effect</text>
      <rect x="86" y="-6" width="10" height="8" fill="var(--c-mahogany)" opacity="0.45" />
      <text x="100" y="2" fill="var(--imfig-muted)" font-family="var(--f-mono)" font-size="7.5" letter-spacing="0.06em">Upcoming</text>
      <rect x="180" y="-6" width="10" height="8" fill="var(--c-mahogany)" opacity="0.78" />
      <text x="194" y="2" fill="var(--imfig-muted)" font-family="var(--f-mono)" font-size="7.5" letter-spacing="0.06em">Multi-year programme</text>
    </g>
  </svg>
</IMFigure>

<style>
  .ra { width: 100%; height: auto; display: block; }
</style>
