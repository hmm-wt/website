---
/**
 * SmallMultiples. N-up identical mini-chart layout wrapper.
 *
 * Pudding pattern: when comparing across groups, don't overlay six lines.
 * Show six small panels. Pure CSS grid + slot.
 *
 * Usage:
 *   <SmallMultiples cols={4}>
 *     <PremiumBar label="Seed" value={1.12} />
 *     <PremiumBar label="Series A" value={1.19} />
 *     <PremiumBar label="Series C" value={1.53} />
 *     <PremiumBar label="Series D+" value={1.42} />
 *   </SmallMultiples>
 */
interface Props {
  cols?: number;
  gap?: string;
}

const { cols = 4, gap = 'var(--s-5)' } = Astro.props;
---
<div
  class="small-multiples"
  style={`--sm-cols: ${cols}; --sm-gap: ${gap};`}
>
  <slot />
</div>

<style>
  .small-multiples {
    display: grid;
    grid-template-columns: repeat(var(--sm-cols), 1fr);
    gap: var(--sm-gap);
    align-items: start;
  }
  @media (max-width: 900px) {
    .small-multiples { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .small-multiples { grid-template-columns: 1fr; }
  }
</style>
