---
/**
 * NecessityFunnel. The home hero centrepiece.
 *
 * One canvas, four acts, driven by the shared figures in necessity-index.json:
 *   universe  19,416  four-market companies, sitting in four territories
 *   cut        6,505  regulation strikes; failures fall away, survivors
 *                     collapse to a third of the field
 *   cohort     2,625  seed-stage survivors take their Necessity colour
 *   markets    2,625  each market's cohort crystallises into its national
 *                     flower (wattle / chrysanthemum / koru / vanda)
 *
 * Geography is present from the first frame: the universe IS the four-market
 * dataset, so the four markets are never "revealed", only refined. Necessity
 * is the colour layer; regulation is the mechanism that does the cut.
 *
 * Numbers are read from necessity-index.json, never re-keyed. Necessity tones
 * come from the --nec-* tokens (every one an existing brand value). Autoplay
 * starts on scroll-into-view; reduced motion renders the final bloom statically.
 */
import data from '../../data/necessity-index.json';
import NecessityMark from '../NecessityMark.astro';

const universe = data.universe.four_market_companies;            // 19416
const passFilter = data.tier_shares.conservative_classifier_count; // 6505
const seedStage = data.stage_funnel[2].count;                    // 2625

// Necessity key -> mark kind + share (in-thesis companies) + colour token.
const necRows = [
  { k: 'eat',    label: 'Eat',    mark: 'food' as const,       name: 'Food Security Systems',            w: 395,  cssVar: '--nec-eat' },
  { k: 'heal',   label: 'Heal',   mark: 'biomedical' as const, name: 'Biomedical Systems',               w: 1269, cssVar: '--nec-heal' },
  { k: 'move',   label: 'Move',   mark: 'autonomous' as const, name: 'Autonomous Systems',               w: 561,  cssVar: '--nec-move' },
  { k: 'power',  label: 'Power',  mark: 'power' as const,      name: 'Power Systems',                     w: 581,  cssVar: '--nec-power' },
  { k: 'supply', label: 'Supply', mark: 'materials' as const,  name: 'Critical Materials and Supply Integrity', w: 505, cssVar: '--nec-supply' },
];

const cfg = {
  universe, passFilter, seedStage,
  t1: data.tier_shares.t1_count, t2: data.tier_shares.t2_count,
  markets: data.per_market.map((m) => ({ c: m.market, name: m.code, w: m.companies, fl: m.market.toLowerCase() })),
  necessities: necRows.map((n) => ({ k: n.k, name: n.name, w: n.w, cssVar: n.cssVar })),
};
---
<div class="nfun" data-necessity-funnel data-config={JSON.stringify(cfg)}>
  <ul class="nfun__legend" aria-label="Necessity colour key">
    {necRows.map((n) => (
      <li class="nfun__legenditem" style={`color: var(${n.cssVar});`}>
        <NecessityMark kind={n.mark} size={20} />
        <span>{n.label}</span>
      </li>
    ))}
  </ul>

  <div class="nfun__stage">
    <canvas class="nfun__canvas" aria-hidden="true"></canvas>
    <div class="nfun__tip" data-tip hidden role="status" aria-live="polite"></div>
  </div>

  <div class="nfun__readout">
    <span class="nfun__num" data-num>{universe.toLocaleString('en-GB')}</span>
    <span class="nfun__line" data-line>Companies in the four-market dataset.</span>
  </div>

  <div class="nfun__controls" data-chips aria-label="Funnel stages"></div>

  <p class="nfun__source">Source: hmm Ventures four-market classified dataset · {universe.toLocaleString('en-GB')} companies.</p>

  <p class="nfun__sr">
    The four-market universe holds {universe.toLocaleString('en-GB')} companies.
    The regulation filter cuts it to {passFilter.toLocaleString('en-GB')} that either need a licence to operate or are compelled to comply.
    {seedStage.toLocaleString('en-GB')} of those are seed-stage and in the five Necessities,
    distributed across Australia, Japan, New Zealand and Singapore.
    From that cohort, hmm backs around 25 companies at pre-seed and seed.
  </p>
</div>

<style>
  .nfun { width: 100%; max-width: 72rem; margin-inline: auto; }

  .nfun__source {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.05em;
    color: var(--fg-faint);
    margin: var(--s-3) 0 0;
  }

  .nfun__legend {
    list-style: none;
    margin: 0 0 var(--s-3);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-2) var(--s-5);
  }
  .nfun__legenditem {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .nfun__legenditem span { color: var(--fg-soft); }

  .nfun__stage { position: relative; }
  .nfun__canvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 11 / 2;
    border-block: var(--hair) solid var(--hair-color);
  }
  .nfun__tip {
    position: absolute;
    top: 0; left: 0;
    transform: translate(-50%, calc(-100% - 10px));
    pointer-events: none;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    line-height: 1.35;
    white-space: pre-line;
    color: var(--c-pearl);
    background: var(--c-mahogany);
    border: var(--hair) solid var(--rule-strong);
    padding: 0.4rem 0.55rem;
    max-width: 28ch;
    z-index: 3;
  }
  .nfun__tip[hidden] { display: none; }

  .nfun__readout {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--s-3);
    margin: var(--s-4) 0 var(--s-4);
    flex-wrap: wrap;
  }
  .nfun__num {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: 1;
    color: var(--c-tomato);
    letter-spacing: -0.01em;
  }
  .nfun__line {
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    letter-spacing: 0.03em;
    color: var(--fg-soft);
  }

  .nfun__controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-2);
    align-items: center;
  }
  .nfun :global(.nfun__chip) {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    min-height: var(--tap-min);
    padding: 0 var(--s-3);
    color: var(--fg-soft);
    background: transparent;
    border: var(--hair) solid var(--rule);
    cursor: pointer;
    transition: color var(--mo-tick) var(--ease-golden),
                background var(--mo-tick) var(--ease-golden),
                border-color var(--mo-tick) var(--ease-golden);
  }
  .nfun :global(.nfun__chip[aria-pressed='true']) {
    color: var(--c-evergreen);
    background: var(--c-pearl);
    border-color: var(--c-pearl);
  }
  .nfun :global(.nfun__chip:hover) { border-color: var(--c-tomato); }

  .nfun__sr {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .nfun__canvas { aspect-ratio: 16 / 10; }
    .nfun__legend { gap: var(--s-2) var(--s-4); }
  }
  @media (max-width: 480px) {
    .nfun__canvas { aspect-ratio: 4 / 5; }
  }
</style>

<script>
  type NecCfg = {
    universe: number; passFilter: number; seedStage: number; t1: number; t2: number;
    markets: { c: string; name: string; w: number; fl: string }[];
    necessities: { k: string; name: string; w: number; cssVar: string }[];
  };
  type Dot = {
    ux: number; uy: number; x: number; y: number; tx: number; ty: number;
    v: number; nec: number; mk: number; tier: 1 | 2;
    cr: number; cg: number; cb: number; a: number;
    tr: number; tg: number; tb: number; ta: number;
    ptr: number; ptg: number; ptb: number; pta: number; ptx: number; pty: number;
    resolved: boolean;
  };

  function hash(i: number) { const x = Math.sin(i * 127.1 + 0.3) * 43758.5453; return x - Math.floor(x); }


  function parseRGB(s: string): number[] {
    s = s.trim();
    if (s[0] === '#') { let h = s.slice(1); if (h.length === 3) h = h.split('').map((c) => c + c).join(''); return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)]; }
    const m = s.match(/[\d.]+/g) || ['242', '236', '201']; return [+m[0], +m[1], +m[2]];
  }

  function flowerShape(fl: string): { fill: Path2D | null; stroke: Path2D | null; lw: number } {
    if (fl === 'au') {
      const s = new Path2D('M 16 88 Q 40 74 56 56 Q 72 38 84 20');
      const f = new Path2D();
      ([[24,84,7],[37,71,7.5],[50,57,7],[63,43,7.5],[75,30,7],[84,21,6]] as number[][]).forEach((b) => { f.moveTo(b[0]+b[2], b[1]); f.arc(b[0], b[1], b[2], 0, Math.PI*2); });
      return { fill: f, stroke: s, lw: 5 };
    }
    if (fl === 'jp') {
      const f = new Path2D();
      const pet = new Path2D('M 50 8 L 46 34 L 50 48 L 54 34 Z');
      // 16 petals at 22.5deg matches the canonical fauna SVG + JurisdictionMark.
      for (let i = 0; i < 16; i++) { const m = new DOMMatrix().translateSelf(50,50).rotateSelf(i*22.5).translateSelf(-50,-50); f.addPath(pet, m); }
      const c = new Path2D(); c.arc(50, 50, 11, 0, Math.PI*2); f.addPath(c);
      return { fill: f, stroke: null, lw: 0 };
    }
    if (fl === 'nz') return { fill: null, stroke: new Path2D('M 20 88 C 20 40 46 12 70 12 C 92 12 94 40 73 47 C 56 52 47 38 55 26 C 61 17 77 21 77 32'), lw: 9 };
    return { fill: null, stroke: new Path2D('M 50 94 Q 52 80 50 68 L 50 44 M 50 44 C 44 32 42 18 47 9 C 51 16 53 30 50 44 M 50 44 C 56 32 58 18 53 9 C 49 16 47 30 50 44 M 48 46 C 36 46 25 39 19 30 C 30 35 41 42 48 46 M 52 46 C 64 46 75 39 81 30 C 70 35 59 42 52 46 M 47 49 C 37 51 27 53 21 57 M 53 49 C 63 51 73 53 79 57 M 50 47 C 40 53 36 63 40 73 C 42 79 48 83 50 83 C 52 83 58 79 60 73 C 64 63 60 53 50 47'), lw: 5 };
  }

  class NecessityFunnel {
    el: HTMLElement; cfg: NecCfg;
    canvas: HTMLCanvasElement; ctx: CanvasRenderingContext2D;
    tip: HTMLElement | null; numEl: HTMLElement | null; lineEl: HTMLElement | null; chipsEl: HTMLElement | null;
    reduced: boolean;
    necCols: string[] = []; necRgb: number[][] = []; PEARL = [242, 236, 201]; NEUTA = 0.34; BRIGHTA = 0.9;
    monoFont = 'ui-monospace, monospace';
    serifFont = 'Instrument Serif, serif';
    W = 0; H = 0; dpr = 1; step = 8; ds = 5; fstep = 10;
    fx0 = 0; fx1 = 0; fy0 = 0; fy1 = 0;
    dots: Dot[] = []; cols4: { x: number; w: number; cx: number }[] = []; colsIn: number[] = []; blooms: any[] = [];
    mTot = 0; nCum: number[] = [];
    stages: { id: string; kicker: string; num: number; line: string; mode: string; thr: number }[] = [];
    stage = 's1'; hovered = -1;
    raf = 0; numRaf = 0; scanning = false; scanX = 0; running = false;
    autoTimer: any = 0; playing = false; started = false;
    onResize: () => void; onMove: (e: PointerEvent) => void; onLeave: () => void;
    io: IntersectionObserver | null = null;

    constructor(el: HTMLElement) {
      this.el = el;
      this.cfg = JSON.parse(el.dataset.config || '{}');
      this.canvas = el.querySelector('.nfun__canvas') as HTMLCanvasElement;
      this.ctx = this.canvas.getContext('2d')!;
      this.tip = el.querySelector('[data-tip]');
      this.numEl = el.querySelector('[data-num]');
      this.lineEl = el.querySelector('[data-line]');
      this.chipsEl = el.querySelector('[data-chips]');
      this.reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      this.mTot = this.cfg.markets.reduce((s, m) => s + m.w, 0);
      const nTot = this.cfg.necessities.reduce((s, n) => s + n.w, 0);
      let a = 0; this.cfg.necessities.forEach((n) => { a += n.w / nTot; this.nCum.push(a); });

      const root = getComputedStyle(document.documentElement);
      const read = (v: string, fb: string) => (root.getPropertyValue(v).trim() || fb);
      this.necCols = this.cfg.necessities.map((n) => read(n.cssVar, '#C44539'));
      this.necRgb = this.necCols.map(parseRGB);
      this.monoFont = read('--f-mono', this.monoFont);
      this.serifFont = read('--f-display', this.serifFont);

      const u = this.cfg.universe, p = this.cfg.passFilter, s = this.cfg.seedStage;
      this.stages = [
        { id: 's1', kicker: 'The universe', num: u, line: 'Companies in the four-market dataset.', mode: 'universe', thr: 1 },
        { id: 's2', kicker: 'The cut', num: p, line: 'Pass the regulation filter.', mode: 'cut', thr: p / u },
        { id: 's3', kicker: 'The cohort', num: s, line: 'In Necessities, at seed stage.', mode: 'cohort', thr: s / u },
        { id: 's4', kicker: 'The markets', num: s, line: 'Across four developed APAC markets.', mode: 'bloom', thr: s / u },
        { id: 's5', kicker: 'The portfolio', num: 25, line: 'Backed at pre-seed and seed.', mode: 'portfolio', thr: 25 / u },
      ];

      this.buildChips();
      this.build();

      this.onResize = () => { this.build(); this.applyStage(this.stage, true); };
      window.addEventListener('resize', this.onResize, { passive: true });
      this.onMove = (e) => this.hover(e);
      this.onLeave = () => { this.hovered = -1; if (this.tip) this.tip.hidden = true; if (!this.running) this.draw(); };
      if (!this.reduced) {
        this.canvas.addEventListener('pointermove', this.onMove, { passive: true });
        this.canvas.addEventListener('pointerleave', this.onLeave);
      }

      if (this.reduced) {
        this.applyStage('s4', true); // legible final state, no motion
      } else {
        this.applyStage('s1', true);
        this.io = new IntersectionObserver((es) => {
          es.forEach((e) => { if (e.isIntersecting && !this.started) { this.started = true; this.startAuto(); } });
        }, { rootMargin: '-20% 0px -20% 0px' });
        this.io.observe(this.el);
      }
    }

    destroy() {
      cancelAnimationFrame(this.raf); cancelAnimationFrame(this.numRaf); clearInterval(this.autoTimer);
      window.removeEventListener('resize', this.onResize);
      this.canvas.removeEventListener('pointermove', this.onMove);
      this.canvas.removeEventListener('pointerleave', this.onLeave);
      this.io?.disconnect();
    }

    buildChips() {
      if (!this.chipsEl) return;
      this.chipsEl.innerHTML = '';
      [
        { id: 's1', t: 'The universe' }, { id: 's2', t: 'The cut' }, { id: 's3', t: 'The cohort' }, { id: 's4', t: 'The markets' }, { id: 's5', t: 'The portfolio' },
      ].forEach((c) => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'nfun__chip'; b.dataset.st = c.id; b.textContent = c.t;
        b.setAttribute('aria-pressed', c.id === 's1' ? 'true' : 'false');
        b.addEventListener('click', () => { this.stopAuto(); this.applyStage(c.id, false); });
        this.chipsEl!.appendChild(b);
      });
    }

    build() {
      const rect = this.canvas.getBoundingClientRect();
      this.dpr = Math.min(2, window.devicePixelRatio || 1);
      this.W = Math.max(1, Math.round(rect.width)); this.H = Math.max(1, Math.round(rect.height));
      this.canvas.width = Math.round(this.W * this.dpr); this.canvas.height = Math.round(this.H * this.dpr);
      this.ctx.setTransform(this.dpr, 0, 0, this.dpr, 0, 0);
      const pad = 5; this.fx0 = pad; this.fx1 = this.W - pad; this.fy0 = 18; this.fy1 = this.H - pad - 18; // reserve a strip for market labels
      // Bound the dot count so the field stays smooth (derive grid step from a budget).
      const fieldW = this.fx1 - this.fx0, fieldH = this.fy1 - this.fy0;
      const budget = this.W < 480 ? 2200 : this.W < 720 ? 3200 : 5000;
      this.step = Math.max(6, Math.round(Math.sqrt((fieldW * fieldH) / budget)));
      this.ds = Math.max(2, this.step - 3); this.fstep = Math.max(7, Math.round(this.step * 1.2));

      const innerW = this.fx1 - this.fx0, cgap = 6, usable = innerW - cgap * 3; let cx = this.fx0;
      this.cols4 = []; this.cfg.markets.forEach((m) => { const w = usable * (m.w / this.mTot); this.cols4.push({ x: cx, w, cx: cx + w / 2 }); cx += w + cgap; });
      this.colsIn = this.cols4.map((c) => Math.max(1, Math.floor(c.w / this.step)));
      const capRows = Math.floor((this.fy1 - this.fy0) / this.step);

      this.dots = []; let gi = 0;
      this.cfg.markets.forEach((m, j) => {
        const cap = this.colsIn[j] * capRows;
        for (let t = 0; t < cap; t++) {
          const cc = t % this.colsIn[j], rr = Math.floor(t / this.colsIn[j]);
          const x = this.cols4[j].x + cc * this.step + this.step / 2, y = this.fy0 + rr * this.step + this.step / 2;
          const v = hash(gi * 1.7 + 0.1), nr = hash(gi * 2.3); let nec = this.nCum.length - 1;
          for (let k = 0; k < this.nCum.length; k++) { if (nr <= this.nCum[k]) { nec = k; break; } }
          const tier: 1 | 2 = hash(gi * 4.4) < this.cfg.t1 / (this.cfg.t1 + this.cfg.t2) ? 1 : 2;
          const pr = this.PEARL;
          this.dots.push({ ux: x, uy: y, x, y, tx: x, ty: y, v, nec, mk: j, tier, cr: pr[0], cg: pr[1], cb: pr[2], a: this.NEUTA, tr: pr[0], tg: pr[1], tb: pr[2], ta: this.NEUTA, ptr: pr[0], ptg: pr[1], ptb: pr[2], pta: this.NEUTA, ptx: x, pty: y, resolved: true });
          gi++;
        }
      });

      const sq = this.cfg.markets.map((m) => Math.sqrt(m.w / this.mTot)), mxs = Math.max(...sq);
      const rel = sq.map((q) => 0.82 + 0.18 * q / mxs);
      const gap = Math.max(14, innerW * 0.03), avail = innerW - gap * 3, sumRel = rel.reduce((p, q) => p + q, 0);
      const unit = avail / sumRel, hcap = (this.fy1 - this.fy0) - 24;
      const sizes = rel.map((r) => Math.min(r * unit, hcap));
      const totalW = sizes.reduce((p, q) => p + q, 0) + gap * 3; let x0 = this.fx0 + ((this.fx1 - this.fx0) - totalW) / 2;
      this.blooms = [];
      this.cfg.markets.forEach((m, j) => {
        const sz = sizes[j]; const box: any = { x: x0, y: this.fy1 - 14 - sz, w: sz, h: sz, cx: x0 + sz / 2 };
        box.P = this.sampleFlower(flowerShape(m.fl), box); box.P.sort((a: any, b: any) => hash(a.x * 1.7 + a.y) - hash(b.x * 1.7 + b.y));
        this.blooms.push(box); x0 += sz + gap;
      });
    }

    sampleFlower(shape: { fill: Path2D | null; stroke: Path2D | null; lw: number }, box: any) {
      const ctx = this.ctx; ctx.save(); ctx.setTransform(1, 0, 0, 1, 0, 0); ctx.lineJoin = 'round'; ctx.lineCap = 'round';
      const pts: { x: number; y: number }[] = [];
      for (let sy = box.y + this.fstep / 2; sy < box.y + box.h; sy += this.fstep) {
        for (let sx = box.x + this.fstep / 2; sx < box.x + box.w; sx += this.fstep) {
          const lx = (sx - box.x) / box.w * 100, ly = (sy - box.y) / box.h * 100; let hit = false;
          if (shape.fill && ctx.isPointInPath(shape.fill, lx, ly)) hit = true;
          if (!hit && shape.stroke) { ctx.lineWidth = shape.lw; if (ctx.isPointInStroke(shape.stroke, lx, ly)) hit = true; }
          if (hit) pts.push({ x: sx, y: sy });
        }
      }
      ctx.restore(); return pts;
    }

    pend(d: Dot, rgb: number[], alpha: number, x: number, y: number) {
      d.ptr = rgb[0]; d.ptg = rgb[1]; d.ptb = rgb[2]; d.pta = alpha; d.ptx = x; d.pty = y;
    }

    resolveTargets(st: any) {
      const P = this.PEARL;
      if (st.mode === 'universe') { this.dots.forEach((d) => this.pend(d, P, this.NEUTA, d.ux, d.uy)); return; }
      if (st.mode === 'portfolio') {
        // The field resolves to the target portfolio: the ~25 companies hmm
        // backs, a tight central cluster coloured by Necessity. The rest fade.
        const N = 25;
        const order = this.dots.slice().sort((a, b) => a.v - b.v);
        const cols = 5, cell = this.step * 1.7, rows = Math.ceil(N / cols);
        const ccx = (this.fx0 + this.fx1) / 2, ccy = (this.fy0 + this.fy1) / 2;
        const x0 = ccx - ((cols - 1) * cell) / 2, y0 = ccy - ((rows - 1) * cell) / 2;
        order.forEach((d, i) => {
          if (i < N) { const r = Math.floor(i / cols), c = i % cols; this.pend(d, this.necRgb[d.nec], 1, x0 + c * cell, y0 + r * cell); }
          else this.pend(d, P, 0, d.ux, d.uy);
        });
        return;
      }
      if (st.mode === 'bloom') {
        const idx = [0, 0, 0, 0]; const order = this.dots.slice().sort((a, b) => a.v - b.v);
        order.forEach((d) => {
          if (d.v <= st.thr) { const pts = this.blooms[d.mk].P, t = idx[d.mk]++; if (t < pts.length) this.pend(d, this.necRgb[d.nec], 1, pts[t].x, pts[t].y); else this.pend(d, P, 0, d.ux, this.fy1 + 60); }
          else this.pend(d, P, 0, d.ux, this.fy1 + 60);
        });
        return;
      }
      // The cut drops failures out of frame; the cohort dims its non-survivors in place.
      if (st.mode === 'cut') { this.dots.forEach((d) => { if (d.v > st.thr) this.pend(d, P, 0, d.ux, this.fy1 + 40 + hash(d.v * 99) * 70); }); }
      else { this.dots.forEach((d) => { if (d.v > st.thr) this.pend(d, P, 0, d.x, d.y); }); }
      const idxP = [0, 0, 0, 0]; const order = this.dots.slice().sort((a, b) => a.v - b.v);
      order.forEach((d) => {
        if (d.v <= st.thr) { const ci = this.colsIn[d.mk], t = idxP[d.mk]++, cc = t % ci, rr = Math.floor(t / ci);
          const x = this.cols4[d.mk].x + cc * this.step + this.step / 2, y = this.fy1 - 6 - (rr * this.step + this.step / 2);
          this.pend(d, st.mode === 'cut' ? P : this.necRgb[d.nec], st.mode === 'cut' ? this.BRIGHTA : 1, x, y); }
      });
    }

    tweenNum(to: number, dur: number) {
      if (!this.numEl) return; const from = parseInt((this.numEl.textContent || '0').replace(/,/g, '')) || to;
      cancelAnimationFrame(this.numRaf); const t0 = performance.now();
      const tk = (now: number) => { const k = Math.min(1, (now - t0) / dur), p = 1 - Math.pow(1 - k, 3), val = Math.round(from + (to - from) * p); this.numEl!.textContent = val.toLocaleString('en-GB'); if (k < 1) this.numRaf = requestAnimationFrame(tk); };
      this.numRaf = requestAnimationFrame(tk);
    }

    draw() {
      const ctx = this.ctx; ctx.clearRect(0, 0, this.W, this.H); const r = this.ds / 2;
      const TAU = Math.PI * 2;
      for (let i = 0; i < this.dots.length; i++) { const d = this.dots[i]; if (d.a <= 0.012) continue; ctx.globalAlpha = d.a; ctx.fillStyle = `rgb(${d.cr | 0},${d.cg | 0},${d.cb | 0})`; ctx.beginPath(); ctx.arc(d.x, d.y, r, 0, TAU); ctx.fill(); }
      ctx.globalAlpha = 1; ctx.font = '600 11px ' + this.monoFont; ctx.textAlign = 'center'; ctx.textBaseline = 'top';
      if (this.stage !== 's5') {
        this.cfg.markets.forEach((m, j) => { ctx.fillStyle = `rgba(242,236,201,${this.stage === 's4' ? 0.85 : 0.5})`; ctx.fillText(m.c, this.stage === 's4' ? this.blooms[j].cx : this.cols4[j].cx, this.fy1 + 5); });
      }
      if (this.scanning) { ctx.fillStyle = '#F2ECC9'; ctx.globalAlpha = 0.9; ctx.fillRect(this.scanX - 1, this.fy0, 2, this.fy1 - this.fy0); ctx.globalAlpha = 1; }
      if (this.hovered >= 0) { const h = this.dots[this.hovered]; ctx.strokeStyle = '#F2ECC9'; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.arc(h.x, h.y, r + 3, 0, TAU); ctx.stroke(); }
    }

    tick() {
      let md = 0;
      for (let i = 0; i < this.dots.length; i++) {
        const d = this.dots[i];
        d.x += (d.tx - d.x) * 0.16; d.y += (d.ty - d.y) * 0.16; d.a += (d.ta - d.a) * 0.18;
        d.cr += (d.tr - d.cr) * 0.2; d.cg += (d.tg - d.cg) * 0.2; d.cb += (d.tb - d.cb) * 0.2;
        const dd = Math.abs(d.tx - d.x) + Math.abs(d.ty - d.y) + Math.abs(d.ta - d.a) * 6
          + (Math.abs(d.tr - d.cr) + Math.abs(d.tg - d.cg) + Math.abs(d.tb - d.cb)) * 0.05;
        if (dd > md) md = dd;
      }
      this.draw(); return md > 0.5 || this.scanning;
    }
    loop() { this.running = true; if (this.tick()) this.raf = requestAnimationFrame(() => this.loop()); else this.running = false; }

    applyStage(sid: string, immediate: boolean) {
      const st = this.stages.find((x) => x.id === sid)!; this.stage = sid;
      if (this.lineEl) this.lineEl.textContent = st.line;
      if (this.numEl) this.numEl.style.color = st.mode === 'universe' ? 'var(--c-pearl)' : 'var(--c-tomato)';
      this.chipsEl?.querySelectorAll<HTMLButtonElement>('.nfun__chip').forEach((b) => b.setAttribute('aria-pressed', b.dataset.st === sid ? 'true' : 'false'));
      cancelAnimationFrame(this.raf); this.scanning = false; this.resolveTargets(st);

      if (immediate) {
        if (this.numEl) this.numEl.textContent = st.num.toLocaleString('en-GB');
        this.dots.forEach((d) => { d.tx = d.ptx; d.ty = d.pty; d.tr = d.ptr; d.tg = d.ptg; d.tb = d.ptb; d.ta = d.pta; d.x = d.tx; d.y = d.ty; d.cr = d.tr; d.cg = d.tg; d.cb = d.tb; d.a = d.ta; });
        this.draw(); return;
      }
      if (st.mode === 'cut') {
        this.tweenNum(st.num, 700);
        this.dots.forEach((d) => { d.resolved = false; d.tx = d.x; d.ty = d.y; d.tr = d.cr; d.tg = d.cg; d.tb = d.cb; d.ta = d.a; });
        this.scanning = true; this.scanX = this.fx0; const t0 = performance.now(), dur = 720;
        const sweep = (now: number) => {
          const k = Math.min(1, (now - t0) / dur); this.scanX = this.fx0 + k * (this.fx1 - this.fx0);
          for (let i = 0; i < this.dots.length; i++) { const d = this.dots[i]; if (!d.resolved && d.ux <= this.scanX) { d.resolved = true; d.tx = d.ptx; d.ty = d.pty; d.tr = d.ptr; d.tg = d.ptg; d.tb = d.ptb; d.ta = d.pta; } }
          this.tick(); if (k < 1) this.raf = requestAnimationFrame(sweep); else { this.scanning = false; this.loop(); }
        };
        this.raf = requestAnimationFrame(sweep);
      } else {
        this.tweenNum(st.num, 560);
        this.dots.forEach((d) => { d.tx = d.ptx; d.ty = d.pty; d.tr = d.ptr; d.tg = d.ptg; d.tb = d.ptb; d.ta = d.pta; });
        this.loop();
      }
    }

    startAuto() {
      this.playing = true; clearInterval(this.autoTimer);
      this.autoTimer = setInterval(() => {
        const i = this.stages.findIndex((s) => s.id === this.stage);
        if (i >= this.stages.length - 1) { this.stopAuto(); return; } // rest on the bloom
        this.applyStage(this.stages[i + 1].id, false);
      }, 3800);
    }
    stopAuto() { this.playing = false; clearInterval(this.autoTimer); }

    hover(e: PointerEvent) {
      if (this.scanning) return;
      const rect = this.canvas.getBoundingClientRect(); const px = e.clientX - rect.left, py = e.clientY - rect.top;
      let best = -1, bd = 12 * 12;
      for (let i = 0; i < this.dots.length; i++) { const d = this.dots[i]; if (d.a < 0.4) continue; const dx = d.x - px, dy = d.y - py, di = dx * dx + dy * dy; if (di < bd) { bd = di; best = i; } }
      if (best === this.hovered) return; this.hovered = best;
      if (best >= 0 && this.tip) {
        const d = this.dots[best]; const st = this.stages.find((x) => x.id === this.stage)!;
        const mk = this.cfg.markets[d.mk].name, nc = this.cfg.necessities[d.nec].name;
        const line = (st.mode === 'universe' || st.mode === 'cut')
          ? `One company · ${mk}`
          : `${this.cfg.necessities[d.nec].k.toUpperCase()} · ${nc}\nBarrier: ${d.tier === 1 ? 'permission to operate' : 'evidence of compliance'} · ${mk}`;
        this.tip.textContent = line; this.tip.style.left = px + 'px'; this.tip.style.top = py + 'px'; this.tip.hidden = false;
      } else if (this.tip) { this.tip.hidden = true; }
      if (!this.running) this.draw();
    }
  }

  const live: NecessityFunnel[] = [];
  function boot() {
    while (live.length) live.pop()?.destroy();
    document.querySelectorAll<HTMLElement>('[data-necessity-funnel]').forEach((el) => live.push(new NecessityFunnel(el)));
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => { while (live.length) live.pop()?.destroy(); });
</script>
