---
interface Props {
  kicker: string;
  title: string;
  body: string;
  href: string;
  cta: string;
}
const { kicker, title, body, href, cta } = Astro.props;
---
<a class="door" href={href}>
  <p class="kicker">{kicker}</p>
  <h3 class="door__title">{title}</h3>
  <p class="door__body">{body}</p>
  <span class="door__cta">{cta} →</span>
</a>

<style>
  .door {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-6) var(--s-5);
    text-decoration: none;
    color: var(--fg);
    border-top: 1px solid var(--rule);
    background: var(--bg);
    transition: background var(--dur-2) var(--ease), color var(--dur-2) var(--ease);
    min-height: 18rem;
  }
  .door:hover {
    background: var(--c-evergreen);
    color: var(--c-pearl);
  }
  .door:hover .kicker,
  .door:hover .door__cta { color: var(--c-pearl); }
  .door__title {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    margin: 0;
  }
  .door__body {
    font-size: var(--fs-md);
    max-width: 30ch;
    flex: 1;
    margin: 0;
  }
  .door__cta {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-block-start: auto;
  }
</style>
