---
import scoreboard from '../data/scoreboard.json';

const closes = scoreboard.window_closes;
const open = scoreboard.window_open;

const closeLabel = new Date(closes).toLocaleDateString('en-GB', {
  year: 'numeric', month: 'long', day: 'numeric'
});

// SSR fallback for the countdown: compute days remaining at build time so the
// span never renders as a literal "..." for crawlers, no-JS users, or first
// paint. Client-side script then takes over and updates every minute.
let ssrDays: string;
let ssrUnit: string;
if (open) {
  const ms = new Date(closes).getTime() - Date.now();
  if (ms <= 0) {
    ssrDays = '0';
    ssrUnit = 'days · closed';
  } else {
    const days = Math.floor(ms / (1000 * 60 * 60 * 24));
    const hours = Math.floor((ms / (1000 * 60 * 60)) % 24);
    if (days > 1) {
      ssrDays = String(days);
      ssrUnit = 'days';
    } else if (days === 1) {
      ssrDays = `1d ${hours}h`;
      ssrUnit = 'remaining';
    } else {
      ssrDays = `${hours}h`;
      ssrUnit = 'remaining';
    }
  }
} else {
  ssrDays = '0';
  ssrUnit = 'days';
}
---
<aside class={`bw ${open ? 'is-open' : 'is-closed'}`} data-window-closes={closes} data-window-open={open ? 'true' : 'false'}>
  <header class="bw__head">
    <span class="bw__dot" aria-hidden="true"></span>
    <span class="bw__label">Betting window · {open ? 'open' : 'closed'}</span>
  </header>

  <div class="bw__body">
    {open ? (
      <>
        <p class="bw__count" data-bw-count>
          <span class="bw__count-num" data-bw-num>{ssrDays}</span>
          <span class="bw__count-unit" data-bw-unit>{ssrUnit}</span>
        </p>
        <p class="bw__close">
          Window closes <time datetime={closes}>{closeLabel}</time>.
          Charity-bound bets accepted at <a href="mailto:wt@hmm.ventures?subject=Scoreboard%20bet">wt@hmm.ventures</a>.
        </p>
      </>
    ) : (
      <p class="bw__close">
        The betting window closed on <time datetime={closes}>{closeLabel}</time>. Predictions stand and are scored annually.
      </p>
    )}
  </div>
</aside>

<script>
  /**
   * Live countdown to scoreboard window close.
   * Client-side only. Recomputes every minute.
   */
  function initBettingWindow() {
    const root = document.querySelector<HTMLElement>('.bw[data-window-closes]');
    if (!root) return;
    const open = root.dataset.windowOpen === 'true';
    if (!open) return;

    const closesIso = root.dataset.windowCloses;
    if (!closesIso) return;
    const closesAt = new Date(closesIso).getTime();

    const numEl = root.querySelector<HTMLElement>('[data-bw-num]');
    const unitEl = root.querySelector<HTMLElement>('[data-bw-unit]');
    if (!numEl || !unitEl) return;

    function tick() {
      const now = Date.now();
      const ms = closesAt - now;
      if (ms <= 0) {
        if (numEl && unitEl) { numEl.textContent = '0'; unitEl.textContent = 'days · closed'; }
        return;
      }
      const days = Math.floor(ms / (1000 * 60 * 60 * 24));
      const hours = Math.floor((ms / (1000 * 60 * 60)) % 24);
      const mins = Math.floor((ms / (1000 * 60)) % 60);

      if (days > 1) {
        if (numEl) numEl.textContent = String(days);
        if (unitEl) unitEl.textContent = 'days';
      } else if (days === 1) {
        if (numEl) numEl.textContent = `1d ${hours}h`;
        if (unitEl) unitEl.textContent = 'remaining';
      } else if (hours > 0) {
        if (numEl) numEl.textContent = `${hours}h ${mins}m`;
        if (unitEl) unitEl.textContent = 'remaining';
      } else {
        if (numEl) numEl.textContent = `${mins}m`;
        if (unitEl) unitEl.textContent = 'remaining';
      }
    }

    tick();
    setInterval(tick, 60_000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBettingWindow);
  } else {
    initBettingWindow();
  }
</script>

<style>
  .bw {
    padding: var(--s-5);
    background: var(--c-evergreen);
    color: var(--c-pearl);
    font-family: var(--f-mono);
    border-left: 3px solid var(--c-tomato);
  }
  .bw.is-closed { border-left-color: color-mix(in srgb, var(--c-tomato) 40%, transparent); }

  .bw__head {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-block-end: var(--s-3);
  }
  .bw__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-tomato);
  }
  .bw.is-closed .bw__dot { background: color-mix(in srgb, var(--c-pearl) 40%, transparent); }

  .bw__label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
  }

  .bw__count {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    margin: 0 0 var(--s-3);
  }
  .bw__count-num {
    font-family: var(--f-display);
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem);
    color: var(--c-tomato);
    line-height: 1;
    font-weight: 400;
  }
  .bw__count-unit {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
  }

  .bw__close {
    font-size: var(--fs-sm);
    line-height: 1.55;
    margin: 0;
  }
  .bw a {
    color: var(--c-pearl);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--c-tomato) 70%, transparent);
  }
  .bw a:hover { color: var(--c-tomato); }
</style>
