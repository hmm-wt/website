---
import scoreboard from '../data/scoreboard.json';
import StatusIndicator from './StatusIndicator.astro';
import { buildContactMailto } from '../utils/mailto.ts';

type Status = 'open' | 'confirmed' | 'refuted' | 'pending';

interface Bet {
  bettor: string;
  direction: 'for' | 'against';
  charity: string;
  amount_usd: number;
  staked_at: string;
}

interface EvidenceLink {
  label: string;
  href: string;
}

interface Prediction {
  id: string;
  certainty_num?: number;
  certainty?: string;
  claim: string;
  testable_by: string;
  last_reviewed?: string;
  resolution_criteria?: string;
  source?: string;
  status: Status;
  evidence?: EvidenceLink[];
  bets: Bet[];
}

const predictions = scoreboard.predictions as Prediction[];

// Each tile shows a horizontal progress bar from "inception" (the earliest
// last_reviewed across the scoreboard, or a 2026-01-01 floor) to testable_by.
// NOW marker shows today's position. Caller may pass `?dryrun` for testing.
const DAY = 24 * 60 * 60 * 1000;
const inceptionFloor = new Date('2026-01-01').getTime();
const inception = Math.min(
  inceptionFloor,
  ...predictions
    .map((p) => (p.last_reviewed ? new Date(p.last_reviewed).getTime() : Number.POSITIVE_INFINITY))
    .filter((t) => Number.isFinite(t))
);
const today = Date.now();
---
<section class="sb">
  <ol class="sb__list" role="list">
    {predictions.map((p) => {
      const testDate = new Date(p.testable_by);
      const testLabel = testDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long' });
      const totalStake = p.bets.reduce((sum, b) => sum + b.amount_usd, 0);
      const certaintyMailto = buildContactMailto(`Scoreboard · ${p.certainty ?? p.id}`);
      const totalMs = testDate.getTime() - inception;
      const elapsedMs = Math.max(0, today - inception);
      const elapsedPct = totalMs > 0 ? Math.max(0, Math.min(100, (elapsedMs / totalMs) * 100)) : 0;
      const daysRemaining = Math.max(0, Math.ceil((testDate.getTime() - today) / DAY));
      const inceptionLabel = new Date(inception).toLocaleDateString('en-GB', { year: 'numeric', month: 'short' });
      return (
        <li class="sb__item" id={p.id}>
          <header class="sb__item-head">
            <p class="sb__item-cnum">{p.certainty_num ? `Certainty ${p.certainty_num}` : p.id}</p>
            <h3 class="sb__item-certainty">{p.certainty ?? p.id}</h3>
          </header>

          <p class="sb__item-claim">{p.claim}</p>

          <div class="sb__item-meta">
            <StatusIndicator status={p.status} />
            <time class="sb__item-test" datetime={p.testable_by}>
              <span class="sb__item-test-label">Testable by</span>
              <span class="sb__item-test-value">{testLabel}</span>
            </time>
          </div>

          <div class="sb__item-progress" style={`--sb-pct: ${elapsedPct.toFixed(2)}%`}>
            <div class="sb__bar" aria-hidden="true">
              <span class="sb__bar-fill"></span>
              <span class="sb__bar-now" title={`Today · ${daysRemaining} days remaining`}></span>
            </div>
            <p class="sb__bar-meta">
              <span class="sb__bar-anchor">{inceptionLabel}</span>
              <span class="sb__bar-remaining">{daysRemaining.toLocaleString('en-GB')} days remaining</span>
              <span class="sb__bar-anchor">{testLabel}</span>
            </p>
          </div>

          {p.evidence && p.evidence.length > 0 && (
            <p class="sb__item-evidence">
              {p.evidence.map((e, i) => (
                <>
                  {i > 0 && <span aria-hidden="true"> · </span>}
                  <a href={e.href}>{e.label}</a>
                </>
              ))}
            </p>
          )}

          <footer class="sb__item-bets">
            <p class="sb__bets-line sb__bets-line--empty">Scored on the dataset.</p>
            <a class="sb__bets-cta" href={`/data/scoreboard/${(p.id as string).toLowerCase()}/`}>Open the claim &rarr;</a>
          </footer>
        </li>
      );
    })}
  </ol>
</section>

<style>
  .sb { padding-block: var(--s-7); }

  .sb__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  .sb__item {
    padding: var(--s-5) var(--s-5) var(--s-4);
    background: var(--c-light-tint);
    border-left: 3px solid var(--c-tomato);
    scroll-margin-top: var(--s-7);
  }

  .sb__item-head {
    margin-block-end: var(--s-4);
    padding-block-end: var(--s-3);
    border-bottom: 1px solid var(--rule);
  }
  .sb__item-cnum {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--c-tomato);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0;
  }
  .sb__item-certainty {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: var(--s-2) 0 0;
    color: var(--fg);
  }

  .sb__item-claim {
    font-family: var(--f-body);
    font-size: var(--fs-base);
    line-height: 1.6;
    margin: 0;
    max-width: 64ch;
    color: var(--fg);
  }

  .sb__item-meta {
    margin-block-start: var(--s-3);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-4);
  }
  .sb__item-test {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
  }
  .sb__item-test-label {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
  }
  .sb__item-test-value {
    color: var(--fg);
    font-weight: 600;
  }

  .sb__item-progress {
    margin-block-start: var(--s-4);
    padding-block-start: var(--s-3);
    border-top: 1px dashed var(--rule);
  }
  .sb__bar {
    position: relative;
    height: 8px;
    background: color-mix(in srgb, var(--c-tomato) 10%, transparent);
    border: 1px solid var(--rule);
    overflow: visible;
  }
  .sb__bar-fill {
    display: block;
    height: 100%;
    width: 0;
    background: linear-gradient(90deg,
      color-mix(in srgb, var(--c-evergreen) 88%, var(--c-tomato)),
      color-mix(in srgb, var(--c-evergreen) 65%, var(--c-tomato)));
    transition: width 880ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sb__item[data-imfig-revealed="true"] .sb__bar-fill {
    width: var(--sb-pct, 0%);
  }
  .sb__bar-now {
    position: absolute;
    top: -3px;
    bottom: -3px;
    left: var(--sb-pct, 0%);
    width: 2px;
    background: var(--c-tomato);
    transform: translateX(-1px);
  }
  .sb__bar-now::after {
    content: "NOW";
    position: absolute;
    bottom: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--c-tomato);
    color: var(--c-pearl);
    font-family: var(--f-mono);
    font-size: calc(var(--fs-xs) * 0.8);
    letter-spacing: 0.15em;
    padding: 0.1rem 0.35rem;
    white-space: nowrap;
  }
  .sb__bar-meta {
    margin: var(--s-3) 0 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--f-mono);
    font-size: calc(var(--fs-xs) * 0.92);
    color: var(--fg-soft);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    gap: var(--s-3);
    flex-wrap: wrap;
  }
  .sb__bar-anchor { color: var(--fg-soft); }
  .sb__bar-remaining { color: var(--c-tomato); font-weight: 700; }
  @media (prefers-reduced-motion: reduce) {
    .sb__bar-fill { transition: none; width: var(--sb-pct, 0%); }
  }

  .sb__item-evidence {
    margin-block-start: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: var(--fg-soft);
  }
  .sb__item-evidence a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }

  .sb__item-bets {
    margin-block-start: var(--s-4);
    padding-block-start: var(--s-3);
    border-top: 1px dashed var(--rule);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
  }
  .sb__bets-line {
    margin: 0;
    color: var(--fg-soft);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .sb__bets-count, .sb__bets-stake { color: var(--fg); font-weight: 600; }
  .sb__bets-sep { color: var(--fg-faint); margin: 0 0.5em; }
  .sb__bets-line--empty { color: var(--fg-soft); }
  .sb__bets-cta {
    color: var(--c-tomato);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .sb__bets-cta:hover { color: var(--c-mahogany); border-bottom-color: var(--c-mahogany); }
</style>

<script>
  import '../scripts/imfig-reveal';
</script>
