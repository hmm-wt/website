---
import scoreboard from '../data/scoreboard.json';
import StatusIndicator from './StatusIndicator.astro';
import { buildContactMailto } from '../utils/mailto.ts';

type Status = 'open' | 'confirmed' | 'refuted' | 'pending';

interface Bet {
  bettor: string;
  direction: 'for' | 'against';
  charity: string;
  amount_usd: number;
  staked_at: string;
}

interface EvidenceLink {
  label: string;
  href: string;
}

const predictions = scoreboard.predictions as Array<{
  id: string;
  certainty_num?: number;
  certainty?: string;
  claim: string;
  testable_by: string;
  status: Status;
  evidence?: EvidenceLink[];
  bets: Bet[];
}>;
---
<section class="sb">
  <ol class="sb__list" role="list">
    {predictions.map((p) => {
      const testLabel = new Date(p.testable_by).toLocaleDateString('en-GB', { year: 'numeric', month: 'long' });
      const totalStake = p.bets.reduce((sum, b) => sum + b.amount_usd, 0);
      const certaintyMailto = buildContactMailto(`Scoreboard · ${p.certainty ?? p.id}`);
      return (
        <li class="sb__item" id={p.id}>
          <header class="sb__item-head">
            <p class="sb__item-cnum">{p.certainty_num ? `Certainty ${p.certainty_num}` : p.id}</p>
            <h3 class="sb__item-certainty">{p.certainty ?? p.id}</h3>
          </header>

          <p class="sb__item-claim">{p.claim}</p>

          <div class="sb__item-meta">
            <StatusIndicator status={p.status} />
            <time class="sb__item-test" datetime={p.testable_by}>
              <span class="sb__item-test-label">Testable by</span>
              <span class="sb__item-test-value">{testLabel}</span>
            </time>
          </div>

          {p.evidence && p.evidence.length > 0 && (
            <p class="sb__item-evidence">
              {p.evidence.map((e, i) => (
                <>
                  {i > 0 && <span aria-hidden="true"> · </span>}
                  <a href={e.href}>{e.label}</a>
                </>
              ))}
            </p>
          )}

          <footer class="sb__item-bets">
            {p.bets.length > 0 ? (
              <p class="sb__bets-line">
                <span class="sb__bets-count">{p.bets.length} {p.bets.length === 1 ? 'bet' : 'bets'}</span>
                <span class="sb__bets-sep">·</span>
                <span class="sb__bets-stake">${totalStake.toLocaleString('en-US')} staked</span>
              </p>
            ) : (
              <p class="sb__bets-line sb__bets-line--empty">Open for bets.</p>
            )}
            <a class="sb__bets-cta" href={certaintyMailto}>Bet on this →</a>
          </footer>
        </li>
      );
    })}
  </ol>
</section>

<style>
  .sb { padding-block: var(--s-7); }

  .sb__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  .sb__item {
    padding: var(--s-5) var(--s-5) var(--s-4);
    background: var(--c-light-tint);
    border-left: 3px solid var(--c-tomato);
    scroll-margin-top: var(--s-7);
  }

  .sb__item-head {
    margin-block-end: var(--s-4);
    padding-block-end: var(--s-3);
    border-bottom: 1px solid var(--rule);
  }
  .sb__item-cnum {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--c-tomato);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0;
  }
  .sb__item-certainty {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: var(--s-2) 0 0;
    color: var(--fg);
  }

  .sb__item-claim {
    font-family: var(--f-body);
    font-size: var(--fs-base);
    line-height: 1.6;
    margin: 0;
    max-width: 64ch;
    color: var(--fg);
  }

  .sb__item-meta {
    margin-block-start: var(--s-3);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-4);
  }
  .sb__item-test {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
  }
  .sb__item-test-label {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
  }
  .sb__item-test-value {
    color: var(--fg);
    font-weight: 600;
  }

  .sb__item-evidence {
    margin-block-start: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: var(--fg-soft);
  }
  .sb__item-evidence a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }

  .sb__item-bets {
    margin-block-start: var(--s-4);
    padding-block-start: var(--s-3);
    border-top: 1px dashed var(--rule);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
  }
  .sb__bets-line {
    margin: 0;
    color: var(--fg-soft);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .sb__bets-count, .sb__bets-stake { color: var(--fg); font-weight: 600; }
  .sb__bets-sep { color: var(--fg-faint); margin: 0 0.5em; }
  .sb__bets-line--empty { color: var(--fg-soft); }
  .sb__bets-cta {
    color: var(--c-tomato);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .sb__bets-cta:hover { color: var(--c-mahogany); border-bottom-color: var(--c-mahogany); }
</style>
