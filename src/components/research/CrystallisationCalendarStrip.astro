---
/**
 * V4 — CrystallisationCalendarStrip.
 *
 * Thirty-four in-flight regulations across the four target markets, plotted
 * 2024–2030 with a sticky year axis and per-market rows. Horizontal scroll
 * (native overflow-x). Click a chip → detail panel below the strip.
 *
 * Source: /src/data/crystallisation-window.json (refreshed monthly).
 */
import TagFilter from '../TagFilter.astro';
import calendar from '../../data/crystallisation-window.json';

const MARKETS = ['AU', 'JP', 'NZ', 'SG'] as const;
const MARKET_NAMES: Record<string, string> = { AU: 'AUS', JP: 'JPN', NZ: 'NZL', SG: 'SIN' };
const yearList = Array.from(new Set(calendar.regulations.map((r) => r.effective_year))).sort();
const minYear = yearList[0];
const maxYear = yearList[yearList.length - 1];
const yearSpan = maxYear - minYear + 1;
const nowYear = new Date().getFullYear();
const necessityList = Array.from(new Set(calendar.regulations.map((r) => r.necessity))).sort();

const filterGroups = [
  { key: 'market', label: 'Market', options: ['AU', 'JP', 'NZ', 'SG'] },
  { key: 'necessity', label: 'Necessity', options: necessityList },
  { key: 'tier', label: 'Tier', options: ['T1', 'T2'] }
];

// Group regs by market, then plot each at its year column.
const regsByMarket: Record<string, typeof calendar.regulations> = { AU: [], JP: [], NZ: [], SG: [] };
calendar.regulations.forEach((r) => {
  if (regsByMarket[r.market]) regsByMarket[r.market].push(r);
});
---
<section class="ccs motion-group" aria-label="Crystallisation window timeline">
  <div class="ccs__controls">
    <TagFilter groups={filterGroups} target=".ccs__chip" />
  </div>

  <div class="ccs__scroll" tabindex="0" role="region" aria-label="Scrollable regulatory timeline">
    <div class="ccs__plot" style={`--year-count: ${yearSpan}; --min-year: ${minYear};`}>
      <!-- Per-market rows. -->
      {MARKETS.map((m) => (
        <div class="ccs__row" data-market-row={m}>
          <span class="ccs__row-label">{MARKET_NAMES[m]}</span>
          <div class="ccs__row-track">
            {regsByMarket[m].map((r, idx) => (
              <button
                type="button"
                class={`ccs__chip ccs__chip--${r.tier.toLowerCase()} stagger-row`}
                style={`--i: ${idx % 8}; --col: ${r.effective_year - minYear};`}
                data-market={r.market}
                data-necessity={r.necessity}
                data-tier={r.tier}
                data-reg-id={r.id}
                data-reg-title={r.title}
                data-reg-status={r.status}
                data-reg-year={r.effective_year}
                aria-label={`${r.tier} regulation: ${r.title}, ${r.market}, effective ${r.effective_year}.`}
              >
                <span class="ccs__chip-tier">{r.tier}</span>
                <span class="ccs__chip-title">{r.title}</span>
              </button>
            ))}
          </div>
        </div>
      ))}

      <!-- NOW marker. -->
      <div
        class="ccs__now now-pulse"
        style={`--col: ${nowYear - minYear};`}
        aria-hidden="true"
      >
        <span class="ccs__now-label">NOW · {nowYear}</span>
      </div>

      <!-- Year axis. -->
      <div class="ccs__axis">
        {yearList.map((y) => (
          <div class="ccs__year" style={`--col: ${y - minYear};`}>
            <span class="ccs__year-label">{y}</span>
            <span class="ccs__year-count">{calendar.year_counts[y as unknown as keyof typeof calendar.year_counts] ?? 0}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <aside class="ccs__panel panel-slide" data-ccs-panel data-open="false" aria-live="polite">
    <header class="ccs__panel-head">
      <p class="kicker ccs__panel-kicker">Selected regulation</p>
      <button type="button" class="ccs__panel-close" data-ccs-close aria-label="Close">x</button>
    </header>
    <h3 class="ccs__panel-title" data-ccs-title>Click a chip to see detail.</h3>
    <dl class="ccs__panel-meta">
      <div><dt>Market</dt><dd data-ccs-market>—</dd></div>
      <div><dt>Necessity</dt><dd data-ccs-necessity>—</dd></div>
      <div><dt>Tier</dt><dd data-ccs-tier>—</dd></div>
      <div><dt>Status</dt><dd data-ccs-status>—</dd></div>
      <div><dt>Effective year</dt><dd data-ccs-year>—</dd></div>
    </dl>
    <p class="ccs__panel-note">Primary regulator portal references are catalogued in the public dataset.</p>
  </aside>
</section>

<script>
  function initCcs() {
    document.querySelectorAll<HTMLElement>('.ccs').forEach((root) => {
      const panel = root.querySelector<HTMLElement>('[data-ccs-panel]');
      if (!panel) return;
      const title = panel.querySelector<HTMLElement>('[data-ccs-title]')!;
      const fields = {
        market: panel.querySelector<HTMLElement>('[data-ccs-market]')!,
        necessity: panel.querySelector<HTMLElement>('[data-ccs-necessity]')!,
        tier: panel.querySelector<HTMLElement>('[data-ccs-tier]')!,
        status: panel.querySelector<HTMLElement>('[data-ccs-status]')!,
        year: panel.querySelector<HTMLElement>('[data-ccs-year]')!,
      };

      const select = (chip: HTMLElement) => {
        title.textContent = chip.dataset.regTitle ?? '';
        fields.market.textContent = chip.dataset.market ?? '';
        fields.necessity.textContent = chip.dataset.necessity ?? '';
        fields.tier.textContent = chip.dataset.tier ?? '';
        fields.status.textContent = chip.dataset.regStatus ?? '';
        fields.year.textContent = chip.dataset.regYear ?? '';
        panel.dataset.open = 'true';
        root.querySelectorAll('.ccs__chip').forEach((c) => c.classList.remove('is-selected'));
        chip.classList.add('is-selected');
      };

      root.querySelectorAll<HTMLButtonElement>('.ccs__chip').forEach((chip) => {
        chip.addEventListener('click', () => select(chip));
      });
      root.querySelector<HTMLButtonElement>('[data-ccs-close]')?.addEventListener('click', () => {
        panel.dataset.open = 'false';
        root.querySelectorAll('.ccs__chip').forEach((c) => c.classList.remove('is-selected'));
      });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCcs);
  } else {
    initCcs();
  }
</script>

<style>
  .ccs {
    margin-block: var(--s-6);
    border-block: 1px solid var(--rule);
  }
  .ccs__controls {
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--rule);
  }
  .ccs__scroll {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    background: color-mix(in srgb, var(--c-pearl) 22%, transparent);
  }
  .ccs__scroll:focus { outline: 2px solid var(--c-tomato); outline-offset: -2px; }

  /* Grid: each year is a 12rem-wide column. The plot is positioned absolutely
   * via grid-column on each chip + axis tick using var(--col). */
  .ccs__plot {
    position: relative;
    display: grid;
    grid-template-columns: 4rem repeat(var(--year-count), 12rem);
    grid-template-rows: auto auto auto auto auto;
    grid-auto-flow: row;
    padding-block: var(--s-4) 0;
  }

  .ccs__row {
    display: contents;
  }
  .ccs__row-label {
    grid-column: 1;
    align-self: center;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-tomato);
    padding-inline: var(--s-3);
    border-inline-end: 1px solid var(--rule);
  }
  .ccs__row-track {
    grid-column: 2 / -1;
    display: grid;
    grid-template-columns: repeat(var(--year-count), 12rem);
    grid-template-rows: minmax(3rem, auto);
    align-items: start;
    padding-block: var(--s-2);
    border-bottom: 1px dashed var(--rule);
    position: relative;
  }

  .ccs__chip {
    grid-column: calc(var(--col) + 1) / span 1;
    align-self: start;
    justify-self: start;
    margin: 2px 6px;
    padding: 0.35rem 0.5rem;
    border: 1px solid currentColor;
    background: var(--bg, var(--c-pearl));
    font-family: var(--f-mono);
    font-size: calc(var(--fs-xs) * 0.95);
    line-height: 1.3;
    cursor: pointer;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    max-width: 11rem;
    color: var(--c-mahogany);
    transition: background var(--mo-tick) var(--ease-golden), color var(--mo-tick) var(--ease-golden);
  }
  .ccs__chip--t1 { color: var(--c-tomato); }
  .ccs__chip--t2 { color: var(--c-mahogany); }
  .ccs__chip:hover { background: color-mix(in srgb, currentColor 12%, var(--c-pearl)); }
  .ccs__chip.is-selected { background: currentColor; color: var(--c-pearl); }
  .ccs__chip.is-selected .ccs__chip-tier, .ccs__chip.is-selected .ccs__chip-title { color: inherit; }

  .ccs__chip-tier {
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .ccs__chip-title {
    font-size: 0.78rem;
    color: var(--fg);
    text-transform: none;
    letter-spacing: 0.01em;
  }

  .ccs__now {
    grid-column: calc(var(--col) + 2) / span 1;
    grid-row: 1 / -1;
    width: 2px;
    background: var(--c-tomato);
    justify-self: start;
    margin-inline-start: -1px;
    position: relative;
  }
  .ccs__now-label {
    position: absolute;
    top: -1.4rem;
    left: 0;
    transform: translateX(-50%);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: var(--c-tomato);
    font-weight: 600;
    white-space: nowrap;
    letter-spacing: 0.12em;
  }

  .ccs__axis {
    grid-column: 2 / -1;
    display: grid;
    grid-template-columns: repeat(var(--year-count), 12rem);
    border-top: 1px solid var(--rule);
    padding-block: var(--s-3);
    background: color-mix(in srgb, var(--c-pearl) 60%, transparent);
    position: sticky;
    bottom: 0;
  }
  .ccs__year {
    grid-column: calc(var(--col) + 1) / span 1;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding-inline: var(--s-3);
    border-inline-start: 1px solid var(--rule);
  }
  .ccs__year:first-of-type { border-inline-start: 0; }
  .ccs__year-label {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    color: var(--c-mahogany);
    line-height: 1;
  }
  .ccs__year-count {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
  }

  /* Detail panel below the strip. */
  .ccs__panel {
    padding: var(--s-5);
    background: var(--c-evergreen);
    color: var(--c-pearl);
    border-top: 2px solid var(--c-tomato);
  }
  .ccs__panel[data-open="false"] { display: none; }
  .ccs__panel-head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    margin-block-end: var(--s-3);
  }
  .ccs__panel-kicker { color: var(--c-tomato); margin: 0; }
  .ccs__panel-close {
    margin-inline-start: auto;
    background: none;
    border: 1px solid color-mix(in srgb, var(--c-pearl) 30%, transparent);
    color: var(--c-pearl);
    font-size: 20px;
    width: 32px;
    height: 32px;
    line-height: 1;
    cursor: pointer;
  }
  .ccs__panel-close:hover { color: var(--c-tomato); border-color: var(--c-tomato); }
  .ccs__panel-title {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-tight);
    margin: 0 0 var(--s-4);
    color: var(--c-pearl);
    max-width: 60ch;
  }
  .ccs__panel-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--s-3);
    margin: 0 0 var(--s-3);
  }
  .ccs__panel-meta div { display: flex; flex-direction: column; gap: 2px; }
  .ccs__panel-meta dt {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
  }
  .ccs__panel-meta dd {
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    margin: 0;
    color: var(--c-pearl);
  }
  .ccs__panel-note {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: color-mix(in srgb, var(--c-pearl) 65%, transparent);
    margin: 0;
    padding-block-start: var(--s-3);
    border-top: 1px solid color-mix(in srgb, var(--c-pearl) 18%, transparent);
  }

  @media (max-width: 720px) {
    .ccs__plot {
      grid-template-columns: 3rem repeat(var(--year-count), 9rem);
    }
    .ccs__row-track, .ccs__axis {
      grid-template-columns: repeat(var(--year-count), 9rem);
    }
    .ccs__chip { max-width: 8rem; }
  }
</style>
