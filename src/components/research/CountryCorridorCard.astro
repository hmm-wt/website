---
/**
 * V3a — CountryCorridorCard.
 *
 * Single market card. Used by CountryCorridorGrid. Hover or focus expands
 * the card horizontally (via flex-grow), revealing the in-flight reg list
 * and the portfolio allocation. Fauna glyph as the visual anchor.
 */
interface Reg {
  id: string;
  title: string;
  effective_year: number;
  tier: string;
  status: string;
}

interface Props {
  code: string;            // ISO-style 3-letter, e.g. "AUS"
  legacyCode: string;      // 2-letter, e.g. "AU" — matches per_market and per_market data
  name: string;            // "Australia"
  fauna: string;           // /fauna/hmm-fauna-au-wattle.svg
  inThesisCompanies: number | null;
  regulations: number;
  t1: number;
  t2: number;
  portfolioAllocation: number;  // 9 / 8 / 5 / 3
  inFlightRegs: Reg[];
  href: string;            // /thesis/australia/
}

const {
  code, legacyCode, name, fauna,
  inThesisCompanies, regulations, t1, t2,
  portfolioAllocation, inFlightRegs, href
} = Astro.props;

const topRegs = inFlightRegs.slice(0, 3);
---
<article class="ccc" data-market={legacyCode}>
  <a class="ccc__link" href={href} aria-label={`${name} corridor detail`}>
    <header class="ccc__head">
      <img class="ccc__fauna" src={fauna} alt="" loading="lazy" />
      <div class="ccc__codes">
        <span class="ccc__code">{code}</span>
        <span class="ccc__name">{name}</span>
      </div>
    </header>

    <div class="ccc__stats">
      {inThesisCompanies !== null ? (
        <div class="ccc__stat">
          <span class="ccc__stat-value">{inThesisCompanies.toLocaleString('en-GB')}</span>
          <span class="ccc__stat-label">Companies classified</span>
        </div>
      ) : (
        <div class="ccc__stat">
          <span class="ccc__stat-value ccc__stat-value--pending">—</span>
          <span class="ccc__stat-label">Companies pending re-query</span>
        </div>
      )}
      <div class="ccc__stat">
        <span class="ccc__stat-value">{regulations}</span>
        <span class="ccc__stat-label">Regulations · {t1} T1 / {t2} T2</span>
      </div>
      <div class="ccc__stat">
        <span class="ccc__stat-value">{portfolioAllocation}</span>
        <span class="ccc__stat-label">Portfolio positions</span>
      </div>
    </div>

    <div class="ccc__reveal" aria-hidden="false">
      <p class="ccc__reveal-label">In flight</p>
      <ul class="ccc__regs" role="list">
        {topRegs.map((r) => (
          <li class="ccc__reg">
            <span class="ccc__reg-year">{r.effective_year}</span>
            <span class="ccc__reg-tier">{r.tier}</span>
            <span class="ccc__reg-title">{r.title}</span>
          </li>
        ))}
        {topRegs.length === 0 && (
          <li class="ccc__reg ccc__reg--empty">No in-flight regulations in the current dataset window.</li>
        )}
      </ul>
      <p class="ccc__cta">Corridor detail <span aria-hidden="true">→</span></p>
    </div>
  </a>
</article>

<style>
  .ccc {
    flex: 1 1 0;
    min-width: 0;
    transition: flex var(--mo-hold) var(--ease-golden);
    border-inline-start: 1px solid var(--rule);
  }
  .ccc:first-child { border-inline-start: 0; }
  .ccc:hover, .ccc:focus-within { flex: 1.6 1 0; }

  .ccc__link {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-5);
    text-decoration: none;
    color: var(--fg);
    height: 100%;
    transition: background var(--mo-tick) var(--ease-golden);
  }
  .ccc:hover .ccc__link, .ccc:focus-within .ccc__link {
    background: color-mix(in srgb, var(--c-tomato) 5%, transparent);
  }

  .ccc__head {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding-block-end: var(--s-3);
    border-bottom: 1px solid var(--rule);
  }
  .ccc__fauna {
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    filter: brightness(0) saturate(100%);
    opacity: 0.85;
    transition: opacity var(--mo-tick) var(--ease-golden);
  }
  .ccc:hover .ccc__fauna, .ccc:focus-within .ccc__fauna { opacity: 1; }
  .ccc__codes { display: flex; flex-direction: column; gap: 0.1rem; }
  .ccc__code {
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-tomato);
    font-weight: 600;
  }
  .ccc__name {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: 1.1;
    color: var(--fg);
  }

  .ccc__stats {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .ccc__stat { display: flex; flex-direction: column; gap: 0.15rem; }
  .ccc__stat-value {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: 1;
    color: var(--c-tomato);
    letter-spacing: -0.01em;
  }
  .ccc__stat-value--pending { color: var(--fg-faint); }
  .ccc__stat-label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-soft);
  }

  /* Reveal block — visible only when the card is expanded. */
  .ccc__reveal {
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition: opacity var(--mo-hold) var(--ease-golden),
                max-height var(--mo-hold) var(--ease-golden);
  }
  .ccc:hover .ccc__reveal, .ccc:focus-within .ccc__reveal {
    opacity: 1;
    max-height: 24rem;
  }
  .ccc__reveal-label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-tomato);
    margin: 0 0 var(--s-2);
  }
  .ccc__regs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .ccc__reg {
    display: grid;
    grid-template-columns: 3rem 2rem minmax(0, 1fr);
    gap: var(--s-2);
    align-items: baseline;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    padding-block: var(--s-2);
    border-top: 1px dashed var(--rule);
  }
  .ccc__reg:first-child { border-top: 0; }
  .ccc__reg--empty { display: block; color: var(--fg-faint); font-style: italic; }
  .ccc__reg-year { color: var(--fg-soft); }
  .ccc__reg-tier { color: var(--c-tomato); font-weight: 600; }
  .ccc__reg-title { color: var(--fg); line-height: 1.4; }
  .ccc__cta {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-tomato);
    margin: var(--s-3) 0 0;
    padding-block-start: var(--s-2);
    border-top: 1px solid var(--rule);
  }

  /* Mobile: stack vertically with all reveal blocks visible by default. */
  @media (max-width: 800px) {
    .ccc {
      flex: 1 1 100%;
      border-inline-start: 0;
      border-top: 1px solid var(--rule);
    }
    .ccc:first-child { border-top: 0; }
    .ccc:hover, .ccc:focus-within { flex: 1 1 100%; }
    .ccc__reveal { opacity: 1; max-height: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ccc, .ccc__reveal, .ccc__fauna {
      transition: none;
    }
  }
</style>
