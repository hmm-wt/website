---
/**
 * V10 — ClassifierProbe.
 *
 * Founder-facing utility. Paste a one-liner about your company, the probe
 * returns a rules-based T1 / T2 / excluded verdict. Client-side keyword
 * matching only — no API call, no telemetry. Designed to communicate the
 * fund's screen, not to substitute for it.
 *
 * Source: /src/data/classifier-rules.json (illustrative rule set; deployed
 * pipeline applies a two-stage validator with registry joins, per IM
 * Appendix F).
 */
import rules from '../../data/classifier-rules.json';
---
<section class="cpr" aria-label="Classifier probe">
  <header class="cpr__head">
    <p class="kicker cpr__kicker">Founder probe · public utility</p>
    <h2 class="cpr__title">Paste a one-liner. See what the screen reads.</h2>
    <p class="cpr__lede">
      Drop a sentence describing the company. The probe applies a published rule order: off-mandate first, then T1 (licence), then T2 (compulsion). The deployed classifier is more nuanced. This is the front door.
    </p>
  </header>

  <form class="cpr__form" data-cpr-form onsubmit="return false;">
    <label class="cpr__label" for="cpr-input">Your one-liner</label>
    <textarea
      class="cpr__input"
      id="cpr-input"
      name="input"
      rows="3"
      placeholder="e.g. We sell TGA-cleared software to AU hospitals that automates clinical handover."
      data-cpr-input
    ></textarea>
    <div class="cpr__actions">
      <button type="button" class="cpr__btn" data-cpr-run>Classify</button>
      <button type="button" class="cpr__btn cpr__btn--ghost" data-cpr-clear>Clear</button>
    </div>
  </form>

  <article class="cpr__verdict" data-cpr-verdict data-outcome="pending" aria-live="polite">
    <header class="cpr__verdict-head">
      <span class="cpr__verdict-tag" data-cpr-tag>Pending</span>
      <span class="cpr__verdict-rule" data-cpr-rule>Type a sentence above to see the verdict.</span>
    </header>
    <p class="cpr__verdict-explain" data-cpr-explain>The verdict, the rule that matched, and a worked next step will print here.</p>
    <p class="cpr__verdict-next" data-cpr-next hidden></p>
    <details class="cpr__rules">
      <summary>How the probe decides</summary>
      <ol>
        {rules.rules.map((r) => (
          <li class={`cpr__rule cpr__rule--${r.outcome}`}>
            <strong>{r.label}.</strong> {r.explanation}
            {r.keywords && r.keywords.length > 0 && (
              <p class="cpr__rule-kw"><span>Matches if input contains: </span>{r.keywords.slice(0, 6).join(', ')}{r.keywords.length > 6 ? ', …' : ''}</p>
            )}
          </li>
        ))}
      </ol>
      <p class="cpr__rules-foot">Order of evaluation is top-down. The first matching rule wins. Off-mandate exclusions are evaluated before T1 / T2.</p>
    </details>
  </article>
</section>

<script>
  import rulesData from '../../data/classifier-rules.json';

  type Rule = {
    id: string;
    label: string;
    outcome: 'excluded' | 't1' | 't2';
    keywords: string[];
    explanation: string;
    next_step?: string;
    is_default?: boolean;
  };

  function classify(input: string, rules: Rule[]) {
    const text = input.toLowerCase();
    if (!text.trim()) return null;
    for (const rule of rules) {
      if (rule.is_default) continue;
      if (rule.keywords.some((kw) => text.includes(kw.toLowerCase()))) {
        return rule;
      }
    }
    return rules.find((r) => r.is_default) ?? null;
  }

  function initCpr() {
    document.querySelectorAll<HTMLElement>('.cpr').forEach((root) => {
      const input = root.querySelector<HTMLTextAreaElement>('[data-cpr-input]');
      const verdict = root.querySelector<HTMLElement>('[data-cpr-verdict]');
      const tag = root.querySelector<HTMLElement>('[data-cpr-tag]');
      const rule = root.querySelector<HTMLElement>('[data-cpr-rule]');
      const explain = root.querySelector<HTMLElement>('[data-cpr-explain]');
      const next = root.querySelector<HTMLElement>('[data-cpr-next]');
      const run = root.querySelector<HTMLButtonElement>('[data-cpr-run]');
      const clear = root.querySelector<HTMLButtonElement>('[data-cpr-clear]');
      if (!input || !verdict || !tag || !rule || !explain || !next || !run || !clear) return;

      const update = () => {
        const result = classify(input.value, rulesData.rules as Rule[]);
        if (!result) {
          verdict.dataset.outcome = 'pending';
          tag.textContent = 'Pending';
          rule.textContent = 'Type a sentence above to see the verdict.';
          explain.textContent = 'The verdict, the rule that matched, and a worked next step will print here.';
          next.hidden = true;
          return;
        }
        verdict.dataset.outcome = result.outcome;
        tag.textContent = result.outcome === 't1' ? 'T1' : result.outcome === 't2' ? 'T2' : 'EXCLUDED';
        rule.textContent = result.label;
        explain.textContent = result.explanation;
        if (result.next_step) {
          next.hidden = false;
          next.textContent = result.next_step;
        } else {
          next.hidden = true;
        }
      };

      let debounce: number | undefined;
      input.addEventListener('input', () => {
        window.clearTimeout(debounce);
        debounce = window.setTimeout(update, 220);
      });
      run.addEventListener('click', update);
      clear.addEventListener('click', () => {
        input.value = '';
        update();
        input.focus();
      });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCpr);
  } else {
    initCpr();
  }
</script>

<style>
  .cpr {
    margin-block: var(--s-6);
    padding: var(--s-5);
    border-block: 1px solid var(--rule);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-5);
    align-items: start;
  }
  @media (max-width: 800px) {
    .cpr { grid-template-columns: 1fr; }
  }

  .cpr__head { grid-column: 1 / -1; }
  .cpr__kicker { color: var(--c-tomato); margin: 0; }
  .cpr__title {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-tight);
    margin: var(--s-2) 0 var(--s-3);
    max-width: 32ch;
  }
  .cpr__lede {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: var(--lh-loose);
    color: var(--fg-soft);
    margin: 0 0 var(--s-3);
    max-width: 64ch;
  }

  .cpr__form { display: flex; flex-direction: column; gap: var(--s-3); }
  .cpr__label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-soft);
  }
  .cpr__input {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: 1.5;
    padding: var(--s-3);
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--c-pearl) 40%, transparent);
    color: var(--fg);
    resize: vertical;
    min-height: 5rem;
  }
  .cpr__input:focus { outline: 2px solid var(--c-tomato); outline-offset: -1px; }
  .cpr__actions { display: flex; gap: var(--s-3); }
  .cpr__btn {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: var(--s-2) var(--s-4);
    background: var(--c-tomato);
    color: var(--c-pearl);
    border: 0;
    cursor: pointer;
    transition: background var(--mo-tick) var(--ease-golden);
  }
  .cpr__btn:hover { background: var(--c-mahogany); }
  .cpr__btn--ghost {
    background: transparent;
    color: var(--c-tomato);
    border: 1px solid var(--c-tomato);
  }
  .cpr__btn--ghost:hover { background: var(--c-tomato); color: var(--c-pearl); }

  .cpr__verdict {
    padding: var(--s-4);
    border-left: 2px solid var(--rule);
    background: color-mix(in srgb, var(--c-pearl) 35%, transparent);
    transition: border-left-color var(--mo-tick) var(--ease-golden), background var(--mo-tick) var(--ease-golden);
  }
  .cpr__verdict[data-outcome="t1"] { border-left-color: var(--c-tomato); background: color-mix(in srgb, var(--c-tomato) 6%, var(--c-pearl)); }
  .cpr__verdict[data-outcome="t2"] { border-left-color: var(--c04, var(--c-mahogany)); background: color-mix(in srgb, var(--c04, var(--c-mahogany)) 4%, var(--c-pearl)); }
  .cpr__verdict[data-outcome="excluded"] { border-left-color: var(--fg-faint); }

  .cpr__verdict-head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin-block-end: var(--s-3);
    padding-block-end: var(--s-3);
    border-bottom: 1px solid var(--rule);
  }
  .cpr__verdict-tag {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: 1;
    color: var(--c-tomato);
    letter-spacing: -0.01em;
  }
  .cpr__verdict[data-outcome="t2"] .cpr__verdict-tag { color: var(--c04, var(--c-mahogany)); }
  .cpr__verdict[data-outcome="excluded"] .cpr__verdict-tag { color: var(--fg-soft); }
  .cpr__verdict[data-outcome="pending"] .cpr__verdict-tag { color: var(--fg-faint); }
  .cpr__verdict-rule {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
  }

  .cpr__verdict-explain {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: 1.55;
    color: var(--fg);
    margin: 0 0 var(--s-3);
  }
  .cpr__verdict-next {
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--c-tomato);
    margin: 0;
    padding-block-start: var(--s-3);
    border-top: 1px dashed var(--rule);
  }

  .cpr__rules {
    margin-block-start: var(--s-4);
    padding-block-start: var(--s-3);
    border-top: 1px solid var(--rule);
  }
  .cpr__rules summary {
    cursor: pointer;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-tomato);
    margin-block-end: var(--s-3);
  }
  .cpr__rules ol {
    margin: var(--s-3) 0 0;
    padding-inline-start: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .cpr__rule {
    font-family: var(--f-body);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--fg);
  }
  .cpr__rule--t1::marker { color: var(--c-tomato); }
  .cpr__rule--t2::marker { color: var(--c04, var(--c-mahogany)); }
  .cpr__rule--excluded::marker { color: var(--fg-faint); }
  .cpr__rule-kw {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: var(--fg-soft);
    margin: var(--s-2) 0 0;
  }
  .cpr__rule-kw span { color: var(--fg-faint); }
  .cpr__rules-foot {
    margin-block-start: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: var(--fg-soft);
    line-height: 1.5;
  }
</style>
