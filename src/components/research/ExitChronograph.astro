---
/**
 * V5 — ExitChronograph.
 *
 * Nine named developed-APAC regulated-company acquisitions along a 2020–2026
 * axis, sized by disclosed deal value, coloured by Necessity. Hover a dot to
 * preview the deal; click to pin the detail panel. Primary-source URLs ship
 * with the panel.
 *
 * Source: /src/data/exits-named.json (verified per IM §3.4).
 */
import exits from '../../data/exits-named.json';

const yearList = Array.from(new Set(exits.exits.map((e) => e.year))).sort();
const minYear = Math.min(...yearList);
const maxYear = Math.max(...yearList);

const W = 800;
const H = 360;
const ml = 60, mr = 60, mt = 50, mb = 80;
const iw = W - ml - mr;
const ih = H - mt - mb;

// Necessity → chart token. Power and Food sit alongside Biomedical to keep
// the colour count under the four-tier palette discipline.
const necessityColor: Record<string, string> = {
  Biomedical: 'var(--c01)',
  Power: 'var(--c02)',
  'Food Security': 'var(--c04)',
  Autonomous: 'var(--c05)',
  'Critical Materials': 'var(--c06)'
};

// Disclosed deal values converted to USD millions where the IM provides a USD
// figure; AUD values converted at the rates implied by the IM proof-points
// commentary. Undisclosed deals get a fixed minimum radius and no value chip.
const maxValue = Math.max(...exits.exits.map((e) => e.value_usd_m_high ?? 0));

// Vertical jitter to avoid label collisions when two deals share a year.
const yearCounts: Record<number, number> = {};
exits.exits.forEach((e) => { yearCounts[e.year] = (yearCounts[e.year] ?? 0) + 1; });
const yearIndex: Record<number, number> = {};

const dots = exits.exits.map((e, i) => {
  const x = ml + ((e.year - minYear) / Math.max(1, maxYear - minYear)) * iw;
  const stack = yearCounts[e.year];
  const slot = (yearIndex[e.year] = (yearIndex[e.year] ?? -1) + 1);
  const yCenter = mt + ih / 2;
  const ySpread = ih * 0.55;
  const y = stack === 1
    ? yCenter
    : yCenter - ySpread / 2 + (ySpread / (stack - 1)) * slot;
  const valueScaled = e.value_usd_m_high ?? 0;
  const r = valueScaled === 0
    ? 4
    : 4 + Math.sqrt(valueScaled / maxValue) * 14;
  return {
    ...e,
    i,
    x,
    y,
    r,
    color: necessityColor[e.necessity] ?? 'var(--c-mahogany)'
  };
});
---
<section class="exc motion-group" aria-label="Named exit chronograph">
  <div class="exc__viz">
    <svg
      class="exc__svg"
      viewBox={`0 0 ${W} ${H}`}
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label={`Exit chronograph: ${dots.length} named developed-APAC regulated-company acquisitions from ${minYear} to ${maxYear}.`}
    >
      <!-- Year axis -->
      <line x1={ml} y1={H - mb} x2={W - mr} y2={H - mb} class="exc__axis" />
      {yearList.map((y) => {
        const x = ml + ((y - minYear) / Math.max(1, maxYear - minYear)) * iw;
        return (
          <g class="exc__tick" transform={`translate(${x}, ${H - mb})`}>
            <line x1="0" y1="0" x2="0" y2="6" class="exc__axis" />
            <text x="0" y="22" text-anchor="middle" class="exc__year">{y}</text>
            <text x="0" y="38" text-anchor="middle" class="exc__year-count">{yearCounts[y]}</text>
          </g>
        );
      })}

      <!-- Dots -->
      {dots.map((d) => (
        <g class="exc__dot-g stagger-row" data-i={d.i % 8} data-id={d.id}>
          <circle
            cx={d.x}
            cy={d.y}
            r={d.r}
            class="exc__dot"
            style={`--dot-color: ${d.color};`}
            data-id={d.id}
            data-company={d.company}
            data-acquirer={d.acquirer}
            data-acquirer-country={d.acquirer_country}
            data-acquirer-url={d.acquirer_url ?? ''}
            data-company-url={d.company_url ?? ''}
            data-market={d.market}
            data-necessity={d.necessity}
            data-tier={d.tier}
            data-barrier={d.barrier}
            data-value-display={d.value_display}
            data-year={d.year}
            tabindex="0"
            role="button"
            aria-label={`${d.company} acquired by ${d.acquirer}, ${d.year}, ${d.value_display}.`}
          />
          <text
            x={d.x}
            y={d.y - d.r - 6}
            text-anchor="middle"
            class="exc__dot-label"
          >{d.company}</text>
        </g>
      ))}
    </svg>
  </div>

  <aside class="exc__panel panel-slide" data-exc-panel data-open="false" aria-live="polite">
    <header class="exc__panel-head">
      <p class="kicker exc__panel-kicker">Selected exit</p>
      <button type="button" class="exc__panel-close" data-exc-close aria-label="Close">×</button>
    </header>
    <h3 class="exc__panel-title" data-exc-title>Hover or click a dot.</h3>
    <p class="exc__panel-acquirer" data-exc-acquirer></p>
    <dl class="exc__panel-meta">
      <div><dt>Market</dt><dd data-exc-market>—</dd></div>
      <div><dt>Necessity</dt><dd data-exc-necessity>—</dd></div>
      <div><dt>Tier</dt><dd data-exc-tier>—</dd></div>
      <div><dt>Year</dt><dd data-exc-year>—</dd></div>
      <div class="exc__panel-meta--wide"><dt>Barrier</dt><dd data-exc-barrier>—</dd></div>
      <div class="exc__panel-meta--wide"><dt>Value</dt><dd data-exc-value>—</dd></div>
    </dl>
    <p class="exc__panel-links">
      <a data-exc-acquirer-link href="#" target="_blank" rel="noopener">Acquirer site →</a>
      <a data-exc-company-link href="#" target="_blank" rel="noopener" hidden>Press release →</a>
    </p>
    <p class="exc__panel-source">Source: hmm Ventures IM v3.8.3 §3.4 · primary-source verified.</p>
  </aside>

  <!-- Static fallback table — readable without JS and always present below the chart. -->
  <table class="exc__table">
    <caption>Named developed-APAC regulated-company acquisitions, 2020–2026</caption>
    <thead>
      <tr>
        <th scope="col">Company</th>
        <th scope="col">Market</th>
        <th scope="col">Necessity</th>
        <th scope="col">Tier</th>
        <th scope="col">Acquirer</th>
        <th scope="col">Year</th>
        <th scope="col">Value</th>
      </tr>
    </thead>
    <tbody>
      {exits.exits.map((e) => (
        <tr>
          <td>{e.company_url ? <a href={e.company_url} target="_blank" rel="noopener">{e.company}</a> : e.company}</td>
          <td>{e.market}</td>
          <td>{e.necessity}</td>
          <td>{e.tier}</td>
          <td>{e.acquirer_url ? <a href={e.acquirer_url} target="_blank" rel="noopener">{e.acquirer}</a> : e.acquirer} <span class="exc__country">({e.acquirer_country})</span></td>
          <td>{e.year}</td>
          <td>{e.value_display}</td>
        </tr>
      ))}
    </tbody>
  </table>
</section>

<script>
  function initExc() {
    document.querySelectorAll<HTMLElement>('.exc').forEach((root) => {
      const panel = root.querySelector<HTMLElement>('[data-exc-panel]');
      if (!panel) return;
      const title = panel.querySelector<HTMLElement>('[data-exc-title]')!;
      const acquirer = panel.querySelector<HTMLElement>('[data-exc-acquirer]')!;
      const acquirerLink = panel.querySelector<HTMLAnchorElement>('[data-exc-acquirer-link]')!;
      const companyLink = panel.querySelector<HTMLAnchorElement>('[data-exc-company-link]')!;
      const fields = {
        market: panel.querySelector<HTMLElement>('[data-exc-market]')!,
        necessity: panel.querySelector<HTMLElement>('[data-exc-necessity]')!,
        tier: panel.querySelector<HTMLElement>('[data-exc-tier]')!,
        year: panel.querySelector<HTMLElement>('[data-exc-year]')!,
        barrier: panel.querySelector<HTMLElement>('[data-exc-barrier]')!,
        value: panel.querySelector<HTMLElement>('[data-exc-value]')!,
      };

      const fill = (dot: HTMLElement) => {
        title.textContent = dot.dataset.company ?? '';
        const acq = dot.dataset.acquirer ?? '';
        const country = dot.dataset.acquirerCountry ?? '';
        acquirer.textContent = `Acquired by ${acq} (${country})`;
        fields.market.textContent = dot.dataset.market ?? '';
        fields.necessity.textContent = dot.dataset.necessity ?? '';
        fields.tier.textContent = dot.dataset.tier ?? '';
        fields.year.textContent = dot.dataset.year ?? '';
        fields.barrier.textContent = dot.dataset.barrier ?? '';
        fields.value.textContent = dot.dataset.valueDisplay ?? '';
        const acquirerUrl = dot.dataset.acquirerUrl ?? '';
        const companyUrl = dot.dataset.companyUrl ?? '';
        if (acquirerUrl) { acquirerLink.href = acquirerUrl; acquirerLink.hidden = false; }
        else { acquirerLink.hidden = true; }
        if (companyUrl) { companyLink.href = companyUrl; companyLink.hidden = false; }
        else { companyLink.hidden = true; }
        panel.dataset.open = 'true';
      };

      root.querySelectorAll<SVGCircleElement>('.exc__dot').forEach((dot) => {
        const el = dot as unknown as HTMLElement;
        dot.addEventListener('mouseenter', () => fill(el));
        dot.addEventListener('focus', () => fill(el));
        dot.addEventListener('click', () => { fill(el); el.classList.add('is-pinned'); });
        dot.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            fill(el);
            el.classList.add('is-pinned');
          }
        });
      });
      root.querySelector<HTMLButtonElement>('[data-exc-close]')?.addEventListener('click', () => {
        panel.dataset.open = 'false';
        root.querySelectorAll('.exc__dot').forEach((d) => d.classList.remove('is-pinned'));
      });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initExc);
  } else {
    initExc();
  }
</script>

<style>
  .exc {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    margin-block: var(--s-6);
  }
  .exc__svg { width: 100%; height: auto; display: block; }

  .exc__axis {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .exc__year {
    font-family: var(--f-display);
    font-size: 14px;
    fill: var(--c-mahogany);
  }
  .exc__year-count {
    font-family: var(--f-mono);
    font-size: 9px;
    fill: var(--fg-soft);
    letter-spacing: 0.08em;
  }

  .exc__dot {
    fill: var(--dot-color);
    fill-opacity: 0.55;
    stroke: var(--dot-color);
    stroke-width: 1.4;
    cursor: pointer;
    transition: fill-opacity var(--mo-tick) var(--ease-golden),
                stroke-width var(--mo-tick) var(--ease-golden);
  }
  .exc__dot:hover, .exc__dot:focus, .exc__dot.is-pinned {
    fill-opacity: 0.92;
    stroke-width: 2.2;
    outline: none;
  }
  .exc__dot-label {
    font-family: var(--f-mono);
    font-size: 10px;
    fill: var(--c-mahogany);
    pointer-events: none;
  }

  .exc__panel {
    padding: var(--s-5);
    background: var(--c-evergreen);
    color: var(--c-pearl);
    border-top: 2px solid var(--c-tomato);
  }
  .exc__panel[data-open="false"] { display: none; }
  .exc__panel-head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    margin-block-end: var(--s-3);
  }
  .exc__panel-kicker { color: var(--c-tomato); margin: 0; }
  .exc__panel-close {
    margin-inline-start: auto;
    background: none;
    border: 1px solid color-mix(in srgb, var(--c-pearl) 30%, transparent);
    color: var(--c-pearl);
    font-size: 20px;
    width: 32px;
    height: 32px;
    cursor: pointer;
  }
  .exc__panel-close:hover { color: var(--c-tomato); border-color: var(--c-tomato); }
  .exc__panel-title {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-tight);
    margin: 0 0 var(--s-2);
    color: var(--c-pearl);
  }
  .exc__panel-acquirer {
    font-family: var(--f-display);
    font-style: italic;
    color: color-mix(in srgb, var(--c-pearl) 75%, transparent);
    margin: 0 0 var(--s-4);
  }
  .exc__panel-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: var(--s-3);
    margin: 0 0 var(--s-4);
  }
  .exc__panel-meta > div { display: flex; flex-direction: column; gap: 2px; }
  .exc__panel-meta--wide { grid-column: span 2; }
  .exc__panel-meta dt {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
  }
  .exc__panel-meta dd {
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    margin: 0;
    color: var(--c-pearl);
  }
  .exc__panel-links {
    display: flex;
    gap: var(--s-4);
    margin: 0 0 var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
  }
  .exc__panel-links a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .exc__panel-source {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
    margin: 0;
    padding-block-start: var(--s-3);
    border-top: 1px solid color-mix(in srgb, var(--c-pearl) 18%, transparent);
  }

  /* Static fallback table. */
  .exc__table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--f-body);
    font-size: var(--fs-sm);
  }
  .exc__table caption {
    text-align: left;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
    margin-block-end: var(--s-3);
  }
  .exc__table th, .exc__table td {
    text-align: left;
    padding: var(--s-2) var(--s-3);
    border-bottom: 1px solid var(--rule);
  }
  .exc__table th {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-tomato);
  }
  .exc__table a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .exc__country { color: var(--fg-faint); font-family: var(--f-mono); font-size: 0.85em; }
</style>
