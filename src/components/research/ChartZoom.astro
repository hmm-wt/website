---
/**
 * ChartZoom — on mobile (<=720px), lets a wide chart scroll horizontally so it
 * renders at readable native size. Slot content is the chart itself. The
 * wrapper is transparent on desktop.
 */
interface Props {
  /** Minimum SVG width on mobile (rem). Default 32. Use 40+ for wide charts. */
  minWidthRem?: number;
}

const { minWidthRem = 32 } = Astro.props;
---
<div class="cz" style={`--cz-min: ${minWidthRem}rem;`}>
  <div class="cz__content">
    <slot />
  </div>
</div>

<style>
  .cz {
    position: relative;
  }
  @media (max-width: 720px) {
    .cz__content {
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
    }
    .cz__content :global(> svg),
    .cz__content :global(svg.cz-target) {
      min-width: var(--cz-min);
      display: block;
    }
  }
</style>
