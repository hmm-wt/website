---
/**
 * ClassifiedFunnel (WEB-E). 1:1 port of web_classified_funnel() in
 * CIM/html/charts.py. True trapezoid funnel.
 *
 * The file name stays ScrollyClassifierFunnel.astro for import compatibility;
 * the scrolly mode was removed in the prior cleanup.
 */
interface Props { inline?: boolean }
const _props = Astro.props as Props;
void _props;

import IMFigure from '../IMFigure.astro';

const steps = [
  { label: 'Global universe',          count: 22217, ci: 'Crunchbase + Dealroom four-market base' },
  { label: 'Four-market companies',    count: 19416, ci: 'Geographic filter applied' },
  { label: 'In Necessities (T1 + T2)',      count: 6505,  ci: 'Conservative classifier · 33.5%' },
  { label: 'Seed-stage in Necessities',     count: 2625,  ci: 'Stage filter · 13.5% of four-market' }
];

const W = 800;
const H = 320;
const ml = 180, mr = 220, mt = 30, mb = 30;
const iw = W - ml - mr;
const ih = H - mt - mb;
const maxCount = steps[0].count;
const n = steps.length;
const rowH = ih / n;
const gap = 6;
const cx = ml + iw / 2;

const rows = steps.map((s, i) => {
  const isTerminal = i === n - 1;
  const isThesis = i === n - 2;
  const col = (isTerminal || isThesis) ? 'var(--tomato)' : 'var(--dark-teal)';
  const op = isTerminal ? '0.85' : isThesis ? '0.55' : '0.30';
  const topW = (s.count / maxCount) * iw;
  const nextCount = i + 1 < n ? steps[i + 1].count : s.count * 0.7;
  const botW = i + 1 < n ? (nextCount / maxCount) * iw : topW * 0.92;
  const y0 = mt + i * rowH + gap / 2;
  const y1 = mt + (i + 1) * rowH - gap / 2;
  const xtl = cx - topW / 2;
  const xtr = cx + topW / 2;
  const xbl = cx - botW / 2;
  const xbr = cx + botW / 2;
  const labelY = (y0 + y1) / 2 + 3;
  const weight = (isTerminal || isThesis) ? '700' : '500';
  const textCol = (isTerminal || isThesis) ? 'var(--tomato)' : 'var(--ink)';
  return { ...s, isTerminal, isThesis, col, op, weight, textCol, points: `${xtl.toFixed(1)},${y0.toFixed(1)} ${xtr.toFixed(1)},${y0.toFixed(1)} ${xbr.toFixed(1)},${y1.toFixed(1)} ${xbl.toFixed(1)},${y1.toFixed(1)}`, labelY };
});
---
<IMFigure
  fignum="WEB-E"
  label="Classified universe · Four-step funnel"
  title='From 22,217 APAC technology companies to <em>2,625</em> seed-stage Necessities-aligned targets.'
  sub="Geographic filter narrows to four-market base. Conservative classifier applies the T1/T2 test. Stage filter isolates seed-priced rounds."
  metrics={[
    { label: 'APAC UNIVERSE',   value: '22,217', ci: 'Pre-filter base' },
    { label: 'FOUR-MARKET',     value: '19,416', ci: 'Geographic filter' },
    { label: 'IN THESIS',       value: '6,505',  ci: 'T1 + T2 · 33.5%' },
    { label: 'SEED-STAGE',      value: '2,625',  ci: 'Pipeline base', accent: true }
  ]}
  source="hmm Ventures classified dataset"
  basis="Four-step funnel · Crunchbase + Dealroom four-market base"
>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="xMidYMid meet"
    style="width:100%;height:auto;display:block;"
    role="img"
    aria-label="Classification funnel: 22,217 global companies narrow to 2,625 seed-stage four-market Necessities-aligned targets."
  >
    {rows.map((r) => (
      <g>
        <polygon points={r.points} fill={r.col} opacity={r.op} stroke={r.col} stroke-width="0.6" stroke-opacity="0.6" />
        <text x={ml - 16} y={r.labelY} text-anchor="end" fill="var(--ink)" font-family="var(--mono)" font-size="9" font-weight="600">{r.label}</text>
        <text x={ml + iw + 16} y={r.labelY - 3} fill={r.textCol} font-family="var(--mono)" font-size="12" font-weight={r.weight}>{r.count.toLocaleString('en-GB')}</text>
        <text x={ml + iw + 16} y={r.labelY + 11} fill="var(--muted)" font-family="var(--mono)" font-size="7" letter-spacing="0.04em">{r.ci}</text>
      </g>
    ))}
  </svg>
</IMFigure>
