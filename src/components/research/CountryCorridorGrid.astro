---
/**
 * V3 — CountryCorridorGrid.
 *
 * Four-market snapshot. Hover/focus expands the active card horizontally.
 * Fauna glyph + AUS·JPN·NZL·SGP country code as the visual anchor.
 *
 * Data is composed from:
 *   - /src/data/necessity-index.json — per_market (regulations, T1/T2 split, companies)
 *   - /src/data/im-canonical.json — fund.portfolio_split (AU 9 / JP 8 / NZ 5 / SG 3)
 *   - /src/data/crystallisation-window.json — in-flight regulations per market
 */
import CountryCorridorCard from './CountryCorridorCard.astro';
import necessity from '../../data/necessity-index.json';
import canonical from '../../data/im-canonical.json';
import calendar from '../../data/crystallisation-window.json';

const meta = [
  { legacy: 'AU', code: 'AUS', name: 'Australia',   fauna: '/fauna/hmm-fauna-au-wattle.svg',         href: '/thesis/australia/' },
  { legacy: 'JP', code: 'JPN', name: 'Japan',       fauna: '/fauna/hmm-fauna-jp-chrysanthemum.svg',  href: '/thesis/japan/' },
  { legacy: 'NZ', code: 'NZL', name: 'New Zealand', fauna: '/fauna/hmm-fauna-nz-koru.svg',           href: '/thesis/new-zealand/' },
  { legacy: 'SG', code: 'SGP', name: 'Singapore',   fauna: '/fauna/hmm-fauna-sg-vanda.svg',          href: '/thesis/singapore/' }
];

const perMarket = new Map(necessity.per_market.map((m) => [m.market, m]));
const portfolioSplit = canonical.fund.portfolio_split as Record<string, number>;

const cards = meta.map((m) => {
  const market = perMarket.get(m.legacy);
  const inFlight = calendar.regulations
    .filter((r) => r.market === m.legacy)
    .sort((a, b) => a.effective_year - b.effective_year);
  return {
    ...m,
    inThesisCompanies: market?.companies ?? null,
    regulations: market?.regulations ?? 0,
    t1: market?.t1 ?? 0,
    t2: market?.t2 ?? 0,
    portfolioAllocation: portfolioSplit[m.legacy] ?? 0,
    inFlightRegs: inFlight
  };
});
---
<section class="ccg motion-group" aria-label="Four-market corridor snapshot">
  <div class="ccg__grid">
    {cards.map((c, i) => (
      <div class="stagger-row" data-i={i}><CountryCorridorCard
        code={c.code}
        legacyCode={c.legacy}
        name={c.name}
        fauna={c.fauna}
        inThesisCompanies={c.inThesisCompanies}
        regulations={c.regulations}
        t1={c.t1}
        t2={c.t2}
        portfolioAllocation={c.portfolioAllocation}
        inFlightRegs={c.inFlightRegs}
        href={c.href}
      /></div>
    ))}
  </div>
  <footer class="ccg__foot">
    <p class="kicker">
      Source: hmm Ventures classified universe ({necessity.as_of}). Portfolio split per IM §6.1. In-flight regulations refreshed monthly.
    </p>
  </footer>
</section>

<style>
  .ccg {
    margin-block: var(--s-6);
    border-block: 1px solid var(--rule);
  }
  .ccg__grid {
    display: flex;
    align-items: stretch;
  }
  /* Stagger wrapper passes flex-grow to the card inside. */
  .ccg__grid > .stagger-row {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
  }
  .ccg__grid > .stagger-row > * {
    flex: 1 1 0;
    min-width: 0;
  }
  @media (max-width: 800px) {
    .ccg__grid > .stagger-row { flex: 1 1 100%; }
  }
  .ccg__foot {
    padding: var(--s-3) var(--s-5);
    border-top: 1px solid var(--rule);
  }
  .ccg__foot .kicker {
    margin: 0;
    text-transform: none;
    letter-spacing: 0.02em;
    line-height: 1.5;
  }

  @media (max-width: 800px) {
    .ccg__grid {
      flex-direction: column;
    }
  }
</style>
