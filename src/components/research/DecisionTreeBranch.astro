---
/**
 * V2 — DecisionTreeBranch.
 *
 * Interactive expansion of the T1 / T2 / Excluded classifier. Renders a
 * branching SVG at top with a root node, two primary branches, and an
 * excluded outlet. Below the diagram, three worked examples per branch.
 * Clicking any branch node focuses that branch's example panel.
 *
 * Falls back to a static three-column reading with no JS.
 */
import data from '../../data/classifier-examples.json';
import ChartZoom from './ChartZoom.astro';

type Branch = keyof typeof data.branches;
const order: Branch[] = ['t1', 't2', 'excluded'];
const branches = order.map((id) => ({ id, ...data.branches[id] }));

const W = 800;
const H = 220;
---
<section class="dtb motion-group" aria-label="T1 / T2 classifier decision tree">
  <div class="dtb__diagram">
    <ChartZoom title="T1 / T2 decision tree" minWidthRem={36}>
    <svg
      class="dtb__svg"
      viewBox={`0 0 ${W} ${H}`}
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label="Classifier decision tree: root splits into T1 (licence-as-barrier), T2 (compulsion-as-barrier), and an excluded outlet for off-mandate companies."
    >
      <line x1="400" y1="62" x2="200" y2="148" class="dtb__edge dtb__edge--t1 wedge-draw" />
      <line x1="400" y1="62" x2="600" y2="148" class="dtb__edge dtb__edge--t2 wedge-draw" />
      <line x1="400" y1="62" x2="400" y2="148" class="dtb__edge dtb__edge--excluded wedge-draw" stroke-dasharray="3 4" />

      <g class="dtb__node dtb__node--root stagger-row" data-i="0">
        <rect x="320" y="20" width="160" height="44" rx="2" />
        <text x="400" y="42" text-anchor="middle" class="dtb__node-h">A company</text>
        <text x="400" y="56" text-anchor="middle" class="dtb__node-s">enters the screen</text>
      </g>

      <g class="dtb__node dtb__node--t1 stagger-row" data-i="1" data-branch="t1" role="button" tabindex="0" aria-label="T1. Licence as barrier. Show examples.">
        <rect x="80" y="148" width="240" height="56" rx="2" />
        <text x="200" y="172" text-anchor="middle" class="dtb__node-h">T1. Licence-as-barrier.</text>
        <text x="200" y="190" text-anchor="middle" class="dtb__node-s">Approval required to operate.</text>
      </g>

      <g class="dtb__node dtb__node--t2 stagger-row" data-i="2" data-branch="t2" role="button" tabindex="0" aria-label="T2. Compulsion as barrier. Show examples.">
        <rect x="480" y="148" width="240" height="56" rx="2" />
        <text x="600" y="172" text-anchor="middle" class="dtb__node-h">T2. Compulsion-as-barrier.</text>
        <text x="600" y="190" text-anchor="middle" class="dtb__node-s">Buyer is statutorily compelled.</text>
      </g>

      <g class="dtb__node dtb__node--excluded stagger-row" data-i="3" data-branch="excluded" role="button" tabindex="0" aria-label="Excluded. Show off-mandate examples.">
        <rect x="340" y="156" width="120" height="40" rx="2" stroke-dasharray="3 4" />
        <text x="400" y="180" text-anchor="middle" class="dtb__node-s">Excluded</text>
      </g>
    </svg>
    </ChartZoom>
  </div>

  <div class="dtb__panels" data-dtb-panels>
    {branches.map((b) => (
      <article
        class={`dtb__panel dtb__panel--${b.id} panel-slide`}
        data-panel={b.id}
        data-open={b.id === 't1' ? 'true' : 'false'}
        id={`dtb-panel-${b.id}`}
      >
        <header class="dtb__panel-head">
          <p class="kicker dtb__panel-kicker">{b.label}</p>
          <p class="dtb__panel-rule">{b.rule}</p>
        </header>
        <ol class="dtb__examples" role="list">
          {b.examples.map((ex, i) => (
            <li class="dtb__example">
              <p class="dtb__example-head">
                <span class="dtb__example-idx">[{String(i + 1).padStart(2, '0')}]</span>
                <span class="dtb__example-co">{ex.company}</span>
                {ex.market !== 'Any' && <span class="dtb__example-market">{ex.market}</span>}
                {ex.necessity !== '—' && <span class="dtb__example-nec">{ex.necessity}</span>}
              </p>
              <p class="dtb__example-rule">{ex.rule_applied}</p>
              <p class="dtb__example-outcome">{ex.outcome}</p>
            </li>
          ))}
        </ol>
      </article>
    ))}
  </div>
</section>

<script>
  function initDtb() {
    document.querySelectorAll<HTMLElement>('.dtb').forEach((root) => {
      const nodes = root.querySelectorAll<SVGGElement>('.dtb__node[data-branch]');
      const panels = root.querySelectorAll<HTMLElement>('[data-panel]');
      const setOpen = (branch: string) => {
        panels.forEach((p) => {
          p.dataset.open = p.dataset.panel === branch ? 'true' : 'false';
        });
        nodes.forEach((n) => {
          n.classList.toggle('is-active', n.dataset.branch === branch);
        });
      };
      nodes.forEach((node) => {
        node.addEventListener('click', () => setOpen(node.dataset.branch ?? 't1'));
        node.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            setOpen(node.dataset.branch ?? 't1');
          }
        });
      });
      // Initial active node mirror.
      root.querySelector('[data-branch="t1"]')?.classList.add('is-active');
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDtb);
  } else {
    initDtb();
  }
</script>

<style>
  .dtb {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    margin-block: var(--s-6);
  }
  .dtb__svg { width: 100%; height: auto; display: block; max-width: 56rem; margin-inline: auto; }

  .dtb__edge {
    stroke: var(--rule);
    stroke-width: 1.4;
    fill: none;
  }
  .dtb__edge--t1 { stroke: var(--c-tomato); stroke-opacity: 0.6; }
  .dtb__edge--t2 { stroke: var(--c04, var(--c-mahogany)); stroke-opacity: 0.6; }
  .dtb__edge--excluded { stroke: var(--fg-faint); stroke-opacity: 0.5; }

  .dtb__node rect {
    fill: var(--c-evergreen);
    fill-opacity: 0.04;
    stroke: var(--c-evergreen);
    stroke-opacity: 0.5;
    stroke-width: 1.2;
  }
  .dtb__node--root rect {
    fill: var(--c-evergreen);
    fill-opacity: 0.85;
  }
  .dtb__node--root .dtb__node-h { fill: var(--c-pearl); font-weight: 600; }
  .dtb__node--root .dtb__node-s { fill: var(--c-pearl); fill-opacity: 0.7; }
  .dtb__node[data-branch] rect { cursor: pointer; transition: fill var(--mo-tick) var(--ease-golden), fill-opacity var(--mo-tick) var(--ease-golden), stroke var(--mo-tick) var(--ease-golden); }
  .dtb__node[data-branch]:hover rect,
  .dtb__node[data-branch]:focus rect,
  .dtb__node[data-branch].is-active rect {
    fill: var(--c-tomato);
    fill-opacity: 0.12;
    stroke: var(--c-tomato);
  }
  .dtb__node[data-branch]:focus { outline: none; }
  .dtb__node[data-branch]:focus rect { stroke-width: 2; }
  @media (prefers-reduced-motion: reduce) {
    .dtb__node[data-branch] rect { transition: none; }
  }

  .dtb__node-h {
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 600;
    fill: var(--c-mahogany);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .dtb__node-s {
    font-family: var(--f-body);
    font-size: 11px;
    fill: var(--fg-soft);
  }

  /* Panels — only the open one is visible at a time with JS.
   * Without JS, the data-open="false" panels still render but stack. */
  .dtb__panels {
    position: relative;
    min-height: 18rem;
  }
  .dtb__panel {
    border-top: 1px solid var(--rule);
    padding-block: var(--s-5);
  }
  .dtb__panel[data-open="false"] {
    display: none;
  }
  .dtb__panel-kicker { color: var(--c-tomato); margin: 0; }
  .dtb__panel-rule {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: 1.55;
    color: var(--fg);
    margin: var(--s-3) 0 var(--s-5);
    max-width: 64ch;
  }

  .dtb__examples {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-4);
  }
  @media (max-width: 720px) {
    .dtb__examples { grid-template-columns: 1fr; }
  }

  .dtb__example {
    padding: var(--s-4);
    border-left: 2px solid var(--rule);
    background: color-mix(in srgb, var(--c-pearl) 30%, transparent);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .dtb__example-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    align-items: baseline;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }
  .dtb__example-idx { color: var(--c-tomato); font-weight: 600; }
  .dtb__example-co {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    color: var(--fg);
    line-height: 1.1;
    text-transform: none;
    letter-spacing: 0;
    margin-inline-end: auto;
  }
  .dtb__example-market { color: var(--c-tomato); }
  .dtb__example-nec { color: var(--fg-soft); }
  .dtb__example-rule {
    font-family: var(--f-body);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--fg-soft);
    margin: 0;
  }
  .dtb__example-outcome {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: var(--c-tomato);
    margin: 0;
    padding-block-start: var(--s-2);
    border-top: 1px dashed var(--rule);
  }
</style>
