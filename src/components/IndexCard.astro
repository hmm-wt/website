---
interface Props {
  label: string;
  value: string | number;
  unit?: string;
  source?: string;
  /** Accent the value in tomato. */
  accent?: boolean;
}

const { label, value, unit, source, accent = false } = Astro.props;
const display = typeof value === 'number' ? value.toLocaleString('en-US') : value;
---
<div class={`ic ${accent ? 'ic--accent' : ''}`}>
  <p class="ic__label">{label}</p>
  <p class="ic__value">
    <span class="ticker-roll">{display}</span>{unit && <span class="ic__unit">{unit}</span>}
  </p>
  {source && <p class="ic__source">{source}</p>}
</div>

<style>
  .ic {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-5);
    background: color-mix(in srgb, var(--c-pearl) 5%, transparent);
    border-left: 2px solid color-mix(in srgb, var(--c-pearl) 25%, transparent);
  }
  .ic--accent { border-left-color: var(--c-tomato); }

  .ic__label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
    margin: 0;
  }
  .ic__value {
    font-family: var(--f-display);
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem);
    line-height: 1;
    margin: 0;
    color: var(--c-pearl);
  }
  .ic--accent .ic__value { color: var(--c-tomato); }
  .ic__unit {
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    margin-inline-start: 0.25em;
    color: color-mix(in srgb, var(--c-pearl) 70%, transparent);
  }
  .ic__source {
    font-family: var(--f-mono);
    font-size: calc(var(--fs-xs) * 0.85);
    color: color-mix(in srgb, var(--c-pearl) 45%, transparent);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
</style>
