---
/**
 * Cite-this button. Generates a formatted citation string and copies
 * it to the clipboard on click. Optional embed code expander beside it.
 */
interface Props {
  title: string;
  version?: string;
  href: string;
  date?: string;
  /** Optional iframe URL for the "Embed" disclosure. */
  embedSrc?: string;
}
const { title, version, href, date, embedSrc } = Astro.props;
const year = date ? new Date(date).getFullYear() : new Date().getFullYear();
const citation = `hmm Ventures (${year}). ${title}${version ? ` ${version}` : ''}. Retrieved from https://hmm.ventures${href}`;
const embedCode = embedSrc
  ? `<iframe src="https://hmm.ventures${embedSrc}" width="100%" height="420" frameborder="0" loading="lazy" title="${title}"></iframe>`
  : '';
---
<div class="cite">
  <button type="button" class="cite__btn" data-cite={citation} aria-label="Copy citation">
    <span aria-hidden="true">⧉</span> Cite this
  </button>
  {embedSrc && (
    <details class="cite__embed">
      <summary class="cite__btn cite__btn--summary">
        <span aria-hidden="true">▾</span> Embed
      </summary>
      <pre class="cite__code"><code>{embedCode}</code></pre>
      <button type="button" class="cite__copy" data-cite-embed={embedCode}>Copy embed code</button>
    </details>
  )}
</div>

<script>
  (() => {
    const flash = (btn: HTMLElement, msg: string) => {
      const orig = btn.textContent;
      btn.textContent = msg;
      window.setTimeout(() => { btn.textContent = orig; }, 1400);
    };
    document.querySelectorAll<HTMLButtonElement>('[data-cite]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.cite || '');
          flash(btn, '✓ Copied');
        } catch { flash(btn, 'Press ⌘C'); }
      });
    });
    document.querySelectorAll<HTMLButtonElement>('[data-cite-embed]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.citeEmbed || '');
          flash(btn, '✓ Copied');
        } catch { flash(btn, 'Press ⌘C'); }
      });
    });
  })();
</script>

<style>
  .cite {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: flex-start;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .cite__btn {
    background: none;
    border: 1px solid currentColor;
    color: var(--c-tomato);
    padding: var(--s-2) var(--s-3);
    cursor: pointer;
    font: inherit;
    text-transform: inherit;
    letter-spacing: inherit;
    transition: background var(--mo-tick) var(--ease-golden), color var(--mo-tick) var(--ease-golden);
  }
  .cite__btn:hover { background: var(--c-tomato); color: var(--c-pearl); }
  .cite__btn--summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .cite__btn--summary::-webkit-details-marker { display: none; }
  .cite__embed { display: inline-block; }
  .cite__code {
    margin: var(--s-3) 0;
    padding: var(--s-3);
    background: rgba(4, 47, 42, 0.06);
    color: var(--c-mahogany);
    font-size: calc(var(--fs-xs) * 0.95);
    overflow-x: auto;
    text-transform: none;
    letter-spacing: 0;
    white-space: pre-wrap;
    word-break: break-all;
  }
  .cite__copy {
    background: var(--c-mahogany);
    color: var(--c-pearl);
    border: 0;
    padding: var(--s-2) var(--s-3);
    cursor: pointer;
    font: inherit;
    text-transform: inherit;
    letter-spacing: inherit;
  }
  .cite__copy:hover { background: var(--c-tomato); }
</style>
