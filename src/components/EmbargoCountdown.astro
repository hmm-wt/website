---
import embargo from '../data/embargo.json';

if (!embargo.active) {
  // Render nothing when inactive. Silent removal post-launch.
}

const liftLabel = new Date(embargo.lift_at).toLocaleString('en-GB', {
  year: 'numeric', month: 'long', day: 'numeric',
  hour: '2-digit', minute: '2-digit', timeZoneName: 'short'
});
---
{embargo.active && (
  <aside class="emb" data-embargo-lift={embargo.lift_at}>
    <div class="container emb__inner">
      <span class="emb__dot" aria-hidden="true"></span>
      <span class="emb__label">Embargoed · {embargo.label}</span>
      <span class="emb__count" data-emb-count>...</span>
      <span class="emb__lift">Lifts {liftLabel}</span>
    </div>
  </aside>
)}

<script>
  function initEmbargo() {
    const root = document.querySelector<HTMLElement>('.emb[data-embargo-lift]');
    if (!root) return;
    const liftIso = root.dataset.embargoLift;
    if (!liftIso) return;
    const liftAt = new Date(liftIso).getTime();
    const out = root.querySelector<HTMLElement>('[data-emb-count]');
    if (!out) return;

    function tick() {
      const now = Date.now();
      const ms = liftAt - now;
      if (ms <= 0) {
        if (out) out.textContent = 'LIFTED';
        return;
      }
      const days = Math.floor(ms / (1000 * 60 * 60 * 24));
      const hours = Math.floor((ms / (1000 * 60 * 60)) % 24);
      const mins = Math.floor((ms / (1000 * 60)) % 60);
      if (out) {
        if (days > 1) {
          out.textContent = `${days}d ${hours}h`;
        } else if (days === 1) {
          out.textContent = `1d ${hours}h ${mins}m`;
        } else {
          out.textContent = `${hours}h ${mins}m`;
        }
      }
    }

    tick();
    setInterval(tick, 30_000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEmbargo);
  } else {
    initEmbargo();
  }
</script>

<style>
  .emb {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    border-block: 1px solid var(--c-tomato);
    font-family: var(--f-mono);
  }
  .emb__inner {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding-block: var(--s-3);
    flex-wrap: wrap;
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .emb__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-tomato);
    animation: emb-pulse 2.4s ease-out infinite;
  }
  @keyframes emb-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--c-tomato) 55%, transparent); }
    70% { box-shadow: 0 0 0 8px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  .emb__label { font-weight: 600; }
  .emb__count {
    color: var(--c-tomato);
    font-weight: 600;
    font-size: var(--fs-sm);
    letter-spacing: 0.08em;
    margin-inline-start: auto;
  }
  .emb__lift {
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
    margin-inline-start: var(--s-3);
  }
  @media (prefers-reduced-motion: reduce) {
    .emb__dot { animation: none; }
  }
</style>
