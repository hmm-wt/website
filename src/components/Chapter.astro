---
interface Props {
  id: string;        // anchor id, e.g. "chapter-01"
  index: string;     // e.g. "01"
  title: string;
}

const { id, index, title } = Astro.props;
---
<section id={id} class="chapter">
  <header class="chapter__head">
    <span class="chapter__idx">[Chapter {index}]</span>
    <h2 class="chapter__title">{title}</h2>
  </header>
  <div class="chapter__body prose">
    <slot />
  </div>
</section>

<style>
  .chapter {
    padding-block: var(--s-7) var(--s-8);
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: var(--s-7);
  }
  .chapter:last-of-type { border-bottom: 0; }

  .chapter__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-end: var(--s-6);
  }
  .chapter__idx {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-tomato);
    font-weight: 600;
  }
  .chapter__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    letter-spacing: -0.01em;
    margin: 0;
  }
  .chapter__body {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: var(--lh-body);
  }
</style>
