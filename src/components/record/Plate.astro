---
/**
 * Plate. The Record's exhibit card, rebuilt from the IM .fig grammar:
 * mahogany double-rule, sci-corner registration, mono eyebrow with the tomato
 * EX-N fignum and a descriptive label, optional serif argument with an
 * tomato key term, the chart slot, a Source / Basis grid. No expand.
 *
 * Charts authored against the dark page inherit pearl-surface tokens inside the
 * plate, so any exhibit reads legibly on paper without per-chart edits.
 */
interface Props {
  ex: string;          // e.g. "EX-1"
  label: string;       // descriptive eyebrow label
  title?: string;      // optional serif argument; may include <em>...</em>
  sub?: string;
  source?: string;
  basis?: string;
}
const { ex, label, title, sub, source, basis } = Astro.props;
---
<figure class="plate" role="figure" aria-label={label}>
  <span class="plate__cor plate__cor--tl" aria-hidden="true"></span>
  <span class="plate__cor plate__cor--tr" aria-hidden="true"></span>
  <span class="plate__cor plate__cor--bl" aria-hidden="true"></span>
  <span class="plate__cor plate__cor--br" aria-hidden="true"></span>

  <div class="plate__inner">
    <div class="plate__eyebrow">
      <span class="plate__ex">{ex}</span>
      <span class="plate__label">{label}</span>
    </div>
    {title && <h3 class="plate__title" set:html={title}></h3>}
    {sub && <p class="plate__sub">{sub}</p>}

    <div class="plate__plot">
      <slot />
    </div>

    {(source || basis) && (
      <div class="plate__source">
        {source && <><span class="plate__k">Source</span><span>{source}</span></>}
        {basis && <><span class="plate__k">Basis</span><span>{basis}</span></>}
      </div>
    )}
  </div>
</figure>

<style>
  .plate {
    position: relative;
    border: 1px solid var(--c-mahogany);
    background: var(--c-pearl);
    color: var(--c-mahogany);
    padding: var(--s-6);
    margin: 0;
    --p-rule: rgba(4, 47, 42, 0.18);
    --p-muted: rgba(37, 0, 1, 0.66);
    --p-faint: rgba(37, 0, 1, 0.42);
    /* Surface remap: dark-page chart tokens become pearl equivalents in-plate. */
    --fg: var(--c-mahogany);
    --fg-soft: var(--p-muted);
    --fg-faint: var(--p-faint);
    --hair-color: var(--p-rule);
    --cohort-1: var(--cohort-1-on-light);
    --cohort-2: var(--cohort-2-on-light);
    --cohort-3: var(--cohort-3-on-light);
    --cohort-4: var(--cohort-4-on-light);
    --hero: var(--c-tomato);
  }
  .plate::before {
    content: "";
    position: absolute;
    inset: 4px;
    border: 1px solid var(--p-rule);
    pointer-events: none;
  }
  .plate__inner { position: relative; z-index: 1; }
  .plate__cor { position: absolute; width: 12px; height: 12px; z-index: 2; opacity: 0.4; pointer-events: none; }
  .plate__cor--tl { top: 8px; left: 8px; border-top: 1px solid var(--c-mahogany); border-left: 1px solid var(--c-mahogany); }
  .plate__cor--tr { top: 8px; right: 8px; border-top: 1px solid var(--c-mahogany); border-right: 1px solid var(--c-mahogany); }
  .plate__cor--bl { bottom: 8px; left: 8px; border-bottom: 1px solid var(--c-mahogany); border-left: 1px solid var(--c-mahogany); }
  .plate__cor--br { bottom: 8px; right: 8px; border-bottom: 1px solid var(--c-mahogany); border-right: 1px solid var(--c-mahogany); }

  .plate__eyebrow {
    display: flex;
    gap: var(--s-3);
    align-items: baseline;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--p-muted);
    padding-block-end: var(--s-3);
    border-bottom: 1px solid var(--p-rule);
    margin-block-end: var(--s-4);
  }
  .plate__ex { color: var(--c-tomato); font-weight: 700; }

  .plate__title {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: var(--fs-2xl);
    line-height: 1.14;
    letter-spacing: -0.005em;
    color: var(--c-mahogany);
    margin: 0 0 var(--s-3);
    text-wrap: balance;
  }
  .plate__title :global(em) { font-style: normal; color: var(--c-tomato); }

  .plate__sub {
    font-family: var(--f-body);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--p-muted);
    margin: 0 0 var(--s-5);
    max-width: 60ch;
  }
  .plate__plot { margin-block: var(--s-4); }
  @media (max-width: 720px) {
    .plate__plot { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .plate__plot > :global(svg) { min-width: 30rem; display: block; }
  }

  .plate__source {
    border-top: 1px solid var(--p-rule);
    padding-block-start: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    line-height: 1.55;
    color: var(--p-muted);
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--s-2) var(--s-4);
    letter-spacing: 0.04em;
  }
  .plate__k {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--p-faint);
    font-weight: 700;
  }
</style>
