---
/**
 * Bars. IM-grade vertical bar exhibit, built to the charts.py grammar:
 * hairline baseline only (no gridlines, no border), faint mahogany columns with
 * the hero column in Tomato, mono value labels above each bar, mono category
 * labels below, and an optional mono axis title. Designed for the pearl Plate
 * surface (mahogany ink). Geometry is computed so labels never overlap.
 */
interface Item {
  label: string;
  value: number;
  display?: string;   // value label text; defaults to the number
  hero?: boolean;     // renders in Tomato
}
interface Props {
  items: Item[];
  height?: number;
  max?: number;
  axisTitle?: string;
}
const { items, height = 150, max: maxProp, axisTitle } = Astro.props;

const W = 360;
const H = height;
const padX = 10;
const topPad = 22;        // room for the value label above the tallest bar
const botPad = axisTitle ? 38 : 24;  // room for category labels (+ axis title)
const plotTop = topPad;
const plotBot = H - botPad;
const plotH = plotBot - plotTop;
const innerW = W - padX * 2;

const max = maxProp ?? Math.max(...items.map((d) => d.value), 1);
const n = items.length;
const slot = innerW / n;
const barW = Math.min(slot * 0.5, 40);

const bars = items.map((d, i) => {
  const h = max > 0 ? (d.value / max) * plotH : 0;
  const cx = padX + slot * i + slot / 2;
  return {
    ...d,
    x: cx - barW / 2,
    cx,
    y: plotBot - h,
    h,
    text: d.display ?? String(d.value),
  };
});
---
<svg class="bars" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={axisTitle ?? 'Bar chart'}>
  <line class="bars__base" x1={padX} y1={plotBot} x2={W - padX} y2={plotBot} />
  {bars.map((b) => (
    <g>
      <rect class={`bars__bar ${b.hero ? 'bars__bar--hero' : ''}`} x={b.x} y={b.y} width={barW} height={Math.max(b.h, 0)} />
      <text class={`bars__val ${b.hero ? 'bars__val--hero' : ''}`} x={b.cx} y={b.y - 6} text-anchor="middle">{b.text}</text>
      <text class={`bars__cat ${b.hero ? 'bars__cat--hero' : ''}`} x={b.cx} y={plotBot + 13} text-anchor="middle">{b.label}</text>
    </g>
  ))}
  {axisTitle && <text class="bars__axis" x={W / 2} y={H - 6} text-anchor="middle">{axisTitle}</text>}
</svg>

<style>
  .bars { display: block; width: 100%; height: auto; }
  .bars__base { stroke: var(--c-mahogany); stroke-width: 0.6; opacity: 0.5; }
  .bars__bar { fill: var(--c-mahogany); opacity: 0.28; }
  .bars__bar--hero { fill: var(--c-tomato); opacity: 0.95; }
  .bars__val {
    font-family: var(--f-mono); font-size: 9px; font-weight: 700;
    fill: rgba(37, 0, 1, 0.62);
  }
  .bars__val--hero { fill: var(--c-tomato); }
  .bars__cat {
    font-family: var(--f-mono); font-size: 7.5px; letter-spacing: 0.04em;
    fill: rgba(37, 0, 1, 0.5);
  }
  .bars__cat--hero { fill: var(--c-tomato); }
  .bars__axis {
    font-family: var(--f-mono); font-size: 7.5px; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase; fill: rgba(37, 0, 1, 0.42);
  }
</style>
