---
interface Props {
  /** Beehiiv publication slug. */
  pubId?: string;
  /** PDF download URL revealed after subscribe. */
  pdfUrl: string;
  /** PDF filename label, e.g. "The Necessity Doctrine, v1.0, 8 MB". */
  pdfLabel: string;
  heading?: string;
  body?: string;
}

const {
  pubId = 'YOUR_BEEHIIV_PUB_ID',
  pdfUrl,
  pdfLabel,
  heading = 'Download the Doctrine',
  body = 'Subscribe to the Necessity Memo to receive the Doctrine PDF and fortnightly chapters extending the artefact.'
} = Astro.props;

const beehiivSrc = `https://embeds.beehiiv.com/${pubId}?slim=true`;
---
<section class="pdfcap" data-pdf-url={pdfUrl}>
  <div class="pdfcap__copy">
    <p class="kicker pdfcap__kicker">Doctrine · PDF</p>
    <h2 class="pdfcap__heading">{heading}</h2>
    <p class="pdfcap__body">{body}</p>
    <ul class="pdfcap__perks" role="list">
      <li>Numbered hardcover (first 100 subscribers)</li>
      <li>Standing salon invitation (24 months)</li>
      <li>Pathway Brief early access (14 days before public)</li>
    </ul>
  </div>

  <div class="pdfcap__form-zone">
    <div class="pdfcap__gate" data-pdf-gate>
      <iframe
        src={beehiivSrc}
        title="Subscribe to the Necessity Memo"
        width="100%"
        height="120"
        style="border:0; overflow:hidden;"
      ></iframe>
      <p class="pdfcap__legal kicker">
        Subscribe to reveal the PDF link. No spam. Unsubscribe in one click. US Reg D 506(b): subscribing does not constitute a fund inquiry.
      </p>
      <button class="pdfcap__reveal" type="button" data-pdf-reveal>
        I've subscribed. Show the download.
      </button>
    </div>

    <div class="pdfcap__reveal-zone" data-pdf-reveal-zone hidden>
      <a class="pdfcap__download" href={pdfUrl} download>
        <span class="pdfcap__download-label">Download</span>
        <span class="pdfcap__download-file">{pdfLabel}</span>
        <span class="pdfcap__download-arrow" aria-hidden="true">↓</span>
      </a>
      <p class="pdfcap__thanks kicker">Thanks for subscribing. The next memo lands fortnightly.</p>
    </div>
  </div>
</section>

<script>
  /**
   * Reveal PDF link after the user clicks "I've subscribed".
   * Persists in localStorage so returning visitors skip the gate.
   */
  function initPDFCapture() {
    const root = document.querySelector<HTMLElement>('.pdfcap[data-pdf-url]');
    if (!root) return;
    const gate = root.querySelector<HTMLElement>('[data-pdf-gate]');
    const revealZone = root.querySelector<HTMLElement>('[data-pdf-reveal-zone]');
    const revealBtn = root.querySelector<HTMLButtonElement>('[data-pdf-reveal]');
    if (!gate || !revealZone || !revealBtn) return;

    const KEY = 'hmm:doctrine-pdf-revealed';

    function reveal() {
      if (gate) gate.hidden = true;
      if (revealZone) revealZone.hidden = false;
      try { localStorage.setItem(KEY, '1'); } catch { /* private mode, ignore */ }
    }

    try {
      if (localStorage.getItem(KEY) === '1') reveal();
    } catch { /* ignore */ }

    revealBtn.addEventListener('click', reveal);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPDFCapture);
  } else {
    initPDFCapture();
  }
</script>

<style>
  .pdfcap {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--s-7);
    padding: var(--s-7) var(--s-5);
    background: var(--bg-warm);
    border-top: 2px solid var(--c-tomato);
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 820px) {
    .pdfcap { grid-template-columns: 1fr; gap: var(--s-5); }
  }

  .pdfcap__kicker { color: var(--c-tomato); }
  .pdfcap__heading {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: var(--s-2) 0 var(--s-3);
  }
  .pdfcap__body { max-width: 48ch; }

  .pdfcap__perks {
    list-style: none;
    padding: 0;
    margin: var(--s-4) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-soft);
  }
  .pdfcap__perks li {
    padding-inline-start: var(--s-4);
    position: relative;
  }
  .pdfcap__perks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 1px;
    background: var(--c-tomato);
  }

  .pdfcap__form-zone {
    background: var(--bg);
    padding: var(--s-5);
    border: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .pdfcap__legal { font-size: calc(var(--fs-xs) * 0.95); margin-block-start: var(--s-3); line-height: 1.4; }

  .pdfcap__reveal {
    margin-block-start: var(--s-4);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: transparent;
    color: var(--c-evergreen);
    border: 1px solid var(--c-evergreen);
    padding: 0.75rem 1.2rem;
    cursor: pointer;
    transition: background var(--dur-1) var(--ease), color var(--dur-1) var(--ease);
  }
  .pdfcap__reveal:hover {
    background: var(--c-evergreen);
    color: var(--c-pearl);
  }

  .pdfcap__download {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-4) var(--s-5);
    background: var(--c-evergreen);
    color: var(--c-pearl);
    text-decoration: none;
    position: relative;
    transition: background var(--dur-1) var(--ease);
  }
  .pdfcap__download:hover { background: var(--c-tomato); }
  .pdfcap__download-label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-tomato);
    font-weight: 600;
  }
  .pdfcap__download:hover .pdfcap__download-label { color: var(--c-pearl); }
  .pdfcap__download-file {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: 1.2;
  }
  .pdfcap__download-arrow {
    position: absolute;
    top: var(--s-3);
    right: var(--s-4);
    font-size: 1.5rem;
  }
  .pdfcap__thanks {
    margin-block-start: var(--s-3);
    color: var(--fg-soft);
  }
</style>
