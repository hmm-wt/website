---
/**
 * ShapeRow. Five stamped numbers in a row. Replaces the original ShapeStats.
 *
 * Pulls from the necessity-index.json contract so the numbers are always
 * in sync with the IM dataset.
 */
import data from '../data/necessity-index.json';

const stats = [
  {
    n: data.universe.four_market_companies.toLocaleString(),
    label: 'Companies in the four-market universe',
  },
  {
    n: data.tier_shares.conservative_classifier_pct.toFixed(1) + '%',
    label: 'Pass the regulation filter',
  },
  {
    n: data.stage_funnel[2].count.toLocaleString(),
    label: 'In Necessities at seed stage',
  },
  {
    n: data.universe.regulations_four_market.toString(),
    label: 'Four-market regulations live or in flight',
  },
  {
    n: data.crystallisation_window.in_flight_2024_2030.toString(),
    label: 'In-flight regulations 2024-2030',
  },
];
---
<section class="shape-row container" aria-label="Five anchored numbers">
  <ol class="shape-row__list">
    {stats.map((s, i) => (
      <li class="shape-row__cell">
        <span class="shape-row__n ticker-roll">{s.n}</span>
        <span class="shape-row__label">{s.label}</span>
      </li>
    ))}
  </ol>
</section>

<style>
  .shape-row {
    padding-block: var(--s-7);
  }
  .shape-row__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0;
    border-top: var(--hair) solid var(--hair-color);
    border-bottom: var(--hair) solid var(--hair-color);
  }
  .shape-row__cell {
    padding: var(--s-5) var(--s-4);
    border-left: var(--hair) solid var(--hair-color);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .shape-row__cell:first-child { border-left: 0; }
  .shape-row__n {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: 1;
    color: var(--fg);
    letter-spacing: -0.02em;
  }
  .shape-row__label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-soft);
    line-height: 1.4;
    max-width: 22ch;
  }

  @media (max-width: 1000px) {
    .shape-row__list { grid-template-columns: repeat(3, 1fr); }
    .shape-row__cell { border-top: var(--hair) solid var(--hair-color); }
    .shape-row__cell:nth-child(3n+1) { border-left: 0; }
    .shape-row__cell:nth-child(-n+3) { border-top: 0; }
  }
  @media (max-width: 640px) {
    .shape-row__list { grid-template-columns: 1fr 1fr; }
    .shape-row__cell { border-left: var(--hair) solid var(--hair-color); border-top: var(--hair) solid var(--hair-color); }
    .shape-row__cell:nth-child(2n+1) { border-left: 0; }
    .shape-row__cell:nth-child(-n+2) { border-top: 0; }
  }
</style>
