---
interface Props {
  regulator: string;          // "TGA"
  regulatorFull: string;       // "Therapeutic Goods Administration"
  market: string;              // "Australia"
  necessity: string;           // "Biomedical Systems"
  catalyst?: string;           // e.g. "TGA ASDER 2026"
  /** Full bleed image path from /public/charts/ */
  image?: string;
  imageAlt?: string;
  version?: string;
  published?: string;
  pages?: number;
  pdfUrl?: string;
}

const {
  regulator, regulatorFull, market, necessity,
  catalyst, image, imageAlt,
  version, published, pages, pdfUrl
} = Astro.props;

const pubLabel = published
  ? new Date(published).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---
<header class="bh">
  <div class="bh__top">
    <span class="bh__reg" aria-hidden="true"></span>
    <span class="bh__kicker">Pathway Brief · {regulator}</span>
    {version && <span class="bh__version">{version}</span>}
  </div>

  <div class="bh__grid">
    <div class="bh__copy">
      <p class="bh__regulator-full">{regulatorFull}</p>
      <h1 class="bh__title">
        <slot>{necessity}, {market}.</slot>
      </h1>
      {catalyst && (
        <p class="bh__catalyst">
          <span class="bh__catalyst-label">Catalyst</span>
          <span class="bh__catalyst-value">{catalyst}</span>
        </p>
      )}
      <div class="bh__facts">
        <div class="bh__fact">
          <span class="bh__fact-label">Market</span>
          <span class="bh__fact-value">{market}</span>
        </div>
        <div class="bh__fact">
          <span class="bh__fact-label">Necessity</span>
          <span class="bh__fact-value">{necessity}</span>
        </div>
        {pubLabel && (
          <div class="bh__fact">
            <span class="bh__fact-label">Published</span>
            <time class="bh__fact-value" datetime={published}>{pubLabel}</time>
          </div>
        )}
        {pages && (
          <div class="bh__fact">
            <span class="bh__fact-label">Length</span>
            <span class="bh__fact-value">{pages} pages</span>
          </div>
        )}
      </div>
      {pdfUrl && (
        <a class="bh__pdf" href={pdfUrl} download>
          Download PDF ↓
        </a>
      )}
    </div>

    <div class="bh__graphic">
      {image ? (
        <img
          src={image}
          alt={imageAlt ?? `${regulator} pathway graphic`}
          width="1200"
          height="900"
          loading="eager"
          decoding="async"
        />
      ) : (
        <div class="bh__graphic-placeholder" aria-hidden="true">
          <span class="bh__graphic-mark"></span>
        </div>
      )}
    </div>
  </div>
</header>

<style>
  .bh {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding-block: var(--s-7) var(--s-8);
  }

  .bh__top {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    padding-inline: var(--s-5);
    margin-block-end: var(--s-6);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .bh__reg { display: inline-block; width: 10px; height: 10px; background: var(--c-tomato); align-self: center; }
  .bh__kicker { color: color-mix(in srgb, var(--c-pearl) 70%, transparent); }
  .bh__version { color: var(--c-tomato); margin-inline-start: auto; }

  .bh__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-7);
    align-items: center;
    padding-inline: var(--s-5);
    max-width: var(--container);
    margin-inline: auto;
  }

  .bh__copy { display: flex; flex-direction: column; gap: var(--s-4); }

  .bh__regulator-full {
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-tomato);
    margin: 0;
  }

  .bh__title {
    font-family: var(--f-display);
    font-size: clamp(2rem, 1.4rem + 3vw, 3.5rem);
    line-height: var(--lh-tight);
    letter-spacing: -0.01em;
    margin: 0;
    max-width: 18ch;
  }

  .bh__catalyst {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    font-family: var(--f-mono);
  }
  .bh__catalyst-label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
  }
  .bh__catalyst-value { font-size: var(--fs-md); color: var(--c-pearl); }

  .bh__facts {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: var(--s-4) var(--s-5);
    padding-block: var(--s-4);
    border-top: 1px solid color-mix(in srgb, var(--c-pearl) 18%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--c-pearl) 18%, transparent);
    font-family: var(--f-mono);
    max-width: 28rem;
  }
  .bh__fact { display: flex; flex-direction: column; gap: 2px; }
  .bh__fact-label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
  }
  .bh__fact-value { font-size: var(--fs-sm); color: var(--c-pearl); }

  .bh__pdf {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-evergreen);
    background: var(--c-pearl);
    padding: 0.875rem 1.25rem;
    text-decoration: none;
    font-weight: 600;
    transition: background var(--dur-1) var(--ease), color var(--dur-1) var(--ease);
  }
  .bh__pdf:hover,
  .bh__pdf:active {
    background: var(--c-tomato);
    color: var(--c-pearl);
  }

  .bh__graphic {
    aspect-ratio: 4 / 3;
    background: var(--c-dark-teal);
    overflow: hidden;
  }
  .bh__graphic img { width: 100%; height: 100%; object-fit: cover; }
  .bh__graphic-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
  .bh__graphic-mark { width: 24px; height: 24px; background: var(--c-tomato); }

  @media (max-width: 820px) {
    .bh__grid { grid-template-columns: 1fr; }
    .bh__title { max-width: 100%; }
  }
</style>
