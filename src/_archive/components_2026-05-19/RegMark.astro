---
interface Props {
  /** Variant: solid (default) or hollow (third dot of wordmark per design system). */
  variant?: 'solid' | 'hollow';
  /** Size in pixels. Default 8 per design spec. */
  size?: number;
  /** Optional aria-label. Defaults to decorative (aria-hidden). */
  label?: string;
}

const { variant = 'solid', size = 8, label } = Astro.props;
const decorative = !label;
---
<span
  class={`reg-mark reg-mark--${variant}`}
  style={`--reg-size:${size}px`}
  role={decorative ? undefined : 'img'}
  aria-label={label}
  aria-hidden={decorative ? 'true' : undefined}
></span>

<style>
  .reg-mark {
    display: inline-block;
    width: var(--reg-size);
    height: var(--reg-size);
    flex-shrink: 0;
    line-height: 0;
  }
  .reg-mark--solid {
    background: var(--c-tomato);
  }
  .reg-mark--hollow {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--c-tomato);
  }
</style>
