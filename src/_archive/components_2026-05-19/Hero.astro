---
/**
 * Hero. Generic page hero. Replaces ad-hoc hero blocks on multiple pages.
 *
 * Modes:
 *   - 'large' (default): display serif, max-width 18ch
 *   - 'compact': for inner pages, narrower
 *
 * Accent: a span wrapping the part of the title that should pick up tomato.
 */
interface Props {
  kicker?: string;
  title: string;
  accent?: string;
  sub?: string;
  mode?: 'large' | 'compact';
}

const { kicker, title, accent, sub, mode = 'large' } = Astro.props;
---
<header class={`pgh pgh--${mode}`}>
  <div class="container pgh__inner">
    {kicker && (
      <div class="pgh__meta">
        <span class="pgh__reg" aria-hidden="true"></span>
        <span class="pgh__kicker">{kicker}</span>
      </div>
    )}
    <h1 class="pgh__title">
      {title}
      {accent && <span class="pgh__accent">{' '}{accent}</span>}
    </h1>
    {sub && <p class="pgh__sub">{sub}</p>}
    <slot />
  </div>
</header>

<style>
  .pgh {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding-block: var(--s-9) var(--s-7);
    position: relative;
  }
  .pgh--compact {
    padding-block: var(--s-7) var(--s-6);
  }
  .pgh__inner {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .pgh__meta {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .pgh__reg {
    display: inline-block;
    width: 10px;
    height: 10px;
    background: var(--c-tomato);
    align-self: center;
  }
  .pgh__kicker { color: color-mix(in srgb, var(--c-pearl) 70%, transparent); }

  .pgh__title {
    font-family: var(--f-display);
    line-height: 1.0;
    letter-spacing: -0.025em;
    font-weight: 400;
    margin: var(--s-3) 0 0;
  }
  .pgh--large .pgh__title {
    font-size: clamp(2.5rem, 1.5rem + 5.5vw, 6rem);
    max-width: 22ch;
  }
  .pgh--compact .pgh__title {
    font-size: clamp(2rem, 1.4rem + 3vw, 3.5rem);
    max-width: 26ch;
  }
  .pgh__accent { color: var(--c-tomato); }

  .pgh__sub {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: color-mix(in srgb, var(--c-pearl) 84%, transparent);
    max-width: 56ch;
    margin: var(--s-4) 0 0;
  }

  @media (max-width: 720px) {
    .pgh { padding-block: var(--s-7) var(--s-5); }
    .pgh--compact { padding-block: var(--s-6) var(--s-4); }
  }
</style>
