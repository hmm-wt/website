---
/**
 * Horizon chart for the Crystallisation Window calendar.
 * X axis: years 2024-2030. Y rows: AU / JP / NZ / SG.
 * Each cell shows the count of in-flight regulations for that
 * market/year combination, sized by intensity (count / max).
 * Pure server-rendered HTML+CSS. No JS, no chart library.
 */
import calendar from '../data/crystallisation-window.json';
import JurisdictionMark from './JurisdictionMark.astro';

type Market = 'AU' | 'JP' | 'NZ' | 'SG';
const markets: Market[] = ['AU', 'JP', 'NZ', 'SG'];
const marketName: Record<Market, string> = {
  AU: 'Australia',
  JP: 'Japan',
  NZ: 'New Zealand',
  SG: 'Singapore',
};

// Build year range from data
const years = Array.from(
  new Set(calendar.regulations.map((r) => r.effective_year))
).sort((a, b) => a - b);
const minYear = years[0];
const maxYear = years[years.length - 1];
const yearSpan: number[] = [];
for (let y = minYear; y <= maxYear; y++) yearSpan.push(y);

// Grid: market -> year -> count
const grid: Record<Market, Record<number, number>> = {
  AU: {}, JP: {}, NZ: {}, SG: {},
};
calendar.regulations.forEach((r) => {
  const m = r.market as Market;
  if (!grid[m]) return;
  grid[m][r.effective_year] = (grid[m][r.effective_year] || 0) + 1;
});

// Compute max for intensity scaling
let max = 0;
markets.forEach((m) =>
  yearSpan.forEach((y) => {
    if ((grid[m][y] || 0) > max) max = grid[m][y] || 0;
  })
);

const totalsByYear: Record<number, number> = {};
yearSpan.forEach((y) => {
  totalsByYear[y] = markets.reduce((acc, m) => acc + (grid[m][y] || 0), 0);
});

const totalsByMarket: Record<Market, number> = {
  AU: markets.includes('AU') ? Object.values(grid.AU).reduce((a, b) => a + b, 0) : 0,
  JP: Object.values(grid.JP).reduce((a, b) => a + b, 0),
  NZ: Object.values(grid.NZ).reduce((a, b) => a + b, 0),
  SG: Object.values(grid.SG).reduce((a, b) => a + b, 0),
};
---
<figure class="ch">
  <figcaption class="ch__cap">
    <span class="ch__cap-num">{calendar.total_count}</span>
    <span class="ch__cap-label">in-flight regulations · {minYear}–{maxYear} · peak {calendar.year_counts && Object.entries(calendar.year_counts).reduce((a, b) => (a[1] > b[1] ? a : b))[0]}</span>
  </figcaption>

  <div class="ch__grid" style={`--cols: ${yearSpan.length + 1};`}>
    {/* Header row */}
    <span class="ch__cell ch__cell--corner"></span>
    {yearSpan.map((y) => (
      <span class="ch__cell ch__cell--yhead">{y}</span>
    ))}

    {/* Market rows */}
    {markets.map((m) => (
      <>
        <span class="ch__cell ch__cell--mhead">
          <span class="ch__mhead-flower"><JurisdictionMark market={m} size={22} /></span>
          <span class="ch__mhead-code">{m}</span>
          <span class="ch__mhead-name">{marketName[m]}</span>
          <span class="ch__mhead-total">{totalsByMarket[m]}</span>
        </span>
        {yearSpan.map((y) => {
          const count = grid[m][y] || 0;
          const intensity = max > 0 ? count / max : 0;
          return (
            <span
              class={`ch__cell ch__cell--data ${count > 0 ? 'has-data' : ''}`}
              style={`--intensity: ${intensity};`}
              aria-label={`${marketName[m]} ${y}: ${count} regulation${count === 1 ? '' : 's'}`}
            >
              {count > 0 ? <span class="ch__count">{count}</span> : null}
            </span>
          );
        })}
      </>
    ))}

    {/* Totals row */}
    <span class="ch__cell ch__cell--ttotals">Σ</span>
    {yearSpan.map((y) => (
      <span class="ch__cell ch__cell--ttotal">{totalsByYear[y] || 0}</span>
    ))}
  </div>

  <p class="ch__legend">
    <span class="ch__legend-dot ch__legend-dot--lo"></span> 1
    <span class="ch__legend-dot ch__legend-dot--mid"></span> {Math.ceil(max / 2)}
    <span class="ch__legend-dot ch__legend-dot--hi"></span> {max}
    <span class="ch__legend-sep">·</span>
    <span class="ch__legend-meta">count of in-flight regulations per market-year</span>
  </p>
</figure>

<style>
  .ch {
    margin: 0;
    padding: var(--s-5);
    border: 1px solid var(--rule);
    background: var(--surface);
  }
  .ch__cap {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    margin-block-end: var(--s-5);
    padding-block-end: var(--s-3);
    border-bottom: 1px solid var(--rule);
  }
  .ch__cap-num {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    color: var(--c-tomato);
    line-height: 1;
  }
  .ch__cap-label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
  }

  .ch__grid {
    display: grid;
    grid-template-columns: minmax(7rem, auto) repeat(calc(var(--cols) - 1), minmax(2.4rem, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
  }

  .ch__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-2);
    background: var(--bg);
    color: var(--fg-soft);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    min-height: 2.4rem;
  }
  .ch__cell--corner { background: var(--bg); }
  .ch__cell--yhead {
    color: var(--c-tomato);
    font-weight: 600;
  }
  .ch__cell--mhead {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px var(--s-2);
    padding-inline: var(--s-3);
  }
  .ch__mhead-flower {
    color: var(--c-tomato);
    display: inline-flex;
    flex-shrink: 0;
  }
  .ch__mhead-code { color: var(--c-tomato); font-weight: 600; }
  .ch__mhead-name {
    color: var(--fg);
    text-transform: none;
    letter-spacing: 0;
    font-size: calc(var(--fs-xs) * 0.92);
  }
  .ch__mhead-total {
    color: var(--fg-soft);
    font-size: calc(var(--fs-xs) * 0.88);
    margin-inline-start: auto;
  }

  .ch__cell--data {
    background: color-mix(in srgb, var(--c-tomato) calc(var(--intensity, 0) * 70%), var(--bg));
    color: var(--c-pearl);
    transition: background var(--transition);
  }
  .ch__cell--data:not(.has-data) {
    color: var(--fg-faint);
  }
  .ch__count {
    font-weight: 600;
    color: var(--c-pearl);
    font-size: calc(var(--fs-xs) * 1.08);
  }

  .ch__cell--ttotals,
  .ch__cell--ttotal {
    background: color-mix(in srgb, var(--c-evergreen) 100%, transparent);
    color: var(--c-pearl);
    font-weight: 600;
    border-top: 1px solid var(--c-tomato);
  }
  .ch__cell--ttotals { color: var(--c-tomato); }

  .ch__legend {
    margin: var(--s-4) 0 0;
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex-wrap: wrap;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-soft);
  }
  .ch__legend-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    background: var(--c-tomato);
    margin-inline-start: var(--s-3);
  }
  .ch__legend-dot--lo  { opacity: 0.18; }
  .ch__legend-dot--mid { opacity: 0.5; }
  .ch__legend-dot--hi  { opacity: 0.95; }
  .ch__legend-sep { color: var(--fg-faint); margin-inline: var(--s-2); }
  .ch__legend-meta { text-transform: none; letter-spacing: 0; }

  /* Surface-light overrides */
  :global(.surface-light) .ch__cell { background: var(--c-pearl); color: var(--fg-light-soft); }
  :global(.surface-light) .ch__cell--corner { background: var(--c-pearl); }
  :global(.surface-light) .ch__cell--mhead .ch__mhead-name { color: var(--fg-light); }
  :global(.surface-light) .ch__cell--mhead .ch__mhead-total { color: var(--fg-light-soft); }
  :global(.surface-light) .ch__cell--data {
    background: color-mix(in srgb, var(--c-tomato) calc(var(--intensity, 0) * 80%), var(--c-pearl));
    color: var(--fg-light);
  }
  :global(.surface-light) .ch__cell--data:not(.has-data) { color: var(--fg-light-faint); }
  :global(.surface-light) .ch__count { color: var(--c-pearl); text-shadow: 0 1px 1px rgba(0,0,0,0.15); }
  :global(.surface-light) .ch__cell--ttotals,
  :global(.surface-light) .ch__cell--ttotal {
    background: var(--c-evergreen);
    color: var(--c-pearl);
  }
  :global(.surface-light) .ch__cell--ttotals { color: var(--c-tomato); }

  @media (max-width: 720px) {
    .ch__grid {
      grid-template-columns: minmax(5rem, auto) repeat(calc(var(--cols) - 1), minmax(1.8rem, 1fr));
      font-size: calc(var(--fs-xs) * 0.92);
    }
    .ch__mhead-name { display: none; }
  }
</style>
