---
interface Stage {
  stage: string;
  count: number;
  share_pct?: number;
}

interface Props {
  stages: Stage[];
}

const { stages } = Astro.props;
const max = Math.max(...stages.map((s) => s.count));
---
<div class="if">
  <p class="if__label">From classified universe to seed-stage in-thesis</p>
  <div class="if__bars">
    {stages.map((s) => {
      const width = (s.count / max) * 100;
      return (
        <div class="if__row">
          <div class="if__top">
            <span class="if__stage">{s.stage}</span>
            <span class="if__count">{s.count.toLocaleString('en-US')}</span>
            {s.share_pct !== undefined && (
              <span class="if__share">{s.share_pct}%</span>
            )}
          </div>
          <div class="if__bar-track">
            <div class="if__bar-fill" style={`width: ${width}%`}></div>
          </div>
        </div>
      );
    })}
  </div>
</div>

<style>
  .if { display: flex; flex-direction: column; gap: var(--s-4); }
  .if__label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
    margin: 0;
  }
  .if__bars { display: flex; flex-direction: column; gap: var(--s-3); }
  .if__row { display: flex; flex-direction: column; gap: var(--s-2); }
  .if__top {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
  }
  .if__stage { color: var(--c-pearl); flex: 1; }
  .if__count {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    color: var(--c-tomato);
    line-height: 1;
  }
  .if__share {
    font-size: var(--fs-xs);
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .if__bar-track {
    height: 8px;
    background: color-mix(in srgb, var(--c-pearl) 8%, transparent);
  }
  .if__bar-fill {
    height: 100%;
    background: var(--c-tomato);
    transition: width var(--dur-2) var(--ease);
  }
</style>
