---
interface DataRow {
  label: string;
  value: string;
  source?: string;
  sourceUrl?: string;
}

interface Props {
  title?: string;                  // Default: "Regulatory State of Play"
  market?: string;                  // AU / JP / NZ / SG / Global
  rows: DataRow[];                  // 3-5 rows recommended
  index?: string;                   // optional [01] index
}

const {
  title = 'Regulatory State of Play',
  market,
  rows,
  index
} = Astro.props;
---
<aside class="margin-widget" aria-label={title}>
  <header class="margin-widget__head">
    {index && <span class="margin-widget__idx">[{index}]</span>}
    <span class="margin-widget__label">
      <span class="margin-widget__reg" aria-hidden="true"></span>
      {title}
      {market && <span class="margin-widget__market">{market}</span>}
    </span>
  </header>

  <dl class="margin-widget__rows">
    {rows.map((row) => (
      <div class="margin-widget__row">
        <dt class="margin-widget__row-label">{row.label}</dt>
        <dd class="margin-widget__row-value">
          {row.sourceUrl ? (
            <a href={row.sourceUrl} target="_blank" rel="noopener">
              {row.value}
            </a>
          ) : (
            row.value
          )}
          {row.source && !row.sourceUrl && (
            <span class="margin-widget__src">{row.source}</span>
          )}
        </dd>
      </div>
    ))}
  </dl>
</aside>

<style>
  .margin-widget {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding: var(--s-5) var(--s-4);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    line-height: 1.5;
    border-top: 2px solid var(--c-tomato);
  }

  .margin-widget__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2);
    padding-block-end: var(--s-3);
    border-bottom: 1px solid color-mix(in srgb, var(--c-pearl) 15%, transparent);
    margin-block-end: var(--s-3);
  }

  .margin-widget__idx {
    color: var(--c-tomato);
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .margin-widget__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-pearl);
    font-weight: 600;
  }

  .margin-widget__reg {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--c-tomato);
  }

  .margin-widget__market {
    color: var(--c-tomato);
    margin-inline-start: 0.4em;
  }

  .margin-widget__date {
    margin-inline-start: auto;
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .margin-widget__rows {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin: 0;
  }

  .margin-widget__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px;
  }

  .margin-widget__row-label {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
    font-size: calc(var(--fs-xs) * 0.92);
  }

  .margin-widget__row-value {
    margin: 0;
    color: var(--c-pearl);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .margin-widget__row-value a {
    color: var(--c-pearl);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--c-tomato) 70%, transparent);
    text-underline-offset: 0.2em;
  }
  .margin-widget__row-value a:hover {
    color: var(--c-tomato);
  }

  .margin-widget__src {
    display: block;
    color: color-mix(in srgb, var(--c-pearl) 50%, transparent);
    font-size: calc(var(--fs-xs) * 0.85);
    margin-block-start: 2px;
  }
</style>
