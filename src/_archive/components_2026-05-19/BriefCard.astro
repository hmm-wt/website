---
interface Props {
  href: string;
  regulator: string;       // e.g. "TGA"
  market: string;          // "AU" / "JP" / "NZ" / "SG"
  necessity: string;       // e.g. "Biomedical Systems"
  title: string;
  description?: string;
  pdfUrl?: string;
  pages?: number;
  date?: string;
  /** Optional country graphic from /public/charts/ */
  thumb?: string;
  /** Status: live, draft, embargoed. */
  status?: 'live' | 'draft' | 'embargoed';
}

const {
  href, regulator, market, necessity,
  title, description, pdfUrl, pages, date,
  thumb, status = 'live'
} = Astro.props;

const dateLabel = date
  ? new Date(date).toLocaleDateString('en-GB', { year: 'numeric', month: 'short' })
  : null;
---
<article class={`bc bc--${status}`}>
  <a class="bc__link" href={href}>
    {thumb ? (
      <div class="bc__thumb">
        <img src={thumb} alt="" width="800" height="600" loading="lazy" decoding="async" />
      </div>
    ) : (
      <div class="bc__thumb bc__thumb--placeholder" aria-hidden="true">
        <span class="bc__thumb-mark"></span>
      </div>
    )}

    <div class="bc__body">
      <header class="bc__head">
        <span class="bc__regulator">[{regulator}]</span>
        <span class="bc__market">{market}</span>
        {status !== 'live' && (
          <span class={`bc__status bc__status--${status}`}>{status}</span>
        )}
      </header>

      <h3 class="bc__title">{title}</h3>

      <p class="bc__necessity kicker">{necessity}</p>

      {description && <p class="bc__desc">{description}</p>}

      <footer class="bc__foot">
        {dateLabel && <time datetime={date}>{dateLabel}</time>}
        {pages && <span>{pages} pp</span>}
        {pdfUrl && status === 'live' && (
          <a class="bc__pdf" href={pdfUrl} download data-stop>
            PDF ↓
          </a>
        )}
      </footer>
    </div>
  </a>
</article>

<style>
  .bc {
    background: var(--bg);
    border: 1px solid var(--rule);
    transition: border-color var(--dur-1) var(--ease), transform var(--dur-1) var(--ease);
  }
  .bc:hover {
    border-color: var(--c-tomato);
  }

  .bc__link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--fg);
    height: 100%;
  }

  .bc__thumb {
    aspect-ratio: 4 / 3;
    background: var(--c-evergreen);
    overflow: hidden;
    position: relative;
  }
  .bc__thumb img { width: 100%; height: 100%; object-fit: cover; }

  .bc__thumb--placeholder { display: flex; align-items: center; justify-content: center; }
  .bc__thumb-mark {
    width: 16px;
    height: 16px;
    background: var(--c-tomato);
  }

  .bc__body {
    padding: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    flex: 1;
  }

  .bc__head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .bc__regulator { color: var(--c-tomato); font-weight: 600; }
  .bc__market { color: var(--fg-soft); }
  .bc__status {
    margin-inline-start: auto;
    padding: 0.1em 0.5em;
    font-size: calc(var(--fs-xs) * 0.85);
    font-weight: 600;
  }
  .bc__status--draft { background: color-mix(in srgb, var(--fg) 8%, transparent); color: var(--fg-soft); }
  .bc__status--embargoed { background: color-mix(in srgb, var(--c-tomato) 14%, transparent); color: var(--c-tomato); }

  .bc__title {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    margin: 0;
    transition: color var(--dur-1) var(--ease);
  }
  .bc__link:hover .bc__title { color: var(--c-tomato); }

  .bc__necessity { color: var(--fg-soft); margin: 0; }
  .bc__desc { font-size: var(--fs-sm); color: var(--fg-soft); margin: 0; line-height: 1.5; }

  .bc__foot {
    margin-block-start: auto;
    padding-block-start: var(--s-3);
    border-top: 1px solid var(--rule);
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: var(--fg-soft);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .bc__pdf {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding-block: 0.5rem;
    margin-inline-start: auto;
    color: var(--c-tomato);
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px solid currentColor;
  }
  .bc__pdf:hover { color: var(--fg); }
</style>
