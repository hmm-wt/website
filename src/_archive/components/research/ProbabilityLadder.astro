---
/**
 * V8 — ProbabilityLadder.
 *
 * Four-tier returns framing: Target / Median / Bear / Tail. Each rung shows
 * DPI, IRR, MOIC drawn from the canonical Monte Carlo simulation (1,000
 * iterations, R12 v2 Base Case). Hover or focus a rung to reveal the basis
 * line and sensitivity note.
 *
 * Source: /src/data/im-canonical.json `returns` block.
 */
import canonical from '../../data/im-canonical.json';

const tiers = canonical.returns.tiers as string[];
const dpi = canonical.returns.dpi as Record<string, number>;
const irr = canonical.returns.irr_pct as Record<string, number>;
const moic = canonical.returns.moic as Record<string, number>;

const rungs = tiers.map((t) => {
  const key = t.toLowerCase();
  return {
    tier: t,
    key,
    dpi: dpi[key],
    irr: irr[key],
    moic: moic[key]
  };
});

const tierMeta: Record<string, { label: string; note: string }> = {
  Target: {
    label: 'TARGET',
    note: 'GP-underwritten outcome on the Base Case lever stack. The fund\'s pitch to LPs is this number.'
  },
  Median: {
    label: 'MEDIAN',
    note: 'P50 of the simulation. Cambridge / Burgiss / Preqin comparable. This is the row LPs underwrite against.'
  },
  Bear: {
    label: 'BEAR',
    note: 'Stressed scenario: regulatory reversal or single-market deterioration. Plot defends downside coverage.'
  },
  Tail: {
    label: 'TAIL',
    note: 'P5 of the simulation. Loss-of-principal tail. The honest read on what could go wrong.'
  }
};

const maxDpi = Math.max(...rungs.map((r) => r.dpi));
const maxMoic = Math.max(...rungs.map((r) => r.moic));
const irrRange = Math.max(...rungs.map((r) => Math.abs(r.irr)));
---
<section class="prl motion-group" aria-label="Four-tier returns framing">
  <header class="prl__head">
    <p class="kicker prl__kicker">{canonical.returns.basis}</p>
    <p class="prl__source">{canonical.returns.source}</p>
  </header>

  <ol class="prl__rungs" role="list">
    {rungs.map((r, i) => {
      const meta = tierMeta[r.tier];
      const dpiPct = (r.dpi / maxDpi) * 100;
      const moicPct = (r.moic / maxMoic) * 100;
      const irrSign = r.irr >= 0 ? 'pos' : 'neg';
      const irrPct = (Math.abs(r.irr) / irrRange) * 100;
      return (
        <li class={`prl__rung prl__rung--${r.key} prl__rung--${i === 0 ? 'top' : i === rungs.length - 1 ? 'bot' : 'mid'} stagger-row`} data-i={i} tabindex="0">
          <header class="prl__rung-head">
            <span class="prl__rung-label">{meta.label}</span>
            <span class="prl__rung-idx">[{String(i + 1).padStart(2, '0')} / {String(rungs.length).padStart(2, '0')}]</span>
          </header>
          <div class="prl__cells">
            <div class="prl__cell">
              <span class="prl__cell-label">DPI</span>
              <span class="prl__cell-value">{r.dpi.toFixed(2)}x</span>
              <span class="prl__cell-bar"><span class="prl__cell-bar-fill" style={`width: ${dpiPct.toFixed(1)}%`}></span></span>
            </div>
            <div class="prl__cell">
              <span class="prl__cell-label">IRR</span>
              <span class="prl__cell-value">{r.irr >= 0 ? '+' : ''}{r.irr.toFixed(1)}%</span>
              <span class={`prl__cell-bar prl__cell-bar--${irrSign}`}><span class="prl__cell-bar-fill" style={`width: ${irrPct.toFixed(1)}%`}></span></span>
            </div>
            <div class="prl__cell">
              <span class="prl__cell-label">MOIC</span>
              <span class="prl__cell-value">{r.moic.toFixed(2)}x</span>
              <span class="prl__cell-bar"><span class="prl__cell-bar-fill" style={`width: ${moicPct.toFixed(1)}%`}></span></span>
            </div>
          </div>
          <p class="prl__rung-note">{meta.note}</p>
        </li>
      );
    })}
  </ol>
</section>

<style>
  .prl {
    margin-block: var(--s-6);
    border-block: 1px solid var(--rule);
  }
  .prl__head {
    padding: var(--s-3) var(--s-5);
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--c-pearl) 30%, transparent);
  }
  .prl__kicker {
    color: var(--c-tomato);
    margin: 0;
    text-transform: none;
    letter-spacing: 0.04em;
  }
  .prl__source {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
    margin: 0.25rem 0 0;
  }

  .prl__rungs {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .prl__rung {
    padding: var(--s-4) var(--s-5);
    border-bottom: 1px solid var(--rule);
    transition: background var(--mo-tick) var(--ease-golden);
  }
  .prl__rung:last-child { border-bottom: 0; }
  .prl__rung:hover, .prl__rung:focus-within {
    background: color-mix(in srgb, var(--c-tomato) 4%, transparent);
    outline: none;
  }

  .prl__rung-head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    margin-block-end: var(--s-3);
  }
  .prl__rung-label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-tomato);
  }
  .prl__rung--target .prl__rung-label { color: var(--c-tomato); }
  .prl__rung--bear .prl__rung-label { color: var(--c04, var(--c-mahogany)); }
  .prl__rung--tail .prl__rung-label { color: var(--fg-faint); }
  .prl__rung-idx {
    margin-inline-start: auto;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: var(--fg-faint);
    letter-spacing: 0.1em;
  }

  .prl__cells {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-4);
  }
  @media (max-width: 640px) { .prl__cells { grid-template-columns: 1fr; gap: var(--s-3); } }

  .prl__cell {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    grid-template-rows: auto auto;
    gap: 0.25rem var(--s-3);
    align-items: baseline;
  }
  .prl__cell-label {
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: center;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
  }
  .prl__cell-value {
    grid-column: 2;
    grid-row: 1;
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: 1;
    color: var(--c-tomato);
    letter-spacing: -0.01em;
  }
  .prl__rung--bear .prl__cell-value { color: var(--c04, var(--c-mahogany)); }
  .prl__rung--tail .prl__cell-value { color: var(--fg-soft); }

  .prl__cell-bar {
    grid-column: 2;
    grid-row: 2;
    display: block;
    height: 4px;
    background: color-mix(in srgb, var(--rule) 100%, transparent);
    overflow: hidden;
  }
  .prl__cell-bar-fill {
    display: block;
    height: 100%;
    width: 0;
    background: var(--c-tomato);
    transition: width var(--speed-draw) var(--ease-draw);
  }
  .prl__rung--bear .prl__cell-bar-fill { background: var(--c04, var(--c-mahogany)); }
  .prl__rung--tail .prl__cell-bar-fill { background: color-mix(in srgb, var(--c-mahogany) 60%, transparent); }
  .prl__cell-bar--neg .prl__cell-bar-fill { background: var(--c-mahogany); opacity: 0.55; }

  .prl__rung-note {
    margin: var(--s-3) 0 0;
    font-family: var(--f-body);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--fg-soft);
    max-width: 64ch;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition: opacity var(--mo-hold) var(--ease-golden),
                max-height var(--mo-hold) var(--ease-golden),
                margin var(--mo-hold) var(--ease-golden);
  }
  .prl__rung:hover .prl__rung-note,
  .prl__rung:focus-within .prl__rung-note {
    opacity: 1;
    max-height: 8rem;
  }
  @media (max-width: 640px) {
    /* On mobile, always show the note. */
    .prl__rung-note { opacity: 1; max-height: none; margin-block-start: var(--s-3); }
  }
  @media (prefers-reduced-motion: reduce) {
    .prl__cell-bar-fill { transition: none; }
    .prl__rung-note { transition: none; opacity: 1; max-height: none; }
  }
</style>
