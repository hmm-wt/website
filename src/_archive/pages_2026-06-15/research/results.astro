---
import Base from '../../layouts/Base.astro';
import IMFigure from '../../components/IMFigure.astro';
import PremiumBar from '../../components/charts/PremiumBar.astro';
import SmallMultiples from '../../components/charts/SmallMultiples.astro';
import ExitsUnitStrip from '../../components/ExitsUnitStrip.astro';
import CTARail from '../../components/CTARail.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import necessityData from '../../data/necessity-index.json';
import exitsData from '../../data/exits-named.json';

const p = necessityData.premiums;
const exits = exitsData.exits as any[];
const totalExits = exits.length;
const countByMarket = exits.reduce<Record<string, number>>((acc, e) => {
  acc[e.market] = (acc[e.market] ?? 0) + 1;
  return acc;
}, {});

const namedExitValues = exits.filter((e) => e.value_usd_m_high).map((e) => e.value_usd_m_high as number);
const minExit = Math.min(...namedExitValues);
const maxExit = Math.max(...namedExitValues);

const fmtUsd = (m: number) => m >= 1000 ? `$${(m / 1000).toFixed(2)}B` : `$${m}M`;

const stats = [
  { n: `${p.exit_rate_multiple.toFixed(2)}x`, label: 'Observed T1 exit incidence vs unregulated cohort' },
  { n: `${p.round_size_series_c.toFixed(2)}x`, label: 'Series C round-size uplift' },
  { n: `${p.cumulative_series_d_plus.toFixed(2)}x`, label: 'Cumulative funding uplift by Series D+' },
  { n: String(totalExits), label: 'Named acquirer deals, 2020-2026' },
];
---
<Base
  title="The results"
  description="Round-size premiums by stage. Exit incidence by tier. Named acquirer deals across the four markets."
>
  <header class="rsl-hero">
    <div class="container">
      <Breadcrumb
        crumbs={[
          { label: 'hmm', href: '/' },
          { label: 'Research', href: '/research/' },
          { label: 'Results' },
        ]}
      />
      <p class="kicker rsl-hero__kicker">The results</p>
      <h1 class="rsl-hero__title">Near-parity at seed. Premiums appear later.</h1>
      <p class="rsl-hero__sub">
        In the four-market dataset, T1 companies show larger later-stage rounds, higher observed graduation, and higher exit incidence than the unregulated cohort. The pattern is strongest from Series C onward.
      </p>
    </div>
  </header>

  <section class="rsl-stats container" aria-label="Headline numbers">
    <ol class="rsl-stats__list">
      {stats.map((s) => (
        <li class="rsl-stats__cell">
          <span class="rsl-stats__n ticker-roll">{s.n}</span>
          <span class="rsl-stats__l">{s.label}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="container rsl-exits">
    <IMFigure
      fignum="EX-1"
      label="Named acquirer deals"
      title="Strategic acquirers are <em>already buying</em>."
      sub={`${totalExits} named developed-APAC regulated-company acquisitions, source-verified. Highlighted marks show T1 acquisitions. Disclosed values range ${fmtUsd(minExit)} to ${fmtUsd(maxExit)}.`}
      source="hmm Ventures exit dataset."
      basis="Named, source-verified acquisitions across the four markets."
    >
      <ExitsUnitStrip />
    </IMFigure>
    <p class="rsl-exits__note">
      Coverage today: AUS {countByMarket['AU'] ?? 0}. NZL {countByMarket['NZ'] ?? 0}. JPN {countByMarket['JP'] ?? 0}. SIN {countByMarket['SG'] ?? 0}. Current coverage is uneven. More data is expected as 2026-2028 compliant cohorts mature.
    </p>
  </section>

  <section class="container rsl-premiums">
    <IMFigure
      fignum="EX-2"
      label="Round-size uplift"
      title="T1 companies show <em>larger observed rounds</em> at every stage."
      sub="Round-size uplift relative to the unregulated cohort. Seed near parity. The gap opens by Series C."
      source="hmm Ventures four-market dataset."
    >
      <SmallMultiples cols={4}>
        <PremiumBar label="Seed" value={p.round_size_seed} />
        <PremiumBar label="Series A" value={p.round_size_series_a} />
        <PremiumBar label="Series C" value={p.round_size_series_c} />
        <PremiumBar label="Series D+" value={p.round_size_series_d_plus} />
      </SmallMultiples>
    </IMFigure>
  </section>

  <section class="container rsl-exit-rate">
    <IMFigure
      fignum="EX-3"
      label="Exit incidence"
      title="T1 companies show <em>2.22x</em> the observed exit incidence of the unregulated cohort."
      sub={`Exit incidence: regulated cohort ${p.regulated_exit_rate_pct}% vs unregulated ${p.unregulated_exit_rate_pct}%.`}
      source="hmm Ventures four-market dataset."
    >
      <SmallMultiples cols={1}>
        <PremiumBar label="Exit rate, T1 vs unregulated" value={p.exit_rate_multiple} max={3} />
      </SmallMultiples>
    </IMFigure>
  </section>

  <CTARail />
</Base>

<style>
  .rsl-hero {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding-block: var(--s-8) var(--s-6);
  }
  .rsl-hero__kicker { color: var(--c-tomato); margin: var(--s-3) 0 0; }
  .rsl-hero__title {
    font-family: var(--f-display);
    font-size: clamp(2.5rem, 1.5rem + 4.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: var(--s-3) 0 var(--s-4);
    font-weight: 400;
    max-width: 22ch;
  }
  .rsl-hero__sub {
    font-family: var(--f-mono);
    font-size: var(--fs-md);
    line-height: 1.6;
    color: color-mix(in srgb, var(--c-pearl) 78%, transparent);
    max-width: 64ch;
    margin: 0;
  }

  .rsl-stats {
    padding-block: var(--s-7);
  }
  .rsl-stats__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: var(--hair) solid var(--hair-color);
    border-bottom: var(--hair) solid var(--hair-color);
  }
  .rsl-stats__cell {
    padding: var(--s-5) var(--s-4);
    border-left: var(--hair) solid var(--hair-color);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .rsl-stats__cell:first-child { border-left: 0; }
  .rsl-stats__n {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: 1;
    color: var(--hero);
    letter-spacing: -0.02em;
  }
  .rsl-stats__l {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-soft);
    line-height: 1.4;
    max-width: 24ch;
  }
  @media (max-width: 900px) {
    .rsl-stats__list { grid-template-columns: repeat(2, 1fr); }
    .rsl-stats__cell:nth-child(2n+1) { border-left: 0; }
    .rsl-stats__cell:nth-child(n+3) { border-top: var(--hair) solid var(--hair-color); }
  }
  @media (max-width: 560px) {
    .rsl-stats__list { grid-template-columns: 1fr; }
    .rsl-stats__cell { border-left: 0; border-top: var(--hair) solid var(--hair-color); }
    .rsl-stats__cell:first-child { border-top: 0; }
  }

  .rsl-exits {
    padding-block: var(--s-7);
  }
  .rsl-exits__note {
    margin-block-start: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-faint);
    max-width: 64ch;
  }
  .rsl-premiums { padding-block: var(--s-7); }
  .rsl-exit-rate { padding-block: var(--s-6) var(--s-8); max-width: 50rem; }
</style>
