---
import { getCollection } from 'astro:content';
import Research from '../../layouts/Research.astro';
import ResearchScrolly from '../../layouts/ResearchScrolly.astro';
import ResearchCorridor from '../../layouts/ResearchCorridor.astro';

export async function getStaticPaths() {
  const entries = await getCollection('research');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Template selection. Explicit `template` field in frontmatter wins; otherwise
// fall back to per-slug sets so existing entries don't need rewriting.
const denseSlugs = new Set(['regulatory-landscape']);
const scrollySlugs = new Set([
  'classifier-walkthrough',
  'exit-evidence-dataset',
  'crystallisation-window-2024-2030'
]);
const corridorSlugs = new Set(['country-corridor-snapshot']);

const template =
  entry.data.template
  ?? (scrollySlugs.has(entry.slug) ? 'scrolly'
   :  corridorSlugs.has(entry.slug) ? 'corridor'
   :  'dense');

const collapseSections = template === 'dense' && denseSlugs.has(entry.slug);
const dateIso = entry.data.date.toISOString();
---
{template === 'scrolly' && (
  <ResearchScrolly
    title={entry.data.title}
    description={entry.data.summary}
    headlineMetrics={entry.data.headline_metrics}
    date={dateIso}
    version={entry.data.version}
  >
    <Content />
  </ResearchScrolly>
)}
{template === 'corridor' && (
  <ResearchCorridor
    title={entry.data.title}
    description={entry.data.summary}
    headlineMetrics={entry.data.headline_metrics}
    date={dateIso}
    version={entry.data.version}
  >
    <Content />
  </ResearchCorridor>
)}
{template === 'dense' && (
  <Research
    title={entry.data.title}
    description={entry.data.summary}
    headlineMetrics={entry.data.headline_metrics}
    date={dateIso}
    version={entry.data.version}
    collapseSections={collapseSections}
  >
    <Content />
  </Research>
)}
