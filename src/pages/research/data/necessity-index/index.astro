---
import Index from '../../../../layouts/Index.astro';
import IndexCard from '../../../../components/IndexCard.astro';
import IndexMatrix from '../../../../components/IndexMatrix.astro';
import StatusIndicator from '../../../../components/StatusIndicator.astro';
import DataSection from '../../../../components/DataSection.astro';
import CiteThis from '../../../../components/CiteThis.astro';
import ClassifiedFunnel from '../../../../components/charts/ClassifiedFunnel.astro';
import MarketRegulationBar from '../../../../components/charts/MarketRegulationBar.astro';
import NecessityBar from '../../../../components/charts/NecessityBar.astro';
import data from '../../../../data/necessity-index.json';

const asOfLabel = new Date(data.as_of).toLocaleDateString('en-GB', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---
<Index
  title="The Necessity Index"
  description="The classified APAC technology universe. Quarterly. Embeddable. The citation engine for the four-market regulated thesis."
>
  <section class="ip container">
    <header class="ip__head">
      <div class="ip__meta">
        <span class="ip__reg" aria-hidden="true"></span>
        <span class="ip__kicker">Necessity Index · {data.version}</span>
        <StatusIndicator status="live" />
      </div>
      <h1 class="ip__title">The classified universe.</h1>
      <p class="ip__lede">
        Twenty-two thousand APAC technology companies, classified against the T1 / T2 thesis. Cross-referenced against 174 four-market regulations. Refreshed {data.refresh_cadence}.
      </p>
      <p class="ip__as-of">As of {asOfLabel}</p>
    </header>

    <DataSection
      fignum="NI-01"
      label="Universe · Four-market classified dataset"
      title='The classified universe sits at <em>22,217</em> companies.'
      sub="Of those, 19,416 trade in the four target markets. 174 four-market regulations frame the thesis."
      source="hmm Ventures classified universe · 2026-04-08 dataset"
      basis="Crunchbase + Dealroom · last_funding_amount join · four-market filter"
    >
      <div class="ip__grid ip__grid--4">
        <IndexCard label="Total companies classified" value={data.universe.total_companies} accent />
        <IndexCard label="Four-market subset" value={data.universe.four_market_companies} />
        <IndexCard label="Regulations mapped (global)" value={data.universe.regulations_global} />
        <IndexCard label="Four-market regulations" value={data.universe.regulations_four_market} accent />
      </div>
    </DataSection>

    <DataSection
      fignum="NI-02"
      label="T1 / T2 screen · Conservative classifier"
      title='One in three four-market companies <em>passes the screen</em>.'
      sub="Conservative T1 / T2 classifier across the four-market universe. T1 = licence-as-barrier."
      source="hmm Ventures conservative classifier"
      basis="T1 + T2 union · four-market subset"
    >
      <div class="ip__grid ip__grid--3">
        <IndexCard
          label="Conservative classifier share"
          value={data.tier_shares.conservative_classifier_pct}
          unit="%"
          accent
          source="Pass the T1 or T2 screen"
        />
        <IndexCard label="In-thesis companies" value={data.tier_shares.conservative_classifier_count} />
        <IndexCard label="T1 (licence-as-barrier)" value={data.tier_shares.t1_count} />
      </div>
    </DataSection>

    <section class="ip__inline-fig">
      <ClassifiedFunnel />
    </section>

    <section class="ip__inline-fig">
      <MarketRegulationBar />
    </section>

    <section class="ip__inline-fig">
      <NecessityBar />
    </section>

    <DataSection
      fignum="NI-06"
      label="Detail tables · Per market and per Necessity"
      title='Drill-down: <em>regulation, tier, and cohort detail</em>.'
      sub="Per-market and per-Necessity counts for the four-market universe. Heat-tinted by intensity. Japan classified count pending dataset re-query; regulations and tier breakdown verified."
      source="hmm Ventures classified universe + Comprehensive Regulatory Dataset"
      basis="Per-market + per-Necessity joins · four-market filter"
    >
      <IndexMatrix perMarket={data.per_market} perNecessity={data.per_necessity} />
    </DataSection>

    <DataSection
      fignum="NI-07"
      label="Round-size premiums · T1 vs unregulated"
      title='Cumulative funding multiple widens to <em>2.12x</em> by Series D+.'
      sub="T1 round-size premium relative to unregulated peers at each stage. Compounds across the funding ladder."
      source="hmm Ventures funding-premium analysis · 2024 four-market deal data"
      basis="T1 / unregulated · last_funding_amount · round-size median"
    >
      <div class="ip__grid ip__grid--4">
        <IndexCard label="Seed" value={data.premiums.round_size_seed} unit="x" />
        <IndexCard label="Series A" value={data.premiums.round_size_series_a} unit="x" />
        <IndexCard label="Series C" value={data.premiums.round_size_series_c} unit="x" accent />
        <IndexCard label="Series D+" value={data.premiums.round_size_series_d_plus} unit="x" />
      </div>
      <div class="ip__grid ip__grid--3 ip__grid--top-gap">
        <IndexCard label="Cumulative pre-seed" value={data.premiums.cumulative_pre_seed} unit="x" />
        <IndexCard label="Cumulative Series D+" value={data.premiums.cumulative_series_d_plus} unit="x" accent />
        <IndexCard
          label="Exit-rate multiple"
          value={data.premiums.exit_rate_multiple}
          unit="x"
          accent
          source={`${data.premiums.regulated_exit_rate_pct}% vs ${data.premiums.unregulated_exit_rate_pct}%`}
        />
      </div>
    </DataSection>

    <DataSection
      fignum="NI-08"
      label="The crystallisation window · 2024 to 2030"
      title='Thirty-four in-flight regulations. Peak density in <em>2027</em>.'
      sub="The window where regulator publications convert into operational compliance demand. Each market on a different clock."
      source="hmm Ventures Comprehensive Regulatory Dataset"
      basis="In-flight 2024 to 2030 · four-market subset"
    >
      <div class="ip__grid ip__grid--3">
        <IndexCard label="In-flight regulations 2024 to 2030" value={data.crystallisation_window.in_flight_2024_2030} accent />
        <IndexCard label="Peak year" value={String(data.crystallisation_window.peak_year)} />
        <IndexCard label="Regulations in peak year" value={data.crystallisation_window.peak_year_count} accent />
      </div>
      <p class="ip__note ip__note--cta">
        <a href="/research/data/calendar/">View the full calendar →</a>
      </p>
    </DataSection>

    <section class="ip__share">
      <p class="kicker ip__share-label">Use this index</p>
      <CiteThis
        title="The Necessity Index"
        version={data.version}
        href="/research/data/necessity-index/"
        date={data.as_of}
        embedSrc="/necessity-index/embed/"
      />
    </section>

    <footer class="ip__foot">
      <p class="ip__sources-label">Source datasets</p>
      <ul class="ip__sources" role="list">
        {data.source_datasets.map((s) => <li>{s}</li>)}
      </ul>
      <p class="ip__methodology">
        <a href="/research/data/necessity-index/methodology/">Methodology →</a>
        <span class="ip__embed-note"> · <a href="/necessity-index/embed/">Open the embed view</a></span>
      </p>
    </footer>
  </section>
</Index>

<style>
  .ip { max-width: 72rem; }

  .ip__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-end: var(--s-8);
    padding-block-end: var(--s-5);
    border-bottom: 1px solid color-mix(in srgb, var(--c-pearl) 18%, transparent);
  }
  .ip__meta {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .ip__reg {
    display: inline-block;
    width: 10px;
    height: 10px;
    background: var(--c-tomato);
    align-self: center;
  }
  .ip__kicker { color: color-mix(in srgb, var(--c-pearl) 70%, transparent); }
  .ip__meta :global(.status) { margin-inline-start: auto; }

  .ip__title {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    margin: var(--s-3) 0 0;
    color: var(--c-pearl);
  }
  .ip__lede {
    font-family: var(--f-display);
    font-style: italic;
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: color-mix(in srgb, var(--c-pearl) 78%, transparent);
    max-width: 56ch;
    margin: 0;
  }
  .ip__as-of {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--c-pearl) 55%, transparent);
    margin: 0;
  }

  .ip__section {
    padding-block: var(--s-6);
    border-bottom: 1px solid color-mix(in srgb, var(--c-pearl) 12%, transparent);
  }
  .ip__section:last-of-type { border-bottom: 0; }
  .ip__h2 {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: 0 0 var(--s-5);
    color: var(--c-pearl);
  }
  .ip__note {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
    margin: 0 0 var(--s-4);
  }
  .ip__note--cta { margin-block-start: var(--s-5); margin-block-end: 0; }
  .ip__note--cta a { color: var(--c-tomato); text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 1px; }

  .ip__inline-fig {
    padding-block: var(--s-7);
    border-bottom: 1px solid color-mix(in srgb, var(--c-pearl) 12%, transparent);
  }
  .ip__inline-fig:last-of-type { border-bottom: 0; }

  .ip__grid {
    display: grid;
    gap: var(--s-3);
  }
  .ip__grid--3 { grid-template-columns: repeat(3, 1fr); }
  .ip__grid--4 { grid-template-columns: repeat(4, 1fr); }
  .ip__grid--top-gap { margin-block-start: var(--s-3); }
  @media (max-width: 900px) {
    .ip__grid--3, .ip__grid--4 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .ip__grid--3, .ip__grid--4 { grid-template-columns: 1fr; }
  }

  .ip__share {
    padding-block: var(--s-6) var(--s-5);
    border-top: 1px solid color-mix(in srgb, var(--c-pearl) 18%, transparent);
    margin-block-start: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .ip__share-label { color: var(--c-tomato); margin: 0; }

  .ip__foot {
    padding-block-start: var(--s-5);
    border-top: 1px solid color-mix(in srgb, var(--c-pearl) 18%, transparent);
    margin-block-start: var(--s-3);
    font-family: var(--f-mono);
  }
  .ip__sources-label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
    margin: 0 0 var(--s-3);
  }
  .ip__sources {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    font-size: var(--fs-xs);
    color: color-mix(in srgb, var(--c-pearl) 75%, transparent);
  }
  .ip__methodology {
    margin-block-start: var(--s-5);
    font-size: var(--fs-sm);
  }
  .ip__methodology a { color: var(--c-tomato); text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 1px; }
  .ip__embed-note { color: color-mix(in srgb, var(--c-pearl) 60%, transparent); }
</style>
