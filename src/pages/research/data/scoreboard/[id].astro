---
import Base from '../../../../layouts/Base.astro';
import KickerLabel from '../../../../components/KickerLabel.astro';
import StatusIndicator from '../../../../components/StatusIndicator.astro';
import scoreboard from '../../../../data/scoreboard.json';

export async function getStaticPaths() {
  return scoreboard.predictions.map((p) => ({
    params: { id: p.id.toLowerCase() },
    props: { prediction: p }
  }));
}

const { prediction } = Astro.props;
const fmtDate = (iso?: string) =>
  iso ? new Date(iso).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: '2-digit' }) : '';
---
<Base
  title={`${prediction.id} · Scoreboard claim · hmm Ventures`}
  description={prediction.claim.slice(0, 200)}
>
  <article class="claim container">
    <header class="claim__head">
      <p class="claim__crumbs"><a href="/research/data/scoreboard/">← All claims</a></p>
      <KickerLabel index={prediction.id} label={`Claim · testable by ${fmtDate(prediction.testable_by)}`} accent />
      <h1 class="claim__title">{prediction.claim}</h1>
      <div class="claim__status-row">
        <StatusIndicator status={prediction.status as 'open' | 'pending' | 'closed' | 'confirmed' | 'refuted'} />
        {prediction.last_reviewed && (
          <span class="claim__reviewed">Last reviewed: {fmtDate(prediction.last_reviewed)}</span>
        )}
      </div>
    </header>

    {prediction.source && (
      <section class="claim__block">
        <p class="kicker claim__kicker">Source</p>
        <p class="claim__p">{prediction.source}</p>
      </section>
    )}

    {prediction.resolution_criteria && (
      <section class="claim__block">
        <p class="kicker claim__kicker">Resolution criteria</p>
        <p class="claim__p">{prediction.resolution_criteria}</p>
      </section>
    )}

    {prediction.evidence && prediction.evidence.length > 0 && (
      <section class="claim__block">
        <p class="kicker claim__kicker">Evidence</p>
        <ul class="claim__evidence" role="list">
          {prediction.evidence.map((e: { label: string; href: string }) => (
            <li><a href={e.href}>{e.label}</a></li>
          ))}
        </ul>
      </section>
    )}

    <section class="claim__share">
      <p class="kicker claim__kicker">Share this claim</p>
      <p class="claim__share-line">
        <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(prediction.claim)}&url=https://hmm.ventures/research/data/scoreboard/${prediction.id.toLowerCase()}/`} target="_blank" rel="noopener">Twitter / X</a>
        <span aria-hidden="true"> · </span>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=https://hmm.ventures/research/data/scoreboard/${prediction.id.toLowerCase()}/`} target="_blank" rel="noopener">LinkedIn</a>
        <span aria-hidden="true"> · </span>
        <a href={`mailto:?subject=${encodeURIComponent(`hmm Scoreboard ${prediction.id}`)}&body=${encodeURIComponent(prediction.claim + '\n\nhttps://hmm.ventures/research/data/scoreboard/' + prediction.id.toLowerCase() + '/')}`}>Email</a>
      </p>
    </section>
  </article>
</Base>

<style>
  .claim { padding-block: var(--s-8) var(--s-9); max-width: 56rem; }
  .claim__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-end: var(--s-7);
    padding-block-end: var(--s-5);
    border-bottom: 1px solid var(--rule);
  }
  .claim__crumbs {
    margin: 0;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .claim__crumbs a {
    color: var(--c-tomato);
    text-decoration: none;
  }
  .claim__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-snug);
    letter-spacing: -0.01em;
    margin: 0;
    max-width: 36ch;
  }
  .claim__status-row {
    display: flex;
    gap: var(--s-4);
    align-items: baseline;
    flex-wrap: wrap;
  }
  .claim__reviewed {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-faint);
  }

  .claim__block {
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .claim__kicker { color: var(--c-tomato); margin: 0; }
  .claim__p { margin: 0; line-height: 1.6; max-width: 56ch; }

  .claim__evidence {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
  }
  .claim__evidence a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }

  .claim__share {
    margin-block-start: var(--s-7);
    padding-block: var(--s-5);
    border-top: 2px solid var(--c-tomato);
  }
  .claim__share-line {
    margin: var(--s-2) 0 0;
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
  }
  .claim__share-line a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
</style>
