---
import Base from '../../../../layouts/Base.astro';
import Scoreboard from '../../../../components/Scoreboard.astro';
import BettingWindow from '../../../../components/BettingWindow.astro';
import DataSection from '../../../../components/DataSection.astro';
import ScoreboardTimeline from '../../../../components/ScoreboardTimeline.astro';
---
<Base
  title="Scoreboard"
  description="Five falsifiable claims with charity-bound bets. Adversarial collaboration as scholarly commitment."
>
  <section class="sb-page container">
    <header class="sb-page__head">
      <p class="kicker">Scoreboard</p>
      <h1 class="sb-page__title gavel-drop">Five claims. Dated. Sourced. <span class="sb-page__bettable stamp">Bettable.</span></h1>
      <p class="sb-page__lede">
        Each prediction in The Necessity Doctrine is falsifiable, dated, and traceable to a public source. The scoreboard is where the claims live in the open.
      </p>
      <div class="sb-page__window">
        <BettingWindow />
      </div>
    </header>

    <DataSection
      fignum="SB-00"
      label="Claim timeline · Open through 2028"
      title='Five claims plotted. <em>NOW</em> at 2026; testable-by dates 2027 and 2028.'
      sub="Each claim resolves on a named date. Jump to a claim by clicking its label below the axis."
      source="hmm Ventures Scoreboard · scoreboard.json"
      basis="Five claims · testable-by dates · annual rescore window"
    >
      <ScoreboardTimeline />
    </DataSection>

    <DataSection
      fignum="SB-01"
      label="Falsifiable claims · Adversarial collaboration"
      title='Five predictions. <em>Dated</em>, sourced, bettable.'
      sub="Each claim is testable against a public dataset by a named date. Charity-bound bets accepted within the open window."
      source="hmm Ventures proprietary 22,217-company dataset · public regulator publications"
      basis="Resolution criteria stated per claim · annual rescore"
    >
      <Scoreboard />
    </DataSection>
  </section>
</Base>

<style>
  .sb-page { padding-block: var(--s-8) var(--s-9); }
  .sb-page__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    margin-block-end: var(--s-7);
    max-width: 72ch;
  }
  .sb-page__title {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    margin: 0;
  }
  .sb-page__bettable {
    color: var(--c-tomato);
    font-style: italic;
  }
  .sb-page__lede {
    font-size: var(--fs-lg);
    font-family: var(--f-display);
    line-height: var(--lh-snug);
    color: var(--fg-soft);
    max-width: 48ch;
  }
  .sb-page__window { margin-block-start: var(--s-4); max-width: 36rem; }
</style>
