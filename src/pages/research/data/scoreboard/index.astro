---
import Base from '../../../../layouts/Base.astro';
import Scoreboard from '../../../../components/Scoreboard.astro';
import BettingWindow from '../../../../components/BettingWindow.astro';
---
<Base
  title="Scoreboard"
  description="Five Structural Certainties. Five bets. Dated and traceable to a public source."
>
  <section class="sb-page container">
    <header class="sb-page__head">
      <h1 class="sb-page__title gavel-drop">Five certainties. Five bets.</h1>
      <p class="sb-page__lede">
        The thesis rests on five structural certainties. Each carries a falsifiable prediction, dated and testable against a public dataset. Charity-bound bets accepted within the open window.
      </p>
      <div class="sb-page__window">
        <BettingWindow />
      </div>
    </header>

    <Scoreboard />
  </section>
</Base>

<style>
  .sb-page { padding-block: var(--s-8) var(--s-9); }
  .sb-page__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    margin-block-end: var(--s-7);
    max-width: 72ch;
  }
  .sb-page__title {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    margin: 0;
  }
  .sb-page__lede {
    font-size: var(--fs-lg);
    font-family: var(--f-display);
    line-height: var(--lh-snug);
    color: var(--fg-soft);
    max-width: 56ch;
  }
  .sb-page__window { margin-block-start: var(--s-4); max-width: 36rem; }
</style>
