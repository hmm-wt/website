---
import Base from '../../layouts/Base.astro';
import LiveStatusStrip from '../../components/LiveStatusStrip.astro';
import { buildContactMailto } from '../../utils/mailto.ts';

const longForm = [
  {
    href: '/research/necessities/',
    title: 'The five necessities. And why now.',
    summary: 'Heal, power, eat, move, supply. Five non-discretionary demand vectors and the window across the four target markets, open through 2028.'
  },
  {
    href: '/research/method/',
    title: 'The method. How the fund identifies investable companies.',
    summary: 'T1 and T2. Licence-as-barrier and compulsion-as-barrier. The two-tier filter that takes the 19,416-company four-market universe down to the 6,505 in the thesis.'
  },
  {
    href: '/research/results/',
    title: 'The results. T1 graduation, T1 exits.',
    summary: 'Round-size premium from 1.12x at seed to 1.53x at Series C. Exit incidence at 2.22x the unregulated rate. Nine named exits, primary-source verified.'
  }
];

const dataProducts = [
  {
    href: '/research/data/necessity-index/',
    title: 'The Necessity Index',
    summary: 'The classified APAC technology universe. 22,217 companies against the T1 / T2 thesis. Cross-referenced against 174 four-market regulations.'
  },
  {
    href: '/research/data/calendar/',
    title: 'The Crystallisation Window',
    summary: 'Thirty-four in-flight regulations across the four markets, dated 2024 to 2030. Filterable by market, Necessity, tier. Density peaks 2026 to 2027.'
  },
  {
    href: '/research/data/scoreboard/',
    title: 'The Scoreboard',
    summary: 'Five Structural Certainties. Five falsifiable predictions, dated and testable against a public dataset. Charity-bound bets within the open window.'
  }
];

const mailto = buildContactMailto('Research · talk through it');
---
<Base
  title="Research"
  description="The map. The dataset. The calendar. Public research from hmm Ventures. Five necessities, four markets, the in-thesis universe, the named exits."
>
  <section class="rh container">
    <header class="rh__head">
      <h1 class="rh__title gavel-drop">What people need. Who is building it. How we know.</h1>
      <p class="rh__lede">
        The five necessities, the two-tier filter that identifies investable companies, and the empirical results — graduation rates and named exits. Three long-form pages plus three live data products.
      </p>
    </header>

    <LiveStatusStrip />

    <section class="rh__group" aria-label="Long-form research">
      <header class="rh__group-head">
        <p class="kicker rh__group-label">Long-form research</p>
      </header>
      <ol class="rh__list" role="list">
        {longForm.map((item) => (
          <li class="rh__cell">
            <a href={item.href} class="rh__link">
              <h3 class="rh__h">{item.title}</h3>
              <p class="rh__body">{item.summary}</p>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="rh__group" aria-label="Live data products">
      <header class="rh__group-head">
        <p class="kicker rh__group-label">Live data products</p>
      </header>
      <ol class="rh__list" role="list">
        {dataProducts.map((dp) => (
          <li class="rh__cell">
            <a href={dp.href} class="rh__link">
              <h3 class="rh__h">{dp.title}</h3>
              <p class="rh__body">{dp.summary}</p>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <footer class="rh__foot">
      <a class="rh__cta" href={mailto}>Talk through it →</a>
    </footer>
  </section>
</Base>

<style>
  .rh { padding-block: var(--s-8) var(--s-9); max-width: 72rem; }
  .rh__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-end: var(--s-5);
    padding-block-end: var(--s-5);
    border-bottom: 1px solid var(--rule);
  }
  .rh__title {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    margin: 0;
    letter-spacing: -0.02em;
    max-width: 28ch;
  }
  .rh__lede {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: var(--fg-soft);
    max-width: 60ch;
    margin: 0;
  }

  .rh__group { margin-block-start: var(--s-7); }
  .rh__group-head {
    padding-block-end: var(--s-3);
    margin-block-end: var(--s-3);
  }
  .rh__group-label { color: var(--c-tomato); margin: 0; }

  .rh__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 980px) { .rh__list { grid-template-columns: 1fr; } }

  .rh__cell { border-left: 1px solid var(--rule); }
  .rh__cell:first-child { border-left: 0; }
  @media (max-width: 980px) {
    .rh__cell { border-left: 0; border-top: 1px solid var(--rule); }
    .rh__cell:first-child { border-top: 0; }
  }

  .rh__link {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-6) var(--s-5);
    text-decoration: none;
    color: var(--fg);
    height: 100%;
    transition: background var(--mo-hold) var(--ease-golden);
  }
  .rh__link:hover { background: color-mix(in srgb, var(--c-tomato) 10%, transparent); }

  .rh__h {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-tight);
    margin: 0;
    color: var(--fg);
    transition: color var(--mo-tick) var(--ease-golden);
  }
  .rh__link:hover .rh__h { color: var(--c-tomato); }
  .rh__body {
    font-family: var(--f-body);
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--fg-soft);
    margin: 0;
    max-width: 44ch;
  }

  .rh__foot {
    margin-block-start: var(--s-8);
    padding-block-start: var(--s-5);
    border-top: 1px solid var(--rule);
  }
  .rh__cta {
    display: inline-block;
    padding: var(--s-3) var(--s-5);
    background: var(--c-tomato);
    color: var(--c-pearl);
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    transition: background var(--dur-1) var(--ease);
  }
  .rh__cta:hover { background: var(--c-mahogany); }
</style>
