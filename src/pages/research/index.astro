---
import Base from '../../layouts/Base.astro';
import CTARail from '../../components/CTARail.astro';
import { buildContactMailto } from '../../utils/mailto.ts';

const cards = [
  {
    href: '/research/method/',
    kicker: 'Method',
    title: 'How the filter identifies investable companies.',
    summary: 'Tier 1 licence-as-barrier and Tier 2 compulsion-as-barrier. The classifier that takes the four-market universe down to the cohort in scope at seed stage.',
  },
  {
    href: '/research/results/',
    kicker: 'Results',
    title: 'What the cohort does once it passes the filter.',
    summary: 'Round-size premium from 1.12x at seed to 1.53x at Series C. Exit incidence at 2.22x the unregulated rate. Nine named acquirer deals, primary-source verified.',
  },
  {
    href: '/references/',
    kicker: 'References',
    title: 'Every cited source, every dataset.',
    summary: 'The bibliography. Public datasets and primary-source references behind every number on the site.',
  },
];

const dataProducts = [
  {
    href: '/data/necessity-index/',
    kicker: 'Index',
    title: 'The Necessity Index.',
    summary: '22,217 companies against the T1 / T2 thesis. Cross-referenced against 174 four-market regulations.',
  },
  {
    href: '/data/calendar/',
    kicker: 'Calendar',
    title: 'The Crystallisation Window.',
    summary: 'Thirty-four in-flight regulations across the four markets, dated 2024 to 2030. Peak 2027.',
  },
  {
    href: '/data/scoreboard/',
    kicker: 'Scoreboard',
    title: 'Five falsifiable bets.',
    summary: 'Five Structural Certainties. Five testable predictions on the dataset. The window is open.',
  },
];
---
<Base
  title="Research"
  description="Method, results, references. The classifier, the graduation rates, the live data products."
>
  <header class="rsh-hero">
    <div class="container">
      <p class="kicker rsh-hero__kicker">The research</p>
      <h1 class="rsh-hero__title">Method. Results. References.</h1>
      <p class="rsh-hero__sub">
        Three long-form pages. Three live data products. Every number traces to a primary source.
      </p>
    </div>
  </header>

  <section class="rsh container">
    <header class="rsh__group-head">
      <p class="kicker">Long-form research</p>
    </header>
    <ol class="rsh__list" role="list">
      {cards.map((c) => (
        <li class="rsh__cell">
          <a class="rsh__link" href={c.href}>
            <span class="rsh__kicker">{c.kicker}</span>
            <h2 class="rsh__h">{c.title}</h2>
            <p class="rsh__body">{c.summary}</p>
            <span class="rsh__more">Open the page &rarr;</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="rsh container">
    <header class="rsh__group-head">
      <p class="kicker">Live data products</p>
    </header>
    <ol class="rsh__list rsh__list--data" role="list">
      {dataProducts.map((d) => (
        <li class="rsh__cell">
          <a class="rsh__link" href={d.href}>
            <span class="rsh__kicker">{d.kicker}</span>
            <h2 class="rsh__h">{d.title}</h2>
            <p class="rsh__body">{d.summary}</p>
            <span class="rsh__more">Open the product &rarr;</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <CTARail />
</Base>

<style>
  .rsh-hero {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding-block: var(--s-8) var(--s-6);
  }
  .rsh-hero__kicker { color: var(--c-tomato); margin: 0; }
  .rsh-hero__title {
    font-family: var(--f-display);
    font-size: clamp(2.5rem, 1.5rem + 4.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: var(--s-3) 0 var(--s-4);
    font-weight: 400;
  }
  .rsh-hero__sub {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: color-mix(in srgb, var(--c-pearl) 84%, transparent);
    max-width: 60ch;
    margin: 0;
  }
  .rsh {
    padding-block: var(--s-7);
  }
  .rsh__group-head {
    padding-block-end: var(--s-3);
    margin-block-end: var(--s-3);
  }
  .rsh__group-head .kicker { color: var(--c-tomato); margin: 0; }
  .rsh__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: var(--hair) solid var(--hair-color);
    border-bottom: var(--hair) solid var(--hair-color);
  }
  @media (max-width: 980px) {
    .rsh__list { grid-template-columns: 1fr; }
  }
  .rsh__cell { border-left: var(--hair) solid var(--hair-color); }
  .rsh__cell:first-child { border-left: 0; }
  @media (max-width: 980px) {
    .rsh__cell { border-left: 0; border-top: var(--hair) solid var(--hair-color); }
    .rsh__cell:first-child { border-top: 0; }
  }
  .rsh__link {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-6) var(--s-5);
    height: 100%;
    text-decoration: none;
    color: var(--fg);
    transition: background var(--mo-hold) var(--ease-golden);
  }
  .rsh__link:hover { background: color-mix(in srgb, var(--c-tomato) 8%, transparent); }
  .rsh__kicker {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-faint);
  }
  .rsh__h {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-tight);
    margin: 0;
    color: var(--fg);
    transition: color var(--mo-tick) var(--ease-golden);
  }
  .rsh__link:hover .rsh__h { color: var(--c-tomato); }
  .rsh__body {
    font-family: var(--f-body);
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--fg-soft);
    margin: 0;
    max-width: 44ch;
  }
  .rsh__more {
    margin-block-start: auto;
    padding-block-start: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--hero);
  }
</style>
