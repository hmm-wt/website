---
import RecordLayout from '../../layouts/RecordLayout.astro';
import MarketFlower from '../../components/record/MarketFlower.astro';

const longform = [
  {
    href: '/the-edge/',
    kicker: 'The edge',
    title: 'Why the regulated cohort reaches exit 2.22x as often.',
    summary: 'Observed exit incidence and the round-size uplift from seed to Series D+. The empirical pattern behind the thesis.',
    cta: 'Open the edge',
  },
  {
    href: '/data/necessity-index/methodology/',
    kicker: 'Methodology',
    title: 'How the universe is classified.',
    summary: 'The T1 licence-as-barrier and T2 compulsion-as-barrier screen, the source registers it reads, and the limits of the method.',
    cta: 'Open the method',
  },
  {
    href: '/references/',
    kicker: 'References',
    title: 'Every cited source, every dataset.',
    summary: 'The bibliography. Public datasets and primary-source references behind every number on the site.',
    cta: 'Open the page',
  },
];

const markets = [
  { href: '/thesis/australia/', code: 'AU' as const, name: 'Australia' },
  { href: '/thesis/japan/', code: 'JP' as const, name: 'Japan' },
  { href: '/thesis/new-zealand/', code: 'NZ' as const, name: 'New Zealand' },
  { href: '/thesis/singapore/', code: 'SG' as const, name: 'Singapore' },
];

const dataProducts = [
  {
    href: '/data/necessity-index/',
    kicker: 'Index',
    title: 'The Necessity Index.',
    summary: '19,416 four-market companies against the T1 / T2 Necessities. Cross-referenced against 174 four-market regulations.',
    cta: 'Open the product',
  },
  {
    href: '/data/calendar/',
    kicker: 'Calendar',
    title: 'The Crystallisation Window.',
    summary: 'Thirty-four in-flight regulations across the four markets, dated 2024 to 2030. Peak 2027.',
    cta: 'Open the product',
  },
  {
    href: '/data/scoreboard/',
    kicker: 'Scoreboard',
    title: 'Five falsifiable predictions.',
    summary: 'Five Structural Certainties. Five testable predictions on the dataset. The window is open.',
    cta: 'Open the product',
  },
];
---
<RecordLayout
  title="Method. Results. References."
  description="The edge, the method, the four markets, and three live data products. Every number traces to a primary source."
  section="method"
  tone="light"  folio="ex-30 / 38"
  locator='04 · <span class="here">The method</span>'
  next={{ href: '/about/', label: '05 The GP' }}
>
  <header class="rec-masthead">
    <p class="rec-masthead__eyebrow">04 · The method</p>
    <h1 class="rec-masthead__title">The edge, the method, the markets.</h1>
    <p class="rec-masthead__claim">Three long-form pages. Four market deep-dives. Three live data products. Every number traces to a primary source.</p>
  </header>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">Long-form research</span><span class="rec-beat__count">01 / 03</span></div>
    <ol class="mth-list mth-list--three" role="list">
      {longform.map((c) => (
        <li class="mth-cell">
          <a class="mth-link" href={c.href}>
            <span class="mth-kicker">{c.kicker}</span>
            <h2 class="mth-h">{c.title}</h2>
            <p class="mth-body">{c.summary}</p>
            <span class="mth-more">{c.cta} &rarr;</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The four markets</span><span class="rec-beat__count">02 / 03</span></div>
    <ol class="mth-list mth-list--four" role="list">
      {markets.map((m) => (
        <li class="mth-cell">
          <a class="mth-link mth-link--market" href={m.href}>
            <span class="mth-flower" aria-hidden="true"><MarketFlower market={m.code} size={24} /></span>
            <span class="mth-kicker">{m.code}</span>
            <h2 class="mth-h">Why {m.name}.</h2>
            <span class="mth-more">Open the chapter &rarr;</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">Live data products</span><span class="rec-beat__count">03 / 03</span></div>
    <ol class="mth-list mth-list--three" role="list">
      {dataProducts.map((d) => (
        <li class="mth-cell">
          <a class="mth-link" href={d.href}>
            <span class="mth-kicker">{d.kicker}</span>
            <h2 class="mth-h">{d.title}</h2>
            <p class="mth-body">{d.summary}</p>
            <span class="mth-more">{d.cta} &rarr;</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</RecordLayout>

<style>
  .mth-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  .mth-list--three { grid-template-columns: repeat(3, 1fr); }
  .mth-list--four { grid-template-columns: repeat(4, 1fr); }

  .mth-cell {
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .mth-link {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5);
    height: 100%;
    text-decoration: none;
    color: var(--fg);
    transition: background var(--mo-hold) var(--ease-golden);
  }
  .mth-link:hover { background: color-mix(in srgb, var(--c-tomato) 8%, transparent); }
  .mth-link--market { gap: var(--s-2); }
  .mth-flower { display: block; color: var(--c-mahogany); }
  .mth-kicker {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--c-tomato);
  }
  .mth-h {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: var(--fs-lg);
    line-height: 1.12;
    margin: 0;
    color: var(--fg);
    transition: color var(--mo-tick) var(--ease-golden);
  }
  .mth-link:hover .mth-h { color: var(--c-tomato); }
  .mth-body {
    font-family: var(--f-body);
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--fg-soft);
    margin: 0;
    max-width: 44ch;
  }
  .mth-more {
    margin-block-start: auto;
    padding-block-start: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--fg-faint);
  }
  .mth-link:hover .mth-more { color: var(--c-tomato); }

  @media (max-width: 900px) {
    .mth-list--four { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .mth-list, .mth-list--three, .mth-list--four { grid-template-columns: 1fr; }
  }
</style>
