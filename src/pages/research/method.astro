---
import Base from '../../layouts/Base.astro';
import ChartFrame from '../../components/ChartFrame.astro';
import UnitDotFunnel from '../../components/charts/UnitDotFunnel.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import CTARail from '../../components/CTARail.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import necessityData from '../../data/necessity-index.json';
import crystallisation from '../../data/crystallisation-window.json';

const t1Example = (mk: string) =>
  (crystallisation.regulations as any[]).find((r) => r.market === mk && r.tier === 'T1');
const t2Example = (mk: string) =>
  (crystallisation.regulations as any[]).find((r) => r.market === mk && r.tier === 'T2');

const orderedMarkets = ['AU', 'JP', 'NZ', 'SG'] as const;
const marketLabel: Record<string, string> = {
  AU: 'Australia', JP: 'Japan', NZ: 'New Zealand', SG: 'Singapore',
};

const t1Row = ['T1. Licence-as-barrier', ...orderedMarkets.map((mk) => {
  const r = t1Example(mk);
  return r ? r.title : 'In flight';
})];
const t2Row = ['T2. Compulsion-as-barrier', ...orderedMarkets.map((mk) => {
  const r = t2Example(mk);
  return r ? r.title : 'In flight';
})];

const universe = necessityData.universe.four_market_companies;
const inThesis = necessityData.tier_shares.conservative_classifier_count;
const seedStage = necessityData.stage_funnel[2].count;
const t1Total = necessityData.tier_shares.t1_count;
const t2Total = necessityData.tier_shares.t2_count;
---
<Base
  title="The method"
  description="Tier 1 licence-as-barrier and Tier 2 compulsion-as-barrier. The classifier that identifies investable companies."
>
  <header class="mth-hero">
    <div class="container">
      <Breadcrumb
        crumbs={[
          { label: 'hmm', href: '/' },
          { label: 'Research', href: '/research/' },
          { label: 'Method' },
        ]}
      />
      <p class="kicker mth-hero__kicker">The method</p>
      <h1 class="mth-hero__title">How the filter identifies investable companies.</h1>
      <p class="mth-hero__sub">
        Most seed funds treat regulation as friction. hmm treats it as a filter. The mechanism is mechanical, not philosophical.
      </p>
    </div>
  </header>

  <section class="container mth-filter" data-scrolly aria-label="The filter, demonstrated">
    <div class="mth-filter__viz" data-scrolly-viz>
      <div class="mth-filter__vizinner">
        <ChartFrame
          kicker="The cut"
          title="One regulation filter. Three stages."
          caption="Each dot is one company in the four-market dataset. Hero dots survive each stage of the cut."
          source="Source. hmm Ventures four-market dataset."
        >
          <UnitDotFunnel />
        </ChartFrame>
      </div>
    </div>
    <div class="mth-filter__rail">
      <div class="scrolly__stage" data-stage="s1">
        <p class="stage__kicker">Stage 1. The universe</p>
        <span class="stage__num">{universe.toLocaleString()}</span>
        <h2>Every classified technology company in scope.</h2>
        <p>Australia, Japan, New Zealand, Singapore. The four-market dataset hmm built and maintains.</p>
      </div>
      <div class="scrolly__stage" data-stage="s2">
        <p class="stage__kicker">Stage 2. The cut</p>
        <span class="stage__num">{inThesis.toLocaleString()}</span>
        <h2>Pass the regulation filter.</h2>
        <p>Companies sitting behind a Tier 1 licence or a Tier 2 compulsion barrier. {(necessityData.tier_shares.conservative_classifier_pct).toFixed(1)}% of the universe. No human triage.</p>
      </div>
      <div class="scrolly__stage" data-stage="s3">
        <p class="stage__kicker">Stage 3. The cohort</p>
        <span class="stage__num">{seedStage.toLocaleString()}</span>
        <h2>In thesis, at seed stage.</h2>
        <p>The addressable cohort. 25 of them get a cheque from Fund I.</p>
      </div>
    </div>
  </section>

  <section class="container mth-tiers">
    <header class="mth-tiers__head">
      <p class="kicker">The two tiers</p>
      <h2 class="mth-tiers__title">Licence on one side. Compulsion on the other.</h2>
      <p class="mth-tiers__sub">
        Tier 1 is permission to operate. Tier 2 is evidence of compliance. The binary is deliberate. {t1Total.toLocaleString()} T1 companies in scope. {t2Total.toLocaleString()} T2.
      </p>
    </header>
    <ComparisonTable
      headers={['Tier', 'AUS', 'JPN', 'NZL', 'SGP']}
      rows={[t1Row, t2Row]}
      note="Source. hmm Ventures comprehensive regulatory dataset. One in-flight example per market."
    />
  </section>

  <CTARail />
</Base>

<script>
  import '../../scripts/scrolly.ts';
</script>

<style>
  .mth-hero {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding-block: var(--s-8) var(--s-6);
  }
  .mth-hero__kicker { color: var(--c-tomato); margin: var(--s-3) 0 0; }
  .mth-hero__title {
    font-family: var(--f-display);
    font-size: clamp(2.5rem, 1.5rem + 4.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: var(--s-3) 0 var(--s-4);
    font-weight: 400;
    max-width: 22ch;
  }
  .mth-hero__sub {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: color-mix(in srgb, var(--c-pearl) 84%, transparent);
    max-width: 60ch;
    margin: 0;
  }

  .mth-filter {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-7);
    padding-block: var(--s-8);
    align-items: start;
  }
  .mth-filter__viz {
    position: sticky;
    top: 5vh;
    height: 90vh;
    display: grid;
    place-items: center;
  }
  .mth-filter__vizinner {
    width: 100%;
    max-width: 460px;
  }
  .mth-filter__rail :global(.scrolly__stage) {
    min-height: 80vh;
    padding-block: var(--s-7);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--s-3);
    max-width: 36ch;
    transition: color var(--mo-hold) var(--ease-golden), opacity var(--mo-hold) var(--ease-golden);
    opacity: 0.45;
    color: var(--fg-soft);
  }
  .mth-filter__rail :global(.scrolly__stage--active) {
    opacity: 1;
    color: var(--fg);
  }
  .mth-filter__rail :global(.stage__kicker) {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-faint);
    margin: 0;
  }
  .mth-filter__rail :global(.stage__num) {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: 1;
    color: var(--hero);
    letter-spacing: -0.02em;
  }
  .mth-filter__rail :global(.scrolly__stage h2) {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-tight);
    margin: 0;
    color: var(--fg);
  }
  .mth-filter__rail :global(.scrolly__stage p) {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    margin: 0;
  }
  @media (max-width: 880px) {
    .mth-filter { grid-template-columns: 1fr; gap: 0; }
    .mth-filter__viz {
      height: 56vh;
      top: 0;
      background: var(--bg);
      z-index: 2;
      border-bottom: var(--hair) solid var(--hair-color);
    }
    .mth-filter__rail :global(.scrolly__stage) {
      min-height: 60vh;
      padding-block: var(--s-5);
    }
  }

  .mth-tiers {
    padding-block: var(--s-7) var(--s-8);
    max-width: 64rem;
  }
  .mth-tiers__head {
    max-width: 56ch;
    margin-block-end: var(--s-5);
  }
  .mth-tiers__head .kicker { color: var(--c-tomato); margin: 0; }
  .mth-tiers__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: var(--s-3) 0 var(--s-3);
    letter-spacing: -0.01em;
  }
  .mth-tiers__sub {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--fg-soft);
    margin: 0;
  }
</style>
