---
import RecordLayout from '../layouts/RecordLayout.astro';
---
<RecordLayout
  title="Not found"
  description="That page does not exist on hmm.ventures."
  section="necessities"
  tone="light"  folio="ex-00 / 38"
  locator='<span class="here">Not found</span>'
>
  <header class="rec-masthead">
    <p class="rec-masthead__eyebrow">404</p>
    <h1 class="rec-masthead__title">That page does not exist.</h1>
    <p class="rec-masthead__claim">
      The URL you followed does not resolve to a page on this site. The link may be stale, mistyped, or pointing at a page that has been moved.
    </p>
  </header>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">Find your way back</span><span class="rec-beat__count">01 / 01</span></div>
    <ul class="nf__list" role="list">
      <li><a href="/">Home</a></li>
      <li><a href="/necessities/">The five Necessities</a></li>
      <li><a href="/exits/">The exits</a></li>
      <li><a href="/research/">Research</a></li>
      <li><a href="/contact/">Contact</a></li>
    </ul>
  </section>
</RecordLayout>

<style>
  .nf__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .nf__list a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    min-width: var(--tap-min);
    padding: 0.5rem 0.5rem 0.5rem 0;
    color: var(--fg);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    align-self: flex-start;
  }
  .nf__list a:hover {
    color: var(--c-tomato);
    border-bottom-color: currentColor;
  }
</style>
