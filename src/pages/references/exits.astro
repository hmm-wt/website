---
import Base from '../../layouts/Base.astro';
import exitsData from '../../data/exits-named.json';

interface Exit {
  id: string;
  company: string;
  company_url: string | null;
  market: string;
  necessity: string;
  tier: string;
  barrier: string;
  acquirer: string;
  acquirer_url: string | null;
  acquirer_country: string;
  year: number;
  value_display: string;
  value_usd_m_low: number | null;
  value_usd_m_high: number | null;
}

const marketLabel: Record<string, string> = {
  AU: 'Australia',
  JP: 'Japan',
  NZ: 'New Zealand',
  SG: 'Singapore',
};

const exits = (exitsData.exits as Exit[]).slice().sort((a, b) => {
  if (b.year !== a.year) return b.year - a.year;
  return a.company.localeCompare(b.company);
});

const marketCounts = exits.reduce<Record<string, number>>((acc, e) => {
  acc[e.market] = (acc[e.market] || 0) + 1;
  return acc;
}, {});
---
<Base
  title="Exit references"
  description="Named acquisitions of regulated companies across Australia, Japan, New Zealand, and Singapore. Primary-source verified."
>
  <header class="ex-hero">
    <div class="container">
      <p class="kicker ex-hero__kicker">Exit references</p>
      <h1 class="ex-hero__title">The four markets clear.</h1>
      <p class="ex-hero__sub">
        Named acquisitions of regulated companies across Australia, Japan, New Zealand, and Singapore. Strategic and financial acquirers from the United States, Europe, and intra-APAC. Primary-source verified per row.
      </p>
      <p class="ex-hero__note">{exitsData.scope_note}</p>
    </div>
  </header>

  <section class="ex container">
    <header class="ex__head">
      <p class="kicker ex__kicker">{exits.length} acquisitions</p>
      <h2 class="ex__title">Recent named exits.</h2>
      <ul class="ex__counts" role="list">
        {Object.entries(marketCounts).map(([code, n]) => (
          <li><span class="ex__count-num">{n}</span> <span class="ex__count-label">{marketLabel[code]}</span></li>
        ))}
      </ul>
    </header>

    <ol class="ex__list" role="list">
      {exits.map((e) => (
        <li class="ex__row" id={e.id}>
          <header class="ex__row-head">
            <span class="ex__year">{e.year}</span>
            <h3 class="ex__company">
              {e.company_url
                ? <a href={e.company_url} target="_blank" rel="noopener noreferrer">{e.company}</a>
                : <span>{e.company}</span>
              }
            </h3>
            <span class="ex__arrow" aria-hidden="true">→</span>
            <span class="ex__acquirer">
              {e.acquirer_url
                ? <a href={e.acquirer_url} target="_blank" rel="noopener noreferrer">{e.acquirer}</a>
                : e.acquirer
              }
            </span>
          </header>
          <dl class="ex__meta">
            <div class="ex__meta-row">
              <dt>Market</dt>
              <dd>{marketLabel[e.market]}</dd>
            </div>
            <div class="ex__meta-row">
              <dt>Necessity</dt>
              <dd>{e.necessity}</dd>
            </div>
            <div class="ex__meta-row">
              <dt>Tier</dt>
              <dd>{e.tier}</dd>
            </div>
            <div class="ex__meta-row">
              <dt>Compliance barrier</dt>
              <dd>{e.barrier}</dd>
            </div>
            <div class="ex__meta-row">
              <dt>Acquirer geography</dt>
              <dd>{e.acquirer_country}</dd>
            </div>
            <div class="ex__meta-row">
              <dt>Value</dt>
              <dd>{e.value_display}</dd>
            </div>
          </dl>
        </li>
      ))}
    </ol>

    <p class="ex__source">Source: {exitsData.source}</p>

    <nav class="ex__foot" aria-label="Related references">
      <a href="/references/">Glossary and citations &rarr;</a>
      <a href="/markets/">The four markets &rarr;</a>
    </nav>
  </section>
</Base>

<style>
  .ex-hero {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding-block: var(--s-8) var(--s-6);
  }
  .ex-hero__kicker { color: var(--c-tomato); margin: 0; }
  .ex-hero__title {
    font-family: var(--f-display);
    font-size: clamp(2.5rem, 1.5rem + 4.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: var(--s-3) 0 var(--s-4);
    font-weight: 400;
  }
  .ex-hero__sub {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: color-mix(in srgb, var(--c-pearl) 84%, transparent);
    max-width: 60ch;
    margin: 0 0 var(--s-4);
  }
  .ex-hero__note {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
    max-width: 72ch;
    margin: 0;
  }

  .ex { padding-block: var(--s-7) var(--s-9); max-width: 64rem; }

  .ex__head { margin-block-end: var(--s-6); }
  .ex__kicker { color: var(--c-tomato); margin: 0; }
  .ex__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: var(--s-3) 0 var(--s-4);
    letter-spacing: -0.01em;
  }
  .ex__counts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
  }
  .ex__counts li {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-2);
  }
  .ex__count-num {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: 1;
    color: var(--hero);
    letter-spacing: -0.01em;
  }
  .ex__count-label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-soft);
  }

  .ex__list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }
  .ex__row {
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    scroll-margin-top: var(--s-6);
  }
  .ex__row:target {
    background: color-mix(in srgb, var(--c-tomato) 8%, transparent);
    padding-inline: var(--s-3);
    margin-inline: calc(-1 * var(--s-3));
  }
  .ex__row-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-3);
  }
  .ex__year {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-tomato);
    font-weight: 600;
    min-width: 3rem;
  }
  .ex__company {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: var(--lh-tight);
    margin: 0;
    color: var(--fg);
  }
  .ex__company a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1px;
  }
  .ex__company a:hover { color: var(--c-tomato); border-bottom-color: currentColor; }
  .ex__arrow {
    font-family: var(--f-mono);
    color: var(--fg-faint);
  }
  .ex__acquirer {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: var(--lh-tight);
    color: var(--fg-soft);
  }
  .ex__acquirer a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1px;
  }
  .ex__acquirer a:hover { color: var(--c-tomato); border-bottom-color: currentColor; }

  .ex__meta {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-2) var(--s-5);
  }
  .ex__meta-row {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
    gap: var(--s-3);
    padding-block: var(--s-1);
  }
  .ex__meta-row dt {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-faint);
    margin: 0;
  }
  .ex__meta-row dd {
    font-family: var(--f-body);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--fg);
    margin: 0;
  }
  @media (max-width: 720px) {
    .ex__meta { grid-template-columns: 1fr; }
    .ex__meta-row { grid-template-columns: minmax(0, 10rem) minmax(0, 1fr); }
  }

  .ex__source {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: var(--fg-soft);
    margin-block-start: var(--s-6);
    padding-block-start: var(--s-4);
    border-top: 1px solid var(--rule);
    max-width: 72ch;
    line-height: 1.55;
    letter-spacing: 0.02em;
  }

  .ex__foot {
    margin-block-start: var(--s-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .ex__foot a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .ex__foot a:hover { color: var(--fg); border-bottom-color: var(--fg); }
</style>
