---
import RecordLayout from '../../layouts/RecordLayout.astro';
import Plate from '../../components/record/Plate.astro';
import exitsData from '../../data/exits-named.json';

interface Exit {
  id: string;
  company: string;
  company_url: string | null;
  type: 'acquisition' | 'ipo' | 'late_stage';
  market: string;
  necessity: string;
  tier: string;
  barrier: string;
  acquirer: string;
  acquirer_url: string | null;
  acquirer_country: string;
  year: number;
  value_display: string;
  value_usd_m_low: number | null;
  value_usd_m_high: number | null;
}

const typeLabel: Record<string, string> = {
  acquisition: 'Acquisition',
  ipo: 'Public listing',
  late_stage: 'Late-stage round',
};
const relationVerb: Record<string, string> = {
  acquisition: 'Acquired by',
  ipo: 'Listed on',
  late_stage: 'Backed by',
};
const geoLabel: Record<string, string> = {
  acquisition: 'Acquirer geography',
  ipo: 'Listing geography',
  late_stage: 'Company geography',
};

const marketLabel: Record<string, string> = {
  AU: 'Australia',
  JP: 'Japan',
  NZ: 'New Zealand',
  SG: 'Singapore',
};

const exits = (exitsData.exits as Exit[]).slice().sort((a, b) => {
  if (b.year !== a.year) return b.year - a.year;
  return a.company.localeCompare(b.company);
});

const marketCounts = exits.reduce<Record<string, number>>((acc, e) => {
  acc[e.market] = (acc[e.market] || 0) + 1;
  return acc;
}, {});
---
<RecordLayout
  title="Named outcomes"
  description="Named outcomes in regulated companies across Australia, Japan, New Zealand, and Singapore. Primary-source verified."
  section="exits"
  tone="light"  folio="ex-14 / 38"
  locator='02 · The exits <span style="color:var(--fg-faint)">&rarr;</span> <span class="here">Recent named exits</span>'
>
  <header class="rec-masthead">
    <p class="rec-masthead__eyebrow" style="color:var(--c-tomato)">02 · Named outcomes</p>
    <h1 class="rec-masthead__title">The four markets clear.</h1>
    <p class="rec-masthead__claim">
      Across Australia, Japan, New Zealand, and Singapore, regulated companies are acquired by global strategics, list on public markets, and raise late-stage capital from Series C onwards. Every figure is primary-source verified per row.
    </p>
  </header>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The scope</span><span class="rec-beat__count">01 / 03</span></div>
    <p class="rec-beat__note">{exitsData.scope_note}</p>
  </section>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The count</span><span class="rec-beat__count">02 / 03</span></div>
    <h2 class="rec-beat__arg">Named outcomes in the regulated Necessities.</h2>
    <ul class="ex-counts" role="list">
      {Object.entries(marketCounts).map(([code, n]) => (
        <li><span class="ex-counts__num">{n}</span> <span class="ex-counts__label">{marketLabel[code]}</span></li>
      ))}
    </ul>
  </section>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The outcomes</span><span class="rec-beat__count">03 / 03</span></div>
    <Plate
      ex="EX-14"
      label="Recent named exits"
      sub="Named developed-APAC outcomes in the regulated Necessities, most recent first."
      source={exitsData.source}
    >
      <ol class="ex-list" role="list">
        {exits.map((e) => (
          <li class="ex-row" id={e.id}>
            <header class="ex-row__head">
              <span class="ex-row__year">{e.year}</span>
              <span class="ex-row__type">{typeLabel[e.type]}</span>
              <h3 class="ex-row__company">
                {e.company_url
                  ? <a href={e.company_url} target="_blank" rel="noopener noreferrer">{e.company}</a>
                  : <span>{e.company}</span>
                }
              </h3>
              <span class="ex-row__relation">{relationVerb[e.type]}</span>
              <span class="ex-row__acquirer">
                {e.acquirer_url
                  ? <a href={e.acquirer_url} target="_blank" rel="noopener noreferrer">{e.acquirer}</a>
                  : e.acquirer
                }
              </span>
            </header>
            <dl class="ex-meta">
              <div class="ex-meta__row">
                <dt>Market</dt>
                <dd>{marketLabel[e.market]}</dd>
              </div>
              <div class="ex-meta__row">
                <dt>Necessity</dt>
                <dd>{e.necessity}</dd>
              </div>
              <div class="ex-meta__row">
                <dt>Tier</dt>
                <dd>{e.tier}</dd>
              </div>
              <div class="ex-meta__row">
                <dt>Compliance barrier</dt>
                <dd>{e.barrier}</dd>
              </div>
              <div class="ex-meta__row">
                <dt>{geoLabel[e.type]}</dt>
                <dd>{e.acquirer_country}</dd>
              </div>
              <div class="ex-meta__row">
                <dt>Value</dt>
                <dd>{e.value_display}</dd>
              </div>
            </dl>
          </li>
        ))}
      </ol>
    </Plate>
  </section>
</RecordLayout>

<style>
  /* Per-market count strip. Mono labels, serif numerals. */
  .ex-counts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
  }
  .ex-counts li { display: inline-flex; align-items: baseline; gap: var(--s-2); }
  .ex-counts__num {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: 1;
    color: var(--c-tomato);
    letter-spacing: -0.01em;
  }
  .ex-counts__label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-soft);
  }

  /* Exit rows live inside the Plate, so they inherit pearl-surface tokens. */
  .ex-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--p-rule, rgba(4, 47, 42, 0.18));
  }
  .ex-row {
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--p-rule, rgba(4, 47, 42, 0.18));
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    scroll-margin-top: var(--s-6);
  }
  .ex-row:target {
    background: color-mix(in srgb, var(--c-tomato) 8%, transparent);
    padding-inline: var(--s-3);
    margin-inline: calc(-1 * var(--s-3));
  }
  .ex-row__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-3);
  }
  .ex-row__year {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-tomato);
    font-weight: 600;
    min-width: 3rem;
  }
  .ex-row__type {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-mahogany);
    border: 1px solid var(--p-rule, rgba(4, 47, 42, 0.18));
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }
  .ex-row__relation {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: lowercase;
    letter-spacing: 0.04em;
    color: rgba(37, 0, 1, 0.42);
  }
  .ex-row__company {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: var(--lh-tight);
    margin: 0;
    color: var(--c-mahogany);
  }
  .ex-row__company a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--p-rule, rgba(4, 47, 42, 0.18));
    padding-bottom: 1px;
  }
  .ex-row__company a:hover { color: var(--c-tomato); border-bottom-color: currentColor; }
  .ex-row__acquirer {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: var(--lh-tight);
    color: rgba(37, 0, 1, 0.66);
  }
  .ex-row__acquirer a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--p-rule, rgba(4, 47, 42, 0.18));
    padding-bottom: 1px;
  }
  .ex-row__acquirer a:hover { color: var(--c-tomato); border-bottom-color: currentColor; }

  .ex-meta {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-2) var(--s-5);
  }
  .ex-meta__row {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
    gap: var(--s-3);
    padding-block: var(--s-1);
  }
  .ex-meta__row dt {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(37, 0, 1, 0.42);
    margin: 0;
  }
  .ex-meta__row dd {
    font-family: var(--f-body);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--c-mahogany);
    margin: 0;
  }
  @media (max-width: 720px) {
    .ex-meta { grid-template-columns: 1fr; }
    .ex-meta__row { grid-template-columns: minmax(0, 10rem) minmax(0, 1fr); }
  }
</style>
