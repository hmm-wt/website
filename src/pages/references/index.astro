---
import RecordLayout from '../../layouts/RecordLayout.astro';
import { getCollection } from 'astro:content';
import glossary from '../../data/glossary.json';

// Pull footnotes from the public content collections. The doctrine collection
// is retired (its routes redirect to /), so its citations are not surfaced here.
const [markets, research] = await Promise.all([
  getCollection('markets'),
  getCollection('research')
]);

interface Segment { kind: 'text' | 'link'; value: string; href?: string; }
interface Footnote { num: string; text: string; segments: Segment[]; }

const footnoteRe = /^\[\^(\d+)\]:\s*(.+?)$/gm;
const urlRe = /(https?:\/\/[^\s<>"')\]]+)/g;

function segmentise(text: string): Segment[] {
  const parts: Segment[] = [];
  let lastIndex = 0;
  let match: RegExpExecArray | null;
  urlRe.lastIndex = 0;
  while ((match = urlRe.exec(text)) !== null) {
    if (match.index > lastIndex) {
      parts.push({ kind: 'text', value: text.slice(lastIndex, match.index) });
    }
    let url = match[0];
    const trailing = url.match(/[.,;:!?]+$/);
    if (trailing) url = url.slice(0, -trailing[0].length);
    parts.push({ kind: 'link', value: url, href: url });
    if (trailing) parts.push({ kind: 'text', value: trailing[0] });
    lastIndex = match.index + match[0].length;
  }
  if (lastIndex < text.length) {
    parts.push({ kind: 'text', value: text.slice(lastIndex) });
  }
  return parts.length > 0 ? parts : [{ kind: 'text', value: text }];
}

function extractFootnotes(body: string): Footnote[] {
  const fns: Footnote[] = [];
  let m: RegExpExecArray | null;
  footnoteRe.lastIndex = 0;
  while ((m = footnoteRe.exec(body)) !== null) {
    const text = m[2].trim();
    fns.push({ num: m[1], text, segments: segmentise(text) });
  }
  return fns;
}

interface SourceGroup {
  collection: string;            // 'doctrine' | 'markets' | 'research'
  collectionLabel: string;
  anchor: string;                // 'doctrine' | 'markets' | 'research'
  items: { slug: string; title: string; chapter?: number; footnotes: Footnote[] }[];
}

function group(collection: string, label: string, anchor: string, entries: any[]): SourceGroup {
  const items = entries
    .map((e) => ({
      slug: e.slug,
      title: e.data.title as string,
      chapter: e.data.chapter as number | undefined,
      footnotes: extractFootnotes(e.body || '')
    }))
    .filter((it) => it.footnotes.length > 0)
    .sort((a, b) => {
      if (a.chapter != null && b.chapter != null) return a.chapter - b.chapter;
      return a.title.localeCompare(b.title);
    });
  return { collection, collectionLabel: label, anchor, items };
}

const sourceGroups: SourceGroup[] = [
  group('markets', 'Markets', 'markets', markets),
  group('research', 'Research', 'research', research)
];

// Beat numbering: glossary + three footnote sources.
const totalBeats = 1 + sourceGroups.length;
const pad = (n: number) => String(n).padStart(2, '0');
---
<RecordLayout
  title="Glossary and citations."
  description="Site-wide glossary and citation index. Every public claim and term across hmm.ventures traces here."
  section="method"
  tone="light"  folio="ex-34 / 38"
  locator='04 · The method <span style="color:var(--fg-faint)">&rarr;</span> <span class="here">References</span>'
>
  <header class="rec-masthead">
    <p class="rec-masthead__eyebrow">04 · The method</p>
    <h1 class="rec-masthead__title">Glossary and citations.</h1>
    <p class="rec-masthead__claim">Definitions and source notes for the market chapters and the research library.</p>
    <nav class="refs-toc" aria-label="On this page">
      <a href="#glossary">Glossary</a>
      <span aria-hidden="true">·</span>
      <a href="#markets">Markets</a>
      <span aria-hidden="true">·</span>
      <a href="#research">Research</a>
      <span aria-hidden="true">·</span>
      <a href="/references/exits/">Exits &rarr;</a>
    </nav>
  </header>

  <!-- GLOSSARY -->
  <section class="rec-beat" id="glossary" aria-label="Glossary">
    <div class="rec-beat__head"><span class="rec-beat__label">Glossary</span><span class="rec-beat__count">{pad(1)} / {pad(totalBeats)}</span></div>
    <h2 class="rec-beat__arg">Terms across the thesis, the markets, the research.</h2>
    <p class="rec-beat__prose">Definitions are written plainly so the assumptions and metrics can be reviewed without specialist context.</p>

    {glossary.categories.map((cat) => (
      <section class="refs__cat" id={`glossary-${cat.id}`}>
        <header class="refs__cat-head">
          <span class="refs__cat-idx">{cat.id.toUpperCase()}</span>
          <h3 class="refs__cat-title">{cat.label}</h3>
        </header>
        <dl class="refs__terms">
          {cat.terms.map((t) => (
            <div class="refs__term" id={`glossary-${cat.id}-${t.term.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
              <dt class="refs__term-key">{t.term}</dt>
              <dd class="refs__term-def">{t.def}</dd>
            </div>
          ))}
        </dl>
      </section>
    ))}
  </section>

  <!-- FOOTNOTES BY SOURCE -->
  {sourceGroups.map((sg, gi) => (
    <section class="rec-beat" id={sg.anchor} aria-label={sg.collectionLabel}>
      <div class="rec-beat__head"><span class="rec-beat__label">{sg.collectionLabel} · footnotes</span><span class="rec-beat__count">{pad(gi + 2)} / {pad(totalBeats)}</span></div>
      <h2 class="rec-beat__arg">{sg.items.length} {sg.items.length === 1 ? 'chapter' : 'entries'} with citations</h2>

      {sg.items.length === 0 ? (
        <p class="rec-beat__note">No external citations in this collection yet.</p>
      ) : sg.items.map((it) => (
        <section class="refs__ch" id={`${sg.anchor}-${it.slug}`}>
          <header class="refs__ch-head">
            {it.chapter != null && (
              <span class="refs__ch-idx">{sg.anchor === 'doctrine' ? 'Chapter' : it.chapter ? 'Chapter' : ''} {it.chapter != null ? String(it.chapter).padStart(2, '0') : ''}</span>
            )}
            <h3 class="refs__ch-title">{it.title}</h3>
          </header>
          <ol class="refs__list" role="list">
            {it.footnotes.map((fn) => (
              <li class="refs__item" id={`${sg.anchor}-${it.slug}-${fn.num}`}>
                <span class="refs__num">[{fn.num}]</span>
                <span class="refs__text">{fn.segments.map((seg) => (
                  seg.kind === 'link'
                    ? <a href={seg.href} target="_blank" rel="noopener noreferrer">{seg.value}</a>
                    : <Fragment>{seg.value}</Fragment>
                ))}</span>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </section>
  ))}
</RecordLayout>

<style>
  .refs-toc {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-2) var(--s-3);
    align-items: baseline;
    margin: var(--s-5) auto 0;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .refs-toc a {
    display: inline-flex;
    align-items: center;
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .refs-toc a:hover { color: var(--fg); border-bottom-color: var(--fg); }
  .refs-toc span { color: var(--fg-faint); }

  .rec-beat[id] { scroll-margin-top: var(--s-6); }

  /* Glossary categories */
  .refs__cat {
    padding-block: var(--s-5);
    border-top: 1px solid var(--rule);
  }
  .refs__cat:first-of-type { margin-block-start: var(--s-4); }
  .refs__cat-head {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    margin-block-end: var(--s-4);
  }
  .refs__cat-idx {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--c-tomato);
  }
  .refs__cat-title {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: var(--fs-lg);
    line-height: 1.12;
    margin: 0;
    color: var(--fg);
  }
  .refs__terms {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  .refs__term {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
    gap: var(--s-4);
    padding-block: var(--s-3);
    border-top: 1px solid var(--rule);
    scroll-margin-top: var(--s-6);
  }
  .refs__term:first-child { border-top: 0; padding-block-start: 0; }
  .refs__term:target {
    background: color-mix(in srgb, var(--c-tomato) 10%, transparent);
    padding-inline: var(--s-3);
    margin-inline: calc(-1 * var(--s-3));
  }
  .refs__term-key {
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    color: var(--c-tomato);
    line-height: 1.45;
    margin: 0;
    letter-spacing: 0.02em;
  }
  .refs__term-def {
    font-family: var(--f-body);
    font-size: var(--fs-base);
    line-height: 1.55;
    color: var(--fg-soft);
    margin: 0;
  }

  @media (max-width: 720px) {
    .refs__term {
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }
  }

  /* Footnote chapters */
  .refs__ch {
    padding-block: var(--s-5);
    border-top: 1px solid var(--rule);
    scroll-margin-top: var(--s-6);
  }
  .refs__ch:first-of-type { border-top: 0; padding-block-start: 0; }
  .refs__ch-head {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    margin-block-end: var(--s-4);
  }
  .refs__ch-idx {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--c-tomato);
  }
  .refs__ch-title {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: var(--fs-lg);
    line-height: 1.12;
    margin: 0;
    color: var(--fg);
  }
  .refs__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .refs__item {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: var(--s-3);
    padding-block: var(--s-2);
    scroll-margin-top: var(--s-6);
  }
  .refs__item:target {
    background: color-mix(in srgb, var(--c-tomato) 10%, transparent);
    padding-inline: var(--s-3);
    margin-inline: calc(-1 * var(--s-3));
  }
  .refs__num {
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    color: var(--c-tomato);
    line-height: 1.55;
  }
  .refs__text {
    font-family: var(--f-body);
    font-size: var(--fs-base);
    line-height: 1.55;
    color: var(--fg-soft);
  }
  .refs__text a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    word-break: break-word;
  }
</style>
