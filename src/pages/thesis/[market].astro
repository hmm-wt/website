---
import { getCollection } from 'astro:content';
import RecordLayout from '../../layouts/RecordLayout.astro';
import IMFigure from '../../components/IMFigure.astro';
import CrystallisationStrip from '../../components/charts/CrystallisationStrip.astro';
import JurisdictionMark from '../../components/JurisdictionMark.astro';

const marketLabel: Record<string, string> = {
  AU: 'Australia',
  JP: 'Japan',
  NZ: 'New Zealand',
  SG: 'Singapore',
};

// Decorative continuous folio. The markets sit inside The exits movement.
const marketFolio: Record<string, string> = { AU: '9', JP: '10', NZ: '11', SG: '12' };

const marketClaim: Record<string, string> = {
  AU: 'The regulatory architecture, the company universe, and the exit pathway across the five Necessities in Australia.',
  JP: 'The regulatory architecture, the company universe, and the exit pathway across the five Necessities in Japan.',
  NZ: 'The regulatory architecture, the company universe, and the exit pathway across the five Necessities in New Zealand.',
  SG: 'The regulatory architecture, the company universe, and the exit pathway across the five Necessities in Singapore.',
};

export async function getStaticPaths() {
  const entries = await getCollection('markets');
  const slugMap: Record<string, string> = {
    JP: 'japan',
    AU: 'australia',
    NZ: 'new-zealand',
    SG: 'singapore',
  };
  return entries.map((entry) => ({
    params: { market: slugMap[entry.data.rail_market] },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const market = entry.data.rail_market as 'AU' | 'JP' | 'NZ' | 'SG';
const fullName = marketLabel[market];
const { Content } = await entry.render();

const others = (['AU', 'JP', 'NZ', 'SG'] as const).filter((m) => m !== market);
const slugFor: Record<string, string> = { AU: 'australia', JP: 'japan', NZ: 'new-zealand', SG: 'singapore' };
---
<RecordLayout
  title={`Why ${fullName}`}
  description={`Why ${fullName} is one of the four target markets for hmm Ventures. The regulatory architecture, the company universe, the exit pathway.`}
  section="exits"
  tone="light"
  folio={`ex-${marketFolio[market]} / 38`}
  locator={`02 · The exits <span style="color:var(--fg-faint)">&rarr;</span> <span class="here">${fullName}</span>`}
  next={{ href: '/exits/', label: '02 The exits' }}
>
  <header class="rec-masthead">
    <span class="mkt-mark" aria-hidden="true"><JurisdictionMark market={market} size={48} /></span>
    <p class="rec-masthead__eyebrow">Markets · {fullName}</p>
    <h1 class="rec-masthead__title">Why {fullName}.</h1>
    <p class="rec-masthead__claim">{marketClaim[market]}</p>
  </header>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The window</span><span class="rec-beat__count">01 / 02</span></div>
    <IMFigure
      fignum="EX-1"
      label="The window"
      title={`${fullName}. <em>In-flight regulations</em> by year.`}
      sub={`Each bar counts effective dates in ${fullName} between 2024 and 2030.`}
      source="hmm Ventures regulatory dataset."
    >
      <CrystallisationStrip market={market} />
    </IMFigure>
  </section>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The market</span><span class="rec-beat__count">02 / 02</span></div>
    <div class="market-prose">
      <Content />
    </div>
  </section>

  <nav class="mkt-foot" aria-label="Other markets">
    <p class="mkt-foot__label">The other three markets</p>
    <ul role="list" class="mkt-foot__list">
      {others.map((m) => (
        <li><a href={`/thesis/${slugFor[m]}/`}>Why {marketLabel[m]} &rarr;</a></li>
      ))}
    </ul>
  </nav>
</RecordLayout>

<style>
  .rec-masthead .mkt-mark {
    display: inline-flex;
    color: var(--c-tomato);
    margin-bottom: var(--s-2);
  }

  /* Footnotes live on /references/. Hide the auto-rendered footnote section
     and inline markers so the chapter reads clean here. */
  .market-prose :global(section[data-footnotes]),
  .market-prose :global(.footnotes),
  .market-prose :global(sup.footnote-ref),
  .market-prose :global(a[data-footnote-ref]) {
    display: none;
  }

  /* Light-register prose. Inside .rec--light the tokens resolve to mahogany
     ink, so the chapter inherits the paper record automatically. */
  .market-prose { max-width: 64ch; }
  .market-prose :global(h2) {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: var(--fs-xl);
    line-height: 1.12;
    letter-spacing: -0.005em;
    color: var(--rec-ink);
    margin: var(--s-7) 0 var(--s-4);
  }
  .market-prose :global(h2:first-child) { margin-top: 0; }
  .market-prose :global(h3) {
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    letter-spacing: 0.04em;
    color: var(--rec-ink);
    margin: var(--s-6) 0 var(--s-3);
  }
  .market-prose :global(p) {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: 1.65;
    color: var(--fg-soft);
    margin: 0 0 var(--s-4);
  }
  .market-prose :global(strong) { color: var(--rec-ink); font-weight: 600; }
  .market-prose :global(em) { font-style: normal; }
  .market-prose :global(a) {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--c-tomato) 45%, transparent);
  }
  .market-prose :global(ul) {
    margin: 0 0 var(--s-4);
    padding-left: var(--s-5);
  }
  .market-prose :global(li) {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: 1.6;
    color: var(--fg-soft);
    margin: 0 0 var(--s-2);
  }
  .market-prose :global(blockquote) {
    margin: var(--s-5) 0;
    padding: var(--s-2) 0 var(--s-2) var(--s-5);
    border-left: 2px solid var(--c-tomato);
  }
  .market-prose :global(blockquote p) { margin-bottom: var(--s-3); }
  .market-prose :global(blockquote p:last-child) { margin-bottom: 0; }
  .market-prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: var(--s-6) 0;
  }

  .mkt-foot {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding-block: var(--s-6) var(--s-2);
  }
  .mkt-foot__label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-tomato);
    margin: 0;
  }
  .mkt-foot__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    font-family: var(--f-display);
    font-size: var(--fs-lg);
  }
  .mkt-foot__list a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    text-decoration: none;
    color: var(--rec-ink);
    border-bottom: 1px solid var(--rule);
  }
  .mkt-foot__list a:hover { color: var(--c-tomato); border-bottom-color: currentColor; }
</style>
