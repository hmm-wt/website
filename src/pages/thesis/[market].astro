---
import { getCollection } from 'astro:content';
import Essay from '../../layouts/Essay.astro';
import EssayMeta from '../../components/EssayMeta.astro';
import CrystallisationRail from '../../components/CrystallisationRail.astro';
import CrystallisationStrip from '../../components/charts/CrystallisationStrip.astro';
import ChartFrame from '../../components/ChartFrame.astro';
import JurisdictionMark from '../../components/JurisdictionMark.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const marketSlugs: Record<string, string> = {
  JP: 'japan',
  AU: 'australia',
  NZ: 'new-zealand',
  SG: 'singapore',
};

const slugToMarket: Record<string, 'AU' | 'JP' | 'NZ' | 'SG'> = {
  australia: 'AU',
  japan: 'JP',
  'new-zealand': 'NZ',
  singapore: 'SG',
};

const marketLabel: Record<string, string> = {
  AU: 'Australia',
  JP: 'Japan',
  NZ: 'New Zealand',
  SG: 'Singapore',
};

export async function getStaticPaths() {
  const entries = await getCollection('markets');
  const slugMap: Record<string, string> = {
    JP: 'japan',
    AU: 'australia',
    NZ: 'new-zealand',
    SG: 'singapore',
  };
  return entries.map((entry) => ({
    params: { market: slugMap[entry.data.rail_market] },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const market = entry.data.rail_market;
const fullName = marketLabel[market];
const { Content } = await entry.render();
---
<Essay
  title={`Why ${fullName}`}
  description={`Why ${fullName} is one of the four target markets for hmm Ventures. The regulatory architecture, the company universe, the exit pathway.`}
>
  <Fragment slot="meta">
    <Breadcrumb
      crumbs={[
        { label: 'hmm', href: '/' },
        { label: 'Markets', href: '/markets/' },
        { label: fullName },
      ]}
    />
    <div class="market-hero">
      <span class="market-hero__mark"><JurisdictionMark market={market} size={56} /></span>
      <EssayMeta
        chapterRef={`Thesis · Markets · ${fullName}`}
        title={`Why ${fullName}.`}
        readingTime={Math.ceil((entry.data.word_count ?? 1200) / 250)}
        market={market}
      />
    </div>
  </Fragment>

  <section class="market-tl">
    <ChartFrame
      kicker="The window"
      title={`${fullName}. In-flight regulations by year.`}
      caption={`Each bar counts effective dates in ${fullName} between 2024 and 2030. Hero bar marks the peak.`}
      source="Source. hmm Ventures comprehensive regulatory dataset."
    >
      <CrystallisationStrip market={market} />
    </ChartFrame>
  </section>

  <Content />

  <Fragment slot="widget">
    <CrystallisationRail market={market} limit={6} title={`${fullName} · upcoming`} />
  </Fragment>

  <Fragment slot="footer">
    <nav class="market-foot" aria-label="Other markets">
      <p class="kicker market-foot__label">The other three markets</p>
      <ul role="list" class="market-foot__list">
        {Object.entries(marketSlugs).filter(([code]) => code !== market).map(([code, slug]) => (
          <li><a href={`/thesis/${slug}/`}>Why {marketLabel[code]} →</a></li>
        ))}
      </ul>
      <p class="market-foot__hub kicker">
        <a href="/markets/">Back to the four markets &rarr;</a>
      </p>
    </nav>
  </Fragment>
</Essay>

<style>
  .market-hero { display: flex; gap: var(--s-5); align-items: flex-start; padding-block-end: var(--s-3); }
  .market-tl {
    margin-block: var(--s-6) var(--s-7);
    padding-block: var(--s-5);
    border-block: 1px solid var(--rule);
  }
  .market-hero__mark { color: var(--c-tomato); flex-shrink: 0; margin-block-start: var(--s-2); }
  .market-hero :global(.essay-meta) { padding-block-end: 0; border-bottom: 0; margin-block-end: 0; flex: 1; }

  .market-foot { display: flex; flex-direction: column; gap: var(--s-3); }
  .market-foot__label { margin: 0; color: var(--c-tomato); }
  .market-foot__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    font-family: var(--f-display);
    font-size: var(--fs-lg);
  }
  .market-foot__list a {
    text-decoration: none;
    color: var(--fg);
    border-bottom: 1px solid var(--rule);
    padding-block-end: 2px;
  }
  .market-foot__list a:hover {
    color: var(--c-tomato);
    border-bottom-color: currentColor;
  }
  .market-foot__hub { margin-block-start: var(--s-4); }
  .market-foot__hub a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
</style>
