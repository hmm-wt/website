---
import Base from '../layouts/Base.astro';
import ShapeStats from '../components/ShapeStats.astro';
import NecessitiesGrid from '../components/NecessitiesGrid.astro';
import MarketBlock from '../components/MarketBlock.astro';
import RegClockStrip from '../components/charts/RegClockStrip.astro';
import { getCollection } from 'astro:content';
import { buildContactMailto, buildIMRequestMailto } from '../utils/mailto.ts';

const doctrineEntries = await getCollection('doctrine');
const footnoteRe = /^\[\^(\d+)\]:\s*.+?$/gm;
const citationCount = doctrineEntries.reduce((acc, e) => {
  const matches = (e.body || '').match(footnoteRe);
  return acc + (matches ? matches.length : 0);
}, 0);
const chapterCount = doctrineEntries.length;

const lpMailto = buildIMRequestMailto();
const founderMailto = buildContactMailto('Founder intro');
---
<Base
  title="hmm Ventures"
  description="Necessity is the thesis. Seed-stage capital into the companies people need to heal, power, eat, move, and supply. Four markets in developed APAC."
>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__meta">
        <span class="hero__reg" aria-hidden="true"></span>
        <span class="hero__kicker">The Necessity Doctrine</span>
      </div>

      <h1 class="hero__sentence">
        <span class="shutter-wipe" style="--shutter-delay: 80ms;">Necessity is</span>
        <span class="hero__accent shutter-wipe" style="--shutter-delay: 520ms; --shutter-color: var(--c-tomato);">the&nbsp;thesis.</span>
      </h1>

      <p class="hero__sub">
        Seed-stage capital into the companies people need to heal, power, eat, move, and supply. Four markets in developed APAC, on a regulatory clock.
      </p>

      <div class="hero__clock">
        <RegClockStrip />
      </div>

      <p class="hero__actions">
        <a class="hero__primary" href="/doctrine/">Read the doctrine →</a>
        <a class="hero__secondary" href="/research/">See the research →</a>
      </p>
    </div>

    <div class="container">
      <ShapeStats />
    </div>

    <span class="hero__cue" aria-hidden="true">scroll</span>
  </section>

  <div class="container">
    <NecessitiesGrid />
  </div>

  <div class="container">
    <MarketBlock />
  </div>

  <section class="evidence container surface-light">
    <header class="evidence__head">
      <p class="kicker evidence__kicker">The evidence</p>
      <h2 class="evidence__title gavel-drop">Enter at parity. Exit at premium.</h2>
    </header>
    <p class="evidence__readmore"><a href="/research/results/">The graduation rates →</a></p>
  </section>

  <section class="paths container" aria-label="Where next">
    <header class="paths__head">
      <p class="kicker paths__kicker">Where next</p>
      <h2 class="paths__title gavel-drop">Pick the door.</h2>
    </header>

    <ol class="paths__list" role="list">
      <li class="paths__cell">
        <a href="#lps" class="paths__link">
          <span class="paths__when">If you allocate capital</span>
          <h3 class="paths__h">For LPs →</h3>
          <p class="paths__body">Request the IM. Single email, short template.</p>
        </a>
      </li>
      <li class="paths__cell">
        <a href="#founders" class="paths__link">
          <span class="paths__when">If you build what people need</span>
          <h3 class="paths__h">For founders →</h3>
          <p class="paths__body">What the fund backs, what it does not, the cheque.</p>
        </a>
      </li>
      <li class="paths__cell">
        <a href="/doctrine/" class="paths__link">
          <span class="paths__when">Read</span>
          <h3 class="paths__h">The Doctrine</h3>
          <p class="paths__body">Ten chapters on the Five Necessities, the four markets, the window.</p>
          <p class="paths__stat">{chapterCount} chapters · {citationCount} cited sources</p>
        </a>
      </li>
      <li class="paths__cell">
        <a href="/research/" class="paths__link">
          <span class="paths__when">Study</span>
          <h3 class="paths__h">The Research</h3>
          <p class="paths__body">The Necessity Index, the Crystallisation Window, the graduation rates.</p>
          <p class="paths__stat">3 long-form pages · 3 live data products</p>
        </a>
      </li>
      <li class="paths__cell">
        <a href="/research/data/scoreboard/" class="paths__link">
          <span class="paths__when">Watch</span>
          <h3 class="paths__h">The Scoreboard</h3>
          <p class="paths__body">Five Structural Certainties. Five dated, falsifiable bets.</p>
          <p class="paths__stat">5 certainties · testable by 2028</p>
        </a>
      </li>
    </ol>
  </section>

  <section id="lps" class="aud container">
    <header class="aud__head">
      <p class="kicker aud__kicker">If you allocate capital</p>
      <h2 class="aud__title gavel-drop">Request the IM.</h2>
      <p class="aud__lede">
        Single email. A few lines on the fund or office, the mandate, and what you have already read.
      </p>
    </header>
    <a class="aud__cta breathe" href={lpMailto}>Learn more →</a>
    <p class="aud__foot-line">Already read: <a href="/doctrine/">Doctrine</a> · <a href="/research/">Research</a> · <a href="/research/data/necessity-index/">Index</a> · <a href="/research/data/scoreboard/">Scoreboard</a></p>
  </section>

  <section id="founders" class="aud aud--alt container">
    <header class="aud__head">
      <p class="kicker aud__kicker">If you build what people need</p>
      <h2 class="aud__title gavel-drop">Seed cheques into the five non-discretionary needs.</h2>
      <p class="aud__lede">
        Heal, power, eat, move, supply. Four markets: Australia, Japan, New Zealand, Singapore. Regulation is the filter that tells the fund which companies are real. Read the doctrine before sending a deck.
      </p>
    </header>
    <a class="aud__cta breathe" href={founderMailto}>Tell us more →</a>
    <p class="aud__foot-line">Before sending: <a href="/doctrine/">Doctrine</a> · <a href="/research/method/">The filter</a></p>
  </section>

</Base>

<style>
  /* HERO */
  .hero {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding-block: var(--s-9) 0;
    position: relative;
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    padding-block-end: var(--s-7);
  }
  .hero__cue {
    position: absolute;
    bottom: var(--s-4);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--f-mono);
    font-size: calc(var(--fs-xs) * 0.9);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: color-mix(in srgb, var(--c-pearl) 50%, transparent);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    pointer-events: none;
  }
  .hero__cue::after {
    content: "";
    width: 1px;
    height: 24px;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--c-tomato) 60%, transparent), transparent);
    animation: hero-cue 2.4s ease-in-out infinite;
  }
  @keyframes hero-cue {
    0%, 100% { opacity: 0.4; transform: scaleY(0.8); }
    50% { opacity: 1; transform: scaleY(1.1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__cue::after { animation: none; }
  }
  @media (max-width: 720px) {
    .hero { padding-block: var(--s-6) 0; }
    .hero__inner { gap: var(--s-4); padding-block-end: var(--s-6); }
    .hero__cue { display: none; }
  }

  .hero__meta {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .hero__reg {
    display: inline-block;
    width: 10px;
    height: 10px;
    background: var(--c-tomato);
    align-self: center;
  }
  .hero__kicker { color: color-mix(in srgb, var(--c-pearl) 70%, transparent); }

  .hero__sentence {
    font-family: var(--f-display);
    font-size: clamp(3rem, 1.6rem + 6.2vw, 7rem);
    line-height: 1.0;
    letter-spacing: -0.025em;
    margin: var(--s-4) 0 0;
    max-width: 18ch;
    font-weight: 400;
  }
  .hero__accent { color: var(--c-tomato); }

  .hero__sub {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: color-mix(in srgb, var(--c-pearl) 84%, transparent);
    max-width: 56ch;
    margin: var(--s-3) 0 0;
  }

  .hero__clock {
    margin: var(--s-5) 0 0;
    max-width: 56rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin: var(--s-4) 0 0;
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .hero__primary {
    display: inline-block;
    padding: var(--s-3) var(--s-5);
    background: var(--c-tomato);
    color: var(--c-pearl);
    text-decoration: none;
    border: 1px solid var(--c-tomato);
    transition: background var(--mo-tick) var(--ease-golden), border-color var(--mo-tick) var(--ease-golden);
  }
  .hero__primary:hover { background: var(--c-pearl); color: var(--c-evergreen); border-color: var(--c-pearl); }
  .hero__secondary {
    display: inline-block;
    padding: var(--s-3) var(--s-5);
    color: var(--c-pearl);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--c-pearl) 40%, transparent);
    transition: color var(--mo-tick) var(--ease-golden), border-color var(--mo-tick) var(--ease-golden);
  }
  .hero__secondary:hover { color: var(--c-tomato); border-color: var(--c-tomato); }

  /* EVIDENCE */
  .evidence {
    padding-block: var(--s-7);
    max-width: 64rem;
    background: var(--c-pearl);
    color: var(--c-mahogany);
    margin-block: var(--s-8);
    padding-inline: var(--s-7);
  }
  .evidence__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-end: var(--s-5);
    max-width: 56ch;
  }
  .evidence__kicker { color: var(--c-tomato); margin: 0; }
  .evidence__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: 0;
    color: var(--c-mahogany);
  }
  .evidence__readmore {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0;
  }
  .evidence__readmore a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  .evidence__readmore a:hover { color: var(--c-mahogany); border-bottom-color: var(--c-mahogany); }

  /* PATHS — single merged routing band */
  .paths {
    padding-block: var(--s-8);
    max-width: 72rem;
  }
  .paths__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-end: var(--s-7);
  }
  .paths__kicker { color: var(--c-tomato); margin: 0; }
  .paths__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: 0;
  }

  .paths__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 1100px) { .paths__list { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .paths__list { grid-template-columns: 1fr; } }

  .paths__cell { border-left: 1px solid var(--rule); }
  .paths__cell:first-child { border-left: 0; }
  @media (max-width: 1100px) {
    .paths__cell:nth-child(odd) { border-left: 0; }
    .paths__cell { border-top: 1px solid var(--rule); }
    .paths__cell:nth-child(-n+2) { border-top: 0; }
  }
  @media (max-width: 600px) {
    .paths__cell { border-left: 0; border-top: 1px solid var(--rule); }
    .paths__cell:first-child { border-top: 0; }
  }

  .paths__link {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5);
    text-decoration: none;
    color: var(--fg);
    height: 100%;
    transition: background var(--mo-hold) var(--ease-golden);
  }
  .paths__link:hover { background: color-mix(in srgb, var(--c-tomato) 10%, transparent); }

  .paths__when {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-soft);
  }
  .paths__h {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-tight);
    margin: 0;
    color: var(--fg);
    transition: color var(--mo-tick) var(--ease-golden);
  }
  .paths__link:hover .paths__h { color: var(--c-tomato); }
  .paths__body {
    font-family: var(--f-body);
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--fg-soft);
    margin: 0;
    max-width: 36ch;
  }
  .paths__stat {
    margin-block-start: auto;
    padding-block-start: var(--s-3);
    border-top: 1px dashed var(--rule);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-tomato);
  }

  /* AUDIENCE ANCHORED PANELS — /#lps and /#founders */
  .aud {
    padding-block: var(--s-8) var(--s-7);
    max-width: 64rem;
    scroll-margin-top: var(--s-7);
    border-top: 1px solid var(--rule);
  }
  .aud--alt {
    background: var(--bg-warm);
  }
  .aud__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-end: var(--s-6);
    max-width: 56ch;
  }
  .aud__kicker { color: var(--c-tomato); margin: 0; }
  .aud__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: 0;
    color: var(--fg);
  }
  .aud__lede {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    color: var(--fg-soft);
    max-width: 60ch;
    margin: 0;
  }
  .aud__cta {
    display: inline-block;
    align-self: flex-start;
    padding: var(--s-4) var(--s-5);
    background: var(--c-tomato);
    color: var(--c-pearl);
    font-family: var(--f-mono);
    font-size: var(--fs-base);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    transition: background var(--dur-1) var(--ease);
  }
  .aud__cta:hover { background: var(--c-mahogany); }
  .aud__foot-line {
    margin-block-start: var(--s-5);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-soft);
  }
  .aud__foot-line a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .aud__foot-line a:hover { color: var(--fg); }
</style>
