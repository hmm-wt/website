---
import Base from '../layouts/Base.astro';
import ShapeStats from '../components/ShapeStats.astro';
import NecessitiesGrid from '../components/NecessitiesGrid.astro';
import MarketBlock from '../components/MarketBlock.astro';
import ChartFigure from '../components/ChartFigure.astro';
import PremiumWedge from '../components/charts/PremiumWedge.astro';
import RegClockStrip from '../components/charts/RegClockStrip.astro';
import { getCollection } from 'astro:content';

// Citation count is computed live from doctrine footnotes — same logic as
// /doctrine/references/. Single source of truth across surfaces.
const doctrineEntries = await getCollection('doctrine');
const footnoteRe = /^\[\^(\d+)\]:\s*.+?$/gm;
const citationCount = doctrineEntries.reduce((acc, e) => {
  const matches = (e.body || '').match(footnoteRe);
  return acc + (matches ? matches.length : 0);
}, 0);
const chapterCount = doctrineEntries.length;
---
<Base
  title="hmm Ventures"
  description="Necessity is the thesis. A doctrine for seed-stage capital in developed APAC, 2026 to 2030."
>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__meta">
        <span class="hero__reg" aria-hidden="true"></span>
        <span class="hero__kicker">The Necessity Doctrine · v1.0 · 2026</span>
        <span class="hero__live"><span class="hero__live-dot pulse-tomato"></span><span class="hero__live-text">live</span></span>
      </div>

      <h1 class="hero__sentence">
        <span class="shutter-wipe" style="--shutter-delay: 80ms;">Necessity is</span>
        <span class="hero__accent shutter-wipe" style="--shutter-delay: 520ms; --shutter-color: var(--c-tomato);">the&nbsp;thesis.</span>
      </h1>

      <p class="hero__sub">
        Seed-stage capital deployed where regulation defines the floor of operation. Four markets in developed APAC, on a regulatory clock.<span class="pause" aria-label="pause"></span>
      </p>

      <div class="hero__clock">
        <RegClockStrip />
      </div>

      <p class="hero__actions">
        <a class="hero__primary" href="/doctrine/">Read the doctrine →</a>
        <a class="hero__secondary" href="/research/">See the research →</a>
      </p>
    </div>

    <div class="container">
      <ShapeStats />
    </div>

    <span class="hero__cue" aria-hidden="true">scroll</span>
  </section>

  <div class="container">
    <NecessitiesGrid />
  </div>

  <div class="container">
    <MarketBlock />
  </div>

  <section class="evidence container surface-light">
    <header class="evidence__head">
      <p class="kicker evidence__kicker">The evidence</p>
      <h2 class="evidence__title gavel-drop">Enter at parity. Exit at premium.</h2>
      <p class="evidence__lede">
        Four-market dataset. The T1 premium widens at every stage from pre-seed parity to a 2.12x cumulative multiple at Series D+. Exit incidence runs at 2.22x the unregulated rate.
      </p>
    </header>

    <div class="evidence__fig">
      <PremiumWedge />
      <p class="evidence__readmore"><a href="/research/t1-graduation-rates/">Read the T1 graduation rates research →</a></p>
    </div>
  </section>

  <section class="paths container" aria-label="Three paths forward">
    <header class="paths__head">
      <p class="kicker paths__kicker">Three paths</p>
      <h2 class="paths__title gavel-drop">Read, study, or watch.</h2>
    </header>

    <ol class="paths__list" role="list">
      <li class="paths__cell">
        <a href="/doctrine/" class="paths__link">
          <span class="paths__idx">[01]</span>
          <span class="paths__kicker-l">Read</span>
          <h3 class="paths__h">The Necessity Doctrine</h3>
          <p class="paths__body">Ten chapters on the Five Necessities, the four markets, and the window in which the operational layer of regulated industries will be built.</p>
          <p class="paths__stat">{chapterCount} chapters  ·  {citationCount} cited sources  ·  ~10,000 words</p>
        </a>
      </li>
      <li class="paths__cell">
        <a href="/research/" class="paths__link">
          <span class="paths__idx">[02]</span>
          <span class="paths__kicker-l">Study</span>
          <h3 class="paths__h">The Research</h3>
          <p class="paths__body">The Necessity Index, the Crystallisation Window calendar, the Regulatory Landscape Report, the T1 graduation rates analysis. Citable, dated, sourced.</p>
          <p class="paths__stat">4 surfaces  ·  IM v3.8.3 anchored  ·  refreshed quarterly</p>
        </a>
      </li>
      <li class="paths__cell">
        <a href="/research/data/scoreboard/" class="paths__link">
          <span class="paths__idx">[03]</span>
          <span class="paths__kicker-l">Watch</span>
          <h3 class="paths__h">The Scoreboard</h3>
          <p class="paths__body">Five falsifiable claims. Dated. Sourced. Bettable, in charity, through the open window.</p>
          <p class="paths__stat">5 claims  ·  betting window through 2028  ·  zero excuses</p>
        </a>
      </li>
    </ol>
  </section>

  <section class="ways container" aria-label="Three ways in">
    <header class="ways__head">
      <p class="kicker ways__kicker">Three ways in</p>
      <h2 class="ways__title">Pick the door.</h2>
    </header>
    <ol class="ways__list" role="list">
      <li class="ways__cell">
        <a href="/lps/" class="ways__link">
          <span class="ways__idx">[01]</span>
          <span class="ways__when">If you allocate capital</span>
          <h3 class="ways__h">For LPs →</h3>
          <p class="ways__body">Request the IM. Single email with a short template asking for fund or office, role, and mandate fit.</p>
        </a>
      </li>
      <li class="ways__cell">
        <a href="/founders/" class="ways__link">
          <span class="ways__idx">[02]</span>
          <span class="ways__when">If you build in a regulated market</span>
          <h3 class="ways__h">For founders →</h3>
          <p class="ways__body">What we fund, what we don't, the process, the cheque.</p>
        </a>
      </li>
      <li class="ways__cell">
        <a href="/press/" class="ways__link">
          <span class="ways__idx">[03]</span>
          <span class="ways__when">If you write about venture or regulation</span>
          <h3 class="ways__h">For media →</h3>
          <p class="ways__body">Bio, factsheet, brand assets. Direct line for interviews and panels.</p>
        </a>
      </li>
    </ol>
  </section>

</Base>

<style>
  /* HERO */
  .hero {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding-block: var(--s-9) 0;
    position: relative;
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    padding-block-end: var(--s-7);
  }
  /* Subtle scroll-cue at bottom of hero (P-INT.2). */
  .hero__cue {
    position: absolute;
    bottom: var(--s-4);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--f-mono);
    font-size: calc(var(--fs-xs) * 0.9);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: color-mix(in srgb, var(--c-pearl) 50%, transparent);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    pointer-events: none;
  }
  .hero__cue::after {
    content: "";
    width: 1px;
    height: 24px;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--c-tomato) 60%, transparent), transparent);
    animation: hero-cue 2.4s ease-in-out infinite;
  }
  @keyframes hero-cue {
    0%, 100% { opacity: 0.4; transform: scaleY(0.8); }
    50% { opacity: 1; transform: scaleY(1.1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__cue::after { animation: none; }
  }
  @media (max-width: 720px) {
    .hero { padding-block: var(--s-6) 0; }
    .hero__inner { gap: var(--s-4); padding-block-end: var(--s-6); }
    .hero__cue { display: none; }
  }

  .hero__meta {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .hero__reg {
    display: inline-block;
    width: 10px;
    height: 10px;
    background: var(--c-tomato);
    align-self: center;
  }
  .hero__kicker { color: color-mix(in srgb, var(--c-pearl) 70%, transparent); }
  .hero__live {
    margin-inline-start: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--c-tomato);
  }
  .hero__live-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--c-tomato);
    display: inline-block;
  }
  .hero__live-text { font-weight: 600; letter-spacing: 0.14em; }

  .hero__sentence {
    font-family: var(--f-display);
    font-style: italic;
    font-size: clamp(3rem, 1.6rem + 6.2vw, 7rem);
    line-height: 1.0;
    letter-spacing: -0.025em;
    margin: var(--s-4) 0 0;
    max-width: 18ch;
    font-weight: 400;
  }
  .hero__accent { color: var(--c-tomato); }

  .hero__sub {
    font-family: var(--f-display);
    font-style: italic;
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: color-mix(in srgb, var(--c-pearl) 84%, transparent);
    max-width: 52ch;
    margin: var(--s-3) 0 0;
  }

  .hero__clock {
    margin: var(--s-5) 0 0;
    max-width: 56rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin: var(--s-4) 0 0;
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .hero__primary {
    display: inline-block;
    padding: var(--s-3) var(--s-5);
    background: var(--c-tomato);
    color: var(--c-pearl);
    text-decoration: none;
    border: 1px solid var(--c-tomato);
    transition: background var(--mo-tick) var(--ease-golden), border-color var(--mo-tick) var(--ease-golden);
  }
  .hero__primary:hover { background: var(--c-pearl); color: var(--c-evergreen); border-color: var(--c-pearl); }
  .hero__secondary {
    display: inline-block;
    padding: var(--s-3) var(--s-5);
    color: var(--c-pearl);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--c-pearl) 40%, transparent);
    transition: color var(--mo-tick) var(--ease-golden), border-color var(--mo-tick) var(--ease-golden);
  }
  .hero__secondary:hover { color: var(--c-tomato); border-color: var(--c-tomato); }

  /* EVIDENCE */
  .evidence {
    padding-block: var(--s-8);
    max-width: 64rem;
    background: var(--c-pearl);
    color: var(--c-mahogany);
    margin-block: var(--s-8);
    padding-inline: var(--s-7);
  }
  .evidence__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-end: var(--s-6);
    max-width: 56ch;
  }
  .evidence__kicker { color: var(--c-tomato); margin: 0; }
  .evidence__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: 0;
    color: var(--c-mahogany);
  }
  .evidence__lede {
    font-family: var(--f-display);
    font-style: italic;
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: color-mix(in srgb, var(--c-mahogany) 75%, transparent);
    margin: 0;
  }
  .evidence__fig { margin: 0; }
  .evidence__fig img {
    width: 100%;
    height: auto;
    border: 1px solid color-mix(in srgb, var(--c-mahogany) 14%, transparent);
    background: var(--c-pearl);
  }
  .evidence__fig figcaption {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--c-mahogany) 55%, transparent);
    margin-block-start: var(--s-3);
    line-height: 1.6;
  }
  .evidence__fig figcaption a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .evidence__fig figcaption a:hover { color: var(--c-mahogany); }

  /* PATHS */
  .paths {
    padding-block: var(--s-8);
    max-width: 72rem;
  }
  .paths__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-end: var(--s-7);
  }
  .paths__kicker { color: var(--c-tomato); margin: 0; }
  .paths__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: 0;
  }

  .paths__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 820px) { .paths__list { grid-template-columns: 1fr; } }

  .paths__cell { border-left: 1px solid var(--rule); }
  .paths__cell:first-child { border-left: 0; }
  @media (max-width: 820px) {
    .paths__cell { border-left: 0; border-top: 1px solid var(--rule); }
    .paths__cell:first-child { border-top: 0; }
  }

  .paths__link {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-6) var(--s-5);
    text-decoration: none;
    color: var(--fg);
    height: 100%;
    transition: background var(--mo-hold) var(--ease-golden);
  }
  .paths__link:hover { background: color-mix(in srgb, var(--c-tomato) 10%, transparent); }

  .paths__idx {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: var(--c-tomato);
    font-weight: 600;
    letter-spacing: 0.14em;
  }
  .paths__kicker-l {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--fg-soft);
  }
  .paths__h {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-tight);
    margin: 0;
    color: var(--fg);
  }
  .paths__body {
    font-family: var(--f-body);
    font-size: var(--fs-base);
    line-height: 1.55;
    color: var(--fg-soft);
    margin: 0;
    max-width: 44ch;
  }
  .paths__stat {
    margin-block-start: auto;
    padding-block-start: var(--s-3);
    border-top: 1px dashed var(--rule);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-tomato);
  }

  /* THREE WAYS IN — audience routing */
  .ways {
    padding-block: var(--s-7) var(--s-8);
    max-width: 72rem;
    border-top: 1px solid var(--rule);
  }
  .ways__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    margin-block-end: var(--s-5);
  }
  .ways__kicker { color: var(--c-tomato); margin: 0; }
  .ways__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: 0;
  }
  .ways__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--rule);
  }
  @media (max-width: 820px) {
    .ways__list { grid-template-columns: 1fr; }
  }
  .ways__cell {
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .ways__cell:last-child { border-right: 0; }
  @media (max-width: 820px) {
    .ways__cell { border-right: 0; }
  }
  .ways__link {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5);
    text-decoration: none;
    color: var(--fg);
    transition: background var(--mo-tick) var(--ease-golden);
  }
  .ways__link:hover, .ways__link:focus-within {
    background: rgba(196, 69, 57, 0.06);
  }
  .ways__idx {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-tomato);
    font-weight: 600;
  }
  .ways__when {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
  }
  .ways__h {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-tight);
    margin: 0;
    color: var(--fg);
    transition: color var(--mo-tick) var(--ease-golden);
  }
  .ways__link:hover .ways__h { color: var(--c-tomato); }
  .ways__body {
    font-family: var(--f-body);
    font-size: var(--fs-base);
    line-height: 1.55;
    color: var(--fg-soft);
    margin: 0;
    max-width: 36ch;
  }

  /* ENDLINE */
  .endline {
    padding-block: var(--s-7);
    border-top: 1px solid var(--rule);
    margin-block-start: var(--s-5);
    text-align: center;
  }
  .endline__line {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-3);
    font-family: var(--f-display);
    font-style: italic;
    font-size: var(--fs-xl);
    margin: 0;
  }
  .endline__label {
    font-family: var(--f-mono);
    font-style: normal;
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-tomato);
  }
  .endline__email {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  .endline__email:hover { color: var(--fg); border-bottom-color: var(--fg); }
</style>
