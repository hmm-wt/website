---
import Base from '../layouts/Base.astro';
import NecessityFunnel from '../components/charts/NecessityFunnel.astro';
import NecessityMark from '../components/NecessityMark.astro';
import CTARail from '../components/CTARail.astro';

// Necessity order is canonical eat / heal / move / power / supply per IM line 42
// and the LP deck (External/Outbound/01_Teaser/build/lib/data.py). Site aligned
// 2026-05-27.
const necessities = [
  {
    slug: 'eat',
    name: 'Food Security Systems',
    shortName: 'Eat',
    necessityKey: 'Food Security Systems',
    markKind: 'food' as const,
    inThesis: 395,
    claim: 'Traceability, biosecurity, recall-readiness, import and export assurance. Cannot launch without machine-readable proof.',
  },
  {
    slug: 'heal',
    name: 'Biomedical Systems',
    shortName: 'Heal',
    necessityKey: 'Biomedical Systems',
    markKind: 'biomedical' as const,
    inThesis: 1269,
    claim: 'Clinical software, diagnostics, AI-assisted decisions. Cannot ship without regulator clearance.',
  },
  {
    slug: 'move',
    name: 'Autonomous Systems',
    shortName: 'Move',
    necessityKey: 'Autonomous Systems',
    markKind: 'autonomous' as const,
    inThesis: 561,
    claim: 'Road, logistics, public-path, maritime, aviation. Cannot operate without licence.',
  },
  {
    slug: 'power',
    name: 'Power Systems',
    shortName: 'Power',
    necessityKey: 'Power Systems',
    markKind: 'power' as const,
    inThesis: 581,
    claim: 'Grid orchestration, storage, EV charging, distributed energy. Cannot connect without compliance proof.',
  },
  {
    slug: 'supply',
    name: 'Critical Materials and Supply Integrity',
    shortName: 'Supply',
    necessityKey: 'Critical Materials and Supply Integrity',
    markKind: 'materials' as const,
    inThesis: 505,
    claim: 'Provenance, chain of custody, processing history, ESG evidence. Cannot sell without traceability.',
  },
];
---
<Base
  title="hmm Ventures"
  description="Necessity is the Thesis. The five Necessities society cannot do without, now being rebuilt as AI moves into them. Eat, heal, move, power, supply, across four developed APAC markets."
>
  <section class="hero">
    <div class="container hero__inner">
      <h1 class="hero__sentence">
        <span class="hero__accent shutter-wipe" style="--shutter-delay: 80ms; --shutter-color: var(--c-tomato);">Necessity</span>
        <span class="shutter-wipe" style="--shutter-delay: 520ms;">is&nbsp;the&nbsp;Thesis.</span>
      </h1>

      <p class="hero__sub">
        <span class="sub-nec sub-nec--eat">Eat</span>, <span class="sub-nec sub-nec--heal">heal</span>, <span class="sub-nec sub-nec--move">move</span>, <span class="sub-nec sub-nec--power">power</span>, <span class="sub-nec sub-nec--supply">supply</span>: the five Necessities society cannot do without. <span class="sub-em">COVID</span> revealed which industries had to keep running when everything else stopped. Now AI is rebuilding them, across four developed APAC markets.
      </p>

      <NecessityFunnel />

      <ul class="hero__marks" role="list" aria-label="The five Necessities">
        {necessities.map((n) => (
          <li class="hero__markitem">
            <a href={`/necessities/${n.slug}/`} class="hero__marklink" aria-label={n.name}>
              <NecessityMark kind={n.markKind} size={28} />
              <span class="hero__marklabel">{n.shortName}</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="hero__actions">
        <a class="hero__primary" href="/necessities/">See the five Necessities &rarr;</a>
        <a class="hero__secondary" href="/research/">See the research &rarr;</a>
      </p>
    </div>

  </section>

  <CTARail />
</Base>

<style>
  /* HERO. */
  .hero {
    background: transparent;
    color: var(--c-pearl);
    padding-block: var(--s-6) var(--s-5);
    position: relative;
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--s-3);
  }
  @media (max-width: 720px) {
    .hero { padding-block: var(--s-6) var(--s-5); }
    .hero__inner { gap: var(--s-4); }
  }

  .hero__sentence {
    font-family: var(--f-display);
    font-size: clamp(2.25rem, 1.4rem + 3vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin: 0;
    max-width: 34ch;
    font-weight: 400;
  }
  .hero__accent { color: var(--c-tomato); }

  .hero__sub {
    font-family: var(--f-mono);
    font-size: clamp(0.875rem, 0.83rem + 0.3vw, 1rem);
    line-height: 1.55;
    letter-spacing: 0.005em;
    color: color-mix(in srgb, var(--c-pearl) 72%, transparent);
    max-width: 60ch;
    margin: 0;
  }
  .sub-nec { font-weight: 500; }
  .sub-nec--eat    { color: var(--nec-eat); }
  .sub-nec--heal   { color: var(--nec-heal); }
  .sub-nec--move   { color: var(--nec-move); }
  .sub-nec--power  { color: var(--nec-power); }
  .sub-nec--supply { color: var(--nec-supply); }
  .sub-em { color: var(--c-pearl); font-weight: 500; }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-4);
    margin: 0;
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .hero__primary {
    display: inline-block;
    padding: var(--s-3) var(--s-5);
    background: var(--c-tomato);
    color: var(--c-pearl);
    text-decoration: none;
    border: 1px solid var(--c-tomato);
    transition: background var(--mo-tick) var(--ease-golden), border-color var(--mo-tick) var(--ease-golden);
  }
  .hero__primary:hover { background: var(--c-pearl); color: var(--c-evergreen); border-color: var(--c-pearl); }
  .hero__secondary {
    display: inline-block;
    padding: var(--s-3) var(--s-5);
    color: var(--c-pearl);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--c-pearl) 40%, transparent);
    transition: color var(--mo-tick) var(--ease-golden), border-color var(--mo-tick) var(--ease-golden);
  }
  .hero__secondary:hover { color: var(--c-tomato); border-color: var(--c-tomato); }

  .hero__marks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    gap: var(--s-4);
    flex-wrap: wrap;
  }
  .hero__markitem { display: inline-block; }
  .hero__marklink {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    gap: var(--s-2);
    padding: 0.5rem 0.7rem;
    text-decoration: none;
    color: color-mix(in srgb, var(--c-pearl) 80%, transparent);
    border: 1px solid color-mix(in srgb, var(--c-pearl) 18%, transparent);
    transition: color var(--mo-tick) var(--ease-golden), border-color var(--mo-tick) var(--ease-golden);
  }
  .hero__marklink:hover {
    color: var(--c-pearl);
    border-color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
  }
  .hero__marklabel {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  @media (max-width: 720px) {
    .hero__marks { gap: var(--s-3); }
    .hero__marklink { padding: 0.4rem 0.55rem; }
  }

</style>
