---
import Base from '../layouts/Base.astro';
import ShapeRow from '../components/ShapeRow.astro';
import UnitDotFunnel from '../components/charts/UnitDotFunnel.astro';
import NecessityPanelTeaser from '../components/NecessityPanelTeaser.astro';
import NecessityMark from '../components/NecessityMark.astro';
import CorridorGrid from '../components/CorridorGrid.astro';
import ChartFrame from '../components/ChartFrame.astro';
import CTARail from '../components/CTARail.astro';

const necessities = [
  {
    slug: 'heal',
    name: 'Biomedical Systems',
    shortName: 'Heal',
    necessityKey: 'Biomedical Systems',
    markKind: 'biomedical' as const,
    inThesis: 1269,
    claim: 'Clinical software, diagnostics, AI-assisted decisions. Cannot ship without regulator clearance.',
  },
  {
    slug: 'power',
    name: 'Power Systems',
    shortName: 'Power',
    necessityKey: 'Power Systems',
    markKind: 'power' as const,
    inThesis: 581,
    claim: 'Grid orchestration, storage, EV charging, distributed energy. Cannot connect without compliance proof.',
  },
  {
    slug: 'move',
    name: 'Autonomous Systems',
    shortName: 'Move',
    necessityKey: 'Autonomous Systems',
    markKind: 'autonomous' as const,
    inThesis: 561,
    claim: 'Road, logistics, public-path, maritime, aviation. Cannot operate without licence.',
  },
  {
    slug: 'supply',
    name: 'Critical Materials and Supply Integrity',
    shortName: 'Supply',
    necessityKey: 'Critical Materials and Supply Integrity',
    markKind: 'materials' as const,
    inThesis: 505,
    claim: 'Provenance, chain of custody, processing history, ESG evidence. Cannot sell without traceability.',
  },
  {
    slug: 'eat',
    name: 'Food Security Systems',
    shortName: 'Eat',
    necessityKey: 'Food Security Systems',
    markKind: 'food' as const,
    inThesis: 395,
    claim: 'Traceability, biosecurity, recall-readiness, import and export assurance. Cannot launch without machine-readable proof.',
  },
];
---
<Base
  title="hmm Ventures"
  description="Necessity is the thesis. Seed-stage capital into the companies people need to heal, power, eat, move, and supply. Four markets in developed APAC."
>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__meta">
        <span class="hero__reg" aria-hidden="true"></span>
        <span class="hero__kicker">The Necessity Doctrine</span>
      </div>

      <h1 class="hero__sentence">
        <span class="shutter-wipe" style="--shutter-delay: 80ms;">Necessity is</span>
        <span class="hero__accent shutter-wipe" style="--shutter-delay: 520ms; --shutter-color: var(--c-tomato);">the&nbsp;thesis.</span>
      </h1>

      <p class="hero__sub">
        Seed-stage capital into the companies people need to heal, power, eat, move, and supply. Four markets in developed APAC, on a regulatory clock.
      </p>

      <ul class="hero__marks" role="list" aria-label="The five Necessities">
        {necessities.map((n) => (
          <li class="hero__markitem">
            <a href={`/necessities/${n.slug}/`} class="hero__marklink" aria-label={n.name}>
              <NecessityMark kind={n.markKind} size={28} />
              <span class="hero__marklabel">{n.shortName}</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="hero__actions">
        <a class="hero__primary" href="#necessities">See the five Necessities &darr;</a>
        <a class="hero__secondary" href="/research/">See the research &rarr;</a>
      </p>
    </div>

  </section>

  <section class="gp-opener">
    <div class="container gp-opener__inner">
      <p class="kicker gp-opener__kicker">The GP</p>
      <p class="gp-opener__line">
        At an early age, his father, an anaesthetist, showed him how health systems reach past the patient to the family in the corridor, the team in theatre, and the people walking down the street. A school trip to Zealandia, the Wellington wildlife sanctuary held inside the world's first predator-proof fence, sparked a lifelong curiosity for how any system actually works.
      </p>
      <p class="gp-opener__readmore">
        <a href="/about/">Read more about the GP &rarr;</a>
      </p>
    </div>
  </section>

  <ShapeRow />

  <section class="filter container" data-scrolly aria-label="The filter, demonstrated">
    <div class="filter__viz" data-scrolly-viz>
      <div class="filter__vizinner">
        <ChartFrame
          kicker="The filter"
          title="Regulation does the deterministic cut."
          caption="Each dot is one company in the four-market classified universe. Hero dots survive the regulation filter; the brightest survive to seed-stage in-thesis."
          source="Source. hmm Ventures four-market dataset."
          centered={false}
        >
          <UnitDotFunnel />
        </ChartFrame>
      </div>
    </div>
    <div class="filter__rail">
      <div class="scrolly__stage" data-stage="s1">
        <p class="stage__kicker">Stage 1. The universe</p>
        <span class="stage__num">19,416</span>
        <h2>Companies in the four-market dataset.</h2>
        <p>Australia, Japan, New Zealand, Singapore. Every classified technology company in scope.</p>
      </div>
      <div class="scrolly__stage" data-stage="s2">
        <p class="stage__kicker">Stage 2. The cut</p>
        <span class="stage__num">6,505</span>
        <h2>Pass the regulation filter.</h2>
        <p>Companies sitting behind a Tier 1 licence or a Tier 2 compulsion barrier. 33.5% of the universe. No human triage.</p>
      </div>
      <div class="scrolly__stage" data-stage="s3">
        <p class="stage__kicker">Stage 3. The cohort</p>
        <span class="stage__num">2,625</span>
        <h2>In thesis, at seed stage.</h2>
        <p>The addressable cohort. 13.5% of the universe. 25 of them get a cheque.</p>
      </div>
    </div>
  </section>

  <section id="necessities" class="necessities-section container">
    <header class="necessities-section__head">
      <p class="kicker">The five Necessities</p>
      <h2 class="necessities-section__title">Heal. Power. Move. Supply. Eat.</h2>
      <p class="necessities-section__sub">
        The AI revolution becomes investable when it leaves the desk and enters the systems society cannot allow to fail.
      </p>
    </header>
    <ol class="necessities-section__list" role="list">
      {necessities.map((n, i) => (
        <NecessityPanelTeaser
          slug={n.slug}
          name={n.name}
          shortName={n.shortName}
          necessityKey={n.necessityKey}
          markKind={n.markKind}
          inThesis={n.inThesis}
          claim={n.claim}
          index={i}
        />
      ))}
    </ol>
  </section>

  <section class="markets-section container">
    <header class="markets-section__head">
      <p class="kicker">The four markets</p>
      <h2 class="markets-section__title">Developed APAC, on a regulatory clock.</h2>
    </header>
  </section>

  <CorridorGrid />

  <section class="evidence container">
    <p class="kicker evidence__kicker">The evidence</p>
    <p class="evidence__line">
      Nine named developed-APAC regulated-company acquisitions 2020 to 2026. Round-size premium 1.12x at seed, 1.53x at Series C. Exit incidence at 2.22x the unregulated rate.
    </p>
    <p class="evidence__readmore">
      <a href="/research/results/">See the graduation rates &rarr;</a>
    </p>
  </section>

  <CTARail />
</Base>

<style>
  /* HERO. */
  .hero {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding-block: var(--s-9) var(--s-7);
    position: relative;
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }
  .hero__cue {
    position: absolute;
    bottom: var(--s-4);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--f-mono);
    font-size: calc(var(--fs-xs) * 0.9);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: color-mix(in srgb, var(--c-pearl) 50%, transparent);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    pointer-events: none;
  }
  .hero__cue::after {
    content: "";
    width: 1px;
    height: 24px;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--c-tomato) 60%, transparent), transparent);
    animation: hero-cue 2.4s ease-in-out infinite;
  }
  @keyframes hero-cue {
    0%, 100% { opacity: 0.4; transform: scaleY(0.8); }
    50% { opacity: 1; transform: scaleY(1.1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__cue::after { animation: none; }
  }
  @media (max-width: 720px) {
    .hero { padding-block: var(--s-6) var(--s-5); }
    .hero__inner { gap: var(--s-4); }
    .hero__cue { display: none; }
  }

  .hero__meta {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .hero__reg {
    display: inline-block;
    width: 10px;
    height: 10px;
    background: var(--c-tomato);
    align-self: center;
  }
  .hero__kicker { color: color-mix(in srgb, var(--c-pearl) 70%, transparent); }

  .hero__sentence {
    font-family: var(--f-display);
    font-size: clamp(3rem, 1.6rem + 6.2vw, 7rem);
    line-height: 1.0;
    letter-spacing: -0.025em;
    margin: var(--s-4) 0 0;
    max-width: 18ch;
    font-weight: 400;
  }
  .hero__accent { color: var(--c-tomato); }

  .hero__sub {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: color-mix(in srgb, var(--c-pearl) 84%, transparent);
    max-width: 56ch;
    margin: var(--s-3) 0 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin: var(--s-4) 0 0;
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .hero__primary {
    display: inline-block;
    padding: var(--s-3) var(--s-5);
    background: var(--c-tomato);
    color: var(--c-pearl);
    text-decoration: none;
    border: 1px solid var(--c-tomato);
    transition: background var(--mo-tick) var(--ease-golden), border-color var(--mo-tick) var(--ease-golden);
  }
  .hero__primary:hover { background: var(--c-pearl); color: var(--c-evergreen); border-color: var(--c-pearl); }
  .hero__secondary {
    display: inline-block;
    padding: var(--s-3) var(--s-5);
    color: var(--c-pearl);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--c-pearl) 40%, transparent);
    transition: color var(--mo-tick) var(--ease-golden), border-color var(--mo-tick) var(--ease-golden);
  }
  .hero__secondary:hover { color: var(--c-tomato); border-color: var(--c-tomato); }

  .hero__marks {
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: 0;
    display: flex;
    gap: var(--s-4);
    flex-wrap: wrap;
  }
  .hero__markitem { display: inline-block; }
  .hero__marklink {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0.5rem 0.7rem;
    text-decoration: none;
    color: color-mix(in srgb, var(--c-pearl) 80%, transparent);
    border: 1px solid color-mix(in srgb, var(--c-pearl) 18%, transparent);
    transition: color var(--mo-tick) var(--ease-golden), border-color var(--mo-tick) var(--ease-golden);
  }
  .hero__marklink:hover {
    color: var(--c-pearl);
    border-color: color-mix(in srgb, var(--c-pearl) 60%, transparent);
  }
  .hero__marklabel {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  @media (max-width: 720px) {
    .hero__marks { gap: var(--s-3); }
    .hero__marklink { padding: 0.4rem 0.55rem; }
  }

  /* GP OPENER. Human anchor before the data sections. */
  .gp-opener {
    padding-block: var(--s-7);
    border-bottom: var(--hair) solid var(--hair-color);
  }
  .gp-opener__inner { max-width: 64rem; }
  .gp-opener__kicker { color: var(--c-tomato); margin: 0; }
  .gp-opener__line {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: var(--fg);
    max-width: 68ch;
    margin: var(--s-3) 0 var(--s-4);
  }
  .gp-opener__readmore {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0;
  }
  .gp-opener__readmore a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  .gp-opener__readmore a:hover { color: var(--fg); }

  /* FILTER. The scrolly. */
  .filter {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-7);
    padding-block: var(--s-8);
    align-items: start;
  }
  .filter__viz {
    position: sticky;
    top: 5vh;
    height: 90vh;
    display: grid;
    place-items: center;
  }
  .filter__vizinner {
    width: 100%;
    max-width: 460px;
  }
  .filter__rail :global(.scrolly__stage) {
    min-height: 80vh;
    padding-block: var(--s-7);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--s-3);
    max-width: 36ch;
    transition: color var(--mo-hold) var(--ease-golden), opacity var(--mo-hold) var(--ease-golden);
    opacity: 0.45;
    color: var(--fg-soft);
  }
  .filter__rail :global(.scrolly__stage--active) {
    opacity: 1;
    color: var(--fg);
  }
  .filter__rail :global(.stage__kicker) {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-faint);
    margin: 0;
  }
  .filter__rail :global(.stage__num) {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: 1;
    color: var(--hero);
    letter-spacing: -0.02em;
  }
  .filter__rail :global(.scrolly__stage h2) {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-tight);
    margin: 0;
    color: var(--fg);
  }
  .filter__rail :global(.scrolly__stage p) {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    margin: 0;
  }
  @media (max-width: 880px) {
    .filter {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .filter__viz {
      height: 56vh;
      top: 0;
      background: var(--bg);
      z-index: 2;
      border-bottom: var(--hair) solid var(--hair-color);
    }
    .filter__rail :global(.scrolly__stage) {
      min-height: 60vh;
      padding-block: var(--s-5);
    }
  }

  /* NECESSITIES SECTION. */
  .necessities-section {
    padding-block: var(--s-8) var(--s-7);
  }
  .necessities-section__head {
    max-width: 56ch;
    margin-block-end: var(--s-6);
  }
  .necessities-section__head .kicker {
    color: var(--c-tomato);
    margin: 0;
  }
  .necessities-section__title {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    margin: var(--s-3) 0 var(--s-3);
    letter-spacing: -0.02em;
  }
  .necessities-section__sub {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: var(--fg-soft);
    margin: 0;
    max-width: 50ch;
  }
  .necessities-section__list {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
  }

  /* WINDOW. */
  .window {
    padding-block: var(--s-7);
  }

  /* MARKETS. */
  .markets-section {
    padding-block: var(--s-7) 0;
  }
  .markets-section__head {
    max-width: 56ch;
  }
  .markets-section__head .kicker { color: var(--c-tomato); margin: 0; }
  .markets-section__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: var(--s-3) 0 0;
    letter-spacing: -0.01em;
  }

  /* EVIDENCE. */
  .evidence {
    padding-block: var(--s-7);
    border-top: var(--hair) solid var(--hair-color);
    max-width: 64rem;
  }
  .evidence__kicker { color: var(--c-tomato); margin: 0; }
  .evidence__line {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: var(--fg);
    max-width: 56ch;
    margin: var(--s-3) 0 var(--s-4);
  }
  .evidence__readmore {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0;
  }
  .evidence__readmore a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  .evidence__readmore a:hover { color: var(--fg); }
</style>

<script>
  import '../scripts/scrolly.ts';
</script>
