---
import Base from '../../layouts/Base.astro';
import KickerLabel from '../../components/KickerLabel.astro';

const operators = [
  {
    idx: '01',
    name: 'GoodFit',
    years: '4 years',
    role: 'Built the sourcing infrastructure',
    detail: 'Spent four years building and validating the classifier methodology now running against the four-market universe. The Necessity Index is a direct descendant of that work.'
  },
  {
    idx: '02',
    name: 'Paddle',
    years: 'APAC from inception',
    role: 'Built the cross-border commercial playbook',
    detail: 'Took the APAC mandate from zero. Stood up China from zero. 20% of company revenue by exit. The cross-border muscle portfolio founders now inherit was built here.'
  },
  {
    idx: '03',
    name: 'Skalata',
    years: 'National coverage',
    role: 'Built the deal-flow architecture',
    detail: 'Mandate was to take a non-profit accelerator to a seed fund and build national coverage across every Australian state. The sourcing layer hmm uses to find founders before they pitch anyone traces to this work.'
  }
];

const assets = [
  'A classifier that surfaces regulated founders before they pitch anyone.',
  'A sourcing layer anchored to regulatory filings, not conference pipelines.',
  'An underwriting discipline built around the approval pathway, not the pitch deck.',
  'A cross-border commercial playbook executed at Paddle, transferable to founders at entry.'
];
---
<Base
  title="The GP"
  description="hmm Ventures is Wahid Tashkandi, Founding GP. Cross-border operator. Seed-stage capital in developed APAC."
>
  <section class="ab container">
    <header class="ab__head">
      <KickerLabel index="00" label="The GP" accent />
      <h1 class="ab__title">Wahid Tashkandi</h1>
      <p class="ab__subline">Founding GP · hmm Ventures</p>
      <p class="ab__lede">
        Cross-border operating exposes seams the rest of the market treats as separate problems. Critical minerals mined in Western Australia, assembled in Shenzhen, sold to a hospital in Tokyo: three regulators, one compliance question, no margin for translation error. Medical device pathways under TGA and PMDA, grid-connection regimes under EMA and the Electricity Authority: different statutes, same gap. The vocabulary changes; the problem does not.
      </p>
    </header>

    <section class="ab__sec">
      <h2 class="ab__sec-title">Three companies. One pattern.</h2>
      <p class="ab__sec-lede">
        The Necessity Doctrine runs on muscles built across three operating roles. Each answers a different problem the fund has to solve.
      </p>
      <ol class="ab__list" role="list">
        {operators.map((op) => (
          <li class="ab__card surface-warm">
            <header class="ab__card-head">
              <span class="ab__card-idx">[{op.idx}]</span>
              <span class="ab__card-years">{op.years}</span>
            </header>
            <h3 class="ab__card-name">{op.name}</h3>
            <p class="ab__card-role">{op.role}</p>
            <p class="ab__card-detail">{op.detail}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="ab__sec">
      <h2 class="ab__sec-title">Four structural assets the generalist fund does not have.</h2>
      <ol class="ab__assets" role="list">
        {assets.map((a, i) => (
          <li class="ab__asset">
            <span class="ab__asset-idx">{String(i + 1).padStart(2, '0')}</span>
            <span class="ab__asset-text">{a}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="ab__coda">
      <p class="ab__coda-line">A generalist developed-APAC seed fund holds none of the four. That is the structural position.</p>
      <p class="ab__coda-line">Fund I establishes the method. The method scales.</p>
      <p class="ab__coda-line">Necessity is the thesis. Regulation is the filter. Developed APAC is the lane.</p>
    </section>

    <footer class="ab__foot">
      <a class="ab__cta-primary" href="/lps/">For LPs →</a>
      <a class="ab__cta-secondary" href="/scoreboard/">Five falsifiable claims → /scoreboard/</a>
      <a class="ab__cta-email" href="mailto:wt@hmm.ventures">wt@hmm.ventures</a>
    </footer>
  </section>
</Base>

<style>
  .ab { padding-block: var(--s-8) var(--s-9); max-width: 64rem; }

  .ab__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-end: var(--s-7);
    padding-block-end: var(--s-5);
    border-bottom: 1px solid var(--rule);
  }
  .ab__title {
    font-family: var(--f-display);
    font-style: italic;
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--c-pearl);
  }
  .ab__subline {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-soft);
    margin: 0;
  }
  .ab__lede {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    color: var(--fg);
    max-width: 60ch;
    margin: var(--s-4) 0 0;
  }

  .ab__sec { margin-block-start: var(--s-8); }
  .ab__sec-title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: 0 0 var(--s-3);
  }
  .ab__sec-lede {
    font-family: var(--f-display);
    font-style: italic;
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--fg-soft);
    max-width: 56ch;
    margin: 0 0 var(--s-5);
  }

  .ab__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-4);
  }
  @media (max-width: 900px) {
    .ab__list { grid-template-columns: 1fr; }
  }
  .ab__card {
    background: var(--bg-warm);
    padding: var(--s-5);
    border-left: 3px solid var(--c-tomato);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .ab__card-head {
    display: flex;
    gap: var(--s-3);
    align-items: baseline;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .ab__card-idx { color: var(--c-tomato); font-weight: 600; }
  .ab__card-years { color: var(--fg-soft); }
  .ab__card-name {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-tight);
    margin: 0;
  }
  .ab__card-role {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-tomato);
    margin: 0;
  }
  .ab__card-detail {
    font-family: var(--f-body);
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
    color: var(--fg-soft);
    margin: 0;
  }

  .ab__assets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .ab__asset {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--s-4);
    padding-block: var(--s-2);
    border-top: 1px solid var(--rule);
  }
  .ab__asset-idx {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: var(--c-tomato);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding-top: 0.15em;
  }
  .ab__asset-text {
    font-family: var(--f-body);
    font-size: var(--fs-base);
    line-height: var(--lh-body);
    color: var(--fg);
  }

  .ab__coda {
    margin-block-start: var(--s-8);
    padding: var(--s-6);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .ab__coda-line {
    font-family: var(--f-display);
    font-style: italic;
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--c-pearl);
    max-width: 52ch;
    margin: 0;
  }

  .ab__foot {
    margin-block-start: var(--s-7);
    padding-block-start: var(--s-5);
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-5);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .ab__cta-primary {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    font-weight: 600;
  }
  .ab__cta-primary:hover { color: var(--c-pearl); border-bottom-color: var(--c-pearl); }
  .ab__cta-secondary,
  .ab__cta-email {
    color: var(--fg-soft);
    text-decoration: none;
  }
  .ab__cta-secondary:hover,
  .ab__cta-email:hover { color: var(--c-tomato); }
</style>
