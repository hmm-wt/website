---
import Base from '../../layouts/Base.astro';
import CTARail from '../../components/CTARail.astro';
import { buildContactMailto } from '../../utils/mailto.ts';

interface Operator {
  idx: string;
  slug: 'paddle' | 'goodfit' | 'skalata';
  name: string;
  logo: string;
  url: string;
  role: string;
  years: string;
  detail: string;
  bridge: string;
  takeaway: string;
}

const operators: Operator[] = [
  {
    idx: '01',
    slug: 'paddle',
    name: 'Paddle',
    logo: '/logos/paddle.png',
    url: 'https://paddle.com',
    role: 'Cross-border operator',
    years: '2017. 2021',
    detail: 'Joined ahead of the Series B in December 2017 at under 30 people. Stayed four years through to the $1.4B Series D. Team-of-one: product validation, revenue building, post-sales function design, the APAC market build. By exit, APAC was around 20% of company revenue with China the primary contributor. The business had a single Chinese speaker, no local entity, and no playbook. He built China to the third-largest revenue contributor to the entire company inside 12 months.',
    bridge: '',
    takeaway: 'Cross-border operator',
  },
  {
    idx: '02',
    slug: 'skalata',
    name: 'Skalata Ventures',
    logo: '/logos/skalata.png',
    url: 'https://skalata.vc',
    role: 'National sourcing build',
    years: '2021. 2022',
    detail: 'Hired to take an organisation transitioning from non-profit accelerator to seed fund and build its outbound sourcing capability. Inside one year, deal-flow networks across universities, accelerators, and co-working spaces in every Australian state, from Hobart and the Sunshine Coast to Sydney and Melbourne. Founders who, when he met them, did not realise the problem they were solving was global. Twelve months later they were hiring in Colorado after closing their largest contract. Regulated-industry companies in developed APAC are systematically capital-scarce at seed relative to their eventual defensibility.',
    bridge: '',
    takeaway: 'National sourcing build',
  },
  {
    idx: '03',
    slug: 'goodfit',
    name: 'GoodFit',
    logo: '/logos/goodfit.png',
    url: 'https://goodfit.io',
    role: 'Revenue function build',
    years: '2021. 2025',
    detail: 'VP Revenue from a founder-led, high-churn starting point. 5x revenue growth. First enterprise agreements. Operations, marketing, customer success, and sales built from scratch. $13M Series A led by Notion Capital, September 2025. The classifier methodology powering Layers 1 and 2 of hmm\'s sourcing engine was built and validated over four years inside GoodFit, now rebuilt against a regulated-T1/T2 ICP. hmm\'s classifier is independently developed against public registry data and licensed commercial feeds. No GoodFit code, dataset, or proprietary IP transferred to hmm. GoodFit leadership is a reference for the underlying methodology and is reachable via the data room.',
    bridge: '',
    takeaway: 'Revenue function build',
  },
];

const gpBackgroundMailto = buildContactMailto('GP background');
---
<Base
  title="The GP"
  description="hmm Ventures is Wahid Tashkandi, Founding GP. Cross-border operator. Seed-stage capital in developed APAC."
>
  <header class="ab-hero">
    <div class="container">
      <p class="kicker ab-hero__kicker">The GP</p>
      <h1 class="ab-hero__title">Wahid Tashkandi</h1>
      <p class="ab-hero__subline">Founding GP. hmm Ventures.</p>
      <p class="ab-hero__opener">
        At an early age, his father, an anaesthetist, showed him how health systems reach past the patient to the family in the corridor and the team in theatre. A school trip to Zealandia, the Wellington wildlife sanctuary held inside the world's first predator-proof fence.
      </p>
    </div>
  </header>

  <section class="container ab-place">
    <p class="ab-place__line">
      Sydney to Wellington as a child. Jeddah, Melbourne, and London as an operator. Work reaching Shenzhen, Taipei, Chengdu, Kyiv, Barcelona, New York, the Bay Area, Montreal, Mexico City, and South Africa.
    </p>
    <p class="ab-place__line">
      Cross-border operating exposes seams others treat as separate problems. Critical minerals mined in Western Australia, assembled in Shenzhen, sold to a hospital in Tokyo: three regulators, one compliance question, no margin for translation error.
    </p>
    <p class="ab-place__line">
      APAC is not one market. It is four markets that look heterogeneous from outside: Japan's CVC dominance, Australia's super-backed Series A, New Zealand's regulator-as-partner pathway, Singapore's regulatory arbitrage.
    </p>
  </section>

  <section class="container ab-journey">
    <header class="ab-journey__head">
      <p class="kicker ab-journey__kicker">The journey</p>
    </header>
    <ol class="ab-journey__timeline" role="list">
      {operators.map((op) => (
        <li class="ab-journey__node">
          <span class="ab-journey__years">{op.years}</span>
          <span class="ab-journey__logo">
            <img src={op.logo} alt={op.name} loading="lazy" />
          </span>
          <span class="ab-journey__takeaway">{op.takeaway}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="container ab-roles">
    <header class="ab-roles__head">
      <p class="kicker ab-roles__kicker">The roles</p>
      <h2 class="ab-roles__title">A decade of work across three operating roles.</h2>
    </header>
    <ol class="ab-roles__list" role="list">
      {operators.map((op) => (
        <li class="ab-role">
          <header class="ab-role__head">
            <span class="ab-role__idx">[{op.idx}]</span>
            <a class="ab-role__logo" href={op.url} rel="noopener" target="_blank" aria-label={`${op.name} website`}>
              <img src={op.logo} alt={op.name} loading="lazy" />
            </a>
            <span class="ab-role__role">{op.role}</span>
          </header>
          <p class="ab-role__detail">{op.detail}</p>
          {op.bridge && <p class="ab-role__bridge">{op.bridge}</p>}
        </li>
      ))}
    </ol>
  </section>

  <section class="container ab-contact">
    <p class="ab-contact__line">
      GP background, references, anything not in the IM. <a href={gpBackgroundMailto}>wt@hmm.ventures</a>
    </p>
  </section>

  <CTARail />
</Base>

<style>
  .ab-hero {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding-block: var(--s-8) var(--s-7);
  }
  .ab-hero__kicker { color: var(--c-tomato); margin: 0; }
  .ab-hero__title {
    font-family: var(--f-display);
    font-size: clamp(2.5rem, 1.5rem + 4.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: var(--s-3) 0 var(--s-3);
    font-weight: 400;
  }
  .ab-hero__subline {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, var(--c-pearl) 70%, transparent);
    margin: 0 0 var(--s-5);
  }
  .ab-hero__opener {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: color-mix(in srgb, var(--c-pearl) 88%, transparent);
    max-width: 64ch;
    margin: 0;
  }

  .ab-place {
    padding-block: var(--s-7) var(--s-6);
    max-width: 64rem;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .ab-place__line {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    color: var(--fg);
    max-width: 64ch;
    margin: 0;
  }

  .ab-journey {
    padding-block: var(--s-7);
    border-top: var(--hair) solid var(--hair-color);
  }
  .ab-journey__head {
    margin-block-end: var(--s-5);
    max-width: 56ch;
  }
  .ab-journey__head .kicker { color: var(--c-tomato); margin: 0; }
  .ab-journey__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: var(--s-3) 0 0;
    letter-spacing: -0.01em;
  }
  .ab-journey__timeline {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: var(--hair) solid var(--hair-color);
    border-bottom: var(--hair) solid var(--hair-color);
  }
  .ab-journey__node {
    padding: var(--s-5);
    border-left: var(--hair) solid var(--hair-color);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .ab-journey__node:first-child { border-left: 0; }
  .ab-journey__years {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--hero);
  }
  .ab-journey__logo {
    color: var(--fg);
  }
  .ab-journey__logo img {
    height: 32px;
    width: auto;
    display: block;
  }
  .ab-journey__takeaway {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: var(--lh-tight);
    color: var(--fg);
  }
  @media (max-width: 800px) {
    .ab-journey__timeline { grid-template-columns: 1fr; }
    .ab-journey__node { border-left: 0; border-top: var(--hair) solid var(--hair-color); }
    .ab-journey__node:first-child { border-top: 0; }
  }

  .ab-roles { padding-block: var(--s-7); }
  .ab-roles__head { max-width: 56ch; }
  .ab-roles__head .kicker { color: var(--c-tomato); margin: 0; }
  .ab-roles__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: var(--s-3) 0 var(--s-5);
    letter-spacing: -0.01em;
  }
  .ab-roles__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: var(--hair) solid var(--hair-color);
  }
  .ab-role {
    padding-block: var(--s-6);
    border-bottom: var(--hair) solid var(--hair-color);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .ab-role__head {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    flex-wrap: wrap;
  }
  .ab-role__idx {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--hero);
  }
  .ab-role__logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding-block: 0.25rem;
    color: var(--fg);
    text-decoration: none;
    transition: color var(--mo-tick) var(--ease-golden);
  }
  .ab-role__logo:hover { color: var(--hero); }
  .ab-role__logo img {
    height: 36px;
    width: auto;
    display: block;
  }
  .ab-role__role {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-soft);
    margin-inline-start: auto;
  }
  .ab-role__detail {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    color: var(--fg);
    max-width: 64ch;
    margin: 0;
  }
  .ab-role__bridge {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--hero);
    padding-block-start: var(--s-3);
    border-top: var(--hair) solid var(--hair-color);
    margin: 0;
    line-height: 1.4;
  }

  .ab-contact {
    padding-block: var(--s-6) var(--s-7);
  }
  .ab-contact__line {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
    margin: 0;
  }
  .ab-contact__line a {
    color: var(--hero);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .ab-contact__line a:hover { color: var(--fg); border-bottom-color: var(--fg); }
</style>
