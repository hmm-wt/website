---
import Base from '../../layouts/Base.astro';
import CTARail from '../../components/CTARail.astro';
import { buildContactMailto } from '../../utils/mailto.ts';

interface Operator {
  idx: string;
  slug: 'paddle' | 'goodfit' | 'skalata';
  name: string;
  logo: string;
  url: string;
  role: string;
  years: string;
  detail: string;
  bridge: string;
}

const operators: Operator[] = [
  {
    idx: '01',
    slug: 'paddle',
    name: 'Paddle',
    logo: '/logos/paddle.png',
    url: 'https://paddle.com',
    role: 'Cross-border operator',
    years: '2017 – 2021',
    detail: 'Joined ahead of the Series B in December 2017 at under 30 people. Stayed four years through to the $1.4B Series D. Inside twelve months he had built China revenue from a single Chinese-speaking team member, no local entity, and no existing playbook into the third-largest country contribution to total company revenue, and the result persisted long after he had left. The cross-border GTM playbook the fund now transfers at seed was first executed at Paddle: pricing architecture, the first commercial hire, the enterprise sales motion, the decision set that bridges bootstrapped operations into a VC-backed growth posture.',
    bridge: '',
  },
  {
    idx: '02',
    slug: 'skalata',
    name: 'Skalata Ventures',
    logo: '/logos/skalata.png',
    url: 'https://skalata.vc',
    role: 'National sourcing build',
    years: '2021 – 2022',
    detail: 'Hired to take an organisation transitioning from non-profit accelerator to seed fund and build its outbound sourcing capability. The repositioning mandate rebuilt sourcing throughput from approximately 300 to 1,200 companies per quarter. Across that volume of regulated-technology companies the same pattern showed up market after market: companies whose eventual defensibility justified a Series A round were systematically under-capitalised at seed.',
    bridge: '',
  },
  {
    idx: '03',
    slug: 'goodfit',
    name: 'GoodFit',
    logo: '/logos/goodfit.png',
    url: 'https://goodfit.io',
    role: 'Revenue function build',
    years: '2022 – 2026',
    detail: 'VP Revenue from a founder-led, high-churn starting point. 5x revenue growth. First enterprise agreements. Operations, marketing, customer success, and sales built from scratch. $13M Series A led by Notion Capital, September 2025. The classifier methodology powering Layers 1 and 2 of hmm\'s sourcing engine was developed and validated across four years inside GoodFit. The architectural pattern most first-time funds spend their first eighteen months building is already running, rebuilt for hmm against a regulated-T1/T2 ICP. hmm\'s classifier is independently developed against public registry data and licensed commercial feeds. No GoodFit code, dataset, or proprietary IP transferred to hmm. GoodFit leadership is a reference for the underlying methodology and is reachable on request.',
    bridge: '',
  },
];

const gpBackgroundMailto = buildContactMailto('GP background');
---
<Base
  title="The GP"
  description="hmm Ventures is Wahid Tashkandi, Founding GP. Cross-border operator. Seed-stage capital in developed APAC."
>
  <header class="ab-hero">
    <div class="container">
      <p class="kicker ab-hero__kicker">The GP</p>
      <h1 class="ab-hero__title">Wahid Tashkandi</h1>
      <p class="ab-hero__subline">Founding GP. hmm Ventures.</p>
    </div>
  </header>

  <section class="container ab-journey">
    <header class="ab-journey__head">
      <p class="kicker ab-journey__kicker">The journey</p>
    </header>
    <ol class="ab-journey__timeline" role="list">
      {operators.map((op) => (
        <li class="ab-journey__node">
          <span class="ab-journey__years">{op.years}</span>
          <span class="ab-journey__logo">
            <img src={op.logo} alt={op.name} loading="lazy" />
          </span>
          <span class="ab-journey__takeaway">{op.role}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="container ab-roles">
    <header class="ab-roles__head">
      <p class="kicker ab-roles__kicker">The roles</p>
      <h2 class="ab-roles__title">A decade of work across three operating roles.</h2>
    </header>
    <ol class="ab-roles__list" role="list">
      {operators.map((op) => (
        <li class="ab-role">
          <header class="ab-role__head">
            <span class="ab-role__idx">[{op.idx}]</span>
            <a class="ab-role__logo" href={op.url} rel="noopener" target="_blank" aria-label={`${op.name} website`}>
              <img src={op.logo} alt={op.name} loading="lazy" />
            </a>
            <span class="ab-role__role">{op.role}</span>
          </header>
          <p class="ab-role__detail">{op.detail}</p>
          {op.bridge && <p class="ab-role__bridge">{op.bridge}</p>}
        </li>
      ))}
    </ol>
  </section>

  <section class="container ab-origin">
    <header class="ab-origin__head">
      <p class="kicker ab-origin__kicker">The origin</p>
    </header>
    <p class="ab-origin__opener">
      At an early age, his father, an anaesthetist, showed him how health systems reach past the patient to the family in the corridor and the team in theatre. A school trip to Zealandia, the Wellington wildlife sanctuary held inside the world's first predator-proof fence.
    </p>
    <p class="ab-origin__line">
      Sydney to Wellington as a child. Jeddah, Melbourne, and London as an operator. Work reaching Shenzhen, Taipei, Chengdu, Kyiv, Barcelona, New York, the Bay Area, Montreal, Mexico City, and South Africa.
    </p>
    <p class="ab-origin__line">
      Cross-border operating exposes seams others treat as separate problems. Critical minerals mined in Western Australia, assembled in Shenzhen, sold to a hospital in Tokyo. Each jurisdiction carries its own regulator and its own compliance posture, and a single product crosses all three.
    </p>
    <p class="ab-origin__line">
      Developed APAC reads as one market from outside and operates as four from inside. Japan runs on CVC dominance. Australia runs on super-backed Series A. New Zealand runs a regulator-as-partner pathway. Singapore runs regulatory arbitrage.
    </p>
  </section>

  <section class="container ab-closer">
    <p class="ab-closer__line">
      The same three-in-one quality runs through the operator stack: cross-border APAC operating from Paddle, an institutional sourcing build from Skalata, and the classifier already running from GoodFit. Most generalist seed funds in the target markets carry none of these, and even regulated-sector specialists rarely carry more than one.
    </p>
  </section>

  <section class="container ab-contact">
    <p class="ab-contact__line">
      GP background, references, anything not in the IM. <a href={gpBackgroundMailto}>wt@hmm.ventures</a>
    </p>
  </section>

  <CTARail />
</Base>

<style>
  .ab-hero {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding-block: var(--s-8) var(--s-7);
  }
  .ab-hero__kicker { color: var(--c-tomato); margin: 0; }
  .ab-hero__title {
    font-family: var(--f-display);
    font-size: clamp(2.5rem, 1.5rem + 4.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: var(--s-3) 0 var(--s-3);
    font-weight: 400;
  }
  .ab-hero__subline {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, var(--c-pearl) 70%, transparent);
    margin: 0;
  }

  .ab-origin {
    padding-block: var(--s-7);
    border-top: var(--hair) solid var(--hair-color);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .ab-origin__head { max-width: 56ch; margin-block-end: var(--s-3); }
  .ab-origin__head .kicker { color: var(--c-tomato); margin: 0; }
  .ab-origin__opener {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: var(--fg);
    max-width: 64ch;
    margin: 0;
  }
  .ab-origin__line {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    color: var(--fg);
    max-width: 64ch;
    margin: 0;
  }

  .ab-journey {
    padding-block: var(--s-7);
    border-top: var(--hair) solid var(--hair-color);
  }
  .ab-journey__head {
    margin-block-end: var(--s-5);
    max-width: 56ch;
  }
  .ab-journey__head .kicker { color: var(--c-tomato); margin: 0; }
  .ab-journey__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: var(--s-3) 0 0;
    letter-spacing: -0.01em;
  }
  .ab-journey__timeline {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: var(--hair) solid var(--hair-color);
    border-bottom: var(--hair) solid var(--hair-color);
  }
  .ab-journey__node {
    padding: var(--s-5);
    border-left: var(--hair) solid var(--hair-color);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .ab-journey__node:first-child { border-left: 0; }
  .ab-journey__years {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--hero);
  }
  .ab-journey__logo {
    color: var(--fg);
  }
  .ab-journey__logo img {
    height: 32px;
    width: auto;
    display: block;
  }
  .ab-journey__takeaway {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: var(--lh-tight);
    color: var(--fg);
  }
  @media (max-width: 800px) {
    .ab-journey__timeline { grid-template-columns: 1fr; }
    .ab-journey__node { border-left: 0; border-top: var(--hair) solid var(--hair-color); }
    .ab-journey__node:first-child { border-top: 0; }
  }

  .ab-roles { padding-block: var(--s-7); }
  .ab-roles__head { max-width: 56ch; }
  .ab-roles__head .kicker { color: var(--c-tomato); margin: 0; }
  .ab-roles__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: var(--s-3) 0 var(--s-5);
    letter-spacing: -0.01em;
  }
  .ab-roles__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: var(--hair) solid var(--hair-color);
  }
  .ab-role {
    padding-block: var(--s-6);
    border-bottom: var(--hair) solid var(--hair-color);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .ab-role__head {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    flex-wrap: wrap;
  }
  .ab-role__idx {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--hero);
  }
  .ab-role__logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding-block: 0.25rem;
    color: var(--fg);
    text-decoration: none;
    transition: color var(--mo-tick) var(--ease-golden);
  }
  .ab-role__logo:hover { color: var(--hero); }
  .ab-role__logo img {
    height: 36px;
    width: auto;
    display: block;
  }
  .ab-role__role {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-soft);
    margin-inline-start: auto;
  }
  .ab-role__detail {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    color: var(--fg);
    max-width: 64ch;
    margin: 0;
  }
  .ab-role__bridge {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--hero);
    padding-block-start: var(--s-3);
    border-top: var(--hair) solid var(--hair-color);
    margin: 0;
    line-height: 1.4;
  }

  .ab-closer {
    padding-block: var(--s-6);
    border-top: var(--hair) solid var(--hair-color);
  }
  .ab-closer__line {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--fg);
    max-width: 72ch;
    margin: 0;
  }

  .ab-contact {
    padding-block: var(--s-6) var(--s-7);
  }
  .ab-contact__line {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
    margin: 0;
  }
  .ab-contact__line a {
    color: var(--hero);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .ab-contact__line a:hover { color: var(--fg); border-bottom-color: var(--fg); }
</style>
