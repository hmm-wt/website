---
import RecordLayout from '../../layouts/RecordLayout.astro';
---
<RecordLayout
  title="Thanks"
  description="Message received."
  section="gp"
  tone="light"  folio="ex-38 / 38"
  locator='<span class="here">Thanks</span>'
>
  <header class="rec-masthead">
    <p class="rec-masthead__eyebrow">Received</p>
    <h1 class="rec-masthead__title">Thanks. We'll be in touch.</h1>
    <p class="rec-masthead__claim">
      Replies usually land within two business days. If it's urgent, mail <a href="mailto:wt@hmm.ventures">wt@hmm.ventures</a> directly.
    </p>
  </header>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">Next</span><span class="rec-beat__count">01 / 01</span></div>
    <p class="thanks__next">
      <a href="/">Back to the home page</a>
      <span aria-hidden="true">·</span>
      <a href="/research/">Read the doctrine</a>
    </p>
  </section>
</RecordLayout>

<style>
  .rec-masthead__claim a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .rec-masthead__claim a:hover { color: var(--fg); border-bottom-color: var(--fg); }

  .thanks__next {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-faint);
    margin: 0;
  }
  .thanks__next a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding-block: 0.5rem;
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .thanks__next a:hover { color: var(--fg); border-bottom-color: var(--fg); }
</style>
