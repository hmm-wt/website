---
import '../../styles/global.css';
import IndexCard from '../../components/IndexCard.astro';
import data from '../../data/necessity-index.json';

const asOfLabel = new Date(data.as_of).toLocaleDateString('en-GB', {
  year: 'numeric', month: 'short', day: '2-digit'
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The Necessity Index · hmm Ventures</title>
    <meta name="description" content="Embed: the classified APAC technology universe." />
    <link rel="canonical" href="https://hmm.ventures/research/data/necessity-index/" />
    <meta name="robots" content="noindex" />
  </head>
  <body class="embed">
    <h1 class="visually-hidden">The Necessity Index — classified APAC technology universe ({data.version}, as of {asOfLabel})</h1>
    <a class="embed__link" href="https://hmm.ventures/research/data/necessity-index/" target="_top">
      <header class="embed__head">
        <span class="embed__reg" aria-hidden="true"></span>
        <span class="embed__brand">hmm Ventures · Necessity Index</span>
        <span class="embed__version">{data.version}</span>
        <time class="embed__date" datetime={data.as_of}>{asOfLabel}</time>
      </header>

      <div class="embed__grid">
        <IndexCard label="Companies classified" value={data.universe.total_companies} accent />
        <IndexCard label="Four-market subset" value={data.universe.four_market_companies} />
        <IndexCard label="In-thesis (T1 / T2)" value={data.tier_shares.conservative_classifier_count} accent />
        <IndexCard label="T1 / T2 share" value={data.tier_shares.conservative_classifier_pct} unit="%" />
        <IndexCard label="Regulations mapped (4-market)" value={data.universe.regulations_four_market} />
        <IndexCard label="In-flight 2024 to 2030" value={data.crystallisation_window.in_flight_2024_2030} accent />
      </div>

      <footer class="embed__foot">
        Open full Index → hmm.ventures/necessity-index/
      </footer>
    </a>
  </body>
</html>

<style is:global>
  html, body { margin: 0; padding: 0; }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  body.embed {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    font-family: var(--f-body);
    padding: var(--s-5);
    box-sizing: border-box;
    min-height: 100vh;
  }
  .embed__link {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    text-decoration: none;
    color: inherit;
    height: 100%;
  }
  .embed__head {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding-block-end: var(--s-3);
    border-bottom: 1px solid color-mix(in srgb, var(--c-pearl) 18%, transparent);
  }
  .embed__reg { width: 8px; height: 8px; background: var(--c-tomato); }
  .embed__brand { color: var(--c-pearl); font-weight: 600; }
  .embed__version { color: var(--c-tomato); }
  .embed__date { margin-inline-start: auto; color: color-mix(in srgb, var(--c-pearl) 60%, transparent); }

  .embed__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-2);
    flex: 1;
  }
  @media (max-width: 720px) { .embed__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 420px) { .embed__grid { grid-template-columns: 1fr; } }

  .embed__foot {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-tomato);
    padding-block-start: var(--s-3);
    border-top: 1px solid color-mix(in srgb, var(--c-pearl) 18%, transparent);
  }
</style>
