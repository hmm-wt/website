---
import Base from '../../layouts/Base.astro';
import ChartFrame from '../../components/ChartFrame.astro';
import SparkBar from '../../components/charts/SparkBar.astro';
import UnitDotGrid from '../../components/charts/UnitDotGrid.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import CTARail from '../../components/CTARail.astro';
import necessityData from '../../data/necessity-index.json';
import crystallisation from '../../data/crystallisation-window.json';
import exitsData from '../../data/exits-named.json';

export async function getStaticPaths() {
  return [
    { params: { slug: 'heal' } },
    { params: { slug: 'power' } },
    { params: { slug: 'move' } },
    { params: { slug: 'supply' } },
    { params: { slug: 'eat' } },
  ];
}

interface NecessityConfig {
  slug: string;
  name: string;
  shortName: string;
  necessityKey: string;
  claim: string;
  why: string;
  examples: string;
  exitFilter: string;
}

const configs: Record<string, NecessityConfig> = {
  heal: {
    slug: 'heal',
    name: 'Biomedical Systems',
    shortName: 'Heal',
    necessityKey: 'Biomedical Systems',
    claim: 'Clinical software, diagnostics, digital therapeutics, AI-assisted decision support.',
    why: 'A diagnostic tool cannot reach a patient until the regulator says it can. A new therapy cannot earn reimbursement without evidence on file. Health systems do not buy software without TGA, PMDA, MHLW, or HSA on the label.',
    examples: 'Tier 1: device licensing, clinical software clearance, digital health frameworks. Tier 2: clinical safety reporting, AI risk management for medical devices.',
    exitFilter: 'Biomedical',
  },
  power: {
    slug: 'power',
    name: 'Power Systems',
    shortName: 'Power',
    necessityKey: 'Power Systems',
    claim: 'Grid orchestration, storage, demand response, EV charging, distributed energy.',
    why: 'A new generator cannot connect to the grid without licensing. A storage system cannot earn capacity payments without compliance proof. Carbon-priced utilities cannot procure without traceable inputs.',
    examples: 'Tier 1: grid connection licensing, renewable targets, building energy codes. Tier 2: carbon pricing, embodied carbon disclosure.',
    exitFilter: 'Power',
  },
  move: {
    slug: 'move',
    name: 'Autonomous Systems',
    shortName: 'Move',
    necessityKey: 'Autonomous Systems',
    claim: 'Road, logistics, public-path, maritime, aviation, dual-use autonomy.',
    why: 'A self-driving stack cannot operate on a public road without a deployment licence. A drone cannot fly commercial routes without remote ID. A logistics vessel cannot enter port without classification approval.',
    examples: 'Tier 1: AV deployment frameworks, remote ID for UAS, autonomous vessel classification. Tier 2: transport data sharing, fleet safety reporting.',
    exitFilter: 'Autonomous',
  },
  supply: {
    slug: 'supply',
    name: 'Critical Materials and Supply Integrity',
    shortName: 'Supply',
    necessityKey: 'Critical Materials and Supply Integrity',
    claim: 'Provenance, chain of custody, processing history, ESG evidence.',
    why: 'A buyer in a regulated market cannot import unverified materials. A construction payment cannot release without compliance documentation. Customs cannot clear shipments without digital declarations.',
    examples: 'Tier 1: critical minerals traceability, digital customs automation. Tier 2: construction payment compliance, modern slavery due diligence.',
    exitFilter: 'Critical Materials',
  },
  eat: {
    slug: 'eat',
    name: 'Food Security Systems',
    shortName: 'Eat',
    necessityKey: 'Food Security Systems',
    claim: 'Traceability, biosecurity, recall-readiness, import and export assurance.',
    why: 'A food producer cannot sell into a regulated market without traceability records. An importer cannot clear customs without provenance evidence. A processor cannot launch a recall without machine-readable inventory.',
    examples: 'Tier 1: food labelling laws, AI traceability extensions, food security regulations. Tier 2: small-business compliance phase-ins.',
    exitFilter: 'Food',
  },
};

const { slug } = Astro.params;
const cfg = configs[slug as string];
if (!cfg) throw new Error(`Unknown necessity slug: ${slug}`);

const stats = (necessityData.per_necessity as any[]).find((n) => n.name === cfg.necessityKey);
const inThesis = stats?.in_thesis_companies ?? 0;
const t1Count = stats?.regulations_t1 ?? 0;
const t2Count = stats?.regulations_t2 ?? 0;

const years = [2024, 2025, 2026, 2027, 2028, 2029, 2030];
const regsByYear: Record<number, number> = {};
years.forEach((y) => { regsByYear[y] = 0; });

const relevantRegs = (crystallisation.regulations as any[]).filter((r) => r.necessity === cfg.necessityKey);
relevantRegs.forEach((r) => {
  if (years.includes(r.effective_year)) regsByYear[r.effective_year] += 1;
});

const yearValues = years.map((y) => regsByYear[y]);
const yearLabels = years.map((y) => String(y).slice(-2));
let heroIndex = -1;
let heroMax = 0;
yearValues.forEach((v, i) => { if (v > heroMax) { heroMax = v; heroIndex = i; } });

const totalInFlight = yearValues.reduce((a, b) => a + b, 0);

const matchingExits = (exitsData.exits as any[]).filter((e) => e.necessity === cfg.exitFilter);

const cohortMarks = (() => {
  const total = Math.min(inThesis, 1200);
  const heroCount = matchingExits.length || 1;
  const marks = Array.from({ length: total }, (_, i) => ({ id: String(i), hero: false }));
  const stride = total / heroCount;
  for (let i = 0; i < heroCount; i++) {
    const idx = Math.floor(i * stride);
    if (marks[idx]) marks[idx].hero = true;
  }
  return marks;
})();

const regRows = relevantRegs.slice(0, 6).map((r) => [
  r.market,
  r.title,
  r.tier,
  String(r.effective_year),
]);
---
<Base
  title={`${cfg.shortName}. ${cfg.name}`}
  description={cfg.claim}
>
  <header class="nec-hero">
    <div class="container">
      <p class="kicker nec-hero__kicker">{cfg.shortName}</p>
      <h1 class="nec-hero__title">{cfg.name}</h1>
      <p class="nec-hero__sub">{cfg.claim}</p>
    </div>
  </header>

  <section class="container nec-stages">
    <article class="nec-stage" aria-labelledby="need-h">
      <p class="nec-stage__kicker">Stage 1. The need</p>
      <h2 id="need-h" class="nec-stage__h">{cfg.shortName}.</h2>
      <p class="nec-stage__body">{cfg.why}</p>
      <p class="nec-stage__body">{cfg.examples}</p>
    </article>

    <article class="nec-stage" aria-labelledby="reg-h">
      <p class="nec-stage__kicker">Stage 2. The filter</p>
      <h2 id="reg-h" class="nec-stage__h">
        <span class="nec-stage__bignum">{t1Count + t2Count}</span> regulations.
        <span class="nec-stage__subnum">{t1Count} T1. {t2Count} T2.</span>
      </h2>
      <p class="nec-stage__body">
        {totalInFlight > 0
          ? `${totalInFlight} effective dates land between 2024 and 2030.`
          : 'No in-flight regulations on the current calendar.'}
        Each one identifies the companies that have to comply.
      </p>
      {totalInFlight > 0 && (
        <ChartFrame
          caption="In-flight regulations by effective year. Hero bar is the peak."
        >
          <SparkBar values={yearValues} labels={yearLabels} heroIndex={heroIndex} height={120} ariaLabel={`${cfg.name} regulations by year`} />
        </ChartFrame>
      )}
      {regRows.length > 0 && (
        <ComparisonTable
          headers={['Market', 'Regulation', 'Tier', 'Effective']}
          rows={regRows}
          note="Source. hmm Ventures comprehensive regulatory dataset."
        />
      )}
    </article>

    <article class="nec-stage" aria-labelledby="coh-h">
      <p class="nec-stage__kicker">Stage 3. The cohort</p>
      <h2 id="coh-h" class="nec-stage__h">
        <span class="nec-stage__bignum">{inThesis.toLocaleString()}</span> in-thesis companies.
      </h2>
      <p class="nec-stage__body">
        Each mark below is one company in the four-market dataset. Hero marks are the named exits already on the dataset.
      </p>
      <ChartFrame
        caption={`${inThesis.toLocaleString()} ${cfg.name} companies. Hero marks: named regulated-company acquisitions.`}
      >
        <UnitDotGrid marks={cohortMarks} cols={50} markSize={6} gap={2} shape="squares" ariaLabel={`${cfg.name} in-thesis cohort with named exits`} />
      </ChartFrame>

      {matchingExits.length > 0 && (
        <div class="nec-exits">
          <h3 class="nec-exits__h">Named exits in this Necessity</h3>
          <ul class="nec-exits__list">
            {matchingExits.map((e) => (
              <li class="nec-exits__item">
                <span class="nec-exits__name">{e.company}</span>
                <span class="nec-exits__meta">
                  {e.market}. {e.tier}. {e.year}. Acquirer: {e.acquirer}. {e.value_display}.
                </span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </article>
  </section>

  <CTARail />
</Base>

<style>
  .nec-hero {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding-block: var(--s-8) var(--s-6);
  }
  .nec-hero__kicker { color: var(--c-tomato); margin: 0; }
  .nec-hero__title {
    font-family: var(--f-display);
    font-size: clamp(2.5rem, 1.5rem + 4.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: var(--s-3) 0 var(--s-4);
    font-weight: 400;
    max-width: 18ch;
  }
  .nec-hero__sub {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: color-mix(in srgb, var(--c-pearl) 84%, transparent);
    max-width: 56ch;
    margin: 0;
  }

  .nec-stages {
    padding-block: var(--s-7) var(--s-8);
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }
  .nec-stage {
    border-top: var(--hair) solid var(--hair-color);
    padding-block-start: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    max-width: 64rem;
  }
  .nec-stage__kicker {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-tomato);
    margin: 0;
  }
  .nec-stage__h {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: 0;
    color: var(--fg);
    letter-spacing: -0.01em;
    max-width: 22ch;
  }
  .nec-stage__bignum {
    color: var(--hero);
  }
  .nec-stage__subnum {
    display: block;
    margin-block-start: var(--s-2);
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    color: var(--fg-soft);
  }
  .nec-stage__body {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--fg-soft);
    margin: 0;
    max-width: 56ch;
  }

  .nec-exits {
    margin-block-start: var(--s-5);
    border-top: var(--hair) solid var(--hair-color);
    padding-block-start: var(--s-5);
  }
  .nec-exits__h {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-faint);
    margin: 0 0 var(--s-4);
    font-weight: 500;
  }
  .nec-exits__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .nec-exits__item {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding-block-end: var(--s-3);
    border-bottom: var(--hair) solid var(--hair-color);
  }
  .nec-exits__item:last-child { border-bottom: 0; }
  .nec-exits__name {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    color: var(--hero);
    line-height: 1.1;
  }
  .nec-exits__meta {
    font-family: var(--f-body);
    font-size: var(--fs-sm);
    color: var(--fg-soft);
    line-height: 1.5;
  }
</style>
