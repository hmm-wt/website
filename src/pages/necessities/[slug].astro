---
import RecordLayout from '../../layouts/RecordLayout.astro';
import Plate from '../../components/record/Plate.astro';
import MarketFlower from '../../components/record/MarketFlower.astro';
import Bars from '../../components/record/Bars.astro';
import UnitField from '../../components/record/UnitField.astro';
import NecessityMark from '../../components/NecessityMark.astro';
import NecessityNav from '../../components/NecessityNav.astro';
import necessityData from '../../data/necessity-index.json';
import crystallisation from '../../data/crystallisation-window.json';
import exitsData from '../../data/exits-named.json';

// Canonical order: eat / heal / move / power / supply (IM line 42, LP deck).
export async function getStaticPaths() {
  return [
    { params: { slug: 'eat' } },
    { params: { slug: 'heal' } },
    { params: { slug: 'move' } },
    { params: { slug: 'power' } },
    { params: { slug: 'supply' } },
  ];
}

interface NecessityConfig {
  slug: string;
  name: string;
  shortName: string;
  necessityKey: string;
  markKind: 'food' | 'biomedical' | 'power' | 'autonomous' | 'materials';
  claim: string;
  why: string;
  examples: string;
  exitFilter: string;
  monitoring?: string;
}

const configs: Record<string, NecessityConfig> = {
  eat: {
    slug: 'eat', name: 'Food Security Systems', shortName: 'Eat',
    necessityKey: 'Food Security Systems', markKind: 'food',
    claim: 'Traceability, biosecurity, recall-readiness, import and export assurance. Cannot launch without machine-readable proof.',
    why: 'Food safety is moving from periodic inspection to continuous, traceable proof. A contaminated batch reaches shelves. The recall takes weeks instead of hours. People get sick from food that should have been traced and pulled before it left the warehouse.',
    examples: 'Tier 1: food labelling laws, AI traceability extension (Japan), food security regulations. Tier 2: small-business compliance phase-ins.',
    exitFilter: 'Food',
    monitoring: 'Monitored for biosecurity, food-export assurance, and recall-readiness obligations.',
  },
  heal: {
    slug: 'heal', name: 'Biomedical Systems', shortName: 'Heal',
    necessityKey: 'Biomedical Systems', markKind: 'biomedical',
    claim: 'Clinical software, diagnostics, AI-assisted decisions. Cannot ship without regulator clearance.',
    why: 'Ageing populations and clinical-labour shortages are pushing more care into clinical software, diagnostics, and AI-assisted decision tools. A scan is misread. A treatable condition is caught late. An AI tool is deployed in a clinic without evidence that it works, and a patient pays the price.',
    examples: 'Tier 1: device licensing, clinical software clearance, digital health frameworks. Tier 2: clinical safety reporting, AI risk management for medical devices.',
    exitFilter: 'Biomedical',
  },
  move: {
    slug: 'move', name: 'Autonomous Systems', shortName: 'Move',
    necessityKey: 'Autonomous Systems', markKind: 'autonomous',
    claim: 'Road, logistics, public-path, maritime, aviation. Cannot operate without licence.',
    why: 'Autonomous systems enter public space only when their safety, supervision, and incident evidence can be accepted by regulators. A driverless shuttle runs without safety certification. A freight drone operates in shared airspace without transponder evidence. The first serious incident grounds the entire sector for years.',
    examples: 'Tier 1: AV deployment frameworks, remote ID for UAS, autonomous vessel classification. Tier 2: transport data sharing, fleet safety reporting.',
    exitFilter: 'Autonomous',
  },
  power: {
    slug: 'power', name: 'Power Systems', shortName: 'Power',
    necessityKey: 'Power Systems', markKind: 'power',
    claim: 'Grid orchestration, storage, EV charging, distributed energy. Cannot connect without compliance proof.',
    why: 'Storage, EVs, buildings, and distributed assets are becoming active grid participants, not passive loads. A heatwave hits. Rooftop solar floods the grid with no coordination. Batteries sit idle because nobody filed the dispatch paperwork. The blackout was avoidable.',
    examples: 'Tier 1: grid connection licensing, renewable targets, building energy codes. Tier 2: carbon pricing, embodied carbon disclosure.',
    exitFilter: 'Power',
  },
  supply: {
    slug: 'supply', name: 'Critical Materials and Supply Integrity', shortName: 'Supply',
    necessityKey: 'Critical Materials and Supply Integrity', markKind: 'materials',
    claim: 'Provenance, chain of custody, processing history, ESG evidence. Cannot sell without traceability.',
    why: 'Strategic buyers now require proof of origin, processing, ESG status, and eligibility before they buy. An EV manufacturer loses its tax credit because it cannot prove where the cobalt came from. An OEM is shut out of a procurement framework because its supplier chain fails the country-of-origin attestation.',
    examples: 'Tier 1: critical minerals traceability, digital customs automation. Tier 2: construction payment compliance, modern slavery due diligence.',
    exitFilter: 'Critical Materials',
    monitoring: 'Monitored for customs automation, trade documentation, modern-slavery, and supply-chain assurance obligations.',
  },
};

const order = ['eat', 'heal', 'move', 'power', 'supply'];
const { slug } = Astro.params;
const cfg = configs[slug as string];
if (!cfg) throw new Error(`Unknown necessity slug: ${slug}`);

const oi = order.indexOf(slug as string);
const exA = 3 + oi * 2;                       // continuous folio: home ex-1, index ex-2
const channel: Record<string, string> = {
  eat: 'var(--nec-eat)', heal: 'var(--nec-heal)', move: 'var(--nec-move)',
  power: 'var(--nec-power)', supply: 'var(--nec-supply)',
};
const ch = channel[slug as string];

const nextSlug = order[(oi + 1) % 5];
const nextCfg = configs[nextSlug];
const nextNum = String((oi + 1) % 5 + 1).padStart(2, '0');

const stats = (necessityData.per_necessity as any[]).find((n) => n.name === cfg.necessityKey);
const inThesis = stats?.in_thesis_companies ?? 0;
const t1Count = stats?.regulations_t1 ?? 0;
const t2Count = stats?.regulations_t2 ?? 0;

const years = [2024, 2025, 2026, 2027, 2028, 2029, 2030];
const regsByYear: Record<number, number> = {};
years.forEach((y) => { regsByYear[y] = 0; });
const relevantRegs = (crystallisation.regulations as any[]).filter((r) => r.necessity === cfg.necessityKey);
relevantRegs.forEach((r) => { if (years.includes(r.effective_year)) regsByYear[r.effective_year] += 1; });
const yearValues = years.map((y) => regsByYear[y]);
let heroIndex = -1; let heroMax = 0;
yearValues.forEach((v, i) => { if (v > heroMax) { heroMax = v; heroIndex = i; } });
const totalInFlight = yearValues.reduce((a, b) => a + b, 0);
const peakYear = heroIndex >= 0 ? years[heroIndex] : null;

const matchingExits = (exitsData.exits as any[]).filter((e) => e.necessity === cfg.exitFilter);

const cohortTotal = Math.min(inThesis, 1100);
const cohortMarks = Array.from({ length: cohortTotal }, (_, i) => ({ id: i, hero: false }));
if (matchingExits.length > 0) {
  const stride = cohortTotal / matchingExits.length;
  for (let i = 0; i < matchingExits.length; i++) {
    const idx = Math.floor(i * stride);
    if (cohortMarks[idx]) cohortMarks[idx].hero = true;
  }
}

const STATUS_LABEL: Record<string, string> = {
  in_force: 'In force', enacted: 'Enacted', in_parliament: 'Before parliament', expected: 'Expected',
};
const statusPhrase = (r: any): string => `${STATUS_LABEL[r.status] ?? 'Expected'} ${r.effective_year}`;
const regRows = relevantRegs.slice(0, 4).map((r) => ({
  market: r.market, title: r.title, tier: r.tier, status: statusPhrase(r),
}));

const orderedMarkets = ['AU', 'JP', 'NZ', 'SG'] as const;
const marketLongName: Record<string, string> = { AU: 'Australia', JP: 'Japan', NZ: 'New Zealand', SG: 'Singapore' };
const acrossFourMarkets = orderedMarkets.map((mk) => {
  const exit = matchingExits.find((e) => e.market === mk);
  if (exit) {
    const tierLong = exit.tier === 'T1' ? 'Tier 1' : exit.tier === 'T2' ? 'Tier 2' : exit.tier;
    const counterparty = String(exit.acquirer).replace(/\.$/, '');
    const relation = exit.type === 'ipo' ? `Listed on ${counterparty}` : exit.type === 'late_stage' ? counterparty : `Acquired by ${counterparty}`;
    return { market: mk, kind: 'exit' as const, tag: exit.type === 'ipo' ? 'Public listing' : exit.type === 'late_stage' ? 'Late-stage round' : 'Named acquisition', headline: exit.company, meta: `${tierLong}. ${relation}. ${exit.year}.`, active: true };
  }
  const reg = relevantRegs.filter((r: any) => r.market === mk).sort((a: any, b: any) => a.effective_year - b.effective_year)[0];
  if (reg) {
    const tierLong = reg.tier === 'T1' ? 'Tier 1' : reg.tier === 'T2' ? 'Tier 2' : reg.tier;
    return { market: mk, kind: 'regulation' as const, tag: 'In-flight regulation', headline: reg.title, meta: `${tierLong}. ${statusPhrase(reg)}.`, active: true };
  }
  return { market: mk, kind: 'watching' as const, tag: 'Monitoring', headline: 'Watchlist market', meta: cfg.monitoring ?? 'No dated regulatory trigger in the current dataset.', active: false };
});

---
<RecordLayout
  title={`${cfg.shortName}. ${cfg.name}`}
  description={cfg.claim}
  section="necessities"
  tone="light"
  folio={`ex-${exA} / 38`}
  locator={`01 · The five Necessities <span style="color:var(--fg-faint)">&rarr;</span> <span class="here">${cfg.shortName}</span>`}
  next={{ href: `/necessities/${nextSlug}/`, label: `${nextNum} ${nextCfg.shortName}` }}
>
  <header class="rec-masthead">
    <div class="nd-mark" style={`color:${ch}`} aria-hidden="true">
      <NecessityMark kind={cfg.markKind} size={38} />
    </div>
    <p class="rec-masthead__eyebrow" style={`color:${ch}`}>0{oi + 1} / 05 · {cfg.shortName}</p>
    <h1 class="rec-masthead__title">{cfg.name}</h1>
    <p class="rec-masthead__claim">{cfg.claim}</p>
  </header>

  <NecessityNav current={slug} />

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The need</span><span class="rec-beat__count">01 / 04</span></div>
    <p class="rec-beat__prose">{cfg.why}</p>
    <p class="rec-beat__note">{cfg.examples}</p>
  </section>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The filter</span><span class="rec-beat__count">02 / 04</span></div>
    <h2 class="rec-beat__arg"><em>{t1Count + t2Count}</em> regulations mapped. {t1Count} T1, {t2Count} T2.</h2>
    {totalInFlight > 0 ? (
      <Plate
        ex={`EX-${exA}`}
        label="Crystallisation window"
        sub="In-flight regulations by expected effective year. None yet in force."
        source="hmm Ventures regulatory dataset."
        basis={`${totalInFlight} dated obligations, 2024 to 2030.`}
      >
        <div class="nd-window">
          <div class="nd-window__chips">
            <span class="rec-chip rec-chip--plate"><span class="rec-chip__dot now-pulse"></span>None in force</span>
            {peakYear && <span class="rec-chip rec-chip--plate rec-chip--peak">Peak · {peakYear}</span>}
          </div>
          <Bars
            items={years.map((y, i) => ({ label: String(y), value: yearValues[i], hero: i === heroIndex }))}
            height={150}
          />
          {regRows.length > 0 && (
            <table class="nd-table">
              <thead><tr><th>Market</th><th>Regulation</th><th>Tier</th><th>Status</th></tr></thead>
              <tbody>
                {regRows.map((r) => (
                  <tr>
                    <td>{r.market}</td><td>{r.title}</td>
                    <td class="nd-table__tier">{r.tier}</td><td class="nd-table__status">{r.status}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
      </Plate>
    ) : (
      <p class="rec-beat__note">No expected effective dates on the current calendar between 2024 and 2030.</p>
    )}
  </section>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The cohort</span><span class="rec-beat__count">03 / 04</span></div>
    <h2 class="rec-beat__arg"><em>{inThesis.toLocaleString('en-GB')}</em> companies mapped to the {cfg.name} Necessities.</h2>
    <Plate
      ex={`EX-${exA + 1}`}
      label="Necessities-aligned cohort"
      sub={matchingExits.length > 0
        ? `${inThesis.toLocaleString('en-GB')} companies. Highlighted marks are named outcomes in regulated companies.`
        : `${inThesis.toLocaleString('en-GB')} companies in the four-market dataset.`}
      source="hmm Ventures four-market classified dataset."
    >
      <UnitField
        total={inThesis}
        heroIndices={cohortMarks.map((m, i) => (m.hero ? i : -1)).filter((i) => i >= 0)}
      />
    </Plate>
  </section>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The four markets</span><span class="rec-beat__count">04 / 04</span></div>
    <ol class="nd-four" role="list">
      {acrossFourMarkets.map((cell) => (
        <li class={`nd-four__cell ${cell.active ? '' : 'nd-four__cell--watch'}`}>
          <div class="nd-four__flower" style={cell.active ? 'color:var(--c-tomato)' : 'color:var(--fg-faint)'} aria-hidden="true">
            <MarketFlower market={cell.market} size={30} />
          </div>
          <span class="nd-four__market">{marketLongName[cell.market]}</span>
          <span class={`rec-chip ${cell.active && cell.kind === 'exit' ? 'rec-chip--live' : ''} nd-four__chip`}>{cell.tag}</span>
          <h3 class="nd-four__headline">{cell.headline}</h3>
          <p class="nd-four__meta">{cell.meta}</p>
        </li>
      ))}
    </ol>
  </section>
</RecordLayout>

<style>
  .nd-mark { display: inline-flex; }

  /* Plate-surface chips (mahogany ink). */
  .rec-chip--plate { border-color: rgba(4, 47, 42, 0.2); color: rgba(37, 0, 1, 0.62); }
  .rec-chip--peak { border-color: var(--c-tomato); color: var(--c-tomato); }
  .nd-window__chips { display: flex; gap: var(--s-2); flex-wrap: wrap; margin-bottom: var(--s-3); }
  .now-pulse { animation: nd-pulse 1.8s ease-in-out infinite; }
  @keyframes nd-pulse { 0%, 100% { opacity: 0.4; } 50% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .now-pulse { animation: none; } }


  .nd-table { width: 100%; border-collapse: collapse; margin-top: var(--s-3); font-family: var(--f-mono); }
  .nd-table th {
    text-align: left; font-size: var(--fs-xs); font-weight: 400; text-transform: uppercase;
    letter-spacing: 0.1em; color: rgba(37, 0, 1, 0.42); padding: 0 var(--s-3) var(--s-2) 0;
  }
  .nd-table td {
    font-size: var(--fs-sm); color: rgba(37, 0, 1, 0.74); padding: var(--s-2) var(--s-3) var(--s-2) 0;
    border-top: 1px solid rgba(4, 47, 42, 0.14);
  }
  .nd-table__tier { color: var(--c-tomato); }
  .nd-table__status { text-align: right; white-space: nowrap; }


  .nd-four {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 0;
    border-top: 1px solid var(--rule); border-left: 1px solid var(--rule);
  }
  .nd-four__cell {
    border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
    padding: var(--s-4); display: flex; flex-direction: column; gap: var(--s-2); min-height: 13rem;
  }
  .nd-four__cell--watch { opacity: 0.6; }
  .nd-four__flower { margin-bottom: var(--s-2); }
  .nd-four__market { font-family: var(--f-mono); font-size: var(--fs-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--fg); }
  .nd-four__chip { align-self: flex-start; }
  .nd-four__headline { font-family: var(--f-display); font-size: var(--fs-lg); line-height: 1.1; margin: var(--s-1) 0 0; color: var(--fg); }
  .nd-four__cell:not(.nd-four__cell--watch) .nd-four__headline { color: var(--fg); }
  .nd-four__meta { font-family: var(--f-mono); font-size: var(--fs-xs); line-height: 1.5; color: var(--fg-soft); margin: 0; }

  @media (max-width: 720px) {
    .nd-four { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .nd-four { grid-template-columns: 1fr; }
  }
</style>
