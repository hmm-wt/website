---
import Base from '../../layouts/Base.astro';
import ChartFrame from '../../components/ChartFrame.astro';
import SparkBar from '../../components/charts/SparkBar.astro';
import UnitDotGrid from '../../components/charts/UnitDotGrid.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import CTARail from '../../components/CTARail.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import NecessityMark from '../../components/NecessityMark.astro';
import necessityData from '../../data/necessity-index.json';
import crystallisation from '../../data/crystallisation-window.json';
import exitsData from '../../data/exits-named.json';

export async function getStaticPaths() {
  return [
    { params: { slug: 'heal' } },
    { params: { slug: 'power' } },
    { params: { slug: 'move' } },
    { params: { slug: 'supply' } },
    { params: { slug: 'eat' } },
  ];
}

interface NecessityConfig {
  slug: string;
  name: string;
  shortName: string;
  necessityKey: string;
  markKind: 'food' | 'biomedical' | 'power' | 'autonomous' | 'materials';
  claim: string;
  why: string;
  examples: string;
  exitFilter: string;
}

const configs: Record<string, NecessityConfig> = {
  heal: {
    slug: 'heal',
    name: 'Biomedical Systems',
    shortName: 'Heal',
    necessityKey: 'Biomedical Systems',
    markKind: 'biomedical',
    claim: 'Clinical software, diagnostics, AI-assisted decisions. Cannot ship without regulator clearance.',
    why: 'Ageing populations, clinical-labour constraints, and software-mediated care make regulated clinical infrastructure non-discretionary. A scan is misread. A treatable condition is caught late. An AI tool is deployed in a clinic without evidence that it works, and a patient pays the price.',
    examples: 'Tier 1: device licensing, clinical software clearance, digital health frameworks. Tier 2: clinical safety reporting, AI risk management for medical devices.',
    exitFilter: 'Biomedical',
  },
  power: {
    slug: 'power',
    name: 'Power Systems',
    shortName: 'Power',
    necessityKey: 'Power Systems',
    markKind: 'power',
    claim: 'Grid orchestration, storage, EV charging, distributed energy. Cannot connect without compliance proof.',
    why: 'Storage, EVs, buildings, and distributed assets become grid participants, not passive loads. A heatwave hits. Rooftop solar floods the grid with no coordination. Batteries sit idle because nobody filed the dispatch paperwork. The blackout was avoidable.',
    examples: 'Tier 1: grid connection licensing, renewable targets, building energy codes. Tier 2: carbon pricing, embodied carbon disclosure.',
    exitFilter: 'Power',
  },
  move: {
    slug: 'move',
    name: 'Autonomous Systems',
    shortName: 'Move',
    necessityKey: 'Autonomous Systems',
    markKind: 'autonomous',
    claim: 'Road, logistics, public-path, maritime, aviation. Cannot operate without licence.',
    why: 'Autonomy enters public space only when safety, supervision, incident evidence, and operating-domain proof can be accepted by regulators. A driverless shuttle runs without safety certification. A freight drone operates in shared airspace without transponder evidence. The first serious incident grounds the entire sector for years.',
    examples: 'Tier 1: AV deployment frameworks, remote ID for UAS, autonomous vessel classification. Tier 2: transport data sharing, fleet safety reporting.',
    exitFilter: 'Autonomous',
  },
  supply: {
    slug: 'supply',
    name: 'Critical Materials and Supply Integrity',
    shortName: 'Supply',
    necessityKey: 'Critical Materials and Supply Integrity',
    markKind: 'materials',
    claim: 'Provenance, chain of custody, processing history, ESG evidence. Cannot sell without traceability.',
    why: 'Strategic buyers increasingly require verified origin, processing, ESG status, and eligibility proof before procurement. An EV manufacturer loses its tax credit because it cannot prove where the cobalt came from. An OEM is shut out of a procurement framework because its supplier chain fails the country-of-origin attestation.',
    examples: 'Tier 1: critical minerals traceability, digital customs automation. Tier 2: construction payment compliance, modern slavery due diligence.',
    exitFilter: 'Critical Materials',
  },
  eat: {
    slug: 'eat',
    name: 'Food Security Systems',
    shortName: 'Eat',
    necessityKey: 'Food Security Systems',
    markKind: 'food',
    claim: 'Traceability, biosecurity, recall-readiness, import and export assurance. Cannot launch without machine-readable proof.',
    why: 'Food safety depends on repeatable proof, not occasional inspection. A contaminated batch reaches shelves. The recall takes weeks instead of hours. People get sick from food that should have been traced and pulled before it left the warehouse.',
    examples: 'Tier 1: food labelling laws, AI traceability extensions, food security regulations. Tier 2: small-business compliance phase-ins.',
    exitFilter: 'Food',
  },
};

const { slug } = Astro.params;
const cfg = configs[slug as string];
if (!cfg) throw new Error(`Unknown necessity slug: ${slug}`);

const stats = (necessityData.per_necessity as any[]).find((n) => n.name === cfg.necessityKey);
const inThesis = stats?.in_thesis_companies ?? 0;
const t1Count = stats?.regulations_t1 ?? 0;
const t2Count = stats?.regulations_t2 ?? 0;

const years = [2024, 2025, 2026, 2027, 2028, 2029, 2030];
const regsByYear: Record<number, number> = {};
years.forEach((y) => { regsByYear[y] = 0; });

const relevantRegs = (crystallisation.regulations as any[]).filter((r) => r.necessity === cfg.necessityKey);
relevantRegs.forEach((r) => {
  if (years.includes(r.effective_year)) regsByYear[r.effective_year] += 1;
});

const yearValues = years.map((y) => regsByYear[y]);
const yearLabels = years.map((y) => String(y));
let heroIndex = -1;
let heroMax = 0;
yearValues.forEach((v, i) => { if (v > heroMax) { heroMax = v; heroIndex = i; } });

const totalInFlight = yearValues.reduce((a, b) => a + b, 0);

const matchingExits = (exitsData.exits as any[]).filter((e) => e.necessity === cfg.exitFilter);

const cohortMarks = (() => {
  const total = Math.min(inThesis, 1200);
  const heroCount = Math.max(matchingExits.length, 1);
  const marks = Array.from({ length: total }, (_, i) => ({ id: String(i), hero: false }));
  const stride = total / heroCount;
  for (let i = 0; i < heroCount; i++) {
    const idx = Math.floor(i * stride);
    if (marks[idx]) marks[idx].hero = true;
  }
  return marks;
})();

const regRows = relevantRegs.slice(0, 6).map((r) => [
  r.market,
  r.title,
  r.tier,
  String(r.effective_year),
]);

// Fix 6: Across the four markets four-cell grid.
// For each market, find one named exit (if any), else one representative regulation.
const orderedMarkets = ['AU', 'JP', 'NZ', 'SG'] as const;
const marketLongName: Record<string, string> = {
  AU: 'Australia',
  JP: 'Japan',
  NZ: 'New Zealand',
  SG: 'Singapore',
};

const acrossFourMarkets = orderedMarkets.map((mk) => {
  const exit = matchingExits.find((e) => e.market === mk);
  if (exit) {
    return {
      market: mk,
      kind: 'exit' as const,
      headline: exit.company,
      meta: `${exit.tier}. Acquired by ${exit.acquirer}. ${exit.year}.`,
      sub: exit.value_display,
      barrier: exit.barrier,
    };
  }
  const reg = relevantRegs
    .filter((r: any) => r.market === mk)
    .sort((a: any, b: any) => a.effective_year - b.effective_year)[0];
  if (reg) {
    return {
      market: mk,
      kind: 'regulation' as const,
      headline: reg.title,
      meta: `${reg.tier}. Effective ${reg.effective_year}.`,
      sub: 'Regulator: in flight.',
      barrier: null,
    };
  }
  return {
    market: mk,
    kind: 'watching' as const,
    headline: 'Watching',
    meta: 'No named exit or in-flight regulation in this Necessity.',
    sub: '',
    barrier: null,
  };
});
---
<Base
  title={`${cfg.shortName}. ${cfg.name}`}
  description={cfg.claim}
>
  <header class="nec-hero">
    <div class="container">
      <Breadcrumb
        crumbs={[
          { label: 'hmm', href: '/' },
          { label: 'Necessities', href: '/necessities/' },
          { label: cfg.shortName },
        ]}
      />
      <div class="nec-hero__head">
        <div class="nec-hero__mark" aria-hidden="true">
          <NecessityMark kind={cfg.markKind} size={72} />
        </div>
        <div class="nec-hero__text">
          <p class="kicker nec-hero__kicker">{cfg.shortName}</p>
          <h1 class="nec-hero__title">{cfg.name}</h1>
          <p class="nec-hero__sub">{cfg.claim}</p>
        </div>
      </div>
    </div>
  </header>

  <section class="container nec-stages">
    <article class="nec-stage" aria-labelledby="need-h">
      <p class="nec-stage__kicker">Stage 1. The need</p>
      <h2 id="need-h" class="nec-stage__h">{cfg.shortName}.</h2>
      <p class="nec-stage__body">{cfg.why}</p>
      <p class="nec-stage__body nec-stage__body--soft">{cfg.examples}</p>
    </article>

    <article class="nec-stage" aria-labelledby="reg-h">
      <p class="nec-stage__kicker">Stage 2. The filter</p>
      <h2 id="reg-h" class="nec-stage__h">
        <span class="nec-stage__bignum">{t1Count + t2Count}</span> regulations.
        <span class="nec-stage__subnum">{t1Count} T1. {t2Count} T2.</span>
      </h2>
      <p class="nec-stage__body">
        {totalInFlight > 0
          ? `${totalInFlight} effective dates land between 2024 and 2030.`
          : 'No in-flight regulations on the current calendar.'}
        Each one identifies the companies that have to comply.
      </p>
      {totalInFlight > 0 && (
        <ChartFrame
          kicker="Effective dates"
          title="When the filter takes effect."
          caption="In-flight regulations across the four markets, by effective year. Hero bar marks the peak."
          source="Source. hmm Ventures comprehensive regulatory dataset."
        >
          <SparkBar
            values={yearValues}
            labels={yearLabels}
            heroIndex={heroIndex}
            weight="full"
            height={220}
            width={720}
            ariaLabel={`${cfg.name} regulations by year`}
          />
        </ChartFrame>
      )}
      {regRows.length > 0 && (
        <ComparisonTable
          headers={['Market', 'Regulation', 'Tier', 'Effective']}
          rows={regRows}
          note="Source. hmm Ventures comprehensive regulatory dataset."
        />
      )}
    </article>

    <article class="nec-stage" aria-labelledby="coh-h">
      <p class="nec-stage__kicker">Stage 3. The cohort</p>
      <h2 id="coh-h" class="nec-stage__h">
        <span class="nec-stage__bignum">{inThesis.toLocaleString()}</span> in-thesis companies.
      </h2>
      <p class="nec-stage__body">
        Each mark is one company in the four-market dataset. Hero marks are the named exits already on the dataset.
      </p>
      <ChartFrame
        caption={`${inThesis.toLocaleString()} ${cfg.name} companies. Hero marks: named regulated-company acquisitions.`}
      >
        <UnitDotGrid
          marks={cohortMarks}
          cols={50}
          markSize={6}
          gap={2}
          shape="squares"
          ariaLabel={`${cfg.name} in-thesis cohort with named exits`}
        />
      </ChartFrame>

      <section class="nec-four" aria-labelledby="four-h">
        <header class="nec-four__head">
          <p class="kicker nec-four__kicker">Across the four markets</p>
          <h3 id="four-h" class="nec-four__h">Australia. Japan. New Zealand. Singapore.</h3>
        </header>
        <ol class="nec-four__list" role="list">
          {acrossFourMarkets.map((cell) => (
            <li class={`nec-four__cell nec-four__cell--${cell.kind}`}>
              <span class="nec-four__market">{marketLongName[cell.market]}</span>
              <span class="nec-four__tag">
                {cell.kind === 'exit' && 'Named exit'}
                {cell.kind === 'regulation' && 'In-flight regulation'}
                {cell.kind === 'watching' && 'Watching'}
              </span>
              <h4 class="nec-four__headline">{cell.headline}</h4>
              <p class="nec-four__meta">{cell.meta}</p>
              {cell.sub && <p class="nec-four__sub">{cell.sub}</p>}
              {cell.barrier && <p class="nec-four__barrier">{cell.barrier}</p>}
            </li>
          ))}
        </ol>
      </section>
    </article>
  </section>

  <CTARail />
</Base>

<style>
  .nec-hero {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding-block: var(--s-6) var(--s-6);
  }
  .nec-hero__head {
    display: flex;
    gap: var(--s-6);
    align-items: flex-start;
    margin-block-start: var(--s-4);
  }
  .nec-hero__mark {
    color: var(--c-tomato);
    flex-shrink: 0;
    padding-block-start: var(--s-2);
  }
  .nec-hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .nec-hero__kicker { color: var(--c-tomato); margin: 0; }
  .nec-hero__title {
    font-family: var(--f-display);
    font-size: clamp(2.5rem, 1.5rem + 4.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
    font-weight: 400;
    max-width: 18ch;
  }
  .nec-hero__sub {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: color-mix(in srgb, var(--c-pearl) 84%, transparent);
    max-width: 56ch;
    margin: 0;
  }
  @media (max-width: 640px) {
    .nec-hero__head { flex-direction: column; gap: var(--s-4); }
  }

  .nec-stages {
    padding-block: var(--s-7) var(--s-8);
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }
  .nec-stage {
    border-top: var(--hair) solid var(--hair-color);
    padding-block-start: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    max-width: 64rem;
  }
  .nec-stage__kicker {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-tomato);
    margin: 0;
  }
  .nec-stage__h {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: 0;
    color: var(--fg);
    letter-spacing: -0.01em;
    max-width: 22ch;
  }
  .nec-stage__bignum { color: var(--hero); }
  .nec-stage__subnum {
    display: block;
    margin-block-start: var(--s-2);
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    color: var(--fg-soft);
  }
  .nec-stage__body {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--fg-soft);
    margin: 0;
    max-width: 60ch;
  }
  .nec-stage__body--soft { color: var(--fg-faint); font-size: var(--fs-md); }

  /* Across the four markets */
  .nec-four {
    margin-block-start: var(--s-6);
    border-top: var(--hair) solid var(--hair-color);
    padding-block-start: var(--s-5);
  }
  .nec-four__head { margin-block-end: var(--s-4); }
  .nec-four__kicker { color: var(--c-tomato); margin: 0; }
  .nec-four__h {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-tight);
    margin: var(--s-2) 0 0;
    color: var(--fg);
  }
  .nec-four__list {
    list-style: none;
    margin: var(--s-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: var(--hair) solid var(--hair-color);
    border-bottom: var(--hair) solid var(--hair-color);
  }
  .nec-four__cell {
    border-left: var(--hair) solid var(--hair-color);
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    min-height: 14rem;
  }
  .nec-four__cell:first-child { border-left: 0; }
  .nec-four__cell--watching { opacity: 0.55; }
  .nec-four__market {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg);
  }
  .nec-four__tag {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--hero);
  }
  .nec-four__cell--regulation .nec-four__tag { color: var(--fg-faint); }
  .nec-four__cell--watching .nec-four__tag { color: var(--fg-faint); }
  .nec-four__headline {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: var(--lh-tight);
    margin: 0;
    color: var(--fg);
  }
  .nec-four__cell--exit .nec-four__headline { color: var(--hero); }
  .nec-four__meta {
    font-family: var(--f-body);
    font-size: var(--fs-sm);
    color: var(--fg-soft);
    line-height: 1.45;
    margin: 0;
  }
  .nec-four__sub {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg);
    margin: 0;
  }
  .nec-four__barrier {
    font-family: var(--f-body);
    font-size: var(--fs-xs);
    color: var(--fg-faint);
    margin-block-start: auto;
    line-height: 1.4;
  }

  @media (max-width: 960px) {
    .nec-four__list { grid-template-columns: repeat(2, 1fr); }
    .nec-four__cell:nth-child(2n+1) { border-left: 0; }
    .nec-four__cell { border-top: var(--hair) solid var(--hair-color); }
    .nec-four__cell:nth-child(-n+2) { border-top: 0; }
  }
  @media (max-width: 540px) {
    .nec-four__list { grid-template-columns: 1fr; }
    .nec-four__cell { border-left: 0; border-top: var(--hair) solid var(--hair-color); }
    .nec-four__cell:first-child { border-top: 0; }
  }
</style>
