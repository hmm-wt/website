---
import RecordLayout from '../../layouts/RecordLayout.astro';
import NecessityMark from '../../components/NecessityMark.astro';
import necessityData from '../../data/necessity-index.json';

interface Necessity {
  slug: string;
  name: string;
  shortName: string;
  necessityKey: string;
  markKind: 'food' | 'biomedical' | 'power' | 'autonomous' | 'materials';
  oneLine: string;
}

// Canonical order: eat / heal / move / power / supply (IM line 42, LP deck data.py).
const necessities: Necessity[] = [
  { slug: 'eat', name: 'Food Security Systems', shortName: 'Eat', necessityKey: 'Food Security Systems', markKind: 'food', oneLine: 'Traceability, biosecurity, recall-readiness, import and export assurance.' },
  { slug: 'heal', name: 'Biomedical Systems', shortName: 'Heal', necessityKey: 'Biomedical Systems', markKind: 'biomedical', oneLine: 'Clinical software, diagnostics, AI-assisted decisions.' },
  { slug: 'move', name: 'Autonomous Systems', shortName: 'Move', necessityKey: 'Autonomous Systems', markKind: 'autonomous', oneLine: 'Road, logistics, public-path, maritime, aviation.' },
  { slug: 'power', name: 'Power Systems', shortName: 'Power', necessityKey: 'Power Systems', markKind: 'power', oneLine: 'Grid orchestration, storage, EV charging, distributed energy.' },
  { slug: 'supply', name: 'Critical Materials and Supply Integrity', shortName: 'Supply', necessityKey: 'Critical Materials and Supply Integrity', markKind: 'materials', oneLine: 'Provenance, chain of custody, processing history, ESG evidence.' },
];

const channel: Record<string, string> = {
  eat: 'var(--nec-eat)', heal: 'var(--nec-heal)', move: 'var(--nec-move)',
  power: 'var(--nec-power)', supply: 'var(--nec-supply)',
};

const statsByKey: Record<string, { inThesis: number; regs: number }> = {};
(necessityData.per_necessity as any[]).forEach((n) => {
  statsByKey[n.name] = { inThesis: n.in_thesis_companies, regs: (n.regulations_t1 ?? 0) + (n.regulations_t2 ?? 0) };
});
---
<RecordLayout
  title="The five Necessities"
  description="Five non-discretionary needs gated by regulation across the four target markets."
  section="necessities"
  tone="light"  folio="ex-2 / 38"
  locator='01 · <span class="here">The five Necessities</span>'
  next={{ href: '/exits/', label: '02 The exits' }}
>
  <header class="rec-masthead">
    <p class="rec-masthead__eyebrow" style="color:var(--c-tomato)">01 · The five Necessities</p>
    <h1 class="rec-masthead__title">The systems society cannot allow to fail.</h1>
    <p class="rec-masthead__claim">
      Each Necessity is gated by regulation. Each gate identifies the companies that have to comply.
    </p>
  </header>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The five</span><span class="rec-beat__count">01 / 01</span></div>
    <ol class="ni" role="list">
      {necessities.map((n, i) => {
        const s = statsByKey[n.necessityKey] ?? { inThesis: 0, regs: 0 };
        return (
          <li class="ni__row">
            <a class="ni__link" href={`/necessities/${n.slug}/`} aria-label={`Open ${n.name}`}>
              <span class="ni__num">0{i + 1}</span>
              <span class="ni__mark" style={`color:${channel[n.slug]}`} aria-hidden="true">
                <NecessityMark kind={n.markKind} size={34} />
              </span>
              <span class="ni__text">
                <span class="ni__short" style={`color:${channel[n.slug]}`}>{n.shortName}</span>
                <span class="ni__name">{n.name}</span>
                <span class="ni__line">{n.oneLine}</span>
              </span>
              <span class="ni__stats">
                <span class="ni__stat-n">{s.inThesis.toLocaleString('en-GB')}</span>
                <span class="ni__stat-l">in Necessities</span>
                <span class="ni__stat-sub">{s.regs} regulations mapped</span>
              </span>
              <span class="ni__go" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        );
      })}
    </ol>
  </section>
</RecordLayout>

<style>
  .ni { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .ni__link {
    display: grid;
    grid-template-columns: 2rem 3rem 1fr auto 1.5rem;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-5) var(--s-2);
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    transition: background var(--mo-tick) var(--ease-golden);
  }
  .ni__link:hover { background: rgba(4, 47, 42, 0.04); }
  .ni__num { font-family: var(--f-mono); font-size: var(--fs-xs); letter-spacing: 0.1em; color: var(--fg-faint); }
  .ni__mark { display: inline-flex; }
  .ni__text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .ni__short { font-family: var(--f-mono); font-size: var(--fs-xs); letter-spacing: 0.14em; text-transform: uppercase; }
  .ni__name { font-family: var(--f-display); font-size: var(--fs-xl); line-height: 1.05; color: var(--fg); }
  .ni__line { font-family: var(--f-mono); font-size: var(--fs-xs); line-height: 1.5; color: var(--fg-soft); }
  .ni__stats { display: flex; flex-direction: column; text-align: right; gap: 2px; }
  .ni__stat-n { font-family: var(--f-display); font-size: var(--fs-2xl); line-height: 1; color: var(--fg); }
  .ni__stat-l { font-family: var(--f-mono); font-size: 0.5625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg-faint); }
  .ni__stat-sub { font-family: var(--f-mono); font-size: 0.5625rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--fg-faint); margin-top: 2px; }
  .ni__go { font-family: var(--f-mono); color: var(--fg-faint); text-align: right; transition: color var(--mo-tick) var(--ease-golden); }
  .ni__link:hover .ni__go { color: var(--c-tomato); }
  .ni__link:hover .ni__name { color: var(--fg); }

  @media (max-width: 640px) {
    .ni__link { grid-template-columns: 1.5rem 2.5rem 1fr; gap: var(--s-3); }
    .ni__stats { grid-column: 2 / 4; text-align: left; flex-direction: row; align-items: baseline; gap: var(--s-2); margin-top: var(--s-2); }
    .ni__go { display: none; }
  }
</style>
