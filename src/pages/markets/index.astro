---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import JurisdictionMark from '../../components/JurisdictionMark.astro';
import CrystallisationTimeline from '../../components/charts/CrystallisationTimeline.astro';
import { buildContactMailto } from '../../utils/mailto.ts';

const markets = (await getCollection('markets')).sort(
  (a, b) => (a.data.chapter ?? 0) - (b.data.chapter ?? 0)
);

const slugByMarket: Record<string, string> = {
  AU: 'australia',
  JP: 'japan',
  NZ: 'new-zealand',
  SG: 'singapore'
};

const summary: Record<string, {
  name: string;
  allocation: string;
  necessities: string;
  regulators: string;
  capitalShape: string;
  signature: string;
}> = {
  AU: {
    name: 'Australia',
    allocation: '35%',
    necessities: 'Critical materials, Power, Biomedical, Food security',
    regulators: 'APRA, ASIC, AEMO, TGA, FIRB, ASX',
    capitalShape: 'A$4.3T superannuation pool turning toward unlisted growth. R&D Tax Incentive 43.5% refundable offset under A$20M turnover.',
    signature: 'The deepest signal cohort. Where regulation, R&D capital, and super allocation intersect at scale.'
  },
  JP: {
    name: 'Japan',
    allocation: '30%',
    necessities: 'Biomedical, Autonomous, Power, Food security',
    regulators: 'PMDA, MLIT, METI, FSA, TSE',
    capitalShape: 'CVC dominance. Ten named CVC partners active at Series A. TSE reform redirecting balance sheets to equity.',
    signature: 'The strongest financing access for T1. CVC matches operator-led regulated companies on terms unavailable elsewhere.'
  },
  NZ: {
    name: 'New Zealand',
    allocation: '20%',
    necessities: 'Biomedical, Food security, Power',
    regulators: 'Medsafe WAND, Callaghan Innovation, Electricity Authority, MPI',
    capitalShape: 'Small market, regulator-as-partner pathway. Medsafe WAND accelerates SaMD approval; Callaghan co-invests in R&D.',
    signature: 'High-conviction T1. Volpara → Lunit at $193M USD in 2024 is the exit pattern.'
  },
  SG: {
    name: 'Singapore',
    allocation: '15%',
    necessities: 'Biomedical, Autonomous, Power, Food security',
    regulators: 'HSA, MAS, EMA, IMDA, LTA, SFA',
    capitalShape: 'Regulatory arbitrage gateway for APAC. MAS sandbox, EDBI, Enterprise SG. 30x30 food security mandate by 2030.',
    signature: 'The APAC regulatory innovation gateway. Where frontier mandates ship first.'
  }
};

const orderedMarkets: ('AU' | 'JP' | 'NZ' | 'SG')[] = ['AU', 'JP', 'NZ', 'SG'];
const mailto = buildContactMailto('Markets · talk through the allocation');
---
<Base
  title="Markets"
  description="Four markets in developed APAC. Allocation, regulators, exit patterns. Australia, Japan, New Zealand, Singapore."
>
  <section class="mk container">
    <header class="mk__head">
      <h1 class="mk__title gavel-drop">Four markets. One window.</h1>
      <p class="mk__lede">
        Developed APAC at emerging-market entry prices. Each market is built around a different necessity, enforced by a different regulator, exited through a different acquirer set.
      </p>
    </header>

    <section class="mk__overview" aria-label="Crystallisation window across the four markets">
      <CrystallisationTimeline />
    </section>

    <section class="mk__compare" aria-label="Four-market comparison">
      <table class="mk__table">
        <thead>
          <tr>
            <th scope="col"></th>
            {orderedMarkets.map((m) => (
              <th scope="col">
                <a href={`#${slugByMarket[m]}`} class="mk__table-head">
                  <JurisdictionMark market={m} size={28} />
                  <span>{summary[m].name}</span>
                </a>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Allocation</th>
            {orderedMarkets.map((m) => <td class="mk__td--num">{summary[m].allocation}</td>)}
          </tr>
          <tr>
            <th scope="row">Necessities</th>
            {orderedMarkets.map((m) => <td>{summary[m].necessities}</td>)}
          </tr>
          <tr>
            <th scope="row">Regulators</th>
            {orderedMarkets.map((m) => <td>{summary[m].regulators}</td>)}
          </tr>
          <tr>
            <th scope="row">Capital shape</th>
            {orderedMarkets.map((m) => <td>{summary[m].capitalShape}</td>)}
          </tr>
          <tr>
            <th scope="row">The signature</th>
            {orderedMarkets.map((m) => <td class="mk__td--signature">{summary[m].signature}</td>)}
          </tr>
        </tbody>
      </table>
    </section>

    <section class="mk__per-market">
      {orderedMarkets.map((m) => (
        <article id={slugByMarket[m]} class="mk__market">
          <header class="mk__market-head">
            <span class="mk__market-mark"><JurisdictionMark market={m} size={48} /></span>
            <div>
              <p class="mk__market-allocation">{summary[m].allocation} allocation</p>
              <h2 class="mk__market-name">{summary[m].name}</h2>
              <p class="mk__market-signature">{summary[m].signature}</p>
            </div>
          </header>
          <p class="mk__market-detail">{summary[m].capitalShape}</p>
          <p class="mk__market-deep">
            <a href={`/thesis/${slugByMarket[m]}/`}>The full chapter →</a>
          </p>
        </article>
      ))}
    </section>

    <footer class="mk__foot">
      <a class="mk__cta" href={mailto}>Talk through the allocation →</a>
    </footer>
  </section>
</Base>

<style>
  .mk { padding-block: var(--s-8) var(--s-9); max-width: 72rem; }
  .mk__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-end: var(--s-7);
    padding-block-end: var(--s-5);
    border-bottom: 1px solid var(--rule);
  }
  .mk__title {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    margin: 0;
  }
  .mk__lede {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: var(--fg-soft);
    max-width: 56ch;
    margin: 0;
  }

  .mk__overview {
    margin-block: var(--s-7);
    padding-block: var(--s-5);
    border-block: 1px solid var(--rule);
  }
  .mk__compare {
    margin-block: var(--s-7);
    overflow-x: auto;
  }
  .mk__table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--f-body);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }
  .mk__table th, .mk__table td {
    padding: var(--s-4) var(--s-3);
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
    text-align: left;
  }
  .mk__table thead th {
    border-bottom: 2px solid var(--c-tomato);
    padding-block: var(--s-3);
  }
  .mk__table tbody th {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-tomato);
    width: 9rem;
    border-right: 1px solid var(--rule);
    background: color-mix(in srgb, var(--c-tomato) 4%, transparent);
  }
  .mk__table-head {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    text-decoration: none;
    color: var(--fg);
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    transition: color var(--mo-tick) var(--ease-golden);
  }
  .mk__table-head:hover { color: var(--c-tomato); }
  .mk__td--num {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    color: var(--c-tomato);
  }
  .mk__td--signature {
    font-family: var(--f-display);
    font-size: var(--fs-base);
    color: var(--fg);
  }

  .mk__per-market {
    display: flex;
    flex-direction: column;
    gap: var(--s-7);
    margin-block-start: var(--s-7);
  }
  .mk__market {
    padding-block: var(--s-6);
    border-top: 1px solid var(--rule);
    scroll-margin-top: var(--s-7);
  }
  .mk__market-head {
    display: flex;
    gap: var(--s-4);
    align-items: flex-start;
    margin-block-end: var(--s-4);
  }
  .mk__market-mark { color: var(--c-tomato); flex-shrink: 0; }
  .mk__market-allocation {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-tomato);
    margin: 0;
  }
  .mk__market-name {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: var(--s-1) 0;
  }
  .mk__market-signature {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--fg-soft);
    margin: 0;
    max-width: 56ch;
  }
  .mk__market-detail {
    font-size: var(--fs-base);
    line-height: 1.6;
    margin: 0;
    max-width: 64ch;
  }
  .mk__market-deep {
    margin-block-start: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .mk__market-deep a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }

  .mk__foot {
    margin-block-start: var(--s-8);
    padding-block-start: var(--s-5);
    border-top: 1px solid var(--rule);
  }
  .mk__cta {
    display: inline-block;
    padding: var(--s-3) var(--s-5);
    background: var(--c-tomato);
    color: var(--c-pearl);
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    transition: background var(--dur-1) var(--ease);
  }
  .mk__cta:hover { background: var(--c-mahogany); }

  @media (max-width: 820px) {
    .mk__table thead th { font-size: var(--fs-sm); }
    .mk__td--num { font-size: var(--fs-xl); }
  }
</style>
