---
import Base from '../../layouts/Base.astro';
import CorridorGrid from '../../components/CorridorGrid.astro';
import ChartFrame from '../../components/ChartFrame.astro';
import CrystallisationStrip from '../../components/charts/CrystallisationStrip.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import CTARail from '../../components/CTARail.astro';
import necessityData from '../../data/necessity-index.json';

const allocationMap: Record<string, string> = {
  AU: '35%',
  JP: '30%',
  NZ: '20%',
  SG: '15%',
};

const signatureMap: Record<string, string> = {
  AU: 'Deepest signal cohort. Regulation, R&D capital, and super allocation intersect at scale.',
  JP: 'Strongest financing access for T1. CVCs match operator-led regulated companies on terms unavailable elsewhere.',
  NZ: 'High-conviction T1. Volpara to Lunit at $193M in 2024 is the exit pattern.',
  SG: 'APAC regulatory innovation gateway. Frontier mandates ship first.',
};

const regulatorMap: Record<string, string> = {
  AU: 'APRA, ASIC, AEMO, TGA, FIRB, ASX',
  JP: 'PMDA, MLIT, METI, FSA, TSE',
  NZ: 'Medsafe WAND, Callaghan Innovation, Electricity Authority, MPI',
  SG: 'HSA, MAS, EMA, IMDA, LTA, SFA',
};

const necessityMap: Record<string, string> = {
  AU: 'Critical materials, Power, Biomedical, Food security',
  JP: 'Biomedical, Autonomous, Power, Food security',
  NZ: 'Biomedical, Food security, Power',
  SG: 'Biomedical, Autonomous, Power, Food security',
};

const orderedMarkets = ['AU', 'JP', 'NZ', 'SG'] as const;

const comparisonRows = [
  ['Allocation', ...orderedMarkets.map((m) => allocationMap[m])],
  ['Necessities', ...orderedMarkets.map((m) => necessityMap[m])],
  ['Regulators', ...orderedMarkets.map((m) => regulatorMap[m])],
  ['The signature', ...orderedMarkets.map((m) => signatureMap[m])],
];

const per = necessityData.per_market as any[];
const totals = {
  companies: per.reduce((acc, m) => acc + m.companies, 0),
  regulations: per.reduce((acc, m) => acc + m.regulations, 0),
  t1: per.reduce((acc, m) => acc + m.t1, 0),
  t2: per.reduce((acc, m) => acc + m.t2, 0),
};
---
<Base
  title="Markets"
  description="Four markets in developed APAC. Australia, Japan, New Zealand, Singapore. Allocation, regulators, exit patterns."
>
  <header class="mk-hero">
    <div class="container">
      <p class="kicker mk-hero__kicker">The four markets</p>
      <h1 class="mk-hero__title">Four markets. One window.</h1>
      <p class="mk-hero__sub">
        Developed APAC at emerging-market entry prices. Each market is built around a different Necessity, enforced by a different regulator, exited through a different acquirer set.
      </p>
    </div>
  </header>

  <section class="mk-totals container" aria-label="Four-market totals">
    <ol class="mk-totals__list">
      <li class="mk-totals__cell">
        <span class="mk-totals__n">{totals.companies.toLocaleString()}</span>
        <span class="mk-totals__l">Classified companies</span>
      </li>
      <li class="mk-totals__cell">
        <span class="mk-totals__n">{totals.regulations}</span>
        <span class="mk-totals__l">Regulations</span>
      </li>
      <li class="mk-totals__cell">
        <span class="mk-totals__n">{totals.t1}</span>
        <span class="mk-totals__l">Tier 1 licences</span>
      </li>
      <li class="mk-totals__cell">
        <span class="mk-totals__n">{totals.t2}</span>
        <span class="mk-totals__l">Tier 2 compulsions</span>
      </li>
    </ol>
  </section>

  <CorridorGrid />

  <section class="container mk-window">
    <ChartFrame
      kicker="The window"
      title="One crystallisation window across all four markets."
      caption="In-flight regulations by effective year, summed across the four target markets. Peak crystallisation 2027."
      source="Source. hmm Ventures comprehensive regulatory dataset."
    >
      <CrystallisationStrip />
    </ChartFrame>
  </section>

  <section class="container mk-compare">
    <header class="mk-compare__head">
      <p class="kicker">The comparison</p>
      <h2 class="mk-compare__title">What each market is for.</h2>
    </header>
    <ComparisonTable
      headers={['', 'Australia', 'Japan', 'New Zealand', 'Singapore']}
      rows={comparisonRows}
    />
  </section>

  <CTARail />
</Base>

<style>
  .mk-hero {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding-block: var(--s-8) var(--s-6);
  }
  .mk-hero__kicker { color: var(--c-tomato); margin: 0; }
  .mk-hero__title {
    font-family: var(--f-display);
    font-size: clamp(2.5rem, 1.5rem + 4.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: var(--s-3) 0 var(--s-4);
    font-weight: 400;
  }
  .mk-hero__sub {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: color-mix(in srgb, var(--c-pearl) 84%, transparent);
    max-width: 60ch;
    margin: 0;
  }

  .mk-totals {
    padding-block: var(--s-7);
  }
  .mk-totals__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: var(--hair) solid var(--hair-color);
    border-bottom: var(--hair) solid var(--hair-color);
  }
  .mk-totals__cell {
    padding: var(--s-5) var(--s-4);
    border-left: var(--hair) solid var(--hair-color);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .mk-totals__cell:first-child { border-left: 0; }
  .mk-totals__n {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: 1;
    color: var(--fg);
    letter-spacing: -0.02em;
  }
  .mk-totals__l {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-soft);
  }
  @media (max-width: 700px) {
    .mk-totals__list { grid-template-columns: 1fr 1fr; }
    .mk-totals__cell { border-top: var(--hair) solid var(--hair-color); }
    .mk-totals__cell:nth-child(2n+1) { border-left: 0; }
    .mk-totals__cell:nth-child(-n+2) { border-top: 0; }
  }

  .mk-window { padding-block: var(--s-7); }
  .mk-compare { padding-block: var(--s-7) var(--s-8); }
  .mk-compare__head { max-width: 56ch; }
  .mk-compare__head .kicker { color: var(--c-tomato); margin: 0; }
  .mk-compare__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: var(--s-3) 0 var(--s-5);
    letter-spacing: -0.01em;
  }
</style>
