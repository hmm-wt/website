---
import Base from '../../layouts/Base.astro';
import CorridorGrid from '../../components/CorridorGrid.astro';
import ChartFrame from '../../components/ChartFrame.astro';
import CrystallisationStrip from '../../components/charts/CrystallisationStrip.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import CTARail from '../../components/CTARail.astro';
import necessityData from '../../data/necessity-index.json';

// IM-canonical per-market framing. Each row is parallel across markets;
// each cell is one short line, IM-derived (chapters 4-7).
const roleMap: Record<string, string> = {
  AU: 'Capital depth',
  JP: 'Corporate procurement',
  NZ: 'Lower-cost validation',
  SG: 'Regulatory bridge',
};

const claimMap: Record<string, string> = {
  AU: 'A$4.3T superannuation pool turning toward unlisted growth through 2025-2026 reform.',
  JP: 'G7-leading corporate cash position. Procurement deployed through CVC channels.',
  NZ: 'Same regulatory asset as Sydney or San Francisco. Smaller capital to build it.',
  SG: 'One MAS or HSA licence reduces the regulatory cost of entering ASEAN, Greater China, India, and Western markets.',
};

const capitalMap: Record<string, string> = {
  AU: 'A$4.3T superannuation pool. 43.5% R&D Tax Incentive offset.',
  JP: 'AI Promotion Act in force June 2025. CVC-led procurement channels.',
  NZ: 'Callaghan to MBIE grant ecosystem. 15% R&D credit. Lower entry valuations.',
  SG: 'MAS sandbox. ASEAN passporting. Sector-specific sandboxes 2024-2025.',
};

const regulatorMap: Record<string, string> = {
  AU: 'APRA · ASIC · AEMO · TGA · FIRB · ASX',
  JP: 'PMDA · MLIT · METI · FSA · TSE',
  NZ: 'Medsafe WAND · MBIE · Electricity Authority · MPI',
  SG: 'MAS · HSA · IMDA · LTA · SFA · EMA',
};

const proofMap: Record<string, string> = {
  AU: 'Eucalyptus to Hims & Hers, 2026. Up to $1.15B. Tier 1 biomedical.',
  JP: 'PMDA AI Medical Device Fast-Track. Effective 2027. Tier 1.',
  NZ: 'Volpara to Lunit, 2024. $193M. Tier 1 biomedical.',
  SG: 'MAS AI Risk Management, all sectors. Effective 2028. Tier 1.',
};

const orderedMarkets = ['AU', 'JP', 'NZ', 'SG'] as const;

const comparisonRows = [
  ['Role', ...orderedMarkets.map((m) => roleMap[m])],
  ['The claim', ...orderedMarkets.map((m) => claimMap[m])],
  ['Capital mechanism', ...orderedMarkets.map((m) => capitalMap[m])],
  ['Regulators', ...orderedMarkets.map((m) => regulatorMap[m])],
  ['Lead indicator', ...orderedMarkets.map((m) => proofMap[m])],
];

---
<Base
  title="Markets"
  description="Four markets in developed APAC. Australia, Japan, New Zealand, Singapore. Allocation, regulators, exit patterns."
>
  <header class="mk-hero">
    <div class="container">
      <p class="kicker mk-hero__kicker">The four markets</p>
      <h1 class="mk-hero__title">Four markets. One window.</h1>
      <p class="mk-hero__sub">
        Developed APAC at entry prices. Each market plays a different role.
      </p>
    </div>
  </header>

  <CorridorGrid />

  <section class="container mk-window">
    <ChartFrame
      kicker="The window"
      title="One crystallisation window across all four markets."
      caption="In-flight regulations by effective year, summed across the four target markets. Peak crystallisation 2027."
      source="Source: hmm Ventures regulatory dataset."
    >
      <CrystallisationStrip />
    </ChartFrame>
  </section>

  <section class="container mk-compare">
    <header class="mk-compare__head">
      <p class="kicker">The comparison</p>
      <h2 class="mk-compare__title">What each market is for.</h2>
    </header>
    <ComparisonTable
      headers={['', 'Australia', 'Japan', 'New Zealand', 'Singapore']}
      rows={comparisonRows}
    />
    <p class="mk-compare__foot kicker">
      <a href="/references/exits/">Recent named exits across the four markets &rarr;</a>
    </p>
  </section>

  <CTARail />
</Base>

<style>
  .mk-hero {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding-block: var(--s-8) var(--s-6);
  }
  .mk-hero__kicker { color: var(--c-tomato); margin: 0; }
  .mk-hero__title {
    font-family: var(--f-display);
    font-size: clamp(2.5rem, 1.5rem + 4.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: var(--s-3) 0 var(--s-4);
    font-weight: 400;
  }
  .mk-hero__sub {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: color-mix(in srgb, var(--c-pearl) 84%, transparent);
    max-width: 60ch;
    margin: 0;
  }

  .mk-window { padding-block: var(--s-7); }
  .mk-compare { padding-block: var(--s-7) var(--s-8); }
  .mk-compare__head { max-width: 56ch; }
  .mk-compare__head .kicker { color: var(--c-tomato); margin: 0; }
  .mk-compare__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: var(--s-3) 0 var(--s-5);
    letter-spacing: -0.01em;
  }
  .mk-compare__foot {
    margin-block-start: var(--s-5);
    color: var(--fg-soft);
  }
  .mk-compare__foot a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .mk-compare__foot a:hover { color: var(--fg); border-bottom-color: var(--fg); }
</style>
