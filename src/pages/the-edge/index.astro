---
import RecordLayout from '../../layouts/RecordLayout.astro';
import Plate from '../../components/record/Plate.astro';
import Bars from '../../components/record/Bars.astro';
import necessityData from '../../data/necessity-index.json';

const p = necessityData.premiums;
const u = necessityData.universe;

// Round-size uplift by stage. The regulated cohort relative to unregulated.
const stages = [
  { label: 'Seed', v: p.round_size_seed },
  { label: 'Series A', v: p.round_size_series_a },
  { label: 'Series C', v: p.round_size_series_c },
  { label: 'Series D+', v: p.round_size_series_d_plus },
];
const maxV = Math.max(...stages.map((s) => s.v));
---
<RecordLayout
  title="The edge"
  description="Regulated companies in the four-market dataset survive to exit at 2.22x the unregulated rate, and the funding gap widens with stage. The empirical edge behind the thesis."
  section="exits"
  tone="light"
  folio="ex-14 / 38"
  locator='02 · The exits <span style="color:var(--fg-faint)">&rarr;</span> <span class="here">The edge</span>'
  next={{ href: '/exits/', label: '02 The exits' }}
>
  <header class="rec-masthead">
    <p class="rec-masthead__eyebrow">The edge</p>
    <h1 class="rec-masthead__title">Regulated companies reach exit {p.exit_rate_multiple.toFixed(2)}x as often.</h1>
    <p class="rec-masthead__claim">
      Across {u.four_market_companies.toLocaleString('en-GB')} four-market companies, the cohort behind a
      licence or compliance barrier survives to exit at <strong>{p.regulated_exit_rate_pct}%</strong> against
      <strong>{p.unregulated_exit_rate_pct}%</strong> for the rest. The gap is observed, not assumed.
    </p>
  </header>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The exit incidence</span><span class="rec-beat__count">01 / 03</span></div>
    <h2 class="rec-beat__arg">The same barrier that screens before entry <em>defends after it</em>.</h2>
    <p class="rec-beat__prose">
      A regulator has either created a licence a company cannot operate without, or compelled its customers to
      buy what the company sells. Either barrier is hard to replicate, so the company that clears it first tends
      to keep the position. In the four-market dataset that shows up as a higher rate of reaching exit.
    </p>
    <div class="edge-hero">
      <div class="edge-hero__num">{p.exit_rate_multiple.toFixed(2)}x</div>
      <div class="edge-hero__body">
        <p class="edge-hero__lab">Observed exit incidence, regulated vs unregulated cohort</p>
        <p class="edge-hero__detail">{p.regulated_exit_rate_pct}% reach exit, against {p.unregulated_exit_rate_pct}% unregulated · {u.four_market_companies.toLocaleString('en-GB')}-company four-market dataset</p>
      </div>
    </div>
  </section>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The round-size pattern</span><span class="rec-beat__count">02 / 03</span></div>
    <h2 class="rec-beat__arg">Near parity at seed. The premium <em>appears later</em>.</h2>
    <p class="rec-beat__prose">
      Entry is close to the unregulated price. The regulated round-size premium widens as the company moves up
      the stages, so the advantage is paid for at seed and collected later.
    </p>
    <Plate
      ex="EX-14"
      label="Round-size uplift by stage"
      sub="Regulated cohort relative to the unregulated cohort. The gap opens by Series C."
      source="hmm Ventures four-market dataset."
      basis={`Cumulative funding multiple ${p.cumulative_pre_seed}x at pre-seed widening to ${p.cumulative_series_d_plus}x by Series D+.`}
    >
      <Bars
        items={stages.map((s) => ({ label: s.label, value: s.v, display: `${s.v.toFixed(2)}x`, hero: s.v === maxV }))}
        height={160}
      />
    </Plate>
  </section>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">Read it in full</span><span class="rec-beat__count">03 / 03</span></div>
    <ul class="edge-links" role="list">
      <li class="edge-link">
        <a href="/exits/">
          <span class="edge-link__k">The exits</span>
          <span class="edge-link__t">The named deals behind the rate.</span>
          <span class="edge-link__go">Open &rarr;</span>
        </a>
      </li>
      <li class="edge-link">
        <a href="/data/necessity-index/">
          <span class="edge-link__k">The data</span>
          <span class="edge-link__t">The universe the cohort is drawn from.</span>
          <span class="edge-link__go">Open &rarr;</span>
        </a>
      </li>
      <li class="edge-link">
        <a href="/research/">
          <span class="edge-link__k">The method</span>
          <span class="edge-link__t">How the cohort is classified and tested.</span>
          <span class="edge-link__go">Open &rarr;</span>
        </a>
      </li>
    </ul>
  </section>
</RecordLayout>

<style>
  .edge-hero {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-5);
    align-items: center;
    margin-top: var(--s-5);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
  }
  .edge-hero__num {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: 1;
    color: var(--c-tomato);
  }
  .edge-hero__lab {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--fg-soft);
    margin: 0;
  }
  .edge-hero__detail {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    color: var(--fg-faint);
    margin: var(--s-1) 0 0;
  }

  .edge-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  .edge-link { border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .edge-link a {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-5);
    height: 100%;
    text-decoration: none;
    transition: background var(--mo-hold) var(--ease-golden);
  }
  .edge-link a:hover { background: color-mix(in srgb, var(--c-tomato) 8%, transparent); }
  .edge-link__k {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--c-tomato);
  }
  .edge-link__t {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    line-height: 1.12;
    color: var(--rec-ink);
  }
  .edge-link__go {
    margin-top: auto;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--fg-faint);
  }
  .edge-link a:hover .edge-link__go { color: var(--c-tomato); }

  @media (max-width: 720px) {
    .edge-links { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .edge-hero { grid-template-columns: 1fr; gap: var(--s-3); }
  }
</style>
