---
import Base from '../../layouts/Base.astro';
import KickerLabel from '../../components/KickerLabel.astro';
---
<Base
  title="Press"
  description="Press kit. Bio, headshot, brand pack, factsheet, recent media. Direct contact for interviews."
>
  <section class="pr container">
    <header class="pr__head">
      <KickerLabel index="00" label="For media" accent />
      <h1 class="pr__title">Press kit.</h1>
      <p class="pr__lede">
        Bio, headshot, brand assets, factsheet. Direct contact for interviews and panels.
      </p>
    </header>

    <article class="pr__block">
      <p class="kicker pr__kicker">GP bio (short)</p>
      <p class="pr__p">
        Wahid Tashkandi is the Managing Partner of hmm Ventures, a DIFC-based seed fund investing in regulated-sector technology across Australia, Japan, New Zealand, and Singapore. The thesis: necessity is the thesis. Regulation creates the demand curve; the fund deploys at the seed stage where the curve is forming.
      </p>
      <p class="kicker pr__kicker">GP bio (long)</p>
      <p class="pr__p">
        Wahid Tashkandi is the Managing Partner of hmm Ventures (DIFC). Hmm Fund I is a four-year investment-period seed fund deploying USD 250K–1.5M cheques into regulated-sector software in developed APAC. Wahid is a former operator and angel investor; the fund's thesis is built from a 22,217-company classified universe and a 174-regulation four-market dataset. Speaks to APAC regulatory divergence, the T1 / T2 framework for regulated-sector investing, and the empirical case for the fund's premium-wedge thesis.
      </p>
    </article>

    <article class="pr__block">
      <p class="kicker pr__kicker">Assets</p>
      <ul class="pr__assets" role="list">
        <li><a href="/hmm-logo.svg" download>Brand mark (SVG)</a> — vector, currentColor compatible</li>
        <li><a href="/favicon.svg" download>Favicon</a> — square, single colour</li>
        <li><a href="mailto:wt@hmm.ventures?subject=Press%20kit%20request">Headshot + factsheet</a> — sent on request, same-day</li>
      </ul>
    </article>

    <article class="pr__block">
      <p class="kicker pr__kicker">Live data products</p>
      <ul class="pr__assets" role="list">
        <li><a href="/necessity-index/">The Necessity Index</a> — quarterly classified universe, embeddable</li>
        <li><a href="/calendar/">The Crystallisation Window</a> — 34 in-flight regulations, 2024–2030</li>
        <li><a href="/research/">Research papers</a> — regulatory landscape, T1 graduation rates</li>
        <li><a href="/scoreboard/">The Scoreboard</a> — five falsifiable predictions, dated</li>
      </ul>
    </article>

    <article class="pr__block">
      <p class="kicker pr__kicker">Available for</p>
      <ul class="pr__list" role="list">
        <li>Short interviews (15–30 min) on APAC regulatory divergence</li>
        <li>Panel commentary on regulated-sector venture, the T1 / T2 framework, the four-market thesis</li>
        <li>Podcast guest on capital allocation in regulated sectors</li>
        <li>Off-record background calls for journalists writing on APAC venture</li>
      </ul>
    </article>

    <footer class="pr__cta surface-warm">
      <p class="kicker pr__cta-label">Direct line</p>
      <p class="pr__cta-line">Email for press, podcast, and panel enquiries.</p>
      <p class="pr__cta-row">
        <a class="pr__cta-link" href="mailto:wt@hmm.ventures?subject=Press%20enquiry">wt@hmm.ventures →</a>
      </p>
    </footer>
  </section>
</Base>

<style>
  .pr { padding-block: var(--s-8) var(--s-9); max-width: 56rem; }
  .pr__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-end: var(--s-7);
    padding-block-end: var(--s-5);
    border-bottom: 1px solid var(--rule);
  }
  .pr__title {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    margin: 0;
  }
  .pr__lede {
    font-family: var(--f-display);
    font-style: italic;
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: var(--fg-soft);
    max-width: 56ch;
    margin: 0;
  }

  .pr__block {
    padding-block: var(--s-6);
    border-bottom: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .pr__kicker { color: var(--c-tomato); margin: 0; }
  .pr__p {
    margin: 0;
    line-height: 1.65;
    max-width: 56ch;
  }
  .pr__assets, .pr__list {
    list-style: none;
    margin: var(--s-2) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
  }
  .pr__assets li, .pr__list li {
    padding-inline-start: var(--s-4);
    position: relative;
  }
  .pr__assets li::before, .pr__list li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--c-tomato);
  }
  .pr__assets a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }

  .pr__cta {
    margin-block-start: var(--s-7);
    padding: var(--s-6);
    background: var(--bg-warm);
    border-top: 2px solid var(--c-tomato);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .pr__cta-label { color: var(--c-tomato); margin: 0; }
  .pr__cta-line { font-family: var(--f-display); font-size: var(--fs-lg); margin: 0; }
  .pr__cta-row {
    display: flex;
    gap: var(--s-4);
    align-items: baseline;
    margin: 0;
    flex-wrap: wrap;
  }
  .pr__cta-link {
    font-family: var(--f-mono);
    font-size: var(--fs-md);
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  .pr__cta-meta {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: var(--fg-soft);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
</style>
