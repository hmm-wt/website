---
import Base from '../../layouts/Base.astro';
import KickerLabel from '../../components/KickerLabel.astro';

const subject = 'IM request';
const body = [
  'Fund or office:',
  'Website:',
  'Your role:',
  'Mandate fit (one line):',
  '',
  'Anything else you would like me to know before I send:'
].join('\n');
const mailto = `mailto:wt@hmm.ventures?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
---
<Base
  title="For LPs"
  description="Request the IM. Single email. Reply with a few lines on fit."
>
  <section class="lp container">
    <header class="lp__head">
      <KickerLabel index="00" label="For LPs" accent />
      <h1 class="lp__title gavel-drop">Request the IM.</h1>
      <p class="lp__lede">
        Single email. A few lines on the fund or office, the mandate, and what you have already read. I reply by hand.
      </p>
    </header>

    <div class="lp__action">
      <a class="lp__cta breathe" href={mailto}>wt@hmm.ventures →</a>
      <p class="lp__cta-note">Opens your mail client with a short template. Edit before sending.</p>
    </div>

    <footer class="lp__foot">
      <p class="lp__foot-line">Already read:</p>
      <p class="lp__foot-links">
        <a href="/doctrine/">Doctrine</a>
        <span aria-hidden="true"> · </span>
        <a href="/research/">Research</a>
        <span aria-hidden="true"> · </span>
        <a href="/research/data/necessity-index/">Index</a>
        <span aria-hidden="true"> · </span>
        <a href="/research/data/scoreboard/">Scoreboard</a>
      </p>
    </footer>
  </section>
</Base>

<style>
  .lp { padding-block: var(--s-9) var(--s-9); max-width: 48rem; }

  .lp__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-end: var(--s-8);
    padding-block-end: var(--s-5);
    border-bottom: 1px solid var(--rule);
  }
  .lp__title {
    font-family: var(--f-display);
    font-style: italic;
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--c-pearl);
  }
  .lp__lede {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    color: var(--fg-soft);
    max-width: 56ch;
    margin: 0;
  }

  .lp__action {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-end: var(--s-8);
  }
  .lp__cta {
    display: inline-block;
    align-self: flex-start;
    padding: var(--s-4) var(--s-5);
    background: var(--c-tomato);
    color: var(--c-pearl);
    font-family: var(--f-mono);
    font-size: var(--fs-base);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    border: 0;
    transition: background var(--dur-1) var(--ease);
  }
  .lp__cta:hover {
    background: var(--c-pearl);
    color: var(--c-evergreen);
  }
  .lp__cta-note {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
    margin: 0;
  }

  .lp__foot {
    padding-block-start: var(--s-5);
    border-top: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .lp__foot-line {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-soft);
    margin: 0;
  }
  .lp__foot-links {
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    margin: 0;
  }
  .lp__foot-links a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .lp__foot-links a:hover { color: var(--c-pearl); border-bottom-color: var(--c-pearl); }
</style>
