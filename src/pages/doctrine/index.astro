---
import { getCollection } from 'astro:content';
import Doctrine from '../../layouts/Doctrine.astro';
import DoctrineHeader from '../../components/DoctrineHeader.astro';
import ChapterNav from '../../components/ChapterNav.astro';
import Chapter from '../../components/Chapter.astro';
import MarginWidget from '../../components/MarginWidget.astro';
import CrystallisationRail from '../../components/CrystallisationRail.astro';
import CrystallisationTimeline from '../../components/charts/CrystallisationTimeline.astro';
import ScrollyClassifierFunnel from '../../components/research/ScrollyClassifierFunnel.astro';

const entries = (await getCollection('doctrine')).sort(
  (a, b) => a.data.chapter - b.data.chapter
);

const pad2 = (n: number) => String(n).padStart(2, '0');

type NavItem = { id?: string; index?: string; title: string; kind?: 'chapter' | 'gap' };

const chapters: NavItem[] = [];
for (let i = 0; i < entries.length; i++) {
  const e = entries[i];
  chapters.push({
    id: `chapter-${pad2(e.data.chapter)}`,
    index: pad2(e.data.chapter),
    title: e.data.title,
  });
  // Insert gap between chapter 03 and chapter 08 (the four-markets chapters live on /thesis/[market])
  if (e.data.chapter === 3 && entries[i + 1]?.data.chapter === 8) {
    chapters.push({ kind: 'gap', title: '04–07 · The four markets · private' });
  }
}

const railRows = [
  { label: 'Four-market classified universe', value: '19,416', source: 'hmm Ventures dataset' },
  { label: 'Passes T1 / T2 conservative classifier', value: '33.5%', source: '6,505 of 19,416 companies' },
  { label: 'Seed-stage in scope', value: '2,625', source: 'hmm Ventures dataset' },
  { label: 'Four-market regulations', value: '174', source: '117 T1 in the Five Necessities' },
  { label: 'In-flight 2024 to 2030', value: '34', source: 'AU 11 · JP 11 · SG 10 · NZ 2' },
];
---
<Doctrine
  title="The Necessity Doctrine"
  description="Necessity is the thesis. A doctrine for seed-stage capital in developed APAC."
>
  <Fragment slot="header">
    <DoctrineHeader author="Wahid Tashkandi" />
  </Fragment>

  <Fragment slot="toc">
    <ChapterNav chapters={chapters} />
  </Fragment>

  <Fragment slot="rail">
    <MarginWidget
      title="The four-market universe"
      market="AU · JP · NZ · SG"
      rows={railRows}
      index="01"
    />
  </Fragment>

  {entries.map(async (entry, i) => {
    const { Content } = await entry.render();
    const idx = pad2(entry.data.chapter);
    const market = entry.data.rail_market;
    const next = entries[i + 1];
    const nextIdx = next ? pad2(next.data.chapter) : undefined;
    return (
      <Chapter
        id={`chapter-${idx}`}
        index={idx}
        title={entry.data.title}
        nextHref={next ? `#chapter-${nextIdx}` : undefined}
        nextTitle={next ? next.data.title : undefined}
      >
        {entry.data.chapter === 8 && (
          <div class="chapter__timeline-inline chapter__timeline-inline--sticky">
            <CrystallisationTimeline />
          </div>
        )}
        {entry.data.chapter === 3 && (
          <div class="chapter__funnel-inline chapter__funnel-inline--sticky">
            <ScrollyClassifierFunnel />
          </div>
        )}
        <Content />
        {market && entry.data.chapter !== 8 && (
          <div class="chapter__rail-inline">
            <CrystallisationRail market={market} limit={5} />
          </div>
        )}
      </Chapter>
    );
  })}

</Doctrine>

<style>
  .chapter__rail-inline {
    margin-block-start: var(--s-6);
    padding-block-start: var(--s-5);
    border-top: 1px solid var(--rule);
    max-width: 36rem;
  }
  .chapter__timeline-inline {
    margin-block-start: var(--s-6);
    padding-block-start: var(--s-5);
    border-top: 1px solid var(--rule);
    /* Break out of the 60ch doctrine body column so the timeline reads at width. */
    width: min(72rem, 100vw - 2rem);
    margin-inline: calc(50% - min(36rem, 50vw - 1rem));
  }
  /* Sticky-at-top variant for chapter 8: the timeline pins while the reader
   * walks the chapter prose, then unsticks at the chapter's end. */
  .chapter__timeline-inline--sticky {
    position: sticky;
    top: 0.75rem;
    z-index: 6;
    background: var(--bg);
    padding-block: var(--s-3) var(--s-4);
    margin-block: 0 var(--s-5);
    border-top: 0;
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 820px) {
    .chapter__timeline-inline { width: 100%; margin-inline: 0; }
    .chapter__timeline-inline--sticky { position: static; }
  }
  @media (prefers-reduced-motion: reduce) {
    .chapter__timeline-inline--sticky { position: static; }
  }

  /* Chapter 3 funnel chart: same sticky pattern as chapter 8 timeline. */
  .chapter__funnel-inline {
    margin-block: 0 var(--s-5);
    width: min(56rem, 100vw - 2rem);
    margin-inline: calc(50% - min(28rem, 50vw - 1rem));
  }
  .chapter__funnel-inline--sticky {
    position: sticky;
    top: 0.75rem;
    z-index: 6;
    background: var(--bg);
    padding-block: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 820px) {
    .chapter__funnel-inline { width: 100%; margin-inline: 0; }
    .chapter__funnel-inline--sticky { position: static; }
  }
  @media (prefers-reduced-motion: reduce) {
    .chapter__funnel-inline--sticky { position: static; }
  }
</style>
