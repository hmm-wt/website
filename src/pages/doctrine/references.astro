---
import Base from '../../layouts/Base.astro';
import KickerLabel from '../../components/KickerLabel.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('doctrine')).sort(
  (a, b) => a.data.chapter - b.data.chapter
);

interface Segment { kind: 'text' | 'link'; value: string; href?: string; }
interface Footnote { num: string; text: string; segments: Segment[]; }

const footnoteRe = /^\[\^(\d+)\]:\s*(.+?)$/gm;
const urlRe = /(https?:\/\/[^\s<>"')\]]+)/g;

function segmentise(text: string): Segment[] {
  const parts: Segment[] = [];
  let lastIndex = 0;
  let match: RegExpExecArray | null;
  urlRe.lastIndex = 0;
  while ((match = urlRe.exec(text)) !== null) {
    if (match.index > lastIndex) {
      parts.push({ kind: 'text', value: text.slice(lastIndex, match.index) });
    }
    // Strip trailing punctuation that's clearly part of the prose, not the URL.
    let url = match[0];
    const trailing = url.match(/[.,;:!?]+$/);
    if (trailing) url = url.slice(0, -trailing[0].length);
    parts.push({ kind: 'link', value: url, href: url });
    if (trailing) parts.push({ kind: 'text', value: trailing[0] });
    lastIndex = match.index + match[0].length;
  }
  if (lastIndex < text.length) {
    parts.push({ kind: 'text', value: text.slice(lastIndex) });
  }
  return parts.length > 0 ? parts : [{ kind: 'text', value: text }];
}

const chapters = entries.map((e) => {
  const body = e.body || '';
  const fns: Footnote[] = [];
  let m: RegExpExecArray | null;
  footnoteRe.lastIndex = 0;
  while ((m = footnoteRe.exec(body)) !== null) {
    const text = m[2].trim();
    fns.push({ num: m[1], text, segments: segmentise(text) });
  }
  return {
    chapter: e.data.chapter,
    title: e.data.title,
    footnotes: fns,
  };
});

const total = chapters.reduce((acc, c) => acc + c.footnotes.length, 0);
---
<Base
  title="References"
  description="Citations and source notes for The Necessity Doctrine. Every public claim traces here."
>
  <section class="ref container">
    <header class="ref__head">
      <KickerLabel index="00" label="Doctrine · references" accent />
      <h1 class="ref__title">References.</h1>
      <p class="ref__lede">
        Every numerical claim in the public doctrine traces to one of two sources: the hmm Ventures classified universe (reference dataset 2026-04-08) or a primary public regulatory record. {total} citations across {chapters.length} chapters.
      </p>
      <p class="ref__nav kicker">
        <a href="/doctrine/">← Back to the doctrine</a>
      </p>
    </header>

    {chapters.map((c) => (
      <section class="ref__ch" id={`ch${c.chapter}`}>
        <header class="ref__ch-head">
          <span class="ref__ch-idx">Chapter {String(c.chapter).padStart(2, '0')}</span>
          <h2 class="ref__ch-title">{c.title}</h2>
        </header>
        {c.footnotes.length === 0 ? (
          <p class="ref__empty">No external citations in this chapter.</p>
        ) : (
          <ol class="ref__list" role="list">
            {c.footnotes.map((fn) => (
              <li class="ref__item" id={`ch${c.chapter}-${fn.num}`}>
                <span class="ref__num">[{fn.num}]</span>
                <span class="ref__text">{fn.segments.map((seg) => (
                  seg.kind === 'link'
                    ? <a href={seg.href} target="_blank" rel="noopener noreferrer">{seg.value}</a>
                    : <Fragment>{seg.value}</Fragment>
                ))}</span>
              </li>
            ))}
          </ol>
        )}
      </section>
    ))}

    <footer class="ref__foot">
      <p class="kicker">
        Public canon. Methodology and provenance for the classified universe and the regulatory dataset are documented in Appendix F of the Necessity Index.
      </p>
    </footer>
  </section>
</Base>

<style>
  .ref { padding-block: var(--s-8) var(--s-9); max-width: 56rem; }
  .ref__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-end: var(--s-7);
    padding-block-end: var(--s-5);
    border-bottom: 1px solid var(--rule);
  }
  .ref__title {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    margin: 0;
  }
  .ref__lede {
    font-family: var(--f-display);
    font-style: italic;
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: var(--fg-soft);
    max-width: 56ch;
    margin: 0;
  }
  .ref__nav { margin: 0; }
  .ref__nav a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }

  .ref__ch {
    margin-block-end: var(--s-7);
    padding-block-end: var(--s-5);
    border-bottom: 1px solid var(--rule);
  }
  .ref__ch:last-of-type { border-bottom: 0; }

  .ref__ch-head {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    margin-block-end: var(--s-5);
  }
  .ref__ch-idx {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-tomato);
    font-weight: 600;
  }
  .ref__ch-title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: 0;
  }

  .ref__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .ref__item {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: var(--s-3);
    padding-block: var(--s-2);
    scroll-margin-top: var(--s-6);
  }
  .ref__item:target {
    background: color-mix(in srgb, var(--c-tomato) 8%, transparent);
    padding-inline: var(--s-3);
    margin-inline: calc(-1 * var(--s-3));
  }
  .ref__num {
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    color: var(--c-tomato);
    font-weight: 600;
    line-height: 1.55;
  }
  .ref__text {
    font-family: var(--f-body);
    font-size: var(--fs-base);
    line-height: 1.55;
    color: var(--fg);
  }
  .ref__empty {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-faint);
    margin: 0;
  }

  .ref__foot {
    margin-block-start: var(--s-7);
    padding-block-start: var(--s-5);
    border-top: 1px solid var(--rule);
  }
  .ref__foot .kicker {
    max-width: 72ch;
    text-transform: none;
    letter-spacing: 0;
    font-family: var(--f-body);
    font-size: var(--fs-sm);
    line-height: 1.55;
  }
</style>
