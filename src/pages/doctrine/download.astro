---
import Base from '../../layouts/Base.astro';

const pdfUrl = '/doctrine/the-necessity-doctrine-v1.pdf';
const pdfLabel = 'The Necessity Doctrine · 8.4 MB PDF';
---
<Base
  title="Download The Necessity Doctrine"
  description="The Necessity Doctrine in PDF. For forwarding, printing, and reading offline."
>
  <section class="dl container">
    <header class="dl__head">
      <h1 class="dl__title">The artefact, in print.</h1>
      <p class="dl__lede">
        The web Doctrine reads the same as the PDF. The PDF is for forwarding, printing, and reading offline.
      </p>
    </header>

    <a class="dl__download" href={pdfUrl} download>
      <span class="dl__download-label">Download</span>
      <span class="dl__download-file">{pdfLabel}</span>
      <span class="dl__download-arrow" aria-hidden="true">↓</span>
    </a>
  </section>
</Base>

<style>
  .dl { padding-block: var(--s-8) var(--s-9); display: flex; flex-direction: column; gap: var(--s-7); }
  .dl__head { display: flex; flex-direction: column; gap: var(--s-3); max-width: 64ch; }
  .dl__title { font-family: var(--f-display); font-size: var(--fs-3xl); line-height: var(--lh-tight); margin: 0; }
  .dl__lede { font-size: var(--fs-lg); font-family: var(--f-display); line-height: var(--lh-snug); color: var(--fg-soft); max-width: 52ch; }
  .dl__download {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-5);
    background: var(--c-evergreen);
    color: var(--c-pearl);
    text-decoration: none;
    align-self: flex-start;
    transition: background var(--dur-1) var(--ease);
  }
  .dl__download:hover { background: var(--c-tomato); }
  .dl__download-label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-tomato);
    font-weight: 600;
  }
  .dl__download:hover .dl__download-label { color: var(--c-pearl); }
  .dl__download-file { font-family: var(--f-display); font-size: var(--fs-lg); }
  .dl__download-arrow { font-size: 1.25rem; }
</style>
