---
import Base from '../layouts/Base.astro';
import KickerLabel from '../components/KickerLabel.astro';
---
<Base
  title="Contact"
  description="Direct email. Forty-eight-hour personal reply."
>
  <section class="contact container">
    <header class="contact__head">
      <KickerLabel index="00" label="Contact" />
      <h1 class="contact__title">Three lines.</h1>
    </header>

    <ul class="contact__list" role="list">
      <li class="contact__line">
        <p class="contact__line-label kicker">LPs and allocators</p>
        <p class="contact__line-value">
          <a href="mailto:wt@hmm.ventures">wt@hmm.ventures</a>
        </p>
        <p class="contact__line-meta">Forty-eight-hour personal reply, weekends included for institutional senders.</p>
      </li>

      <li class="contact__line">
        <p class="contact__line-label kicker">Founders</p>
        <p class="contact__line-value">
          <a href="mailto:wt@hmm.ventures?subject=Founder%20intro">wt@hmm.ventures</a>
        </p>
        <p class="contact__line-meta">Send a one-pager or a deck. Tell us which regulator your demand curve depends on and the published timeline you are tracking.</p>
      </li>

      <li class="contact__line">
        <p class="contact__line-label kicker">Media</p>
        <p class="contact__line-value">
          <a href="mailto:wt@hmm.ventures?subject=Media%20enquiry">wt@hmm.ventures</a>
        </p>
        <p class="contact__line-meta">Bio and photo on request.</p>
      </li>
    </ul>

    <footer class="contact__foot">
      <p class="kicker">DIFC, Dubai · SIN · TYO · SYD · AKL</p>
    </footer>
  </section>
</Base>

<style>
  .contact { padding-block: var(--s-8) var(--s-9); max-width: 48rem; }
  .contact__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-end: var(--s-7);
    padding-block-end: var(--s-5);
    border-bottom: 1px solid var(--rule);
  }
  .contact__title {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    margin: 0;
  }
  .contact__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .contact__line {
    padding-block: var(--s-6);
    border-bottom: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .contact__line:last-of-type { border-bottom: 0; }
  .contact__line-label { margin: 0; color: var(--c-tomato); }
  .contact__line-value {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    margin: 0;
  }
  .contact__line-value a {
    text-decoration: none;
    color: var(--fg);
    border-bottom: 1px solid var(--c-tomato);
    padding-bottom: 2px;
  }
  .contact__line-value a:hover { color: var(--c-tomato); }
  .contact__line-meta {
    font-size: var(--fs-sm);
    color: var(--fg-soft);
    margin: 0;
    max-width: 60ch;
    line-height: 1.55;
  }
  .contact__foot {
    margin-block-start: var(--s-7);
    padding-block-start: var(--s-5);
    border-top: 1px solid var(--rule);
  }
</style>
