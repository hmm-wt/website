---
import Base from '../layouts/Base.astro';
import { buildContactMailto, buildIMRequestMailto } from '../utils/mailto.ts';

const lpMailto = buildIMRequestMailto();
const founderMailto = buildContactMailto('Founder intro');
---
<Base
  title="Contact"
  description="Direct email. For LPs and founders."
>
  <section class="contact container-narrow">
    <header class="contact__head">
      <h1 class="contact__title gavel-drop">Get in touch.</h1>
    </header>

    <article id="lps" class="contact__block">
      <h2 class="contact__h2"><a href={lpMailto}>For LPs →</a></h2>
    </article>

    <article id="founders" class="contact__block">
      <h2 class="contact__h2"><a href={founderMailto}>For founders →</a></h2>
    </article>

    <footer class="contact__trust">
      <p class="contact__tag">Necessity is the thesis.</p>
    </footer>
  </section>
</Base>

<style>
  .contact { padding-block: var(--s-8) var(--s-9); }
  .contact__head {
    margin-block-end: var(--s-7);
    padding-block-end: var(--s-5);
    border-bottom: 1px solid var(--rule);
  }
  .contact__title {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    margin: 0;
  }
  .contact__block {
    padding-block: var(--s-6);
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: var(--s-7);
  }
  .contact__h2 {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: 0;
  }
  .contact__h2 a {
    color: var(--fg);
    text-decoration: none;
    transition: color var(--mo-tick) var(--ease-golden);
  }
  .contact__h2 a:hover { color: var(--c-tomato); }
  .contact__trust {
    margin-block-start: var(--s-7);
    padding-block: var(--s-6);
  }
  .contact__tag {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    color: var(--c-tomato);
    margin: 0;
  }
</style>
