---
import Base from '../layouts/Base.astro';
import CTARail from '../components/CTARail.astro';
---
<Base
  title="Contact"
  description="Direct email. For LPs and founders."
>
  <header class="contact-hero">
    <div class="container">
      <p class="kicker contact-hero__kicker">Get in touch</p>
      <h1 class="contact-hero__title">Two doors. One email each.</h1>
      <p class="contact-hero__sub">
        If you allocate capital, request the IM. If you build what people need, send the deck. Read the doctrine first.
      </p>
    </div>
  </header>

  <CTARail />

  <section class="contact-trail container">
    <p class="contact-trail__line">
      Already read the doctrine? <a href="/research/">See the research.</a>
    </p>
  </section>
</Base>

<style>
  .contact-hero {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding-block: var(--s-8) var(--s-6);
  }
  .contact-hero__kicker { color: var(--c-tomato); margin: 0; }
  .contact-hero__title {
    font-family: var(--f-display);
    font-size: clamp(2.5rem, 1.5rem + 4.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: var(--s-3) 0 var(--s-4);
    font-weight: 400;
    max-width: 18ch;
  }
  .contact-hero__sub {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: color-mix(in srgb, var(--c-pearl) 84%, transparent);
    max-width: 60ch;
    margin: 0;
  }
  .contact-trail {
    padding-block: var(--s-6) var(--s-8);
  }
  .contact-trail__line {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-soft);
    margin: 0;
  }
  .contact-trail__line a {
    color: var(--hero);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .contact-trail__line a:hover { color: var(--fg); border-bottom-color: var(--fg); }
</style>
