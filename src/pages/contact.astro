---
import Base from '../layouts/Base.astro';
---
<Base
  title="Contact"
  description="hmm Ventures."
>
  <section class="contact container">
    <div class="contact__card">
      <p class="contact__mark" aria-hidden="true">hmm<span class="contact__dots"><span></span><span></span><span class="hollow"></span></span></p>
      <p class="contact__wordmark">hmm Ventures</p>
      <p class="contact__email">
        <a href="mailto:wt@hmm.ventures">wt@hmm.ventures</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .contact {
    padding-block: var(--s-9);
    min-height: 70vh;
    display: grid;
    place-items: center;
  }
  .contact__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-5);
    text-align: center;
  }
  .contact__mark {
    font-family: var(--f-display);
    font-size: clamp(3rem, 1.5rem + 6vw, 6rem);
    line-height: 1;
    margin: 0;
    color: var(--fg);
    display: inline-flex;
    align-items: flex-end;
    gap: 0.08em;
  }
  .contact__dots {
    display: inline-flex;
    gap: 0.06em;
    align-items: flex-end;
    margin-bottom: 0.18em;
  }
  .contact__dots span {
    width: 0.18em;
    height: 0.18em;
    background: currentColor;
    border-radius: 50%;
    display: inline-block;
  }
  .contact__dots span.hollow {
    background: transparent;
    border: 1px solid currentColor;
  }
  .contact__wordmark {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--fg-soft);
    margin: 0;
  }
  .contact__email {
    font-family: var(--f-display);
    font-style: italic;
    font-size: var(--fs-xl);
    margin: 0;
  }
  .contact__email a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid var(--c-tomato);
    padding-bottom: 2px;
  }
  .contact__email a:hover { color: var(--fg); border-bottom-color: var(--fg); }
</style>
