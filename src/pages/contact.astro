---
import RecordLayout from '../layouts/RecordLayout.astro';
---
<RecordLayout
  title="Get in touch"
  description="Direct contact. For LPs and founders."
  section="gp"
  tone="light"  folio="ex-38 / 38"
  locator='<span class="here">Get in touch</span>'
>
  <header class="rec-masthead">
    <p class="rec-masthead__eyebrow">Get in touch</p>
    <h1 class="rec-masthead__title">Get in touch.</h1>
    <p class="rec-masthead__claim">
      If you allocate capital, request the memorandum. If you build what people need, send the deck. Read the research first so the message can be specific.
    </p>
  </header>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The two paths</span><span class="rec-beat__count">01 / 03</span></div>
    <ul class="contact-paths" role="list">
      <li class="contact-path">
        <p class="contact-path__who">Capital allocators</p>
        <p class="contact-path__ask">Request the memorandum and the data room, or book a call. A few lines on the office and the mandate is enough to start.</p>
      </li>
      <li class="contact-path">
        <p class="contact-path__who">Founders and operators</p>
        <p class="contact-path__ask">Send the deck. If you are building inside one of the five Necessities and a regulator is about to require what you do, that is the conversation.</p>
      </li>
    </ul>
  </section>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">Send a message</span><span class="rec-beat__count">02 / 03</span></div>
    <form
      class="contact-form"
      name="contact"
      method="POST"
      action="/contact/thanks/"
      data-netlify="true"
      netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="contact-form__hp" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;">
        <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>

      <fieldset class="contact-form__role">
        <legend class="contact-form__legend">Reason for contact</legend>
        <label class="contact-form__radio">
          <input type="radio" name="role" value="lp" required />
          <span>Capital allocator</span>
        </label>
        <label class="contact-form__radio">
          <input type="radio" name="role" value="founder" />
          <span>Founder / operator</span>
        </label>
        <label class="contact-form__radio">
          <input type="radio" name="role" value="other" />
          <span>Other</span>
        </label>
      </fieldset>

      <div class="contact-form__row">
        <label class="contact-form__field">
          <span class="contact-form__label">Name</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label class="contact-form__field">
          <span class="contact-form__label">Email</span>
          <input type="email" name="email" inputmode="email" autocomplete="email" required />
        </label>
      </div>

      <label class="contact-form__field">
        <span class="contact-form__label">Organisation</span>
        <input type="text" name="organisation" autocomplete="organization" />
      </label>

      <label class="contact-form__field">
        <span class="contact-form__label">Message</span>
        <textarea name="message" rows="6" required placeholder="A few lines on the office, the mandate, and the part of the thesis you want to test."></textarea>
      </label>

      <div class="contact-form__foot">
        <button type="submit" class="contact-form__submit">Send</button>
        <p class="contact-form__note">
          Direct email also fine: <a href="mailto:wt@hmm.ventures">wt@hmm.ventures</a>
        </p>
      </div>
    </form>
  </section>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">Before you write</span><span class="rec-beat__count">03 / 03</span></div>
    <p class="rec-beat__note">
      New here? <a href="/research/">Start with the research.</a> Every claim on this site traces to a primary source.
    </p>
  </section>
</RecordLayout>

<style>
  /* Two paths. Allocator vs founder, stated before the single shared form. */
  .contact-paths {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  .contact-path {
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .contact-path__who {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-tomato);
    margin: 0;
  }
  .contact-path__ask {
    font-family: var(--f-body);
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--fg-soft);
    margin: 0;
  }
  @media (max-width: 640px) {
    .contact-paths { grid-template-columns: 1fr; }
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    max-width: 48rem;
  }
  .contact-form__hp {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .contact-form__role {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    border: 0;
    padding: 0;
    margin: 0;
  }
  .contact-form__legend {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-soft);
    padding: 0;
    margin-block-end: var(--s-3);
  }
  .contact-form__radio {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap-min);
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--rule);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
    cursor: pointer;
    transition: border-color var(--mo-tick) var(--ease-golden),
                color var(--mo-tick) var(--ease-golden);
  }
  .contact-form__radio:hover,
  .contact-form__radio:focus-within { border-color: var(--c-tomato); color: var(--fg); }
  .contact-form__radio input {
    accent-color: var(--c-tomato);
    width: 16px;
    height: 16px;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-4);
  }
  @media (max-width: 480px) {
    .contact-form__row { grid-template-columns: 1fr; }
  }
  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .contact-form__label {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-soft);
  }
  .contact-form__field input,
  .contact-form__field textarea {
    font-family: var(--f-body);
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--rule);
    padding: 0.75rem var(--s-3);
    min-height: var(--tap-min);
    transition: border-color var(--mo-tick) var(--ease-golden),
                background var(--mo-tick) var(--ease-golden);
  }
  .contact-form__field textarea {
    resize: vertical;
    line-height: 1.55;
    min-height: 8rem;
  }
  .contact-form__field input:focus,
  .contact-form__field textarea:focus {
    outline: none;
    border-color: var(--c-tomato);
    background: color-mix(in srgb, var(--c-pearl) 4%, var(--surface));
  }
  .contact-form__field input::placeholder,
  .contact-form__field textarea::placeholder { color: var(--fg-faint); }

  .contact-form__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    align-items: center;
    margin-block-start: var(--s-2);
  }
  .contact-form__submit {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding: 0.875rem 1.5rem;
    background: var(--c-tomato);
    color: var(--fg);
    border: 0;
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: background var(--mo-tick) var(--ease-golden);
  }
  .contact-form__submit:hover,
  .contact-form__submit:active { background: var(--c-mahogany); }
  .contact-form__note {
    margin: 0;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
  }
  .contact-form__note a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .contact-form__note a:hover { color: var(--fg); border-bottom-color: var(--fg); }

  .rec-beat__note a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .rec-beat__note a:hover { color: var(--fg); border-bottom-color: var(--fg); }
</style>
