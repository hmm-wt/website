---
import Base from '../../../layouts/Base.astro';
import CrystallisationStrip from '../../../components/charts/CrystallisationStrip.astro';
import CalendarTimeline from '../../../components/CalendarTimeline.astro';
import TagFilter from '../../../components/TagFilter.astro';
import ChartFrame from '../../../components/ChartFrame.astro';
import CTARail from '../../../components/CTARail.astro';
import calendar from '../../../data/crystallisation-window.json';

const necessityList = Array.from(new Set(calendar.regulations.map((r) => r.necessity))).sort();

const filterGroups = [
  { key: 'market', label: 'Market', options: ['AU', 'JP', 'NZ', 'SG'] },
  { key: 'necessity', label: 'Necessity', options: necessityList },
  { key: 'tier', label: 'Tier', options: ['T1', 'T2'] }
];
---
<Base
  title="The Crystallisation Window"
  description="Thirty-four regulations crystallising what people need into law across Australia, Japan, New Zealand, and Singapore, dated 2024 to 2030."
>
  <header class="cal-hero">
    <div class="container">
      <p class="kicker cal-hero__kicker">The window</p>
      <h1 class="cal-hero__title">Effective dates concentrate at 2027.</h1>
      <p class="cal-hero__sub">
        Thirty-four regulations across four markets, dated 2024 to 2030. Each one turns a necessity into a category of work that did not previously exist.
      </p>
    </div>
  </header>

  <section class="container cal-chart">
    <ChartFrame
      kicker="Effective dates"
      title="In-flight regulations by year."
      caption="All thirty-four in-flight regulations across the four target markets. Hero bar marks the peak."
      source="Source. hmm Ventures comprehensive regulatory dataset."
    >
      <CrystallisationStrip />
    </ChartFrame>
  </section>

  <section class="container cal-list">
    <header class="cal-list__head">
      <p class="kicker cal-list__kicker">The list</p>
      <h2 class="cal-list__title">Every regulation, grouped by year.</h2>
    </header>
    <div class="cal-list__filter">
      <TagFilter groups={filterGroups} target=".cal-year__list .ce" />
    </div>
    <CalendarTimeline />
  </section>

  <CTARail />
</Base>

<style>
  .cal-hero {
    background: var(--c-evergreen);
    color: var(--c-pearl);
    padding-block: var(--s-8) var(--s-6);
  }
  .cal-hero__kicker { color: var(--c-tomato); margin: 0; }
  .cal-hero__title {
    font-family: var(--f-display);
    font-size: clamp(2.5rem, 1.5rem + 4.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: var(--s-3) 0 var(--s-4);
    font-weight: 400;
    max-width: 22ch;
  }
  .cal-hero__sub {
    font-family: var(--f-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: color-mix(in srgb, var(--c-pearl) 84%, transparent);
    max-width: 60ch;
    margin: 0;
  }
  .cal-chart { padding-block: var(--s-7); }
  .cal-list {
    padding-block: var(--s-7) var(--s-8);
    max-width: 64rem;
  }
  .cal-list__head {
    margin-block-end: var(--s-5);
    max-width: 56ch;
  }
  .cal-list__head .kicker { color: var(--c-tomato); margin: 0; }
  .cal-list__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    margin: var(--s-3) 0 0;
    letter-spacing: -0.01em;
  }
  .cal-list__filter { margin-block-end: var(--s-5); }
</style>
