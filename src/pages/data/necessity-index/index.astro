---
import RecordLayout from '../../../layouts/RecordLayout.astro';
import Plate from '../../../components/record/Plate.astro';
import data from '../../../data/necessity-index.json';

// Per-Necessity rows, ordered by cohort size (largest first) for the EX-15 bars.
const perNecessity = [...data.per_necessity].sort(
  (a, b) => b.in_thesis_companies - a.in_thesis_companies,
);
const cohortMax = Math.max(...perNecessity.map((n) => n.in_thesis_companies));

// Per-market detail rows preserve the classified-dataset breakdown verbatim.
const perMarket = data.per_market;

// Bar geometry for EX-15 (horizontal cohort bars). The necessity name sits on
// its own line above each bar so long labels (Critical Materials and Supply
// Integrity) can never collide with the value.
const ROWW = 360;
const BARMAX = 264; // bar track; the value label sits to the right of the bar
const ROWH = 44;    // taller rows: name above, bar + value below
const chartH = perNecessity.length * ROWH + 6;
---
<RecordLayout
  title="The company universe"
  description="19,416 four-market technology companies, classified against the T1 / T2 Necessities. Cross-referenced against 174 four-market regulations."
  section="data"
  tone="light"  folio="ex-15 / 38"
  locator='03 · <span class="here">The data</span>'
  next={{ href: '/data/calendar/', label: '03 The window' }}
>
  <header class="rec-masthead">
    <p class="rec-masthead__eyebrow" style="color:var(--c-tomato)">03 · The data</p>
    <h1 class="rec-masthead__title">The company universe.</h1>
    <p class="rec-masthead__claim">
      19,416 four-market technology companies, classified against the T1 / T2 Necessities. Cross-referenced against 174 four-market regulations.
    </p>
  </header>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The universe</span><span class="rec-beat__count">01 / 05</span></div>
    <h2 class="rec-beat__arg">The four-market universe sits at <em>{data.universe.four_market_companies.toLocaleString('en-GB')}</em> companies.</h2>
    <p class="rec-beat__prose">
      Every technology company trading in the four target markets, classified against the T1 / T2 screen. {data.universe.regulations_four_market} four-market regulations frame the Necessities.
    </p>
    <dl class="ni-stats ni-stats--3">
      <div class="ni-stat ni-stat--accent">
        <dt class="ni-stat__k">Four-market companies</dt>
        <dd class="ni-stat__v">{data.universe.four_market_companies.toLocaleString('en-GB')}</dd>
      </div>
      <div class="ni-stat">
        <dt class="ni-stat__k">Regulations mapped (global)</dt>
        <dd class="ni-stat__v">{data.universe.regulations_global.toLocaleString('en-GB')}</dd>
      </div>
      <div class="ni-stat ni-stat--accent">
        <dt class="ni-stat__k">Four-market regulations</dt>
        <dd class="ni-stat__v">{data.universe.regulations_four_market}</dd>
      </div>
    </dl>
  </section>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The screen</span><span class="rec-beat__count">02 / 05</span></div>
    <h2 class="rec-beat__arg">One in three four-market companies <em>meets the T1/T2 screen</em>.</h2>
    <p class="rec-beat__prose">
      Conservative T1 / T2 classifier across the four-market universe. T1 = licence-as-barrier. T2 = compliance-demand-as-barrier.
    </p>
    <dl class="ni-stats ni-stats--3">
      <div class="ni-stat ni-stat--accent">
        <dt class="ni-stat__k">Conservative classifier share</dt>
        <dd class="ni-stat__v">{data.tier_shares.conservative_classifier_pct}%</dd>
        <dd class="ni-stat__sub">Pass the T1 or T2 screen</dd>
      </div>
      <div class="ni-stat">
        <dt class="ni-stat__k">Necessities-aligned companies</dt>
        <dd class="ni-stat__v">{data.tier_shares.conservative_classifier_count.toLocaleString('en-GB')}</dd>
      </div>
      <div class="ni-stat">
        <dt class="ni-stat__k">T1 (licence-as-barrier)</dt>
        <dd class="ni-stat__v">{data.tier_shares.t1_count.toLocaleString('en-GB')}</dd>
      </div>
    </dl>
    <p class="rec-beat__note">
      Classified universe (four-market): {data.stage_funnel[0].count.toLocaleString('en-GB')}. In Necessities (T1 or T2): {data.stage_funnel[1].count.toLocaleString('en-GB')} ({data.stage_funnel[1].share_pct}%). In Necessities, seed-stage: {data.stage_funnel[2].count.toLocaleString('en-GB')} ({data.stage_funnel[2].share_pct}%).
    </p>
  </section>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The cohort</span><span class="rec-beat__count">03 / 05</span></div>
    <h2 class="rec-beat__arg">The company universe across the <em>five Necessities</em>.</h2>
    <Plate
      ex="EX-15"
      label="Necessities-aligned cohort"
      sub="Companies in the four-market dataset, mapped to each of the five Necessities. T1 and T2 regulation counts shown per Necessity."
      source="hmm Ventures four-market classified dataset."
      basis="Per-Necessity joins, four-market filter."
    >
      <svg viewBox={`0 0 ${ROWW} ${chartH}`} width={ROWW} height={chartH} preserveAspectRatio="xMidYMid meet" class="ni-bars" role="img" aria-label="Companies mapped to each of the five Necessities">
        {perNecessity.map((n, i) => {
          const top = 4 + i * ROWH;
          const w = (n.in_thesis_companies / cohortMax) * BARMAX;
          const hero = i === 0;
          return (
            <g>
              <text x="0" y={top + 12} class="ni-bars__label">{n.name}</text>
              <rect x="0" y={top + 20} width={w} height="10"
                fill={hero ? 'var(--c-tomato)' : 'var(--c-mahogany)'} opacity={hero ? 0.95 : 0.3} />
              <text x={w + 7} y={top + 29} class="ni-bars__val"
                fill={hero ? 'var(--c-tomato)' : 'rgba(37,0,1,0.66)'}>{n.in_thesis_companies.toLocaleString('en-GB')}</text>
            </g>
          );
        })}
      </svg>
    </Plate>
    <div class="nd-scroll nd-scroll--below">
        <table class="nd-table">
          <thead><tr><th>Necessity</th><th>Companies</th><th>T1</th><th>T2</th></tr></thead>
          <tbody>
            {perNecessity.map((n) => (
              <tr>
                <td>{n.name}</td>
                <td>{n.in_thesis_companies.toLocaleString('en-GB')}</td>
                <td class="nd-table__tier">{n.regulations_t1}</td>
                <td class="nd-table__status">{n.regulations_t2}</td>
              </tr>
            ))}
          </tbody>
        </table>
    </div>
  </section>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The four markets</span><span class="rec-beat__count">04 / 05</span></div>
    <h2 class="rec-beat__arg">Per-market <em>companies, regulations, and tier</em> detail.</h2>
    <p class="rec-beat__note">
      Per-market and per-Necessity counts for the four-market universe. Per-market companies, regulations, and tier breakdown verified against the classified dataset.
    </p>
    <div class="nd-scroll">
    <table class="nd-table ni-market">
      <thead><tr><th>Market</th><th>Companies</th><th>Regulations</th><th>T1</th><th>T2</th><th>Enacted</th><th>Projected</th></tr></thead>
      <tbody>
        {perMarket.map((m) => (
          <tr>
            <td>{m.code}</td>
            <td>{m.companies.toLocaleString('en-GB')}</td>
            <td>{m.regulations}</td>
            <td class="nd-table__tier">{m.t1}</td>
            <td>{m.t2}</td>
            <td>{m.enacted}</td>
            <td class="nd-table__status">{m.projected}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  </section>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The premium</span><span class="rec-beat__count">05 / 05</span></div>
    <h2 class="rec-beat__arg">Cumulative funding multiple widens to <em>2.12x</em> by Series D+.</h2>
    <p class="rec-beat__prose">
      T1 round-size uplift relative to unregulated peers at each stage. The cumulative funding gap is widest by Series D+.
    </p>
    <dl class="ni-stats">
      <div class="ni-stat">
        <dt class="ni-stat__k">Seed</dt>
        <dd class="ni-stat__v">{data.premiums.round_size_seed}x</dd>
      </div>
      <div class="ni-stat">
        <dt class="ni-stat__k">Series A</dt>
        <dd class="ni-stat__v">{data.premiums.round_size_series_a}x</dd>
      </div>
      <div class="ni-stat ni-stat--accent">
        <dt class="ni-stat__k">Series C</dt>
        <dd class="ni-stat__v">{data.premiums.round_size_series_c}x</dd>
      </div>
      <div class="ni-stat">
        <dt class="ni-stat__k">Series D+</dt>
        <dd class="ni-stat__v">{data.premiums.round_size_series_d_plus}x</dd>
      </div>
    </dl>
    <dl class="ni-stats ni-stats--3">
      <div class="ni-stat">
        <dt class="ni-stat__k">Cumulative pre-seed</dt>
        <dd class="ni-stat__v">{data.premiums.cumulative_pre_seed}x</dd>
      </div>
      <div class="ni-stat ni-stat--accent">
        <dt class="ni-stat__k">Cumulative Series D+</dt>
        <dd class="ni-stat__v">{data.premiums.cumulative_series_d_plus}x</dd>
      </div>
      <div class="ni-stat ni-stat--accent">
        <dt class="ni-stat__k">Exit-rate multiple</dt>
        <dd class="ni-stat__v">{data.premiums.exit_rate_multiple}x</dd>
        <dd class="ni-stat__sub">{data.premiums.regulated_exit_rate_pct}% vs {data.premiums.unregulated_exit_rate_pct}%</dd>
      </div>
    </dl>
    <p class="rec-beat__note">
      In-flight regulations 2024 to 2030: {data.crystallisation_window.in_flight_2024_2030}. Peak year: {data.crystallisation_window.peak_year}. Regulations in peak year: {data.crystallisation_window.peak_year_count}.
    </p>
    <p class="ni-cta"><a href="/data/calendar/">View the full calendar &rarr;</a></p>
  </section>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">Source datasets</span><span class="rec-beat__count">Colophon</span></div>
    <ul class="ni-sources" role="list">
      {data.source_datasets.map((s) => <li>{s}</li>)}
    </ul>
    <p class="ni-cta"><a href="/data/necessity-index/methodology/">Methodology &rarr;</a></p>
  </section>
</RecordLayout>

<style>
  /* Stat grid. Mono labels, serif-free data. */
  .ni-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin: var(--s-4) 0 0;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  .ni-stats--3 { grid-template-columns: repeat(3, 1fr); margin-top: var(--s-3); }
  .ni-stat {
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .ni-stat__k {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin: 0;
  }
  .ni-stat__v {
    font-family: var(--f-mono);
    font-size: var(--fs-2xl);
    line-height: 1;
    color: var(--fg);
    margin: 0;
  }
  .ni-stat--accent .ni-stat__v { color: var(--c-tomato); }
  .ni-stat__sub {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    color: var(--fg-faint);
    margin: 0;
  }

  /* EX-15 horizontal bars (pearl surface inside the plate). height:auto lets
     the SVG scale to its container width (without it the viewBox forces an
     intrinsic width that overflows narrow screens). */
  .ni-bars { display: block; width: 100%; height: auto; max-width: 100%; min-width: 0; }
  .ni-bars__label {
    font-family: var(--f-mono);
    font-size: 9px;
    letter-spacing: 0.04em;
    fill: rgba(37, 0, 1, 0.74);
  }
  .ni-bars__val {
    font-family: var(--f-mono);
    font-size: 9px;
  }

  /* Wide tables scroll horizontally inside their own box on narrow screens
     instead of overflowing the page (and widening the EX-15 plate/SVG). */
  .nd-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .nd-scroll--below { margin-top: var(--s-4); }
  .nd-scroll .nd-table { margin-top: 0; }
  .ni-market { white-space: nowrap; }

  /* Shared nd-table (mirrors the reference necessity pattern). */
  .nd-table { width: 100%; border-collapse: collapse; margin-top: var(--s-3); font-family: var(--f-mono); }
  .nd-table th {
    text-align: left; font-size: var(--fs-xs); font-weight: 400; text-transform: uppercase;
    letter-spacing: 0.1em; color: rgba(37, 0, 1, 0.42); padding: 0 var(--s-3) var(--s-2) 0;
  }
  .nd-table td {
    font-size: var(--fs-sm); color: rgba(37, 0, 1, 0.74); padding: var(--s-2) var(--s-3) var(--s-2) 0;
    border-top: 1px solid rgba(4, 47, 42, 0.14);
  }
  .nd-table__tier { color: var(--c-tomato); }
  .nd-table__status { text-align: right; white-space: nowrap; }

  /* Per-market table renders on the dark page, not inside a plate. */
  .ni-market { margin-top: var(--s-4); }
  .ni-market th { color: var(--fg-faint); }
  .ni-market td { color: var(--fg-soft); border-top: 1px solid var(--rule); }
  .ni-market .nd-table__tier { color: var(--c-tomato); }

  .ni-cta {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: var(--s-4) 0 0;
  }
  .ni-cta a { color: var(--c-tomato); text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 1px; }

  .ni-sources {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: var(--s-2);
    font-family: var(--f-mono); font-size: var(--fs-xs); line-height: 1.5;
    color: var(--fg-soft);
  }

  @media (max-width: 900px) {
    .ni-stats, .ni-stats--3 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .ni-stats, .ni-stats--3 { grid-template-columns: 1fr; }
  }
</style>
