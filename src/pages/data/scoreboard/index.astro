---
import RecordLayout from '../../../layouts/RecordLayout.astro';
import Scoreboard from '../../../components/Scoreboard.astro';
import BettingWindow from '../../../components/BettingWindow.astro';
---
<RecordLayout
  title="Scoreboard"
  description="Five Structural Certainties. Five testable predictions. Dated and traceable to a public source."
  section="data"
  tone="light"  folio="ex-18 / 38"
  locator='03 · The data <span style="color:var(--fg-faint)">&rarr;</span> <span class="here">The scoreboard</span>'
>
  <header class="rec-masthead">
    <p class="rec-masthead__eyebrow" style="color:var(--c-tomato)">03 · The scoreboard</p>
    <h1 class="rec-masthead__title">Five Structural Certainties.</h1>
    <p class="rec-masthead__claim">
      The Necessities pairs five structural certainties about regulatory direction with five
      dated, testable claims about magnitude. Each claim has a date, a dataset, and a pass/fail test.
    </p>
  </header>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The window</span><span class="rec-beat__count">01 / 02</span></div>
    <h2 class="rec-beat__arg">We will be <em>wrong in public</em>, on a clock.</h2>
    <div class="sb-window"><BettingWindow /></div>
  </section>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The predictions</span><span class="rec-beat__count">02 / 02</span></div>
    <Scoreboard />
  </section>
</RecordLayout>

<style>
  .sb-window { max-width: 36rem; margin-top: var(--s-3); }
</style>
