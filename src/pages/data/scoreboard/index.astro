---
import Base from '../../../layouts/Base.astro';
import Scoreboard from '../../../components/Scoreboard.astro';
import BettingWindow from '../../../components/BettingWindow.astro';
---
<Base
  title="Scoreboard"
  description="Five Structural Certainties. Five bets. Dated and traceable to a public source."
>
  <div class="page-light">
  <section class="sb-page container">
    <header class="sb-page__head">
      <p class="kicker sb-page__kicker">The scoreboard</p>
      <h1 class="sb-page__title">Five certainties. Five claims.</h1>
      <p class="sb-page__lede">
        The thesis rests on five structural certainties. Each carries a falsifiable prediction, dated and testable against a public dataset.
      </p>
      <p class="sb-page__strap">Falsifiable. Dated. Public.</p>
      <div class="sb-page__window">
        <BettingWindow />
      </div>
    </header>

    <Scoreboard />
  </section>
  </div>
</Base>

<style>
  .sb-page { padding-block: var(--s-8) var(--s-9); }
  .sb-page__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    margin-block-end: var(--s-7);
    max-width: 72ch;
  }
  .sb-page__title {
    font-family: var(--f-display);
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    margin: 0;
  }
  .sb-page__kicker { color: var(--c-tomato); margin: 0; }
  .sb-page__lede {
    font-size: var(--fs-lg);
    font-family: var(--f-display);
    line-height: var(--lh-snug);
    color: var(--fg-soft);
    max-width: 56ch;
  }
  .sb-page__strap {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-tomato);
    margin: 0;
  }
  .sb-page__window { margin-block-start: var(--s-4); max-width: 36rem; }
</style>
