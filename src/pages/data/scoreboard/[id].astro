---
import RecordLayout from '../../../layouts/RecordLayout.astro';
import StatusIndicator from '../../../components/StatusIndicator.astro';
import scoreboard from '../../../data/scoreboard.json';

export async function getStaticPaths() {
  return scoreboard.predictions.map((p) => ({
    params: { id: p.id.toLowerCase() },
    props: { prediction: p }
  }));
}

const { prediction } = Astro.props;
const fmtDate = (iso?: string) =>
  iso ? new Date(iso).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: '2-digit' }) : '';
---
<RecordLayout
  title={`${prediction.certainty ?? prediction.id} · Scoreboard · hmm Ventures`}
  description={prediction.claim.slice(0, 200)}
  section="data"
  tone="light"  folio="ex-18 / 38"
  locator='03 · The data <span style="color:var(--fg-faint)">&rarr;</span> <span class="here">Prediction</span>'
>
  <header class="rec-masthead">
    {prediction.certainty_num && (
      <p class="rec-masthead__eyebrow" style="color:var(--c-tomato)">Certainty {prediction.certainty_num}</p>
    )}
    <h1 class="rec-masthead__title">{prediction.certainty ?? prediction.id}</h1>
    <p class="rec-masthead__claim">{prediction.claim}</p>
  </header>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The test</span><span class="rec-beat__count">01 / 03</span></div>
    <div class="sb-status-row">
      <StatusIndicator status={prediction.status as 'open' | 'pending' | 'closed' | 'confirmed' | 'refuted'} />
      <time class="sb-test" datetime={prediction.testable_by}>
        <span class="sb-test__label">Testable by</span>
        <span class="sb-test__value">{fmtDate(prediction.testable_by)}</span>
      </time>
    </div>
  </section>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The dataset</span><span class="rec-beat__count">02 / 03</span></div>
    <p class="rec-beat__note">{prediction.source}</p>
  </section>

  <section class="rec-beat">
    <div class="rec-beat__head"><span class="rec-beat__label">The current reading</span><span class="rec-beat__count">03 / 03</span></div>
    {prediction.evidence && prediction.evidence.length > 0 && (
      <ul class="sb-evidence" role="list">
        {prediction.evidence.map((e: { label: string; href: string }) => (
          <li><a href={e.href}>{e.label} &rarr;</a></li>
        ))}
      </ul>
    )}
    <p class="rec-beat__note sb-foot">Falsifiable. Dated. Public. Scored on the dataset.</p>
  </section>
</RecordLayout>

<style>
  .sb-status-row {
    display: flex;
    gap: var(--s-4);
    align-items: baseline;
    flex-wrap: wrap;
  }
  .sb-test {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
  }
  .sb-test__label { text-transform: uppercase; letter-spacing: 0.1em; color: var(--fg-soft); }
  .sb-test__value { color: var(--fg); font-weight: 600; }

  .sb-evidence {
    list-style: none;
    margin: 0 0 var(--s-4);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
  }
  .sb-evidence a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .sb-evidence a:hover { color: var(--fg); border-bottom-color: var(--fg); }

  .sb-foot {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-tomato);
  }
</style>
