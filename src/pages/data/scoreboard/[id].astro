---
import Base from '../../../layouts/Base.astro';
import StatusIndicator from '../../../components/StatusIndicator.astro';
import scoreboard from '../../../data/scoreboard.json';
import { buildContactMailto } from '../../../utils/mailto.ts';

export async function getStaticPaths() {
  return scoreboard.predictions.map((p) => ({
    params: { id: p.id.toLowerCase() },
    props: { prediction: p }
  }));
}

const { prediction } = Astro.props;
const fmtDate = (iso?: string) =>
  iso ? new Date(iso).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: '2-digit' }) : '';
const betMailto = buildContactMailto(`Scoreboard · ${prediction.certainty ?? prediction.id}`);
---
<Base
  title={`${prediction.certainty ?? prediction.id} · Scoreboard · hmm Ventures`}
  description={prediction.claim.slice(0, 200)}
>
  <div class="page-light">
  <article class="claim container">
    <header class="claim__head">
      <p class="claim__crumbs"><a href="/data/scoreboard/">← All certainties</a></p>
      {prediction.certainty_num && (
        <p class="claim__cnum">Certainty {prediction.certainty_num}</p>
      )}
      <h1 class="claim__title">{prediction.certainty ?? prediction.id}</h1>
      <p class="claim__claim">{prediction.claim}</p>
      <div class="claim__status-row">
        <StatusIndicator status={prediction.status as 'open' | 'pending' | 'closed' | 'confirmed' | 'refuted'} />
        <time class="claim__test" datetime={prediction.testable_by}>
          <span class="claim__test-label">Testable by</span>
          <span class="claim__test-value">{fmtDate(prediction.testable_by)}</span>
        </time>
      </div>
    </header>

    {prediction.evidence && prediction.evidence.length > 0 && (
      <section class="claim__block">
        <p class="kicker claim__kicker">Evidence</p>
        <ul class="claim__evidence" role="list">
          {prediction.evidence.map((e: { label: string; href: string }) => (
            <li><a href={e.href}>{e.label}</a></li>
          ))}
        </ul>
      </section>
    )}

    <footer class="claim__foot">
      <a class="claim__cta" href={betMailto}>Bet on this →</a>
    </footer>
  </article>
  </div>
</Base>

<style>
  .claim { padding-block: var(--s-8) var(--s-9); max-width: 56rem; }
  .claim__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-end: var(--s-7);
    padding-block-end: var(--s-5);
    border-bottom: 1px solid var(--rule);
  }
  .claim__crumbs {
    margin: 0;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .claim__crumbs a {
    color: var(--c-tomato);
    text-decoration: none;
  }
  .claim__cnum {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--c-tomato);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0;
  }
  .claim__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-snug);
    letter-spacing: -0.01em;
    margin: 0;
    max-width: 36ch;
  }
  .claim__claim {
    font-family: var(--f-body);
    font-size: var(--fs-base);
    line-height: 1.6;
    margin: 0;
    max-width: 64ch;
    color: var(--fg);
  }
  .claim__status-row {
    display: flex;
    gap: var(--s-4);
    align-items: baseline;
    flex-wrap: wrap;
    margin-block-start: var(--s-2);
  }
  .claim__test {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
  }
  .claim__test-label { text-transform: uppercase; letter-spacing: 0.1em; color: var(--fg-soft); }
  .claim__test-value { color: var(--fg); font-weight: 600; }

  .claim__block {
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .claim__kicker { color: var(--c-tomato); margin: 0; }
  .claim__evidence {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
  }
  .claim__evidence a {
    color: var(--c-tomato);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }

  .claim__foot {
    margin-block-start: var(--s-7);
    padding-block-start: var(--s-5);
    border-top: 2px solid var(--c-tomato);
  }
  .claim__cta {
    display: inline-block;
    padding: var(--s-3) var(--s-5);
    background: var(--c-tomato);
    color: var(--c-pearl);
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    transition: background var(--dur-1) var(--ease);
  }
  .claim__cta:hover { background: var(--c-mahogany); }
</style>
